{
  "//": "MẪU. appsettings.json THẬT không nằm trong git (xem .gitignore) vì nó chứa khoá thật.",
  "//1": "Máy mới: sao chép file này thành appsettings.json rồi điền các chỗ để trống.",
  "//2": "  cp src/TourKit.Api/appsettings.example.json src/TourKit.Api/appsettings.json",
  "//3": "Thêm khoá cấu hình mới thì thêm vào CẢ HAI file, nếu không máy khác sẽ thiếu.",

  "Database": {
    "Provider": "Postgres"
  },
  "Jwt": {
    "Issuer": "tourkit",
    "Audience": "tourkit",
    "//Secret": "BẮT BUỘC ĐỔI. Chuỗi ngẫu nhiên >= 32 ký tự. Ai biết khoá này thì tự ký được token với tenant bất kỳ.",
    "Secret": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=tourkit_dev;Username=tourkit;Password=",
    "SqliteExample": "Data Source=TourKit_Dev.db",
    "SqlServerExample": "Server=(localdb)\\MSSQLLocalDB;Database=TourKit_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "//Provider": "Log = chỉ ghi log, không gửi thật (mặc định khi phát triển). Smtp = gửi thật.",
    "Provider": "Log",
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "no-reply@tourkit.vn",
    "FromName": "TourKit"
  },
  "AllowedHosts": "*",
  "Cors": {
    "//Origins": "Nguồn được gọi API từ trình duyệt. Bỏ trống = cổng dev của Vite. TUYỆT ĐỐI không dùng dấu sao ở môi trường thật.",
    "Origins": []
  },
  "FileStorage": {
    "//LocalRoot": "Thư mục cất tệp tải lên. Bỏ trống = <thư mục chạy>/App_Data/uploads.",
    "LocalRoot": ""
  },
  "BackgroundJobs": {
    "//Enabled": "Bật máy chủ job nền (Hangfire). Tắt khi một nút trong cụm chỉ phục vụ request.",
    "Enabled": true
  },
  "Ai": {
    "//": "Cấu hình theo TÍNH NĂNG. Hướng dẫn đầy đủ: docs/ai-config.md",
    "//Enabled": "Công tắc tổng. Bật mà thiếu khoá thì ứng dụng KHÔNG khởi động, kèm thông báo thiếu khoá của hãng nào.",
    "Enabled": false,
    "Providers": {
      "deepseek": {
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.deepseek.com/v1",
        "ApiKey": "",
        "TimeoutSeconds": 60,
        "Capabilities": [ "Chat" ]
      },
      "claude": {
        "Kind": "Anthropic",
        "BaseUrl": "https://api.anthropic.com",
        "ApiKey": "",
        "TimeoutSeconds": 90,
        "Capabilities": [ "Chat" ]
      },
      "openai": {
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKey": "",
        "TimeoutSeconds": 60,
        "Capabilities": [ "Chat", "Embedding" ]
      },
      "fptai": {
        "Kind": "Http",
        "BaseUrl": "https://api.fpt.ai",
        "ApiKey": "",
        "TimeoutSeconds": 30,
        "Capabilities": [ "DocumentRead" ]
      },
      "log": {
        "//": "Nhà cung cấp giả — không gọi ra ngoài, không cần khoá. Trỏ Provider của tính năng sang đây để chạy thử.",
        "Kind": "Log",
        "BaseUrl": "",
        "ApiKey": "",
        "TimeoutSeconds": 5,
        "Capabilities": [ "Chat", "Embedding", "DocumentRead" ]
      }
    },
    "Features": {
      "Assistant": {
        "Enabled": true,
        "Provider": "deepseek",
        "Model": "deepseek-chat",
        "MaxOutputTokens": 8000,
        "MaxToolRounds": 5
      },
      "Draft": {
        "Enabled": true,
        "Provider": "deepseek",
        "Model": "deepseek-chat",
        "MaxOutputTokens": 4000,
        "MaxToolRounds": 1
      },
      "Classify": {
        "Enabled": true,
        "Provider": "deepseek",
        "Model": "deepseek-chat",
        "MaxOutputTokens": 1000,
        "MaxToolRounds": 1
      },
      "Summarize": {
        "Enabled": true,
        "Provider": "deepseek",
        "Model": "deepseek-chat",
        "MaxOutputTokens": 2000,
        "MaxToolRounds": 1
      },
      "Scoring": {
        "Enabled": true,
        "Provider": "deepseek",
        "Model": "deepseek-reasoner",
        "MaxOutputTokens": 4000,
        "MaxToolRounds": 1
      },
      "Embedding": {
        "//": "DeepSeek không có API nhúng vector — để trống tới khi làm RAG (giai đoạn 3).",
        "Enabled": false,
        "Provider": "",
        "Model": "",
        "MaxOutputTokens": 1
      },
      "DocumentRead": {
        "Enabled": false,
        "Provider": "fptai",
        "Model": "",
        "MaxOutputTokens": 1,
        "MaxToolRounds": 1
      },
      "CustomerChat": {
        "Enabled": false,
        "Provider": "deepseek",
        "Model": "deepseek-chat",
        "MaxOutputTokens": 4000,
        "MaxToolRounds": 3
      }
    },
    "Limits": {
      "DailyTokensPerUser": 200000,
      "RequestsPerMinutePerUser": 20
    }
  },
  "Redis": {
    "ConnectionString": ""
  }
}
