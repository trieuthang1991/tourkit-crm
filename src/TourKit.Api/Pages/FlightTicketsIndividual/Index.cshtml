@page
@model TourKit.Api.Pages.FlightTicketsIndividual.IndexModel
@{ ViewData["Title"] = "Vé máy bay lẻ"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Vé máy bay lẻ</h4>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
    @if (Model.CanManage)
    {
      <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm vé lẻ</button>
    }
  </div>
</div>

@{
    // 7 KPI P/L — bám StatGrid hệ cũ (footer P/L đưa lên thẻ), gói vào dải mảnh dùng chung.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-sell", "Tổng thu", Model.Stats.TotalSell.ToString("#,##0"), "ti ti-cash", "primary"),
        ("kpi-received", "Thực thu", Model.Stats.TotalReceived.ToString("#,##0"), "ti ti-arrow-down-circle", "success"),
        ("kpi-receivable", "Còn nợ thu", Model.Stats.TotalReceivable.ToString("#,##0"), "ti ti-alert-circle", "danger"),
        ("kpi-cost", "Tổng chi", Model.Stats.TotalCost.ToString("#,##0"), "ti ti-cash-off", "secondary"),
        ("kpi-paid", "Thực chi", Model.Stats.TotalPaid.ToString("#,##0"), "ti ti-arrow-up-circle", "warning"),
        ("kpi-payable", "Phải chi", Model.Stats.TotalPayable.ToString("#,##0"), "ti ti-clock-dollar", "danger"),
        ("kpi-profit", "Lợi nhuận", Model.Stats.TotalProfit.ToString("#,##0"), "ti ti-trending-up", "success"),
    };
}

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="fw-bold" style="font-size:1.15rem" id="@s.Id">@s.Value</div>
          <small class="text-muted" style="font-size:.75rem">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Sub-tab bám hệ cũ (FI_TABS) — đếm lấy từ GetStatsAsync *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="tab">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1" data-count="total">@Model.Stats.Total.ToString("#,##0")</span></a></li>
      @foreach (var t in TourKit.Api.Pages.FlightTicketsIndividual.IndexModel.Tabs)
      {
        <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="@t.Value">@t.Label <span class="badge bg-label-secondary ms-1" data-count="@t.StatKey">@Model.TabCount(t.StatKey).ToString("#,##0")</span></a></li>
      }
    </ul>
    <input type="hidden" id="f-tab" value="" />

    @* Thanh lọc — MỌI tiêu chí đẩy xuống server (FlightTicketIndividualListFilter) *@
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã / PNR / khách / số vé" /></div>
      <div class="col-md-3">
        <select id="f-providerRef" class="form-select tk-s2f" data-placeholder="Nhà cung cấp / hãng"><option value=""></option>@foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }</select>
      </div>
      <div class="col-md-3">
        <select id="f-status" class="form-select tk-auto">
          <option value="">Trạng thái duyệt</option>
          <option value="0">Tạo mới</option><option value="1">Đã duyệt</option><option value="2">Không duyệt</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-adv" title="Lọc nâng cao"><i class="ti ti-filter"></i></button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-departFrom" class="form-control tk-datef" placeholder="Ngày đi từ" autocomplete="off" /></div>
      <div class="col-md-3"><input type="text" id="f-departTo" class="form-control tk-datef" placeholder="Ngày đi đến" autocomplete="off" /></div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2">
    <span class="fw-medium"><span id="bulk-count">0</span> vé lẻ đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-flight-individual"></div>
</div>

@Html.AntiForgeryToken()

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:560px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">vé lẻ</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      @* Passthrough (không có editor): giữ nguyên để sửa không xoá dữ liệu *@
      <input type="hidden" name="Input.OrderRef" />
      <input type="hidden" name="Input.AssigneeRef" />
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Mã hệ thống <span class="text-danger">*</span></label><input type="text" name="Input.Code" class="form-control" placeholder="Nhập mã vé" /></div>
        <div class="col-6 mb-3"><label class="form-label">Số vé (ticket)</label><input type="text" name="Input.TicketCode" class="form-control" placeholder="Số vé của hãng" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Khách đi vé <span class="text-danger">*</span></label><input type="text" name="Input.CustomerName" class="form-control" placeholder="Tên khách" /></div>
        <div class="col-6 mb-3"><label class="form-label">PNR <span class="text-danger">*</span></label><input type="text" name="Input.Pnr" class="form-control" placeholder="Mã PNR" /></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Nhà cung cấp / hãng</label>
        <select name="Input.ProviderRef" class="form-select tk-s2" data-placeholder="Chọn nhà cung cấp">
          <option value=""></option>
          @foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }
        </select>
      </div>
      <div class="row">
        <div class="col-8 mb-3"><label class="form-label">Hành trình</label><input type="text" name="Input.Route" class="form-control" placeholder="VD: SGN-HAN-SGN" /></div>
        <div class="col-4 mb-3">
          <label class="form-label">Loại vé</label>
          <select name="Input.TripType" class="form-select"><option value="0">Một chiều</option><option value="1">Khứ hồi</option></select>
        </div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngày đi (CI)</label><input type="text" name="Input.DepartDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3"><label class="form-label">Ngày về (CO)</label><input type="text" name="Input.ReturnDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Tổng thu</label><input type="number" step="any" name="Input.SellAmount" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-6 mb-3"><label class="form-label">Thực thu</label><input type="number" step="any" name="Input.ReceivedAmount" class="form-control" placeholder="0" value="0" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Tổng chi (giá vốn)</label><input type="number" step="any" name="Input.TotalCost" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-6 mb-3"><label class="form-label">Thực chi</label><input type="number" step="any" name="Input.PaidAmount" class="form-control" placeholder="0" value="0" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Hạn chi</label><input type="text" name="Input.PaymentDueDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái</label>
          <select name="Input.Status" class="form-select"><option value="0">Tạo mới</option><option value="1">Đã duyệt</option><option value="2">Không duyệt</option></select>
        </div>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Ghi chú thêm"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;
    var CAN_MANAGE = @(Model.CanManage ? "true" : "false");
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    var FILTERS = ['providerRef', 'status', 'tab', 'departFrom', 'departTo'];

    function filterValues() {
      var o = {};
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { o[k] = v; } });
      return o;
    }
    function refreshStats() {
      var p = new URLSearchParams(filterValues());
      var q = $('#f-q').val(); if (q) { p.set('search', q); }
      $.getJSON('?handler=Stats&' + p.toString(), function (s) {
        $('#kpi-sell').text(tk.money(s.totalSell));
        $('#kpi-received').text(tk.money(s.totalReceived));
        $('#kpi-receivable').text(tk.money(s.totalReceivable));
        $('#kpi-cost').text(tk.money(s.totalCost));
        $('#kpi-paid').text(tk.money(s.totalPaid));
        $('#kpi-payable').text(tk.money(s.totalPayable));
        $('#kpi-profit').text(tk.money(s.totalProfit));
        $('#tabs [data-count]').each(function () { $(this).text(tk.money(s[$(this).data('count')] || 0)); });
      });
    }
    function reload() { if (grid) { grid.reload(); } refreshStats(); }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      var g = tk.g, esc = g.esc, money = g.money;

      oc = tk.form({
        offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'vé lẻ',
        rules: { 'Input.Code': { required: true }, 'Input.CustomerName': { required: true }, 'Input.Pnr': { required: true } },
        messages: { 'Input.Code': { required: 'Bắt buộc nhập mã vé' }, 'Input.CustomerName': { required: 'Bắt buộc nhập tên khách' }, 'Input.Pnr': { required: 'Bắt buộc nhập PNR' } },
        // Ref NCC có thể là id legacy KHÔNG nằm trong danh mục → thêm option tạm để không mất giá trị khi lưu.
        fill: function ($form, data) {
          var $sel = $form.find('[name="Input.ProviderRef"]');
          var val = data ? data.providerRef : '';
          if (val && !$sel.find('option[value="' + val + '"]').length) {
            $sel.append(new Option(data.providerName || val, val, true, true));
          }
          $sel.val(val || null).trigger('change');
        }
      });
      // Sau khi lưu qua tk.form → làm tươi KPI + số đếm sub-tab.
      $('#frm').on('submit', function () { setTimeout(refreshStats, 600); });

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá vé lẻ ' + r.code + '?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { reload(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      }

      // Sửa/xoá chỉ dành cho người có quyền quản lý vé — giữ đúng luật hệ cũ.
      function actionsFor(r) {
        if (!CAN_MANAGE) { return []; }
        var items = [{ label: '<i class="ti ti-edit me-2"></i>Sửa vé lẻ', action: function () { oc.open(r); } }];
        if (r.orderId) {
          items.push({ label: '<i class="ti ti-external-link me-2"></i>Mở đơn liên quan', action: function () { window.location = '/don-hang/' + r.orderId; } });
        }
        items.push({ separator: true });
        items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá vé lẻ</span>', action: function () { delRow(r); } });
        return items;
      }

      grid = tk.grid('#grid-flight-individual', {
        filters: FILTERS,
        exportName: 've-may-bay-le.csv',
        actions: CAN_MANAGE ? actionsFor : null,
        onRowClick: CAN_MANAGE ? function (r) { oc.open(r); } : null,
        columns: [
          {
            // Vé / Khách: tên khách + mã hệ thống + (số vé · PNR)
            title: 'Vé / Khách', field: 'customerName', widthGrow: 3, minWidth: 200,
            formatter: function (c) {
              var r = c.getData();
              var bits = [r.code];
              if (r.ticketCode) { bits.push('Vé ' + r.ticketCode); }
              if (r.pnr) { bits.push('PNR ' + r.pnr); }
              return '<div class="tk-row-media">' + g.avatar(r.customerName) +
                g.stack(r.customerName, bits.filter(Boolean).join(' · ')) + '</div>';
            }
          },
          {
            title: 'NCC / Đơn hàng', field: 'providerName', widthGrow: 2, minWidth: 170,
            formatter: 'tkStack', formatterParams: { sub: 'orderCode' }
          },
          {
            title: 'Hành trình', field: 'route', widthGrow: 3, minWidth: 210,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.route, r.tripTypeLabel + ' · CI ' + r.departDateText + ' · CO ' + r.returnDateText);
            }
          },
          {
            title: 'Thu / còn nợ', field: 'sellAmount', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(r.sellAmount) + '</div>' +
                '<div class="tk-cell-sub ' + (r.receivableRemaining > 0 ? 'text-danger' : '') + '">còn ' + money(r.receivableRemaining) + '</div></div>';
            }
          },
          {
            title: 'Chi / phải chi', field: 'totalCost', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(r.totalCost) + '</div>' +
                '<div class="tk-cell-sub ' + (r.payableRemaining > 0 ? 'text-danger' : '') + '">phải chi ' + money(r.payableRemaining) + '</div></div>';
            }
          },
          {
            title: 'Lợi nhuận', field: 'profit', width: 140, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var v = c.getValue();
              return '<span class="fw-semibold ' + (v < 0 ? 'text-danger' : 'text-success') + '">' + money(v) + '</span>';
            },
            formatter: function (c) {
              var v = c.getValue();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main ' + (v < 0 ? 'text-danger' : 'text-success') + '">' + money(v) + '</div></div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 160,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor', sub: 'paymentDueDateText' }
          }
        ]
      });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
