@page
@model TourKit.Api.Pages.Currencies.IndexModel
@{ ViewData["Title"] = "Tiền tệ"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Tiền tệ</h5>
    <button type="button" class="btn btn-primary btn-sm" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm</button>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th style="width:20%">Mã</th><th style="width:40%">Tên</th><th class="text-end" style="width:15%">Tỷ giá</th><th class="text-end" style="width:10%">Thứ tự</th><th style="width:15%"></th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr data-json='@System.Text.Json.JsonSerializer.Serialize(new { id = x.Id, code = x.Code, name = x.Name, rateToVnd = x.RateToVnd, sortOrder = x.SortOrder })'>
          <td class="fw-medium">@x.Code</td>
          <td>@x.Name</td>
          <td class="text-end">@x.RateToVnd.ToString("#,##0")</td>
          <td class="text-end">@x.SortOrder</td>
          <td class="text-end">
            <button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>
            <button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="@x.Id" title="Xoá"><i class="ti ti-trash"></i></button>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">tiền tệ</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Mã <span class="text-danger">*</span></label><input type="text" name="Input.Code" class="form-control" placeholder="Ví dụ: USD" /></div>
      <div class="mb-3"><label class="form-label">Tên <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên tiền tệ" /></div>
      @* Bắt buộc trên thực tế: luật nghiệp vụ đòi tỷ giá > 0. Trước đây ô này không có dấu sao và
         mặc định sẵn 0, nên người dùng điền hết những chỗ đánh dấu rồi bấm Lưu là bị từ chối. *@
      <div class="mb-3"><label class="form-label">Tỷ giá (VND) <span class="text-danger">*</span></label><input type="number" step="any" min="0" name="Input.RateToVnd" class="form-control" placeholder="Ví dụ: 25000" /></div>
      <div class="mb-3"><label class="form-label">Thứ tự</label><input type="number" name="Input.SortOrder" class="form-control" value="0" placeholder="0 — càng nhỏ càng lên trên" /></div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc;
    $(function () {
      tk.tableClient('#tbl', { columnDefs: [{ orderable: false, targets: [4] }] });
      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'tiền tệ',
        // 'min' khớp với luật server (GreaterThan(0)): 0 không phải tỷ giá hợp lệ. Dùng số dương
        // nhỏ nhất thay vì min:0 vì jQuery Validate coi min:0 là chấp nhận đúng số 0.
        rules: {
          'Input.Code': { required: true }, 'Input.Name': { required: true },
          'Input.RateToVnd': { required: true, min: 0.000001 }
        },
        messages: {
          'Input.Code': { required: 'Bắt buộc nhập mã' }, 'Input.Name': { required: 'Bắt buộc nhập tên' },
          'Input.RateToVnd': { required: 'Bắt buộc nhập tỷ giá', min: 'Tỷ giá phải > 0.' }
        } });
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open($(this).closest('tr').data('json')); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá tiền tệ?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
