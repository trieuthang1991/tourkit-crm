@page
@model TourKit.Api.Pages.ProviderDebtReport.IndexModel
@{ ViewData["Title"] = "Công nợ NCC"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@{
    // Chú thích dưới thẻ tổng phải nói đúng phạm vi đang xem: để "toàn bộ NCC" trong khi đang lọc
    // một NCC là con số đúng kèm lời giải thích sai — người đọc tin vào lời giải thích.
    var phamVi = Model.LocNccTen is null ? "toàn bộ NCC" : Model.LocNccTen;
    (string Label, string Value, string Icon, string Color, string Sub)[] statCards =
    {
        ("Tổng chi phí", Model.TotalCost.ToString("#,##0"), "ti ti-file-invoice", "primary", phamVi),
        ("Đã chi", Model.TotalPaid.ToString("#,##0"), "ti ti-cash", "success", "phiếu đã duyệt"),
        ("Còn phải trả", Model.TotalOutstanding.ToString("#,##0"), "ti ti-alert-triangle", "danger", "chưa trả"),
    };
}

@if (Model.LocNccTen is { } tenNcc)
{
  <div class="alert alert-primary d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4" role="alert">
    <span><i class="ti ti-filter me-2"></i>Đang xem công nợ của <strong>@tenNcc</strong></span>
    <a href="/cong-no-ncc" class="btn btn-sm btn-label-primary"><i class="ti ti-x me-1"></i>Xem tất cả NCC</a>
  </div>
}
<div class="row g-4 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color">
                <i class="@s.Icon ti-md"></i>
              </span>
            </div>
            <div>
              <span class="d-block text-muted small">@s.Label</span>
              <h4 class="mb-0">@s.Value</h4>
            </div>
          </div>
          <div class="text-muted small mt-2">@s.Sub</div>
        </div>
      </div>
    </div>
  }
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Công nợ phải trả NCC (phân tuổi nợ)</h5>
    @* Giữ nguyên tham số đang lọc để file xuất khớp đúng thứ đang hiện trên màn. *@
    <a id="btn-export" class="btn btn-sm btn-label-secondary"
       href="?handler=Export&providerId=@(Request.Query["providerId"])"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th>Nhà cung cấp</th>
          <th class="text-end">Tổng chi phí</th>
          <th class="text-end">Đã chi</th>
          <th class="text-end">Còn phải trả</th>
          <th class="text-end">0–30 ngày</th>
          <th class="text-end">31–60</th>
          <th class="text-end">61–90</th>
          <th class="text-end">&gt;90</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr>
          <td class="fw-medium">@(string.IsNullOrEmpty(x.ProviderName) ? "—" : x.ProviderName)</td>
          <td class="text-end">@x.TotalCost.ToString("#,##0")</td>
          <td class="text-end text-success">@x.Paid.ToString("#,##0")</td>
          <td class="text-end fw-medium @(x.Outstanding > 0 ? "text-danger" : "")">@x.Outstanding.ToString("#,##0")</td>
          <td class="text-end">@x.Current.ToString("#,##0")</td>
          <td class="text-end">@x.D30.ToString("#,##0")</td>
          <td class="text-end">@x.D60.ToString("#,##0")</td>
          <td class="text-end">@x.D90Plus.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl'); });
  </script>
}
