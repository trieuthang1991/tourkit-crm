@page
@model TourKit.Api.Pages.Quotes.IndexModel
@{ ViewData["Title"] = "Báo giá"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Báo giá — @Model.TypeLabel</h4>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
    @if (Model.CanManage)
    {
      <a href="/bao-gia/Edit@(Model.QuoteType is int t ? $"?type={t}" : "")" class="btn btn-primary"><i class="ti ti-plus me-1"></i> Thêm báo giá</a>
    }
  </div>
</div>

@{
    // 6 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng báo giá", Model.Stats.Total.ToString("#,##0"), "ti ti-file-text", "primary"),
        ("kpi-amount", "Tổng giá trị", Model.Stats.TotalAmount.ToString("#,##0"), "ti ti-cash", "primary"),
        ("kpi-profit", "Lợi nhuận dự kiến", Model.Stats.TotalProfit.ToString("#,##0"), "ti ti-trending-up", "success"),
        ("kpi-accepted", "Chấp nhận", Model.Stats.Accepted.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("kpi-sent", "Đã gửi", Model.Stats.Sent.ToString("#,##0"), "ti ti-send", "info"),
        ("kpi-rejected", "Từ chối", Model.Stats.Rejected.ToString("#,##0"), "ti ti-circle-x", "danger"),
    };
}

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="fw-bold" style="font-size:1.15rem" id="@s.Id">@s.Value</div>
          <small class="text-muted" style="font-size:.75rem">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — lọc nhanh + panel nâng cao; MỌI tiêu chí đẩy xuống server *@
  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã / khách hàng / tiêu đề" /></div>
      <div class="col-md-3">
        <select id="f-status" class="form-select tk-auto">
          <option value="">Trạng thái</option>
          <option value="0">Nháp</option><option value="1">Đã gửi</option>
          <option value="2">Chấp nhận</option><option value="3">Từ chối</option>
        </select>
      </div>
      <div class="col-md-3">
        <select id="f-quoteType" class="form-select tk-auto">
          <option value="">Loại báo giá</option>
          @for (var i = 0; i < TourKit.Api.Pages.Quotes.IndexModel.TypeLabels.Length; i++)
          {
            <option value="@i" selected="@(Model.QuoteType == i)">@TourKit.Api.Pages.Quotes.IndexModel.TypeLabels[i]</option>
          }
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-adv" title="Lọc nâng cao"><i class="ti ti-filter"></i></button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-validFrom" class="form-control tk-datef" placeholder="Hạn hiệu lực từ" autocomplete="off" /></div>
      <div class="col-md-3"><input type="text" id="f-validTo" class="form-control tk-datef" placeholder="Hạn hiệu lực đến" autocomplete="off" /></div>
      <div class="col-md-3">
        <select id="f-converted" class="form-select tk-auto"><option value="">Đã chuyển đơn</option><option value="true">Đã chuyển</option><option value="false">Chưa chuyển</option></select>
      </div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2">
    <span class="fw-medium"><span id="bulk-count">0</span> báo giá đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-quotes"></div>
</div>

@Html.AntiForgeryToken()

@* Modal chuyển báo giá thành đơn — ghép chuyến sẵn có hoặc tour lẻ FIT theo ngày *@
<div class="modal fade" id="convert-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Chuyển báo giá thành đơn</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <p class="text-muted small">Đơn sẽ đặt chỗ theo số khách của báo giá (giá chỗ = giá báo giá); doanh thu đơn = tổng báo giá; các dòng dịch vụ (KS/xe/visa/vé) sinh phiếu đặt dịch vụ lẻ.</p>
        <input type="hidden" id="cv-id" />
        <div class="mb-3">
          <label class="form-label">Ghép chuyến khởi hành sẵn có</label>
          <select id="cv-departure" class="form-select tk-s2m" data-placeholder="Chọn chuyến khởi hành">
            <option value=""></option>
            @foreach (var d in Model.Departures) { <option value="@d.Id">@d.Text</option> }
          </select>
        </div>
        <div class="mb-1">
          <label class="form-label">Hoặc tour lẻ FIT — ngày khởi hành</label>
          <input type="text" id="cv-date" class="form-control tk-datef" placeholder="dd/mm/yyyy" autocomplete="off" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Huỷ</button>
        <button type="button" class="btn btn-primary" id="cv-submit">Chuyển</button>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var grid;
    var CAN_MANAGE = @(Model.CanManage ? "true" : "false");
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    var FILTERS = ['status', 'quoteType', 'validFrom', 'validTo', 'converted'];

    function filterValues() {
      var o = {};
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { o[k] = v; } });
      return o;
    }
    function refreshStats() {
      $.getJSON('?handler=Stats&' + new URLSearchParams(filterValues()).toString(), function (s) {
        $('#kpi-total').text(tk.money(s.total));
        $('#kpi-amount').text(tk.money(s.totalAmount));
        $('#kpi-profit').text(tk.money(s.totalProfit));
        $('#kpi-accepted').text(tk.money(s.accepted));
        $('#kpi-sent').text(tk.money(s.sent));
        $('#kpi-rejected').text(tk.money(s.rejected));
      });
    }

    $(function () {
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }
      $('#cv-departure').select2({ width: '100%', allowClear: true, placeholder: 'Chọn chuyến khởi hành', dropdownParent: $('#convert-modal') });

      var g = tk.g, esc = g.esc, money = g.money;

      function openConvert(r) {
        $('#cv-id').val(r.id);
        $('#cv-departure').val(null).trigger('change');
        if ($('#cv-date')[0]._flatpickr) { $('#cv-date')[0]._flatpickr.clear(); }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('convert-modal')).show();
      }
      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá báo giá ' + r.code + '?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { reload(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      }

      // "Chuyển đơn" CHỈ hiện với báo giá đã được CHẤP NHẬN và chưa chuyển — đúng luật hệ cũ.
      function actionsFor(r) {
        var items = [{ label: '<i class="ti ti-edit me-2"></i>Sửa báo giá', action: function () { window.location = '/bao-gia/soan/' + r.id; } }];
        if (CAN_MANAGE && r.status === 2 && !r.convertedOrderId) {
          items.push({ label: '<i class="ti ti-transform me-2"></i>Chuyển thành đơn hàng', action: function () { openConvert(r); } });
        }
        if (r.convertedOrderId) {
          items.push({ label: '<i class="ti ti-external-link me-2"></i>Mở đơn đã chuyển', action: function () { window.location = '/don-hang/' + r.convertedOrderId; } });
        }
        if (CAN_MANAGE) {
          items.push({ separator: true });
          items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá báo giá</span>', action: function () { delRow(r); } });
        }
        return items;
      }

      grid = tk.grid('#grid-quotes', {
        filters: FILTERS,
        exportName: 'bao-gia.csv',
        actions: actionsFor,
        onRowClick: function (r) { window.location = '/bao-gia/soan/' + r.id; },
        onData: function () { refreshStats(); },
        columns: [
          {
            title: 'Báo giá', field: 'code', widthGrow: 2, minWidth: 160,
            formatter: 'tkStack', formatterParams: { sub: 'typeLabel' }
          },
          {
            title: 'Khách / Tour', field: 'customerName', widthGrow: 4, minWidth: 240,
            formatter: 'tkMedia', formatterParams: { sub: 'title' }
          },
          {
            title: 'Số khách', field: 'adults', width: 160, hozAlign: 'center',
            formatter: function (c) {
              var r = c.getData();
              return '<span class="badge bg-label-secondary me-1" title="Người lớn">' + r.adults + 'NL</span>' +
                '<span class="badge bg-label-info me-1" title="Trẻ em">' + r.children + 'TE</span>' +
                '<span class="badge bg-label-warning" title="Trẻ nhỏ">' + r.infants + 'EB</span>';
            }
          },
          {
            title: 'Giá trị', field: 'totalAmount', width: 160, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var pf = c.getTable().getData().reduce(function (a, r) { return a + (r.totalProfit || 0); }, 0);
              return '<span class="fw-semibold" title="Lợi nhuận trang này: ' + money(pf) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(r.totalAmount) + '</div>' +
                '<div class="tk-cell-sub ' + (r.totalProfit < 0 ? 'text-danger' : 'text-success') + '">LN ' + money(r.totalProfit) + '</div></div>';
            }
          },
          { title: 'Hạn hiệu lực', field: 'validUntil', width: 140, formatter: 'tkStack' },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 170,
            formatter: function (c) {
              var r = c.getData();
              var h = '<span class="badge bg-label-' + r.statusColor + '">' + esc(r.statusLabel) + '</span>';
              if (r.convertedOrderId) { h += '<div class="tk-cell-sub mt-1">Đã chuyển đơn</div>'; }
              return '<div class="tk-cell">' + h + '</div>';
            }
          }
        ]
      });

      function reload() { grid.reload(); refreshStats(); }

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });

      $('#cv-submit').on('click', function () {
        var fd = new FormData();
        fd.append('id', $('#cv-id').val());
        var dep = $('#cv-departure').val(); if (dep) { fd.append('tourDepartureId', dep); }
        var dte = $('#cv-date').val(); if (!dep && dte) { fd.append('departureDate', dte); }
        if (!dep && !dte) { tk.error('Chọn chuyến khởi hành hoặc nhập ngày khởi hành.'); return; }
        tk.post('?handler=Convert', fd).then(function (res) {
          if (res && res.isSuccess) {
            bootstrap.Modal.getInstance(document.getElementById('convert-modal')).hide();
            reload(); tk.toast(res.message || 'Đã chuyển đơn.');
          } else { tk.error((res && res.message) || 'Chuyển đơn thất bại.'); }
        });
      });
    });
  </script>
}
