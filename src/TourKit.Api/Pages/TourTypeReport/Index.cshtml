@page
@model TourKit.Api.Pages.TourTypeReport.IndexModel
@{ ViewData["Title"] = "Thu chi theo loại tour"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@{
    (string Label, string Value, string Icon, string Color, string Sub)[] statCards =
    {
        ("Doanh thu ròng", Model.TotalNetRevenue.ToString("#,##0"), "ti ti-report-money", "primary", "gộp − hoàn/huỷ"),
        ("Chi phí thực", Model.TotalCost.ToString("#,##0"), "ti ti-receipt", "danger", "chi phí đơn"),
        ("Lợi nhuận", Model.TotalProfit.ToString("#,##0"), "ti ti-trending-up", "success", "ròng − chi phí"),
    };
}
<div class="row g-4 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color">
                <i class="@s.Icon ti-md"></i>
              </span>
            </div>
            <div>
              <span class="d-block text-muted small">@s.Label</span>
              <h4 class="mb-0">@s.Value</h4>
            </div>
          </div>
          <div class="text-muted small mt-2">@s.Sub</div>
        </div>
      </div>
    </div>
  }
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Thu–chi theo loại tour</h5>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th>Loại tour</th>
          <th class="text-end">Số đơn</th>
          <th class="text-end">Doanh thu gộp</th>
          <th class="text-end">Hoàn/huỷ</th>
          <th class="text-end">Doanh thu ròng</th>
          <th class="text-end">Chi phí</th>
          <th class="text-end">Lợi nhuận</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr>
          <td class="fw-medium">@(string.IsNullOrEmpty(x.TourTypeName) ? "—" : x.TourTypeName)</td>
          <td class="text-end">@x.OrderCount.ToString("#,##0")</td>
          <td class="text-end">@x.GrossRevenue.ToString("#,##0")</td>
          <td class="text-end text-warning">@x.Refund.ToString("#,##0")</td>
          <td class="text-end fw-medium">@x.NetRevenue.ToString("#,##0")</td>
          <td class="text-end text-danger">@x.Cost.ToString("#,##0")</td>
          <td class="text-end fw-medium @(x.Profit < 0 ? "text-danger" : "text-success")">@x.Profit.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl'); });
  </script>
}
