@page
@model TourKit.Api.Pages.MarketingCampaigns.IndexModel
@{ ViewData["Title"] = "Chiến dịch"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Marketing</h4>
  <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm chiến dịch</button>
</div>

@* 4 KPI — bám StatGrid hệ cũ *@
<div class="row g-3 mb-3">
  <div class="col-sm-6 col-lg-3">
    <div class="card h-100"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-primary"><i class="ti ti-speakerphone"></i></span></div>
      <div><small class="text-muted d-block">Tổng chiến dịch</small><h5 class="mb-0">@Model.Stats.Total.ToString("#,##0")</h5></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card h-100"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-secondary"><i class="ti ti-pencil"></i></span></div>
      <div><small class="text-muted d-block">Nháp</small><h5 class="mb-0">@Model.Stats.Draft.ToString("#,##0")</h5></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card h-100"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-success"><i class="ti ti-send"></i></span></div>
      <div><small class="text-muted d-block">Đã gửi</small><h5 class="mb-0">@Model.Stats.Sent.ToString("#,##0")</h5></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card h-100"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-info"><i class="ti ti-mail"></i></span></div>
      <div><small class="text-muted d-block">Tin đã gửi</small><h5 class="mb-0">@Model.Stats.Messages.ToString("#,##0")</h5></div>
    </div></div>
  </div>
</div>

@* Thanh lọc — đủ tiêu chí CampaignListFilter (Q · Channel · Status), đẩy hết xuống service. *@
<div class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Tên chiến dịch…" /></div>
      <div class="col-md-3">
        <select id="f-channel" class="form-select tk-s2f" data-placeholder="Kênh">
          <option value=""></option><option value="1">Email</option><option value="2">SMS</option><option value="3">Zalo</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search"></i></button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Segmented trạng thái của hệ cũ *@
    <div class="btn-group btn-group-sm mt-3" role="group" id="seg-status">
      <button type="button" class="btn btn-primary" data-status="">Tất cả (@Model.Stats.Total.ToString("#,##0"))</button>
      <button type="button" class="btn btn-label-primary" data-status="0">Nháp</button>
      <button type="button" class="btn btn-label-primary" data-status="1">Đã gửi</button>
    </div>
  </div>
</div>

<div class="card">
  <h5 class="card-header">Danh sách chiến dịch</h5>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr><th class="text-center">#</th><th style="width:28%">Chiến dịch</th><th style="width:38%">Nội dung</th><th style="width:12%">Trạng thái</th><th></th></tr>
      </thead>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:560px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">chiến dịch</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Tên chiến dịch <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên chiến dịch" /></div>
      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label">Kênh <span class="text-danger">*</span></label>
          <select name="Input.Channel" class="form-select"><option value="1">Email</option><option value="2">SMS</option><option value="3">Zalo</option></select>
        </div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái</label>
          <select name="Input.Status" class="form-select"><option value="0">Nháp</option><option value="1">Đã gửi</option></select>
        </div>
      </div>
      <div class="mb-3"><label class="form-label">Chủ đề</label><input type="text" name="Input.Subject" class="form-control" placeholder="Tiêu đề email/tin nhắn" /></div>
      <div class="mb-3"><label class="form-label">Nội dung <span class="text-danger">*</span></label><textarea name="Input.Body" class="form-control" rows="6" placeholder="Nội dung chiến dịch"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@* Modal nhật ký gửi — bám CampaignLogsDrawer của hệ cũ (chỉ xem). *@
<div class="modal fade" id="md-log" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Nhật ký gửi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><div id="log-list"></div></div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt, segStatus = '';

    function collectFilters(d) {
      var ch = $('#f-channel').val(); if (ch) { d.channel = ch; }
      if (segStatus !== '') { d.status = segStatus; }
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }

    function openLogs(row) {
      $('#md-log .modal-title').text('Nhật ký gửi — ' + row.name);
      $('#log-list').html('<div class="text-muted">Đang tải…</div>');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('md-log')).show();
      $.getJSON('?handler=Logs&campaignId=' + row.id, function (rows) {
        if (!rows.length) { $('#log-list').html('<div class="text-muted">Chưa có lượt gửi nào</div>'); return; }
        $('#log-list').html('<table class="table table-sm"><thead><tr><th>Người nhận</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>' +
          rows.map(function (l) {
            return '<tr><td>' + tk.escape(l.recipient) + '</td>' +
              '<td><span class="badge bg-label-' + l.statusColor + '">' + tk.escape(l.statusLabel) + '</span></td>' +
              '<td>' + tk.escape(l.sentAtText) + '</td></tr>';
          }).join('') + '</tbody></table>');
      });
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      // Server-side: mỗi lần chỉ tải 1 trang (không get-all).
      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: null, render: function (r) {
              return '<div class="fw-medium">' + tk.escape(r.name) + '</div>' +
                     '<span class="badge bg-label-' + r.channelColor + '">' + tk.escape(r.channelLabel) + '</span>';
            } },
          { data: null, render: function (r) {
              return '<div>' + tk.escape(r.subjectText) + '</div>' +
                     '<small class="text-muted" title="' + tk.escape(r.body) + '">' + tk.escape(r.bodyPreview) + '</small>';
            } },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, className: 'text-end text-nowrap', render: function () {
              return '<button type="button" class="btn btn-sm btn-label-secondary js-log" title="Nhật ký gửi"><i class="ti ti-list me-1"></i>Log</button> ' +
                     '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" title="Xoá"><i class="ti ti-trash"></i></button>';
            } }
        ]
      });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'chiến dịch',
        rules: { 'Input.Name': { required: true }, 'Input.Body': { required: true } },
        messages: { 'Input.Name': { required: 'Bắt buộc nhập tên' }, 'Input.Body': { required: 'Bắt buộc nhập nội dung' } } });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { dt.ajax.reload(); } });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      $('#seg-status button').on('click', function () {
        segStatus = this.getAttribute('data-status');
        $('#seg-status button').removeClass('btn-primary').addClass('btn-label-primary');
        $(this).removeClass('btn-label-primary').addClass('btn-primary');
        dt.ajax.reload();
      });
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        $('#f-channel').val('').trigger('change.select2');
        segStatus = '';
        $('#seg-status button').removeClass('btn-primary').addClass('btn-label-primary');
        $('#seg-status button[data-status=""]').removeClass('btn-label-primary').addClass('btn-primary');
        dt.ajax.reload();
      });

      // Server-side: lấy dữ liệu dòng từ DataTables API (không còn data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-log', function () { openLogs(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = dt.row($(this).closest('tr')).data().id;
        tk.confirmDelete({ title: 'Xoá chiến dịch?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
