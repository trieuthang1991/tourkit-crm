@page
@model TourKit.Api.Pages.MarketingCampaigns.IndexModel
@{ ViewData["Title"] = "Chiến dịch"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  @* Ô soạn thảo có định dạng cho trường lưu HTML — Quill đi kèm theme, không thêm thư viện ngoài. *@
  <link rel="stylesheet" href="~/vendor/libs/quill/typography.css" />
  <link rel="stylesheet" href="~/vendor/libs/quill/editor.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 4 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng chiến dịch", Model.Stats.Total.ToString("#,##0"), "ti ti-speakerphone", "primary"),
        ("Nháp", Model.Stats.Draft.ToString("#,##0"), "ti ti-pencil", "secondary"),
        ("Đã gửi", Model.Stats.Sent.ToString("#,##0"), "ti ti-send", "success"),
        ("Tin đã gửi", Model.Stats.Messages.ToString("#,##0"), "ti ti-mail", "info"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Marketing <span class="mx-1">/</span> <span class="text-body">Chiến dịch</span></div>
    <h4 class="mb-0">Marketing</h4>
  </div>
  @if (Model.CanCreate)
  {
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm chiến dịch</button>
  }
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — đủ tiêu chí CampaignListFilter (Q · Channel · Status), đẩy hết xuống service. *@
  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Tên chiến dịch…" /></div>
      <div class="col-md-3">
        <select id="f-channel" class="form-select tk-s2f" data-placeholder="Kênh">
          <option value=""></option><option value="1">Email</option><option value="2">SMS</option><option value="3">Zalo</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Trạng thái (Segmented của hệ cũ) — chuyển sang chip lọc nhanh chuẩn của tk.grid *@
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
      <span class="text-muted small fw-medium" style="min-width:110px">Trạng thái</span>
      <input type="hidden" id="f-status" value="" />
      <button type="button" class="btn btn-sm btn-primary tk-chip" data-k="status" data-v="">Tất cả <span class="badge bg-white text-dark ms-1">@Model.Stats.Total.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="0">Nháp <span class="badge bg-secondary ms-1">@Model.Stats.Draft.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="1">Đã gửi <span class="badge bg-secondary ms-1">@Model.Stats.Sent.ToString("#,##0")</span></button>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> chiến dịch đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-campaigns"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:560px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">chiến dịch</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Tên chiến dịch <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên chiến dịch" /></div>
      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label">Kênh <span class="text-danger">*</span></label>
          <select name="Input.Channel" class="form-select"><option value="1">Email</option><option value="2">SMS</option><option value="3">Zalo</option></select>
        </div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái</label>
          <select name="Input.Status" class="form-select"><option value="0">Nháp</option><option value="1">Đã gửi</option></select>
        </div>
      </div>
      <div class="mb-3"><label class="form-label">Chủ đề</label><input type="text" name="Input.Subject" class="form-control" placeholder="Tiêu đề email/tin nhắn" /></div>
      @* Email gửi HTML nên soạn bằng ô có định dạng; SMS/Zalo là văn bản thuần — xem script bên dưới. *@
      <div class="mb-3"><label class="form-label">Nội dung <span class="text-danger">*</span></label><textarea name="Input.Body" class="form-control tk-rte-field" rows="6" placeholder="Nội dung gửi cho khách…"></textarea></div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@* Modal nhật ký gửi — bám CampaignLogsDrawer của hệ cũ (chỉ xem). *@
<div class="modal fade" id="md-log" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Nhật ký gửi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><div id="log-list"></div></div>
    </div>
  </div>
</div>

@* Modal gửi chiến dịch — danh sách người nhận LUÔN hiển thị tường minh trước khi bấm gửi. *@
<div class="modal fade" id="md-send" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Gửi chiến dịch</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="alert alert-warning d-flex align-items-start" role="alert">
          <i class="ti ti-alert-triangle me-2 mt-1"></i>
          <div>Hệ thống gửi <strong>thật</strong> tới từng địa chỉ trong ô dưới. Kiểm tra kỹ danh sách trước khi bấm gửi — đã gửi thì không thu hồi được.</div>
        </div>
        <div class="row g-2 align-items-end mb-3">
          <div class="col-md-7">
            <label class="form-label small mb-1">Lấy từ danh sách khách hàng (tuỳ chọn)</label>
            <input type="text" id="s-q" class="form-control" placeholder="Từ khoá tên/điện thoại khách — để trống là lấy từ đầu danh sách" />
          </div>
          <div class="col-md-5">
            <button type="button" class="btn btn-label-primary w-100" id="s-fill"><i class="ti ti-users me-1"></i> Nạp địa chỉ</button>
          </div>
        </div>
        <label class="form-label">Danh sách người nhận <span class="text-danger">*</span> <span class="text-muted small">(mỗi dòng một địa chỉ)</span></label>
        <textarea id="s-recipients" class="form-control font-monospace" rows="10" placeholder="vd@email.com"></textarea>
        <div class="d-flex justify-content-between mt-2">
          <span class="text-muted small" id="s-hint"></span>
          <span class="small" id="s-count">0 địa chỉ</span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Huỷ</button>
        <button type="button" class="btn btn-primary" id="s-send"><i class="ti ti-send me-1"></i> Gửi ngay</button>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/quill/quill.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid, sendRow = null;
    var CAN_CREATE = @(Model.CanCreate ? "true" : "false");
    var CAN_SEND = @(Model.CanSend ? "true" : "false");
    var MAX_RECIPIENTS = @TourKit.Api.Pages.MarketingCampaigns.IndexModel.MaxRecipients;

    function recipientLines() {
      return ($('#s-recipients').val() || '').split(/[\n,;]+/).map(function (s) { return s.trim(); }).filter(Boolean);
    }

    function refreshCount() {
      var n = recipientLines().length;
      $('#s-count').text(n + ' địa chỉ').toggleClass('text-danger', n > MAX_RECIPIENTS);
    }

    function openSend(row) {
      sendRow = row;
      $('#md-send .modal-title').text('Gửi chiến dịch — ' + row.name);
      $('#s-recipients').val('');
      $('#s-q').val('');
      $('#s-hint').text('Kênh ' + row.channelLabel + ' · tối đa ' + MAX_RECIPIENTS + ' địa chỉ mỗi lần gửi');
      refreshCount();
      bootstrap.Modal.getOrCreateInstance(document.getElementById('md-send')).show();
    }

    function openLogs(row) {
      $('#md-log .modal-title').text('Nhật ký gửi — ' + row.name);
      $('#log-list').html('<div class="text-muted">Đang tải…</div>');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('md-log')).show();
      $.getJSON('?handler=Logs&campaignId=' + row.id, function (rows) {
        if (!rows.length) { $('#log-list').html('<div class="text-muted">Chưa có lượt gửi nào</div>'); return; }
        $('#log-list').html('<table class="table table-sm"><thead><tr><th>Người nhận</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>' +
          rows.map(function (l) {
            return '<tr><td>' + tk.escape(l.recipient) + '</td>' +
              '<td><span class="badge bg-label-' + l.statusColor + '">' + tk.escape(l.statusLabel) + '</span></td>' +
              '<td>' + tk.escape(l.sentAtText) + '</td></tr>';
          }).join('') + '</tbody></table>');
      });
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      var g = tk.g, esc = g.esc;

      // Email gửi đi là HTML → soạn bằng ô có định dạng. SMS/Zalo là văn bản THUẦN, gõ HTML vào
      // là nhà mạng gửi nguyên mớ thẻ cho khách → giữ ô nhập thường.
      var body = document.querySelector('#frm [name="Input.Body"]');
      function syncEditor() { tk.rte.enable(body, String($('#frm [name="Input.Channel"]').val()) === '1'); }

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'chiến dịch',
        rules: { 'Input.Name': { required: true }, 'Input.Body': { required: true } },
        messages: { 'Input.Name': { required: 'Bắt buộc nhập tên' }, 'Input.Body': { required: 'Bắt buộc nhập nội dung' } },
        afterOpen: syncEditor });
      $('#frm [name="Input.Channel"]').on('change', syncEditor);

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá chiến dịch?', text: r.name || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = r.id;
          f.submit();
        });
      }

      // Gửi/sửa/xoá bám ĐÚNG quyền như bản cũ: gửi cần quyền gửi, sửa–xoá cần quyền tạo.
      function actionsFor(r) {
        var items = [{ label: '<i class="ti ti-list me-2"></i>Nhật ký gửi', action: function () { openLogs(r); } }];
        if (CAN_SEND) {
          items.unshift({ label: '<i class="ti ti-send me-2"></i>Gửi chiến dịch', action: function () { openSend(r); } });
        }
        if (CAN_CREATE) {
          items.push({ label: '<i class="ti ti-edit me-2"></i>Sửa chiến dịch', action: function () { oc.open(r); } });
          items.push({ separator: true });
          items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá chiến dịch</span>', action: function () { delRow(r); } });
        }
        return items;
      }

      // Server-side: mỗi lần chỉ tải 1 trang (không get-all).
      grid = tk.grid('#grid-campaigns', {
        filters: ['channel', 'status'],
        chipGroups: ['status'],
        exportName: 'chien-dich-marketing.csv',
        actions: actionsFor,
        columns: [
          {
            title: 'Chiến dịch', field: 'name', widthGrow: 3, minWidth: 220,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell"><div class="tk-cell-main">' + esc(r.name) + '</div>' +
                '<div class="mt-1"><span class="badge bg-label-' + r.channelColor + '">' + esc(r.channelLabel) + '</span></div></div>';
            }
          },
          {
            title: 'Nội dung', field: 'subjectText', widthGrow: 5, minWidth: 280,
            formatter: function (c) { var r = c.getData(); return g.stack(r.subjectText, r.bodyPreview); }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 140,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });

      $('#s-recipients').on('input', refreshCount);

      $('#s-fill').on('click', function () {
        var btn = $(this).prop('disabled', true);
        $.getJSON('?handler=Recipients&channel=' + sendRow.channel + '&q=' + encodeURIComponent($('#s-q').val() || ''))
          .always(function () { btn.prop('disabled', false); })
          .done(function (res) {
            if (!res || !res.isSuccess) { tk.error((res && res.message) || 'Không nạp được danh sách'); return; }
            var items = res.data.items || [];
            if (!items.length) { tk.error('Không có khách hàng nào có ' + res.data.channelLabel + ' khớp điều kiện.'); return; }
            $('#s-recipients').val(items.map(function (i) { return i.contact; }).join('\n'));
            refreshCount();
            tk.toast('Đã nạp ' + items.length + ' địa chỉ' + (items.length >= res.data.max ? ' (chạm trần ' + res.data.max + ')' : ''));
          });
      });

      $('#s-send').on('click', function () {
        var list = recipientLines();
        if (!list.length) { tk.error('Chưa có địa chỉ nhận nào.'); return; }
        Swal.fire({
          title: 'Gửi thật tới ' + list.length + ' địa chỉ?',
          text: 'Chiến dịch "' + sendRow.name + '" qua kênh ' + sendRow.channelLabel + '. Đã gửi thì không thu hồi được.',
          icon: 'warning', showCancelButton: true, confirmButtonText: 'Gửi ngay', cancelButtonText: 'Huỷ',
          customClass: { confirmButton: 'btn btn-primary me-2', cancelButton: 'btn btn-label-secondary' }, buttonsStyling: false
        }).then(function (r) {
          if (!r.isConfirmed) { return; }
          var btn = $('#s-send').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi…');
          var fd = new FormData();
          fd.append('id', sendRow.id);
          fd.append('recipients', list.join('\n'));
          tk.post('?handler=Send', fd)
            .then(function (res) {
              btn.prop('disabled', false).html('<i class="ti ti-send me-1"></i> Gửi ngay');
              if (res && res.isSuccess) {
                tk.toast(res.message);
                bootstrap.Modal.getInstance(document.getElementById('md-send')).hide();
                grid.reload();
              } else { tk.error((res && res.message) || 'Gửi thất bại'); }
            });
        });
      });
    });
  </script>
}
