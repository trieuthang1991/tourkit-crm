@page
@using TourKit.Shared.Enums
@model TourKit.Api.Pages.MarketingCampaigns.IndexModel
@{ ViewData["Title"] = "Chiến dịch"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="row g-3 mb-3">
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-primary"><i class="ti ti-speakerphone"></i></span></div>
      <div><small class="text-muted d-block">Tổng chiến dịch</small><h5 class="mb-0">@Model.Stats.Total</h5></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-secondary"><i class="ti ti-pencil"></i></span></div>
      <div><small class="text-muted d-block">Nháp</small><h5 class="mb-0">@Model.Stats.Draft</h5></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-success"><i class="ti ti-send"></i></span></div>
      <div><small class="text-muted d-block">Đã gửi</small><h5 class="mb-0">@Model.Stats.Sent</h5></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body d-flex align-items-center">
      <div class="avatar me-3"><span class="avatar-initial rounded bg-label-info"><i class="ti ti-mail"></i></span></div>
      <div><small class="text-muted d-block">Tin đã gửi</small><h5 class="mb-0">@Model.Stats.Messages.ToString("#,##0")</h5></div>
    </div></div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Chiến dịch (Email Marketing)</h5>
    <button type="button" class="btn btn-primary btn-sm" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm chiến dịch</button>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th style="width:32%">Tên</th><th style="width:12%">Kênh</th><th style="width:34%">Chủ đề</th><th style="width:12%">Trạng thái</th><th style="width:10%"></th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr data-json='@System.Text.Json.JsonSerializer.Serialize(new { id = x.Id, name = x.Name, channel = (int)x.Channel, subject = x.Subject, body = x.Body, status = x.Status })'>
          <td class="fw-medium">@x.Name</td>
          <td>@TourKit.Api.Pages.MarketingCampaigns.IndexModel.ChannelLabel(x.Channel)</td>
          <td>@(string.IsNullOrEmpty(x.Subject) ? "—" : x.Subject)</td>
          <td>@if (x.Status == 1) { <span class="badge bg-label-success">Đã gửi</span> } else { <span class="badge bg-label-secondary">Nháp</span> }</td>
          <td class="text-end">
            <button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>
            <button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="@x.Id" title="Xoá"><i class="ti ti-trash"></i></button>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:560px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">chiến dịch</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Tên chiến dịch <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên chiến dịch" /></div>
      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label">Kênh <span class="text-danger">*</span></label>
          <select name="Input.Channel" class="form-select"><option value="1">Email</option><option value="2">SMS</option><option value="3">Zalo</option></select>
        </div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái</label>
          <select name="Input.Status" class="form-select"><option value="0">Nháp</option><option value="1">Đã gửi</option></select>
        </div>
      </div>
      <div class="mb-3"><label class="form-label">Chủ đề</label><input type="text" name="Input.Subject" class="form-control" placeholder="Tiêu đề email/tin nhắn" /></div>
      <div class="mb-3"><label class="form-label">Nội dung <span class="text-danger">*</span></label><textarea name="Input.Body" class="form-control" rows="6" placeholder="Nội dung chiến dịch"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc;
    $(function () {
      tk.tableClient('#tbl', { columnDefs: [{ orderable: false, targets: [4] }] });
      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'chiến dịch',
        rules: { 'Input.Name': { required: true }, 'Input.Body': { required: true } },
        messages: { 'Input.Name': { required: 'Bắt buộc nhập tên' }, 'Input.Body': { required: 'Bắt buộc nhập nội dung' } } });
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open($(this).closest('tr').data('json')); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá chiến dịch?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
