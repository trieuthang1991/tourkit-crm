@page
@model TourKit.Api.Pages.RoomAllotments.IndexModel
@{ ViewData["Title"] = "Quỹ phòng khách sạn"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

@section PageStyles {
  <style>
    /* Ma trận NCC × ngày: cột đầu ghim trái để cuộn ngang vẫn đọc được tên NCC/dịch vụ. */
    #grid { min-width: 900px; }
    #grid th.tk-gcol, #grid td.tk-gcol { position: sticky; left: 0; z-index: 2; min-width: 220px; background: var(--bs-card-bg, var(--bs-body-bg)); }
    #grid td.tk-gcell { min-width: 74px; cursor: pointer; line-height: 1.25; }
    #grid td.tk-gcell:hover { outline: 2px solid var(--bs-primary); outline-offset: -2px; }
  </style>
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-0">Quỹ phòng khách sạn</h4>
    <small class="text-muted">Lịch tồn (allotment) + giá NET theo ngày — lưới chỉ nạp cửa sổ ngày đang xem.</small>
  </div>
  <div class="d-flex gap-2">
    @* Chuyển Lưới lịch / Bảng — lưới chỉ nạp NCC + ngày trong cửa sổ đang xem *@
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-label-secondary active" id="view-grid" title="Lưới lịch"><i class="ti ti-layout-grid"></i></button>
      <button type="button" class="btn btn-label-secondary" id="view-table" title="Dạng bảng"><i class="ti ti-list"></i></button>
    </div>
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm quỹ phòng</button>
  </div>
</div>

@* 5 KPI — bám StatGrid hệ cũ, cập nhật theo bộ lọc đang áp *@
<div class="row g-3 mb-3">
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Số ô lịch</small><h5 class="mb-0" id="kpi-cells">@Model.Stats.Cells.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Số NCC</small><h5 class="mb-0" id="kpi-providers">@Model.Stats.Providers.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng tồn</small><h5 class="mb-0" id="kpi-quota">@Model.Stats.TotalQuota.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã đặt</small><h5 class="mb-0 text-warning" id="kpi-booked">@Model.Stats.TotalBooked.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Còn lại</small><h5 class="mb-0 text-success" id="kpi-available">@Model.Stats.TotalAvailable.ToString("#,##0")</h5></div></div></div>
</div>

@* Chú giải loại ngày — bám card "Loại ngày" hệ cũ *@
<div class="card mb-3">
  <div class="card-body py-3">
    <small class="text-muted d-block mb-2">Loại ngày</small>
    @foreach (var d in TourKit.Api.Pages.RoomAllotments.IndexModel.DayTypes)
    {
      <span class="badge bg-label-@TourKit.Api.Pages.RoomAllotments.IndexModel.DayTypeColor(d.Value) me-1">@d.Label</span>
    }
  </div>
</div>

@* Thanh lọc — đủ tiêu chí RoomAllotmentListFilter hỗ trợ *@
<div class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-3"><input type="text" id="f-q" class="form-control" placeholder="Dịch vụ / dự án / tỉnh thành" /></div>
      <div class="col-md-2"><input type="text" id="f-province" class="form-control" placeholder="Tỉnh thành" /></div>
      <div class="col-md-2"><input type="text" id="f-market" class="form-control" placeholder="Thị trường" /></div>
      <div class="col-md-2">
        <select id="f-providerRef" class="form-select tk-s2f" data-placeholder="Nhà cung cấp"><option value=""></option>@foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }</select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <select id="f-rating" class="form-select"><option value="">Hạng sao</option><option value="1">1★</option><option value="2">2★</option><option value="3">3★</option><option value="4">4★</option><option value="5">5★</option></select>
        <button type="button" class="btn btn-primary" id="btn-search" title="Tìm kiếm"><i class="ti ti-search"></i></button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
      <div class="col-md-3"><label class="form-label small mb-1">Ngày từ</label><input type="text" id="f-dateFrom" class="form-control tk-datef" placeholder="dd/mm/yyyy" /></div>
      <div class="col-md-3"><label class="form-label small mb-1">đến</label><input type="text" id="f-dateTo" class="form-control tk-datef" placeholder="dd/mm/yyyy" /></div>
    </div>
  </div>
</div>

@* Khung LƯỚI LỊCH — ma trận NCC/dịch vụ × ngày (không dùng FullCalendar).
   Mỗi lần đổi cửa sổ/trang hàng chỉ gọi handler Grid cho ĐÚNG cửa sổ đó — không get-all. *@
<div class="card" id="pane-grid">
  <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <h5 class="mb-0">Lưới quỹ phòng theo ngày</h5>
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <span class="text-muted small" id="g-range"></span>
      <select id="g-span" class="form-select form-select-sm" style="width:auto" aria-label="Độ dài cửa sổ">
        <option value="7">7 ngày</option>
        <option value="14" selected>14 ngày</option>
        <option value="30">30 ngày</option>
      </select>
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn btn-label-secondary" id="g-prev" title="Cửa sổ trước"><i class="ti ti-chevron-left"></i></button>
        <button type="button" class="btn btn-label-secondary" id="g-today">Hôm nay</button>
        <button type="button" class="btn btn-label-secondary" id="g-next" title="Cửa sổ sau"><i class="ti ti-chevron-right"></i></button>
      </div>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-bordered table-sm mb-0 align-middle" id="grid">
      <thead></thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="card-footer d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <small class="text-muted" id="g-info"></small>
    <div class="d-flex gap-2 align-items-center">
      <select id="g-size" class="form-select form-select-sm" style="width:auto" aria-label="Số hàng mỗi trang">
        <option value="10">10 hàng</option>
        <option value="25" selected>25 hàng</option>
        <option value="50">50 hàng</option>
        <option value="100">100 hàng</option>
      </select>
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn btn-label-secondary" id="g-rprev" title="Trang hàng trước"><i class="ti ti-chevron-left"></i></button>
        <button type="button" class="btn btn-label-secondary" id="g-rnext" title="Trang hàng sau"><i class="ti ti-chevron-right"></i></button>
      </div>
    </div>
  </div>
</div>

<div class="card d-none" id="pane-table">
  <div class="card-header"><h5 class="mb-0">Quỹ phòng / Allotment</h5></div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          @* min-width để bảng cuộn ngang thay vì bóp cột chữ trên màn hẹp. *@
          <th class="text-center" style="min-width:52px">#</th><th style="min-width:170px">Nhà cung cấp</th><th style="min-width:170px">Dịch vụ / Phòng</th><th style="min-width:150px">Tỉnh / Thị trường</th>
          <th style="min-width:110px">Ngày</th><th style="min-width:110px">Loại ngày</th>
          <th class="text-center" style="min-width:70px">Tồn</th><th class="text-center" style="min-width:70px">Đặt</th><th class="text-center" style="min-width:70px">Còn</th>
          <th class="text-end" style="min-width:120px">Giá NET</th><th style="min-width:56px"></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="11" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:560px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">ô quỹ phòng</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Mã NCC <span class="text-danger">*</span></label><input type="text" name="Input.ProviderRef" class="form-control" placeholder="VD: KS001" /></div>
        <div class="col-6 mb-3"><label class="form-label">Tên dịch vụ / Phòng <span class="text-danger">*</span></label><input type="text" name="Input.ServiceName" class="form-control" placeholder="VD: Deluxe Double" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Dự án</label><input type="text" name="Input.ProjectName" class="form-control" placeholder="Tên dự án/khách sạn" /></div>
        <div class="col-6 mb-3"><label class="form-label">Tỉnh thành</label><input type="text" name="Input.Province" class="form-control" placeholder="VD: Đà Nẵng" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Thị trường</label><input type="text" name="Input.Market" class="form-control" placeholder="VD: Nội địa" /></div>
        <div class="col-6 mb-3"><label class="form-label">Ngày <span class="text-danger">*</span></label><input type="text" name="Input.Date" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label">Loại ngày</label>
          <select name="Input.DayType" class="form-select"><option value="0">Thường</option><option value="1">Cuối tuần</option><option value="2">Lễ tết</option><option value="3">Cao điểm</option></select>
        </div>
        <div class="col-6 mb-3">
          <label class="form-label">Hạng (sao)</label>
          <select name="Input.Rating" class="form-select"><option value="">— Không —</option><option value="1">1 sao</option><option value="2">2 sao</option><option value="3">3 sao</option><option value="4">4 sao</option><option value="5">5 sao</option></select>
        </div>
      </div>
      <div class="row">
        <div class="col-4 mb-3"><label class="form-label">Tồn (quota)</label><input type="number" name="Input.Quota" class="form-control" placeholder="0" min="0" /></div>
        <div class="col-4 mb-3"><label class="form-label">Đã đặt</label><input type="number" name="Input.Booked" class="form-control" placeholder="0" min="0" /></div>
        <div class="col-4 mb-3"><label class="form-label">Giá NET/đêm</label><input type="number" name="Input.Price" class="form-control" placeholder="0" min="0" step="1000" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Ghi chú quỹ phòng"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt;
    // Mọi tiêu chí đẩy xuống SERVER (RoomAllotmentListFilter) — không lọc ở client.
    var FILTERS = ['province', 'market', 'providerRef', 'rating', 'dateFrom', 'dateTo'];
    // Lưới tự giới hạn bằng cửa sổ ngày → không gửi dateFrom/dateTo (server đã đè bằng from/to).
    var GRID_FILTERS = ['province', 'market', 'providerRef', 'rating'];

    function collectFilters(d) {
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { d[k] = v; } });
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }

    // ---- Khung LƯỚI LỊCH (ma trận NCC/dịch vụ × ngày) ----
    // gFrom/gTo = cửa sổ ĐANG XEM; gPage/gSize = phân trang HÀNG. Mỗi lần đổi chỉ nạp đúng cửa sổ đó.
    var gFrom = '@Model.GridFrom', gTo = '@Model.GridTo', gSpan = 14, gPage = 1, gSize = 25, gData = null;

    function isoAdd(iso, n) {
      var d = new Date(iso + 'T00:00:00');
      d.setDate(d.getDate() + n);
      var m = String(d.getMonth() + 1), day = String(d.getDate());
      if (m.length < 2) { m = '0' + m; }
      if (day.length < 2) { day = '0' + day; }
      return d.getFullYear() + '-' + m + '-' + day;
    }
    function isoVi(iso) { var p = iso.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }

    function setWindow(from) {
      gFrom = from;
      gTo = isoAdd(from, gSpan - 1);
      gPage = 1;
      gridLoad();
    }

    function gridParams() {
      var p = { from: gFrom, to: gTo, page: gPage, size: gSize };
      GRID_FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { p[k] = v; } });
      var q = $('#f-q').val(); if (q) { p.q = q; }
      return p;
    }

    function gridLoad() {
      $('#g-range').text(isoVi(gFrom) + ' – ' + isoVi(gTo));
      $.getJSON('?handler=Grid&' + $.param(gridParams())).done(function (res) {
        if (res.tooWide) {
          tk.error('Cửa sổ tối đa ' + res.maxDays + ' ngày — hãy chọn 7/14/30 ngày.');
          return;
        }
        gData = res;
        gridRender(res);
        applyStats(res.stats);
      });
    }

    function gridRender(res) {
      var h = '<tr><th class="tk-gcol">NCC / Dịch vụ</th>';
      res.days.forEach(function (d) {
        h += '<th class="text-center small' + (d.isWeekend ? ' table-active' : '') + '">' +
             tk.escape(d.weekday) + '<div class="text-muted fw-normal">' + tk.escape(d.dayText) + '</div></th>';
      });
      h += '</tr>';
      $('#grid thead').html(h);

      var b = '';
      if (!res.rows.length) {
        b = '<tr><td class="text-center text-muted py-4" colspan="' + (res.days.length + 1) + '">Không có quỹ phòng trong cửa sổ này.</td></tr>';
      }
      res.rows.forEach(function (r, ri) {
        b += '<tr><td class="tk-gcol">' +
             '<div class="fw-medium">' + tk.trunc(r.providerName, 220) + '</div>' +
             '<div class="small text-muted">' + tk.escape(r.serviceName) + (r.rating ? ' · ' + r.rating + '★' : '') + '</div>' +
             ((r.province || r.market) ? '<div class="small text-muted">' + tk.escape([r.province, r.market].filter(Boolean).join(' · ')) + '</div>' : '') +
             '</td>';
        r.cells.forEach(function (c, di) {
          if (!c) { b += '<td class="text-center text-muted">—</td>'; return; }
          var cls = 'text-center tk-gcell' + (c.dayType > 0 ? ' bg-label-' + c.dayTypeColor : '');
          var tip = c.dayTypeLabel + ' · Tồn ' + c.quota + ' · Đặt ' + c.booked + (c.note ? ' · ' + c.note : '');
          b += '<td class="' + cls + '" data-r="' + ri + '" data-d="' + di + '" title="' + tk.escape(tip) + '">' +
               '<div class="small fw-medium">' + tk.money(c.price) + '</div>' +
               '<div class="small ' + (c.available <= 0 ? 'text-danger' : 'text-success') + '">' + c.available + '/' + c.quota + '</div>' +
               '</td>';
        });
        b += '</tr>';
      });
      $('#grid tbody').html(b);

      var first = res.rows.length ? ((res.page - 1) * res.size + 1) : 0;
      var last = (res.page - 1) * res.size + res.rows.length;
      var info = 'Hàng ' + first + '–' + last + (res.rowsTotal != null ? ' / ' + res.rowsTotal : '') +
                 ' · ' + res.days.length + ' ngày · ' + tk.money(res.totalCells) + ' ô trong cửa sổ';
      if (res.capped) { info += ' · Cửa sổ quá dày (đã quét ' + tk.money(res.scannedCells) + ' ô) — hãy thu hẹp bộ lọc.'; }
      $('#g-info').text(info);
      $('#g-rprev').prop('disabled', res.page <= 1);
      $('#g-rnext').prop('disabled', !res.hasMore);
    }

    function applyStats(s) {
      if (!s) { return; }
      $('#kpi-cells').text(tk.money(s.cells));
      $('#kpi-providers').text(tk.money(s.providers));
      $('#kpi-quota').text(tk.money(s.totalQuota));
      $('#kpi-booked').text(tk.money(s.totalBooked));
      $('#kpi-available').text(tk.money(s.totalAvailable));
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: null, render: function (r) {
              // Cột ghép: tên NCC · mã tham chiếu
              return '<div class="fw-medium">' + tk.escape(r.providerName) + '</div>' +
                     '<div class="small text-muted">' + tk.escape(r.providerRef) + '</div>';
            } },
          { data: null, render: function (r) {
              return '<div>' + tk.escape(r.serviceName) + '</div>' +
                     (r.projectName ? '<div class="small text-muted">' + tk.escape(r.projectName) + '</div>' : '');
            } },
          { data: null, render: function (r) {
              var line1 = (r.province || '—') + (r.rating ? ' · ' + r.rating + '★' : '');
              return '<div>' + tk.escape(line1) + '</div>' +
                     (r.market ? '<div class="small text-muted">' + tk.escape(r.market) + '</div>' : '');
            } },
          { data: 'dateText' },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.dayTypeColor + '">' + tk.escape(r.dayTypeLabel) + '</span>'; } },
          { data: 'quota', className: 'text-center' },
          { data: 'booked', className: 'text-center' },
          { data: 'available', className: 'text-center fw-medium', render: function (v) { return '<span class="' + (v <= 0 ? 'text-danger' : 'text-success') + '">' + tk.money(v) + '</span>'; } },
          { data: 'price', className: 'text-end', render: function (v) { return tk.money(v); } },
          { data: null, className: 'text-end', render: function () {
              return '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" title="Xoá"><i class="ti ti-trash"></i></button>';
            } }
        ]
      });

      // KPI + dòng tổng cộng lấy từ khối stats/pageSum ngoài contract DataTables (sự kiện xhr).
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.stats;
        if (!s) { return; }
        applyStats(s);
        var p = (json.pageSum && json.pageSum.price) || 0;
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (theo bộ lọc)</span>' +
          '<span class="me-3 text-muted">Tồn: <span class="fw-medium">' + tk.money(s.totalQuota) + '</span></span>' +
          '<span class="me-3 text-muted">Đã đặt: <span class="fw-medium text-warning">' + tk.money(s.totalBooked) + '</span></span>' +
          '<span class="me-3 text-muted">Còn lại: <span class="fw-medium text-success">' + tk.money(s.totalAvailable) + '</span></span>' +
          '<span class="me-3 text-muted">Giá NET (trang này): <span class="fw-medium">' + tk.money(p) + '</span></span>');
      });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'ô quỹ phòng',
        rules: { 'Input.ProviderRef': { required: true }, 'Input.ServiceName': { required: true }, 'Input.Date': { required: true } },
        messages: { 'Input.ProviderRef': { required: 'Bắt buộc nhập mã NCC' }, 'Input.ServiceName': { required: 'Bắt buộc nhập tên dịch vụ/phòng' }, 'Input.Date': { required: 'Bắt buộc chọn ngày' } } });

      // Server-side: lấy dữ liệu dòng từ DataTables API (không có data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = dt.row($(this).closest('tr')).data().id;
        tk.confirmDelete({ title: 'Xoá ô quỹ phòng?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { dt.ajax.reload(null, false); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      });

      // ---- Ô lưới: mở offcanvas sửa đúng ô quỹ đang bấm (dữ liệu lấy từ ma trận đã nạp) ----
      $('#grid tbody').on('click', '.tk-gcell', function () {
        if (!gData) { return; }
        var r = gData.rows[+this.getAttribute('data-r')];
        var day = gData.days[+this.getAttribute('data-d')];
        var c = r && r.cells[+this.getAttribute('data-d')];
        if (!c) { return; }
        oc.open({
          id: c.id, providerRef: r.providerRef, serviceName: r.serviceName, projectName: r.projectName,
          province: r.province, market: r.market, date: day.date, dayType: c.dayType,
          quota: c.quota, booked: c.booked, price: c.price, rating: r.rating, note: c.note
        });
      });
      // Sau khi lưu/huỷ offcanvas: nạp lại đúng cửa sổ lưới đang xem (bảng đã tự reload trong tk.form).
      $('#oc').on('hidden.bs.offcanvas', function () { if (!$('#pane-grid').hasClass('d-none')) { gridLoad(); } });

      // Điều hướng cửa sổ ngày + phân trang HÀNG.
      $('#g-span').on('change', function () { gSpan = parseInt(this.value, 10) || 14; setWindow(gFrom); });
      $('#g-prev').on('click', function () { setWindow(isoAdd(gFrom, -gSpan)); });
      $('#g-next').on('click', function () { setWindow(isoAdd(gFrom, gSpan)); });
      $('#g-today').on('click', function () { setWindow('@Model.GridFrom'); });
      $('#g-size').on('change', function () { gSize = parseInt(this.value, 10) || 25; gPage = 1; gridLoad(); });
      $('#g-rprev').on('click', function () { if (gPage > 1) { gPage--; gridLoad(); } });
      $('#g-rnext').on('click', function () { gPage++; gridLoad(); });

      // Áp bộ lọc cho ĐÚNG khung đang xem.
      function applyFilters() {
        if ($('#pane-grid').hasClass('d-none')) { dt.ajax.reload(); } else { gPage = 1; gridLoad(); }
      }

      $('#btn-search').on('click', applyFilters);
      $('#f-q, #f-province, #f-market').on('keydown', function (e) { if (e.key === 'Enter') { applyFilters(); } });
      $('#f-rating').on('change', applyFilters);
      $('.tk-s2f').on('change', applyFilters);
      // Khoảng ngày của thanh lọc chỉ có nghĩa với khung bảng — lưới đã tự giới hạn bằng cửa sổ ngày.
      $('.tk-datef').on('change', function () { dt.ajax.reload(); });
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('.tk-datef').each(function () { if (this._flatpickr) { this._flatpickr.clear(); } });
        dt.ajax.reload();
        gPage = 1;
        gridLoad();
      });

      // Chuyển khung Lưới ↔ Bảng.
      $('#view-grid').on('click', function () {
        $('#pane-table').addClass('d-none'); $('#pane-grid').removeClass('d-none');
        $(this).addClass('active'); $('#view-table').removeClass('active');
        if (!gData) { gridLoad(); }
      });
      $('#view-table').on('click', function () {
        $('#pane-grid').addClass('d-none'); $('#pane-table').removeClass('d-none');
        $(this).addClass('active'); $('#view-grid').removeClass('active');
        dt.columns.adjust();
      });

      // Mặc định mở khung LƯỚI LỊCH (đúng dạng ma trận NCC × ngày của bản cũ).
      gridLoad();
    });
  </script>
}
