@page
@model TourKit.Api.Pages.Agents.IndexModel
@{ ViewData["Title"] = "Đại lý (B2B)"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Danh sách đại lý (B2B)</h4>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm đại lý</button>
  </div>
</div>

@{
    // 4 thẻ thống kê — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng đại lý", Model.Stats.Total.ToString("#,##0"), "ti ti-building-store", "primary"),
        ("Đang hoạt động", Model.Stats.Active.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("Ngừng", Model.Stats.Inactive.ToString("#,##0"), "ti ti-circle-x", "secondary"),
        ("Tổng hạn mức", Model.Stats.TotalCreditLimit.ToString("#,##0"), "ti ti-credit-card", "info"),
    };
}

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tab trạng thái kèm số đếm — bám Segmented hệ cũ (lọc ở SERVER qua tiêu chí status) *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="status">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1">@Model.Stats.Total</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="1">Hoạt động <span class="badge bg-label-success ms-1">@Model.Stats.Active</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="0">Ngừng <span class="badge bg-label-secondary ms-1">@Model.Stats.Inactive</span></a></li>
    </ul>
    <input type="hidden" id="f-status" value="" />

    @* Thanh lọc — bám bản cũ: ô tìm kiếm + nút Tìm kiếm/Đặt lại (lọc ở SERVER) *@
    <div class="row g-2 align-items-center">
      <div class="col-md-9"><input type="text" id="f-q" class="form-control" placeholder="Mã / tên / liên hệ / SĐT" /></div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm kiếm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2">
    <span class="fw-medium"><span id="bulk-count">0</span> đại lý đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-agents"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">đại lý</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="row">
        <div class="col-4 mb-3"><label class="form-label">Mã <span class="text-danger">*</span></label><input type="text" name="Input.Code" class="form-control" placeholder="Nhập mã" /></div>
        <div class="col-8 mb-3"><label class="form-label">Tên đại lý <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên đại lý" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Người liên hệ</label><input type="text" name="Input.ContactPerson" class="form-control" placeholder="Nhập người liên hệ" /></div>
        <div class="col-6 mb-3"><label class="form-label">Số điện thoại</label><input type="text" name="Input.Phone" class="form-control" placeholder="Nhập số điện thoại" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Email</label><input type="text" name="Input.Email" class="form-control" placeholder="Nhập email" /></div>
        <div class="col-6 mb-3"><label class="form-label">Mã số thuế</label><input type="text" name="Input.TaxCode" class="form-control" placeholder="Nhập MST" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Địa chỉ</label><input type="text" name="Input.Address" class="form-control" placeholder="Nhập địa chỉ" /></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Hạn mức tín dụng <span class="text-danger">*</span></label><input type="number" step="any" name="Input.CreditLimit" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
          <select name="Input.Status" class="form-select"><option value="1">Hoạt động</option><option value="0">Ngừng</option></select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;

    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'đại lý',
        rules: { 'Input.Code': { required: true }, 'Input.Name': { required: true } },
        messages: { 'Input.Code': { required: 'Bắt buộc nhập mã' }, 'Input.Name': { required: 'Bắt buộc nhập tên' } } });

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá đại lý?', text: r.name || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = r.id;
          f.submit();
        });
      }

      // Tiêu chí lọc đẩy xuống SERVER (AgentListFilter: Q + Status) — không lọc ở client.
      grid = tk.grid('#grid-agents', {
        filters: ['status'],
        exportName: 'dai-ly-b2b.csv',
        actions: function (r) {
          return [
            { label: '<i class="ti ti-edit me-2"></i>Sửa đại lý', action: function () { oc.open(r); } },
            { label: '<i class="ti ti-file-text me-2"></i>Báo giá của đại lý', action: function () { window.location = '/bao-gia-dai-ly?agentId=' + encodeURIComponent(r.id); } },
            { label: '<i class="ti ti-shopping-cart me-2"></i>Booking của đại lý', action: function () { window.location = '/dat-cho-dai-ly?agentId=' + encodeURIComponent(r.id); } },
            { separator: true },
            { label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá đại lý</span>', action: function () { delRow(r); } }
          ];
        },
        onRowClick: function (r) { oc.open(r); },
        columns: [
          {
            title: 'Đại lý', field: 'name', widthGrow: 2, minWidth: 190,
            formatter: 'tkMedia', formatterParams: { sub: 'code' }
          },
          {
            title: 'Liên hệ', field: 'contactPerson', widthGrow: 2, minWidth: 170,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.contactPerson, [r.phone, r.email].filter(Boolean).join(' · '));
            }
          },
          { title: 'MST', field: 'taxCode', width: 130, formatter: 'tkStack' },
          { title: 'Địa chỉ', field: 'address', widthGrow: 3, minWidth: 220, formatter: 'tkStack' },
          {
            title: 'Hạn mức', field: 'creditLimit', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) { return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(c.getValue()) + '</div></div>'; }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 140,
            formatter: function (c) {
              var r = c.getData();
              return '<span class="badge bg-label-' + (r.status === 1 ? 'success' : 'secondary') + '">' + esc(r.statusLabel) + '</span>';
            }
          }
        ]
      });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
