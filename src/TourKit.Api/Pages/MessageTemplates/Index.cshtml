@page
@model TourKit.Api.Pages.MessageTemplates.IndexModel
@{ ViewData["Title"] = "Mẫu tin nhắn"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  @* Ô soạn thảo có định dạng cho trường lưu HTML — Quill đi kèm theme, không thêm thư viện ngoài. *@
  <link rel="stylesheet" href="~/vendor/libs/quill/typography.css" />
  <link rel="stylesheet" href="~/vendor/libs/quill/editor.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Mẫu tin nhắn</h5>
    <button type="button" class="btn btn-primary btn-sm" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm</button>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th style="width:40%">Tên</th><th style="width:15%">Kênh</th><th style="width:35%">Tiêu đề</th><th style="width:10%"></th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr data-json='@System.Text.Json.JsonSerializer.Serialize(new { id = x.Id, name = x.Name, channel = (int)x.Channel, subject = x.Subject, body = x.Body })'>
          <td class="fw-medium">@x.Name</td>
          <td>@x.Channel.ToString()</td>
          <td>@x.Subject</td>
          <td class="text-end">
            <button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>
            <button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="@x.Id" title="Xoá"><i class="ti ti-trash"></i></button>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">mẫu tin nhắn</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Tên <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên mẫu" /></div>
      <div class="mb-3">
        <label class="form-label">Kênh</label>
        <select name="Input.Channel" class="form-select tk-s2" data-placeholder="Chọn kênh">
          <option value="1">Email</option>
          <option value="2">SMS</option>
          <option value="3">Zalo</option>
        </select>
      </div>
      <div class="mb-3"><label class="form-label">Tiêu đề</label><input type="text" name="Input.Subject" class="form-control" placeholder="Nhập tiêu đề" /></div>
      @* Email gửi HTML nên soạn bằng ô có định dạng; SMS/Zalo là văn bản thuần — xem script bên dưới. *@
      <div class="mb-3"><label class="form-label">Nội dung <span class="text-danger">*</span></label><textarea name="Input.Body" class="form-control tk-rte-field" rows="4" placeholder="Nhập nội dung mẫu"></textarea></div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/quill/quill.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc;
    $(function () {
      tk.tableClient('#tbl', { columnDefs: [{ orderable: false, targets: [3] }] });
      // Email gửi đi là HTML → soạn bằng ô có định dạng. SMS/Zalo là văn bản THUẦN, gõ HTML vào
      // là nhà mạng gửi nguyên mớ thẻ cho khách → giữ ô nhập thường.
      var body = document.querySelector('#frm [name="Input.Body"]');
      function syncEditor() { tk.rte.enable(body, String($('#frm [name="Input.Channel"]').val()) === '1'); }

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'mẫu tin nhắn',
        rules: { 'Input.Name': { required: true }, 'Input.Body': { required: true } }, messages: { 'Input.Name': { required: 'Bắt buộc nhập tên' }, 'Input.Body': { required: 'Bắt buộc nhập nội dung' } },
        afterOpen: syncEditor });
      $('#frm [name="Input.Channel"]').on('change', syncEditor);
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open($(this).closest('tr').data('json')); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá mẫu tin nhắn?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
