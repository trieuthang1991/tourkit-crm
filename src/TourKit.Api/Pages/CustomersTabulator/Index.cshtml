@page
@model TourKit.Api.Pages.CustomersTabulator.IndexModel
@{
    ViewData["Title"] = "Data khách hàng";
    ViewData["SaveUrl"] = "?handler=Save";
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  <style>
    /* CHUẨN HOÁ ô nhiều dòng: đúng 1 kiểu (main + sub), tối đa 2 dòng, dùng đồng nhất mọi cột. */
    .tk-cell { line-height: 1.25; }
    .tk-cell-main { font-weight: 500; color: var(--bs-heading-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tk-cell-sub { font-size: .75rem; color: var(--bs-secondary-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tk-cell-right { text-align: right; }
    /* Link chuyển trang: tô màu primary + con trỏ tay để người dùng biết bấm được. */
    a.tk-cell-main { display: block; color: var(--bs-primary); cursor: pointer; }
    a.tk-cell-main:hover { color: var(--bs-primary); text-decoration: underline; }

    /* Icon thống kê — canh giữa chuẩn (trước dùng avatar-initial bị lệch). */
    .tk-stat-ic { width: 38px; height: 38px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
    .tk-stat { display: flex; align-items: center; gap: .625rem; }
    .tk-stat-strip { display: flex; flex-wrap: wrap; row-gap: .75rem; column-gap: 2.25rem; padding: 1rem 1.25rem; }

    /* MỘT MẶT TRẮNG liền mạch: giữ nền (không bị hụt) nhưng vẫn phẳng —
       không chia nhiều hộp, không đổ bóng, chỉ kẻ ngang mảnh ngăn từng vùng. */
    /* LƯU Ý: --bs-body-bg của theme là XÁM nền trang (#f8f7fa) — mặt nội dung phải dùng nền card (trắng). */
    .tk-surface { background: var(--bs-card-bg, #fff); border-radius: 12px; overflow: hidden;
                  display: flex; flex-direction: column; min-height: 0; }
    .tk-surface > * + * { border-top: 1px solid var(--bs-border-color); }
    .tk-pad { padding: 1rem 1.25rem; }
    /* Bảng chiếm hết chiều cao còn lại của màn → luôn gọn trong 1 màn, cuộn NGAY TRONG bảng. */
    #grid-customers { flex: 1 1 auto; min-height: 240px; }

    /* Trang không cuộn nữa → menu trái dài sẽ bị cắt. Cho chính menu cuộn được. */
    #layout-menu .menu-inner { overflow-y: auto; overscroll-behavior: contain; }
    #layout-menu .menu-inner::-webkit-scrollbar { width: 6px; }
    #layout-menu .menu-inner::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .25); border-radius: 3px; }
    #layout-menu .menu-inner::-webkit-scrollbar-track { background: transparent; }

    /* Avatar chữ cái (khách hàng / nhân viên) — màu nhạt đồng bộ với dải thống kê. */
    .tk-av { width: 34px; height: 34px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
             font-size: .75rem; font-weight: 600; flex-shrink: 0; letter-spacing: .3px; }
    .tk-av-sm { width: 28px; height: 28px; font-size: .68rem; }
    .tk-row-media { display: flex; align-items: center; gap: .625rem; min-width: 0; }
    .tk-row-media > .tk-cell { min-width: 0; }

    /* Dòng có icon (SĐT/email) — icon mờ, chữ theo hệ màu chung. */
    .tk-ic-line { display: flex; align-items: center; gap: .375rem; min-width: 0; }
    .tk-ic-line > i { font-size: .875rem; color: var(--bs-secondary-color); flex-shrink: 0; }

    /* Badge nhạt cho nhóm/phân khúc — bo tròn, không viền, cùng tông với thống kê. */
    .tk-chip-sm { display: inline-block; padding: .1rem .5rem; border-radius: 999px; font-size: .7rem; font-weight: 500;
                  line-height: 1.5; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* GIAO DIỆN PHẲNG: bảng không viền ngoài/nền, header nhạt, chỉ kẻ ngang mảnh giữa dòng. */
    #grid-customers.tabulator { border: none; background: transparent; }
    /* Bảng tự cao (1 thanh cuộn duy nhất của trang) → ghim tiêu đề cột để cuộn không mất header. */
    #grid-customers .tabulator-header { background: var(--bs-card-bg, #fff); border-bottom: 1px solid var(--bs-border-color); position: sticky; top: 0; z-index: 5; }
    #grid-customers .tabulator-header .tabulator-col { background: transparent; border-right: none; }
    #grid-customers .tabulator-header .tabulator-col .tabulator-col-title { font-size: .75rem; text-transform: uppercase; letter-spacing: .4px; color: var(--bs-secondary-color); font-weight: 600; }
    /* KHÔNG sọc 2 màu: mọi dòng cùng nền, chỉ phân cách bằng kẻ ngang mảnh. */
    #grid-customers .tabulator-row,
    #grid-customers .tabulator-row.tabulator-row-even,
    #grid-customers .tabulator-row.tabulator-row-odd { background: transparent; }
    #grid-customers .tabulator-row { border-bottom: 1px solid var(--bs-border-color); }
    #grid-customers .tabulator-row .tabulator-cell { border-right: none; }
    #grid-customers .tabulator-row:hover { background: rgba(var(--bs-primary-rgb), .05); }
    /* Dòng tổng NGAY DƯỚI tiêu đề (topCalc) — dải MỎNG, chữ nhỏ, chỉ là chú thích phụ. */
    #grid-customers .tabulator-calcs-top { background: rgba(var(--bs-primary-rgb), .04) !important;
      border-bottom: 1px solid var(--bs-border-color); min-height: 0 !important; height: 30px !important; }
    #grid-customers .tabulator-calcs-top .tabulator-cell { height: 30px !important; padding-top: 0; padding-bottom: 0;
      font-size: .75rem; line-height: 30px; }
    #grid-customers .tabulator-footer { background: transparent; border-top: 1px solid var(--bs-border-color); }
    #grid-customers .tabulator-footer .tabulator-page.active { background: var(--bs-primary); border-color: var(--bs-primary); color: #fff; }
    #grid-customers .tabulator-col-resize-handle { opacity: .4; }

    /* Ô chọn: dùng ĐÚNG component checkbox của theme (Bootstrap .form-check-input) —
       mặc định Tabulator vẽ checkbox thô của trình duyệt, lạc khỏi giao diện. */
    #grid-customers input[type="checkbox"] {
      appearance: none; -webkit-appearance: none;
      width: 1.15em; height: 1.15em; margin: 0; vertical-align: middle; cursor: pointer;
      background-color: var(--bs-body-bg, #fff); background-repeat: no-repeat; background-position: center;
      background-size: contain; border: 1px solid var(--bs-border-color); border-radius: .25em;
      transition: background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }
    #grid-customers input[type="checkbox"]:checked {
      background-color: var(--bs-primary); border-color: var(--bs-primary);
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='M6 10l3 3l6-6'/%3e%3c/svg%3e");
    }
    #grid-customers input[type="checkbox"]:indeterminate {
      background-color: var(--bs-primary); border-color: var(--bs-primary);
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='M6 10h8'/%3e%3c/svg%3e");
    }
    #grid-customers input[type="checkbox"]:focus-visible {
      outline: 0; box-shadow: 0 0 0 .18rem rgba(var(--bs-primary-rgb), .25);
    }
    /* Dòng đang chọn: nền nhấn nhẹ theo brand thay vì màu mặc định của Tabulator. */
    #grid-customers .tabulator-row.tabulator-selected { background: rgba(var(--bs-primary-rgb), .07) !important; }
  </style>
}

@{
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng số khách hàng", Model.Stats.Total.ToString("#,##0"), "ti ti-users", "primary"),
        ("Tạo hôm nay", Model.Stats.NewToday.ToString("#,##0"), "ti ti-user-plus", "info"),
        ("Tạo trong tháng", Model.Stats.NewThisMonth.ToString("#,##0"), "ti ti-calendar-stats", "warning"),
        ("Mua lần đầu", Model.Stats.FirstTimeBuyers.ToString("#,##0"), "ti ti-star", "success"),
        ("Mua lại nhiều lần", Model.Stats.RepeatBuyers.ToString("#,##0"), "ti ti-refresh", "danger"),
    };
    // Chip "Chăm sóc khách hàng" — số đếm từ CustomerFunnelDto.Care (bám hệ cũ).
    (string Key, string Value, string Label, int Count)[] careChips =
    {
        ("purchaseBucket", "first", "Mua lần đầu", Model.Funnel.Care.FirstTime),
        ("purchaseBucket", "repeat", "Khách mua lại", Model.Funnel.Care.Repeat),
        ("notContactedBucket", "nc7", "7 ngày chưa liên hệ", Model.Funnel.Care.NotContacted7),
        ("notContactedBucket", "nc15", "15 ngày chưa liên hệ", Model.Funnel.Care.NotContacted15),
        ("notContactedBucket", "nc30", "30 ngày chưa liên hệ", Model.Funnel.Care.NotContacted30),
        ("notContactedBucket", "nc90", "90 ngày chưa liên hệ", Model.Funnel.Care.NotContacted90),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">CRM <span class="mx-1">/</span> Khách hàng <span class="mx-1">/</span> <span class="text-body">Data khách hàng</span></div>
    <h4 class="mb-0">Data khách hàng</h4>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/khach-hang/ban-cu" class="btn btn-label-secondary" title="Bản cũ (DataTables) — giữ tạm để đối chiếu"><i class="ti ti-arrows-left-right me-1"></i> Bản cũ</a>
    <a id="btn-export" class="btn btn-label-secondary"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    <button type="button" class="btn btn-primary" onclick="openCustomerOffcanvas(null)"><i class="ti ti-plus me-1"></i> Thêm khách</button>
  </div>
</div>

@* MỘT MẶT TRẮNG liền mạch (giữ nền cho đỡ hụt) — 3 vùng ngăn nhau bằng kẻ ngang mảnh, không chia hộp. *@
<div class="tk-surface">

  @* Thống kê: 1 dải ngang mảnh, icon canh giữa bằng .tk-stat-ic *@
  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="fw-bold" style="font-size:1.15rem">@s.Value</div>
          <small class="text-muted" style="font-size:.75rem">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Bộ lọc *@
  <div class="tk-pad">
    <ul class="nav nav-tabs mb-3" id="type-tabs">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả</a></li>
      @foreach (var t in Model.CustomerTypes)
      {
        <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="@t.Code">@t.Name</a></li>
      }
    </ul>
    <input type="hidden" id="f-customerType" value="" />
    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Nhập tên, SĐT, mã, email…" /></div>
      <div class="col-md-3">
        <select id="f-source" class="form-select"><option value="">Tất cả nguồn</option>@foreach (var s in Model.Options.Sources) { <option value="@s">@s</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-city" class="form-select"><option value="">Tỉnh/Thành</option>@foreach (var c in Model.Options.Cities) { <option value="@c">@c</option> }</select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-adv" title="Lọc nâng cao"><i class="ti ti-filter"></i></button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Lọc nâng cao — ĐỦ tiêu chí của CustomerListFilter, tất cả đẩy xuống server *@
    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="Thời gian tạo từ" /></div>
      <div class="col-md-3"><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="Thời gian tạo đến" /></div>
      <div class="col-md-3"><input type="text" id="f-careFrom" class="form-control tk-datef" placeholder="Thời gian chăm sóc từ" /></div>
      <div class="col-md-3"><input type="text" id="f-careTo" class="form-control tk-datef" placeholder="Thời gian chăm sóc đến" /></div>

      <div class="col-md-3"><input type="number" min="0" step="1000" id="f-revenueFrom" class="form-control" placeholder="Doanh thu từ" /></div>
      <div class="col-md-3"><input type="number" min="0" step="1000" id="f-revenueTo" class="form-control" placeholder="Doanh thu đến" /></div>
      <div class="col-md-3">
        <select id="f-gender" class="form-select"><option value="">Giới tính</option><option value="Nam">Nam</option><option value="Nữ">Nữ</option><option value="Khác">Khác</option></select>
      </div>
      <div class="col-md-3">
        <select id="f-birthdayMonth" class="form-select"><option value="">Sinh nhật (tháng)</option>@for (var m = 1; m <= 12; m++) { <option value="@m">Tháng @m</option> }</select>
      </div>

      <div class="col-md-3"><select id="f-marketGroup" class="form-select"><option value="">Thị trường</option>@foreach (var v in Model.Options.MarketGroups) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-branch" class="form-select"><option value="">Chi nhánh</option>@foreach (var v in Model.Options.Branches) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-group" class="form-select"><option value="">Nhóm</option>@foreach (var v in Model.Options.Groups) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-department" class="form-select"><option value="">Phòng ban</option>@foreach (var v in Model.Options.Departments) { <option value="@v">@v</option> }</select></div>

      <div class="col-md-3"><select id="f-collaborator" class="form-select"><option value="">Tên CTV</option>@foreach (var v in Model.Options.Collaborators) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-campaign" class="form-select"><option value="">Chiến dịch</option>@foreach (var v in Model.Options.Campaigns) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-tag" class="form-select"><option value="">Tag</option>@foreach (var v in Model.Options.Tags) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-assignedTo" class="form-select"><option value="">NV phụ trách</option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>

      <div class="col-md-3"><select id="f-createdBy" class="form-select"><option value="">Người tạo</option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
    </div>

    @* Chip lọc nhanh: phễu khách + chăm sóc — bám hệ cũ, kèm số đếm *@
    <div class="d-flex flex-column gap-2 mt-3 pt-3 border-top">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted small fw-medium" style="min-width:110px">Phễu khách hàng</span>
        <button type="button" class="btn btn-sm btn-primary tk-chip" data-k="segment" data-v="">Tất cả <span class="badge bg-white text-dark ms-1">@Model.Funnel.Total.ToString("#,##0")</span></button>
        @foreach (var seg in Model.Funnel.Segments)
        {
          <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="segment" data-v="@seg.Name">@seg.Name <span class="badge bg-secondary ms-1">@seg.Count.ToString("#,##0")</span></button>
        }
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted small fw-medium" style="min-width:110px">Chăm sóc</span>
        @foreach (var c in careChips)
        {
          <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="@c.Key" data-v="@c.Value">@c.Label <span class="badge bg-secondary ms-1">@c.Count.ToString("#,##0")</span></button>
        }
      </div>
      <input type="hidden" id="f-segment" value="" />
      <input type="hidden" id="f-purchaseBucket" value="" />
      <input type="hidden" id="f-notContactedBucket" value="" />
    </div>
  </div>

  @* Thanh tác vụ hàng loạt — chỉ hiện khi có dòng được chọn *@
  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> khách đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-care"><i class="ti ti-headset me-1"></i> Xem lịch hẹn</button>
    <button type="button" class="btn btn-sm btn-label-danger" id="bulk-delete"><i class="ti ti-trash me-1"></i> Xoá</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  @* Bảng *@
  <div id="grid-customers"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none">
  <input type="hidden" name="id" />
</form>

@* Dùng LẠI offcanvas Thêm/Sửa của trang gốc → cùng form, cùng luật, không nhân bản nghiệp vụ. *@
<partial name="/Pages/Customers/_EditOffcanvas.cshtml" />

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/jquery-validation/additional-methods.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/customer-form.js"></script>
  <script>
    (function () {
      var esc = (window.tk && tk.escape) ? tk.escape : function (s) {
        return (s == null ? '' : String(s)).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      };
      var money = (window.tk && tk.money) ? tk.money : function (n) { return (n || 0).toLocaleString('vi-VN'); };

      // Ô 2 dòng CHUẨN HOÁ — dùng chung mọi cột (main đậm + sub mờ).
      function stack(main, sub) {
        var m = '<div class="tk-cell-main" title="' + esc(main || '') + '">' + esc(main || '—') + '</div>';
        var s = sub ? '<div class="tk-cell-sub" title="' + esc(sub) + '">' + esc(sub) + '</div>' : '';
        return '<div class="tk-cell">' + m + s + '</div>';
      }

      // Bảng màu nhạt dùng CHUNG cho avatar + badge (liền mạch với dải thống kê).
      var TONES = ['primary', 'info', 'success', 'warning', 'danger', 'secondary'];
      function toneOf(text) {
        var s = String(text || ''), h = 0;
        for (var i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) >>> 0; }
        return TONES[h % TONES.length];
      }
      // Chữ cái đầu của (tối đa) 2 từ cuối — "Lê Đức Vân" → "ĐV".
      function initials(name) {
        var w = String(name || '').trim().split(/\s+/).filter(Boolean);
        if (!w.length) { return '?'; }
        return (w.length === 1 ? w[0].slice(0, 2) : w[w.length - 2][0] + w[w.length - 1][0]).toUpperCase();
      }
      function avatar(name, small) {
        return '<span class="tk-av ' + (small ? 'tk-av-sm ' : '') + 'bg-label-' + toneOf(name) + '">' + esc(initials(name)) + '</span>';
      }
      // Dòng có icon (SĐT/email…).
      function icLine(icon, text, cls) {
        if (!text) { return ''; }
        return '<div class="tk-ic-line ' + (cls || '') + '"><i class="' + icon + '"></i>' +
          '<span class="text-truncate" title="' + esc(text) + '">' + esc(text) + '</span></div>';
      }
      function chip(text) {
        return '<span class="tk-chip-sm bg-label-' + toneOf(text) + '" title="' + esc(text) + '">' + esc(text) + '</span>';
      }

      // ĐỦ tiêu chí của CustomerListFilter — tất cả đẩy xuống SERVER (không lọc ở client).
      var FILTERS = ['customerType', 'source', 'city', 'gender', 'marketGroup', 'collaborator', 'campaign',
        'branch', 'group', 'department', 'segment', 'tag', 'assignedTo', 'createdBy',
        'createdFrom', 'createdTo', 'careFrom', 'careTo', 'revenueFrom', 'revenueTo', 'birthdayMonth',
        'purchaseBucket', 'notContactedBucket'];

      function collectFilters() {
        var d = {};
        var q = document.getElementById('f-q').value.trim(); if (q) { d.q = q; }
        FILTERS.forEach(function (k) {
          var el = document.getElementById('f-' + k);
          if (el && el.value) { d[k] = el.value; }
        });
        return d;
      }

      function viewRow(d) { window.location = '/khach-hang/' + d.id; }
      // Lịch hẹn/chăm sóc của ĐÚNG khách này (trang /lich-hen đọc customerId từ URL).
      function careRow(d) {
        window.location = '/lich-hen?customerId=' + encodeURIComponent(d.id) +
          '&customerName=' + encodeURIComponent(d.fullName || '');
      }
      function callRow(d) { if (d.phone) { window.location = 'tel:' + String(d.phone).replace(/\s/g, ''); } }
      function mailRow(d) { if (d.email) { window.location = 'mailto:' + d.email; } }
      function delRow(d) {
        var go = function () {
          var f = document.getElementById('delete-form');
          f.querySelector('input[name="id"]').value = d.id;
          f.submit();
        };
        if (window.tk && tk.confirmDelete) {
          tk.confirmDelete({ title: 'Xoá khách hàng?', text: d.fullName || '' }).then(function (ok) { if (ok) { go(); } });
        } else if (window.confirm('Xoá khách hàng "' + (d.fullName || '') + '"?')) { go(); }
      }

      // Mở offcanvas sửa — dùng LẠI form của trang gốc (dữ liệu dòng đã đủ field).
      function editRow(d) {
        if (typeof window.openCustomerOffcanvas === 'function') { window.openCustomerOffcanvas(d); }
      }

      // MENU HÀNH ĐỘNG THEO NGHIỆP VỤ KHÁCH HÀNG (không phải CRUD chung chung).
      // Dựng động theo từng dòng: chỉ hiện "Gọi"/"Gửi email" khi khách CÓ số/є-mail.
      function actionsFor(d) {
        var items = [
          { label: '<i class="ti ti-eye me-2"></i>Xem chi tiết', action: function () { viewRow(d); } },
          { label: '<i class="ti ti-edit me-2"></i>Sửa thông tin', action: function () { editRow(d); } },
          { separator: true },
          { label: '<i class="ti ti-headset me-2"></i>Lịch hẹn &amp; chăm sóc', action: function () { careRow(d); } }
        ];
        if (d.phone) {
          items.push({ label: '<i class="ti ti-phone me-2"></i>Gọi ' + esc(d.phone), action: function () { callRow(d); } });
        }
        if (d.email) {
          items.push({ label: '<i class="ti ti-mail me-2"></i>Gửi email', action: function () { mailRow(d); } });
        }
        items.push({ separator: true });
        items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá khách</span>', action: function () { delRow(d); } });
        return items;
      }
      // Tabulator nhận hàm trả về danh sách mục → mỗi dòng có menu riêng theo dữ liệu của nó.
      function rowActionMenu(e, row) { return actionsFor(row.getData()); }
      function cellActionMenu(e, cell) { return actionsFor(cell.getRow().getData()); }

      var curPage = 1;

      var table = new Tabulator('#grid-customers', {
        layout: 'fitColumns',
        // Chiều cao tính theo màn hình (fitHeight bên dưới) → bảng LUÔN gọn trong 1 màn,
        // cuộn diễn ra NGAY TRONG bảng nên chỉ có MỘT thanh cuộn, không cuộn trang.
        height: 420,
        placeholder: 'Không có dữ liệu',
        ajaxURL: '?handler=Data',
        ajaxParams: collectFilters,
        pagination: true,
        paginationMode: 'remote',
        paginationSize: 20,
        paginationSizeSelector: [20, 50, 100],
        paginationCounter: 'rows',
        ajaxResponse: function (url, params, response) { curPage = params.page || 1; return response; },
        rowContextMenu: rowActionMenu,
        selectableRows: true,          // chọn nhiều dòng để làm tác vụ hàng loạt
        selectableRowsRangeMode: 'click',
        columnDefaults: { headerSort: false, resizable: true, vertAlign: 'middle' },
        columns: [
          {
            // Ô chọn để làm tác vụ hàng loạt; tiêu đề là ô chọn-tất-cả của trang.
            title: '', field: '__sel', width: 44, hozAlign: 'center', headerHozAlign: 'center',
            titleFormatter: 'rowSelection', formatter: 'rowSelection',
            headerSort: false, cellClick: function (e) { e.stopPropagation(); },
            topCalc: function () { return ''; },
            topCalcFormatter: function () { return '<span class="fw-semibold text-muted">Tổng</span>'; }
          },
          {
            title: 'Khách hàng', field: 'fullName', widthGrow: 3, minWidth: 200,
            formatter: function (cell) {
              var r = cell.getData();
              var sub = [r.code, r.customerTypeName].filter(Boolean).join(' · ');
              return '<div class="tk-row-media">' + avatar(r.fullName) +
                '<div class="tk-cell"><a class="tk-cell-main" href="/Customers/Details/' + r.id + '" title="' + esc(r.fullName) + '">' + esc(r.fullName) + '</a>' +
                (sub ? '<div class="tk-cell-sub">' + esc(sub) + '</div>' : '') + '</div></div>';
            }
          },
          {
            title: 'Liên hệ', field: 'phone', widthGrow: 2, minWidth: 155,
            formatter: function (c) {
              var r = c.getData();
              if (!r.phone && !r.email) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-cell">' + icLine('ti ti-phone', r.phone, 'tk-cell-main') +
                icLine('ti ti-mail', r.email, 'tk-cell-sub') + '</div>';
            }
          },
          {
            title: 'Khu vực & nhóm', field: 'city', widthGrow: 2, minWidth: 150,
            formatter: function (c) {
              var r = c.getData();
              var segs = (r.segments || []).slice(0, 2).map(chip).join(' ');
              return '<div class="tk-cell">' + icLine('ti ti-map-pin', r.city || '—', 'tk-cell-main') +
                (segs ? '<div class="mt-1">' + segs + '</div>' : '') + '</div>';
            }
          },
          { title: 'CSKH gần nhất', field: 'lastCareAt', widthGrow: 2, minWidth: 155, formatter: function (c) { var r = c.getData(); return stack(r.lastCareAt, r.lastCareContent); } },
          {
            title: 'Phụ trách', field: 'assignedToNames', widthGrow: 2, minWidth: 150,
            formatter: function (c) {
              var r = c.getData();
              var main = (r.assignedToNames || []).join(', ');
              var sub = r.collaboratorName ? ('CTV: ' + r.collaboratorName) : (r.createdByName || '');
              if (!main) { return stack(main, sub); }
              return '<div class="tk-row-media">' + avatar(main, true) + stack(main, sub) + '</div>';
            }
          },
          {
            title: 'Doanh thu', field: 'revenue', width: 140, hozAlign: 'right', headerHozAlign: 'right',
            // Dòng tổng đặt NGAY DƯỚI tiêu đề (topCalc) để thấy ngay, không phải cuộn xuống đáy.
            topCalc: 'sum',
            topCalcFormatter: function (cell) {
              var rev = cell.getValue();
              var buys = cell.getTable().getData().reduce(function (a, r) { return a + (r.purchaseCount || 0); }, 0);
              // Một dòng gọn: tổng tiền (đậm) + số lần mua (mờ) — không chiếm chiều cao.
              return '<span class="fw-semibold">' + money(rev) + '</span>' +
                '<span class="text-muted ms-2">· ' + money(buys) + ' lần</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main ' + ((r.revenue || 0) > 0 ? 'text-success' : '') + '">' + money(r.revenue) + '</div>' +
                '<div class="tk-cell-sub">' + money(r.purchaseCount) + ' lần mua</div></div>';
            }
          },
          {
            title: '', field: 'id', width: 56, hozAlign: 'center',
            clickMenu: cellActionMenu,
            formatter: function () {
              return '<button type="button" class="btn btn-icon btn-sm" title="Hành động"><i class="ti ti-dots-vertical"></i></button>';
            }
          }
        ]
      });

      function reload() { table.setData(); }
      // customer-form.js gọi hook này sau khi lưu → nạp lại lưới, không tải lại cả trang.
      window.tkGridReload = reload;

      // ===== Tác vụ hàng loạt trên các dòng đã chọn =====
      var bulkbar = document.getElementById('bulkbar');
      table.on('rowSelectionChanged', function (data) {
        document.getElementById('bulk-count').textContent = data.length;
        bulkbar.classList.toggle('d-none', data.length === 0);
        bulkbar.classList.toggle('d-flex', data.length > 0);
      });
      document.getElementById('bulk-clear').addEventListener('click', function () { table.deselectRow(); });
      // Xuất riêng các dòng đã chọn (dữ liệu đang có sẵn ở client → tải ngay, không gọi server).
      document.getElementById('bulk-export').addEventListener('click', function () {
        table.download('csv', 'khach-hang-da-chon.csv', {}, 'selected');
      });
      // Mở lịch hẹn của khách ĐẦU TIÊN đang chọn (trang CSKH lọc theo 1 khách).
      document.getElementById('bulk-care').addEventListener('click', function () {
        var sel = table.getSelectedData();
        if (sel.length) { careRow(sel[0]); }
      });
      document.getElementById('bulk-delete').addEventListener('click', function () {
        var sel = table.getSelectedData();
        if (!sel.length) { return; }
        var go = function () {
          // Gọi handler Razor (auth bằng cookie) — KHÔNG gọi /api/v1 vì API dùng JWT, sẽ 401.
          var token = document.querySelector('input[name="__RequestVerificationToken"]');
          var fd = new FormData();
          sel.forEach(function (d) { fd.append('ids', d.id); });
          fetch('?handler=BulkDelete', {
            method: 'POST',
            headers: token ? { 'RequestVerificationToken': token.value } : {},
            body: fd
          }).then(function (r) { return r.json(); }).then(function (res) {
            table.deselectRow();
            reload();
            if (window.Swal && res && res.message) {
              Swal.fire({ toast: true, position: 'top-end', icon: res.isSuccess ? 'success' : 'error',
                title: res.message, showConfirmButton: false, timer: 2200 });
            }
          });
        };
        if (window.tk && tk.confirmDelete) {
          tk.confirmDelete({ title: 'Xoá ' + sel.length + ' khách hàng?' }).then(function (ok) { if (ok) { go(); } });
        } else if (window.confirm('Xoá ' + sel.length + ' khách hàng?')) { go(); }
      });

      // Bảng luôn nằm gọn trong 1 màn: cao = phần viewport còn lại tính từ đỉnh bảng.
      // Dùng toạ độ TÀI LIỆU (rect.top + scrollY) để giá trị không đổi theo vị trí cuộn,
      // nhờ vậy setHeight không tự kích hoạt lại chính nó (tránh vòng lặp).
      var grid = document.getElementById('grid-customers');
      var lastH = 0;
      function fitHeight() {
        // Đo bằng toạ độ TÀI LIỆU để không phụ thuộc vị trí cuộn hiện tại.
        var top = grid.getBoundingClientRect().top + window.scrollY;
        var h = Math.max(260, Math.round(window.innerHeight - top - 24));
        if (Math.abs(h - lastH) < 3) { return; } // chênh không đáng kể → bỏ qua, tránh vòng lặp
        lastH = h;
        table.setHeight(h);
        // Layout còn đệm dưới (padding content-wrapper…) → trừ đúng phần dư để trang hết cuộn.
        var doc = document.documentElement;
        var over = doc.scrollHeight - doc.clientHeight;
        if (over > 2) {
          lastH = Math.max(260, h - over);
          table.setHeight(lastH);
        }
      }
      // CHỈ tính lúc dựng xong + khi đổi kích thước cửa sổ.
      // TUYỆT ĐỐI không gắn vào renderComplete: setHeight lại kích hoạt render → vòng lặp treo trang.
      function fitSoon() { requestAnimationFrame(fitHeight); setTimeout(fitHeight, 300); }
      table.on('tableBuilt', fitSoon);
      window.addEventListener('resize', fitSoon);

      document.getElementById('btn-search').addEventListener('click', reload);
      document.getElementById('f-q').addEventListener('keydown', function (e) { if (e.key === 'Enter') { reload(); } });
      document.getElementById('f-source').addEventListener('change', reload);
      document.getElementById('f-city').addEventListener('change', reload);
      // Ô ngày: gửi ISO cho server, hiện d/m/Y cho người dùng (luật chung của repo).
      if (window.flatpickr) {
        flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true });
      }
      document.querySelectorAll('#adv select, #adv input').forEach(function (el) {
        el.addEventListener('change', reload);
      });

      // Panel lọc nâng cao
      document.getElementById('btn-adv').addEventListener('click', function () {
        var adv = document.getElementById('adv');
        adv.classList.toggle('d-none');
        this.classList.toggle('btn-primary', !adv.classList.contains('d-none'));
        this.classList.toggle('btn-label-secondary', adv.classList.contains('d-none'));
      });

      // Chip: 3 nhóm (phễu / mua / chưa liên hệ) LOẠI TRỪ nhau — bấm lại để bỏ chọn.
      function syncChips() {
        document.querySelectorAll('.tk-chip').forEach(function (b) {
          var on = (document.getElementById('f-' + b.getAttribute('data-k')).value || '') === b.getAttribute('data-v');
          b.classList.toggle('btn-primary', on);
          b.classList.toggle('btn-label-secondary', !on);
        });
      }
      document.querySelectorAll('.tk-chip').forEach(function (b) {
        b.addEventListener('click', function () {
          var k = b.getAttribute('data-k'), v = b.getAttribute('data-v');
          var next = (document.getElementById('f-' + k).value || '') === v ? '' : v;
          ['segment', 'purchaseBucket', 'notContactedBucket'].forEach(function (x) { document.getElementById('f-' + x).value = ''; });
          document.getElementById('f-' + k).value = next;
          syncChips();
          reload();
        });
      });

      document.getElementById('btn-reset').addEventListener('click', function () {
        document.getElementById('f-q').value = '';
        FILTERS.forEach(function (k) { var el = document.getElementById('f-' + k); if (el) { el.value = ''; } });
        document.querySelectorAll('.tk-datef').forEach(function (el) { if (el._flatpickr) { el._flatpickr.clear(); } });
        document.querySelectorAll('#type-tabs .nav-link').forEach(function (a, i) { a.classList.toggle('active', i === 0); });
        syncChips();
        reload();
      });
      document.getElementById('type-tabs').addEventListener('click', function (e) {
        var a = e.target.closest('.nav-link'); if (!a) { return; }
        document.querySelectorAll('#type-tabs .nav-link').forEach(function (x) { x.classList.remove('active'); });
        a.classList.add('active');
        document.getElementById('f-customerType').value = a.getAttribute('data-type') || '';
        reload();
      });
      // Xuất TOÀN BỘ theo bộ lọc đang áp (server-side) — không chỉ trang hiện tại.
      document.getElementById('btn-export').addEventListener('click', function () {
        var d = collectFilters();
        var qs = Object.keys(d).map(function (k) {
          return encodeURIComponent(k) + '=' + encodeURIComponent(d[k]);
        }).join('&');
        window.location = '?handler=Export' + (qs ? '&' + qs : '');
      });
    })();
  </script>
}
