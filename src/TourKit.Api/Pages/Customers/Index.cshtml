@page
@using TourKit.Api.Pages.Shared
@model TourKit.Api.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Data khách hàng";
    ViewData["SaveUrl"] = "?handler=Save";
    // Tỉnh/thành: ưu tiên facet lấy từ data thật (khớp giá trị đang lưu), rỗng thì dùng danh mục tỉnh.
    // Danh mục dùng CHUNG với màn nhà cung cấp — hai danh sách tỉnh trong một hệ thống chắc chắn
    // trôi lệch nhau, và bản cũ ở đây còn ghim 63 tỉnh trước sáp nhập 01/07/2025.
    var cityOptions = Model.Options.Cities.Count > 0 ? Model.Options.Cities : TourKit.Shared.Domain.TinhThanh.TatCa;
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

@{
    // 5 thẻ thống kê — bám statCards hệ cũ (CustomerStatsDto).
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng số khách hàng", Model.Stats.Total.ToString("#,##0"), "ti ti-users", "primary"),
        ("Tạo hôm nay", Model.Stats.NewToday.ToString("#,##0"), "ti ti-user-plus", "info"),
        ("Tạo trong tháng", Model.Stats.NewThisMonth.ToString("#,##0"), "ti ti-calendar-stats", "warning"),
        ("Mua lần đầu", Model.Stats.FirstTimeBuyers.ToString("#,##0"), "ti ti-star", "success"),
        ("Mua lại nhiều lần", Model.Stats.RepeatBuyers.ToString("#,##0"), "ti ti-refresh", "danger"),
    };
    // Chip "Chăm sóc khách hàng" — số đếm từ CustomerFunnelDto.Care.
    (string Key, string Value, string Label, int Count)[] careChips =
    {
        ("purchaseBucket", "first", "Mua lần đầu", Model.Funnel.Care.FirstTime),
        ("purchaseBucket", "repeat", "Khách mua lại", Model.Funnel.Care.Repeat),
        ("notContactedBucket", "nc7", "7 ngày chưa liên hệ", Model.Funnel.Care.NotContacted7),
        ("notContactedBucket", "nc15", "15 ngày chưa liên hệ", Model.Funnel.Care.NotContacted15),
        ("notContactedBucket", "nc30", "30 ngày chưa liên hệ", Model.Funnel.Care.NotContacted30),
        ("notContactedBucket", "nc90", "90 ngày chưa liên hệ", Model.Funnel.Care.NotContacted90),
    };
}

@* Toolbar trên cùng — bám khuôn chuẩn (Orders): tiêu đề trái + hành động phải *@
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Data khách hàng</h4>
  <div class="d-flex flex-wrap gap-2">
    <a id="btn-export" class="btn btn-label-secondary"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    <button type="button" class="btn btn-primary" onclick="openCustomerOffcanvas(null)"><i class="ti ti-plus me-1"></i> Thêm khách</button>
  </div>
</div>

<div class="row g-3 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-6 col-md-4 col-lg">
      <div class="card h-100">
        <div class="card-body py-3">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color"><i class="@s.Icon ti-md"></i></span>
            </div>
            <div>
              <small class="text-muted d-block">@s.Label</small>
              <h5 class="mb-0">@s.Value</h5>
            </div>
          </div>
        </div>
      </div>
    </div>
  }
</div>

@* Thanh lọc — 4 lọc nhanh + panel nâng cao; TẤT CẢ tiêu chí đẩy xuống CustomerListFilter *@
<div class="card mb-4">
  <div class="card-body">
    @* Tab theo loại khách (bám staging: Cá nhân/Doanh nghiệp/Đối tác/CTV) — điều khiển f-customerType *@
    <ul class="nav nav-tabs mb-3" id="type-tabs">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả</a></li>
      @foreach (var t in Model.CustomerTypes)
      {
        <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="@t.Code">@t.Name</a></li>
      }
    </ul>
    <input type="hidden" id="f-customerType" value="" />

    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Nhập tên, SĐT, mã, email…" /></div>
      <div class="col-md-3">
        <select id="f-source" class="form-select tk-s2f" data-placeholder="Nguồn khách"><option value=""></option>@foreach (var s in Model.Options.Sources) { <option value="@s">@s</option> }</select>
      </div>
      <div class="col-md-3">
        <select id="f-city" class="form-select tk-s2f" data-placeholder="Tỉnh/Thành"><option value=""></option>@foreach (var c in cityOptions) { <option value="@c">@c</option> }</select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-sm btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="Thời gian tạo từ" /></div>
      <div class="col-md-3"><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="Thời gian tạo đến" /></div>
      <div class="col-md-3"><input type="text" id="f-careFrom" class="form-control tk-datef" placeholder="Thời gian chăm sóc từ" /></div>
      <div class="col-md-3"><input type="text" id="f-careTo" class="form-control tk-datef" placeholder="Thời gian chăm sóc đến" /></div>

      <div class="col-md-3"><input type="number" min="0" step="1000" id="f-revenueFrom" class="form-control" placeholder="Doanh thu từ" /></div>
      <div class="col-md-3"><input type="number" min="0" step="1000" id="f-revenueTo" class="form-control" placeholder="Doanh thu đến" /></div>
      <div class="col-md-3">
        <select id="f-gender" class="form-select"><option value="">Giới tính</option><option value="Nam">Nam</option><option value="Nữ">Nữ</option><option value="Khác">Khác</option></select>
      </div>
      <div class="col-md-3">
        <select id="f-birthdayMonth" class="form-select"><option value="">Sinh nhật (tháng)</option>@for (var m = 1; m <= 12; m++) { <option value="@m">Tháng @m</option> }</select>
      </div>

      <div class="col-md-3"><select id="f-marketGroup" class="form-select tk-s2f" data-placeholder="Thị trường"><option value=""></option>@foreach (var v in Model.Options.MarketGroups) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-branch" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var v in Model.Options.Branches) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-group" class="form-select tk-s2f" data-placeholder="Nhóm"><option value=""></option>@foreach (var v in Model.Options.Groups) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-department" class="form-select tk-s2f" data-placeholder="Phòng ban"><option value=""></option>@foreach (var v in Model.Options.Departments) { <option value="@v">@v</option> }</select></div>

      <div class="col-md-3"><select id="f-collaborator" class="form-select tk-s2f" data-placeholder="Tên CTV"><option value=""></option>@foreach (var v in Model.Options.Collaborators) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-campaign" class="form-select tk-s2f" data-placeholder="Chiến dịch"><option value=""></option>@foreach (var v in Model.Options.Campaigns) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-tag" class="form-select tk-s2f" data-placeholder="Tag"><option value=""></option>@foreach (var v in Model.Options.Tags) { <option value="@v">@v</option> }</select></div>
      <div class="col-md-3"><select id="f-assignedTo" class="form-select tk-s2f" data-placeholder="NV phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>

      <div class="col-md-3"><select id="f-createdBy" class="form-select tk-s2f" data-placeholder="Người tạo"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
    </div>
  </div>
</div>

@* Chip lọc nhanh: phễu (Segment) + chăm sóc (PurchaseBucket / NotContactedBucket) *@
<div class="card mb-4">
  <div class="card-body d-flex flex-column gap-3">
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="text-muted small fw-medium" style="min-width:120px">Phễu khách hàng</span>
      <button type="button" class="btn btn-sm btn-primary tk-chip" data-k="segment" data-v="">Tất cả <span class="badge bg-white text-dark ms-1">@Model.Funnel.Total.ToString("#,##0")</span></button>
      @foreach (var seg in Model.Funnel.Segments)
      {
        <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="segment" data-v="@seg.Name">@seg.Name <span class="badge bg-secondary ms-1">@seg.Count.ToString("#,##0")</span></button>
      }
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="text-muted small fw-medium" style="min-width:120px">Chăm sóc khách hàng</span>
      @foreach (var c in careChips)
      {
        <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="@c.Key" data-v="@c.Value">@c.Label <span class="badge bg-secondary ms-1">@c.Count.ToString("#,##0")</span></button>
      }
    </div>
    @* Giá trị chip giữ ở input ẩn để gửi kèm request server-side *@
    <input type="hidden" id="f-segment" value="" />
    <input type="hidden" id="f-purchaseBucket" value="" />
    <input type="hidden" id="f-notContactedBucket" value="" />
  </div>
</div>

<div class="card">
  <div class="card-header border-bottom">
    <h5 class="mb-0">Danh sách khách hàng</h5>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl-customers" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>Khách hàng</th><th>Liên hệ</th><th>Khu vực &amp; nhóm</th>
          <th>CSKH gần nhất</th><th>Phụ trách</th><th class="text-end">Doanh thu</th><th></th>
        </tr>
      </thead>
      <tbody></tbody>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="8" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none">
  <input type="hidden" name="id" />
</form>

<partial name="_EditOffcanvas" />

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/jquery-validation/additional-methods.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/customer-form.js"></script>
  <script>
    var dt;
    // Mọi tiêu chí lọc đẩy xuống SERVER (không lọc client, không get-all).
    var FILTERS = ['customerType', 'source', 'city', 'gender', 'marketGroup', 'collaborator', 'campaign',
      'branch', 'group', 'department', 'segment', 'tag', 'assignedTo', 'createdBy',
      'createdFrom', 'createdTo', 'careFrom', 'careTo', 'revenueFrom', 'revenueTo', 'birthdayMonth',
      'purchaseBucket', 'notContactedBucket'];

    function collectFilters(d) {
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { d[k] = v; } });
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }

    // Ô ghép 2 dòng: dòng chính + dòng phụ nhỏ (bám CellStack hệ cũ).
    function stack(main, sub, mainCls) {
      var m = '<div class="' + (mainCls || 'text-heading') + ' text-truncate" title="' + tk.escape(main || '') + '">' + tk.escape(main || '—') + '</div>';
      var s = sub ? '<div class="small text-muted text-truncate" title="' + tk.escape(sub) + '">' + tk.escape(sub) + '</div>' : '';
      return m + s;
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl-customers', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, width: '44px', className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: null, width: '210px', render: function (r) {
              var sub = [r.code, r.customerTypeName].filter(function (x) { return !!x; }).join(' · ');
              return '<a href="/khach-hang/' + r.id + '" class="fw-medium text-heading d-inline-block text-truncate align-middle" style="max-width:200px" title="' + tk.escape(r.fullName) + '">' + tk.escape(r.fullName) + '</a>' +
                     (sub ? '<div class="small text-muted text-truncate" title="' + tk.escape(sub) + '">' + tk.escape(sub) + '</div>' : '');
            } },
          { data: null, width: '170px', render: function (r) { return stack(r.phone, r.email); } },
          { data: null, width: '180px', render: function (r) { return stack(r.city, (r.segments || []).join(' · ')); } },
          { data: null, width: '200px', render: function (r) { return stack(r.lastCareAt, r.lastCareContent); } },
          { data: null, width: '170px', render: function (r) {
              var main = (r.assignedToNames || []).join(', ');
              var sub = r.collaboratorName ? ('CTV: ' + r.collaboratorName) : (r.createdByName || '');
              return stack(main, sub);
            } },
          { data: null, width: '130px', className: 'text-end', render: function (r) {
              return '<div class="fw-medium ' + ((r.revenue || 0) > 0 ? 'text-success' : 'text-heading') + '">' + tk.money(r.revenue) + '</div>' +
                     '<div class="small text-muted">' + tk.money(r.purchaseCount) + ' lần mua</div>';
            } },
          {
            data: 'id', width: '90px', className: 'text-end',
            render: function (id) {
              return '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="' + id + '" title="Xoá"><i class="ti ti-trash"></i></button>';
            }
          }
        ]
      });

      // Dòng tổng cộng trang hiện tại (ngoài contract DataTables → đọc qua xhr.dt).
      $('#tbl-customers').on('xhr.dt', function (e, settings, json) {
        var s = json && json.pageSum;
        if (!s) { return; }
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' +
          '<span class="me-3 text-muted">Tổng số lần mua: <span class="fw-medium text-heading">' + tk.money(s.purchases) + '</span></span>' +
          '<span class="me-3 text-muted">Tổng doanh thu: <span class="fw-medium text-heading">' + tk.money(s.revenue) + '</span></span>');
      });

      // Chip: 3 nhóm (phễu/mua/chưa liên hệ) loại trừ nhau — bấm lại để bỏ chọn.
      function syncChips() {
        $('.tk-chip').each(function () {
          var on = ($('#f-' + this.getAttribute('data-k')).val() || '') === this.getAttribute('data-v');
          $(this).toggleClass('btn-primary', on).toggleClass('btn-label-secondary', !on);
        });
      }
      $('.tk-chip').on('click', function () {
        var k = this.getAttribute('data-k');
        var v = this.getAttribute('data-v');
        var next = ($('#f-' + k).val() || '') === v ? '' : v;
        $('#f-segment, #f-purchaseBucket, #f-notContactedBucket').val('');
        $('#f-' + k).val(next);
        syncChips();
        dt.ajax.reload();
      });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { dt.ajax.reload(); } });
      $('#f-gender, #f-birthdayMonth, #f-revenueFrom, #f-revenueTo').on('change', function () { dt.ajax.reload(); });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      $('.tk-datef').on('change', function () { dt.ajax.reload(); });

      // Tab loại khách → set f-customerType + tải lại.
      $('#type-tabs').on('click', '.nav-link', function () {
        $('#type-tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        $('#f-customerType').val(this.getAttribute('data-type') || '');
        dt.ajax.reload();
      });

      // Lọc nâng cao: tk.advFilter tự chèn nút icon lọc vào nhóm nút Tìm/Đặt lại (khuôn chuẩn).
      tk.advFilter();

      // "Xuất file" — dựng URL export kèm ĐÚNG bộ lọc đang áp.
      $('#btn-export').on('click', function () {
        var d = {}; collectFilters(d);
        var qs = Object.keys(d).map(function (k) {
          var key = k === 'search[value]' ? 'search' : k;
          return encodeURIComponent(key) + '=' + encodeURIComponent(d[k]);
        }).join('&');
        window.location = '?handler=Export' + (qs ? '&' + qs : '');
      });
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('.tk-datef').each(function () { if (this._flatpickr) { this._flatpickr.clear(); } });
        $('#type-tabs .nav-link').removeClass('active').first().addClass('active');
        syncChips();
        dt.ajax.reload();
      });

      // Sửa: mở offcanvas, điền từ dữ liệu dòng (đã có đủ field trong JSON).
      $('#tbl-customers tbody').on('click', '.js-edit', function () {
        var row = dt.row($(this).closest('tr')).data();
        if (row) { openCustomerOffcanvas(row); }
      });

      $('#tbl-customers tbody').on('click', '.js-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá khách hàng?' }).then(function (ok) {
          if (ok) {
            var f = document.getElementById('delete-form');
            f.querySelector('input[name="id"]').value = id;
            f.submit();
          }
        });
      });
    });
  </script>
}
