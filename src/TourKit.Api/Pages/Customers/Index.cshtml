@page
@using TourKit.Api.Pages.Shared
@model TourKit.Api.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Data khách hàng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@{
    (string Label, string Value, string Icon, string Color, string Sub)[] statCards =
    {
        ("Tổng khách", Model.Stats.Total.ToString("#,##0"), "ti ti-users", "primary", "toàn bộ data"),
        ("Mới hôm nay", Model.Stats.NewToday.ToString("#,##0"), "ti ti-user-plus", "success", "khách vừa thêm"),
        ("Mới tháng này", Model.Stats.NewThisMonth.ToString("#,##0"), "ti ti-calendar-stats", "info", "trong tháng"),
        ("Mua lại", Model.Stats.RepeatBuyers.ToString("#,##0"), "ti ti-refresh", "warning", "khách quay lại"),
    };
}
<div class="row g-4 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color">
                <i class="@s.Icon ti-md"></i>
              </span>
            </div>
            <div>
              <span class="d-block text-muted small">@s.Label</span>
              <h4 class="mb-0">@s.Value</h4>
            </div>
          </div>
          <div class="text-muted small mt-2">@s.Sub</div>
        </div>
      </div>
    </div>
  }
</div>

<div class="card">
  <div class="card-header border-bottom">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0">Data khách hàng</h5>
      <a asp-page="Create" class="btn btn-primary btn-sm"><i class="ti ti-plus me-1"></i> Thêm khách</a>
    </div>
    <div class="row g-2">
      <div class="col-sm-6 col-md-4 col-lg-3">
        <select id="f-source" class="form-select form-select-sm">
          <option value="">— Nguồn —</option>
          @foreach (var s in Model.Options.Sources)
          {
              <option value="@s">@s</option>
          }
        </select>
      </div>
      <div class="col-sm-6 col-md-4 col-lg-3">
        <select id="f-city" class="form-select form-select-sm">
          <option value="">— Tỉnh/Thành —</option>
          @foreach (var c in VietnamProvinces.All)
          {
              <option value="@c">@c</option>
          }
        </select>
      </div>
    </div>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl-customers" class="table table-hover">
      <thead>
        <tr>
          <th>Mã</th><th>Họ tên</th><th>SĐT</th><th>Nguồn</th><th>Tag</th>
          <th class="text-end">Doanh thu</th><th>Ngày tạo</th><th></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none">
  <input type="hidden" name="id" />
</form>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () {
      var table = $('#tbl-customers').DataTable({
        processing: true,
        serverSide: true,
        ordering: false,
        ajax: {
          url: '?handler=Data',
          data: function (d) {
            d.source = $('#f-source').val();
            d.city = $('#f-city').val();
          }
        },
        columns: [
          { data: 'code' },
          { data: 'fullName', render: function (d) { return '<span class="fw-medium">' + (d || '') + '</span>'; } },
          { data: 'phone' },
          { data: 'source' },
          { data: 'tag' },
          { data: 'revenue', className: 'text-end', render: function (d) { return (d || 0).toLocaleString('vi-VN'); } },
          { data: 'createdAt' },
          {
            data: 'id', orderable: false, searchable: false, className: 'text-end',
            render: function (id) {
              return '<a href="/Customers/Edit/' + id + '" class="btn btn-icon btn-sm" title="Sửa"><i class="ti ti-edit"></i></a>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="' + id + '" title="Xoá"><i class="ti ti-trash"></i></button>';
            }
          }
        ],
        lengthMenu: [10, 20, 50, 100],
        pageLength: 20,
        dom: '<"row mx-2 mt-2"<"col-md-6 d-flex align-items-center"l><"col-md-6 d-flex align-items-center justify-content-md-end"f>>t<"row mx-2 my-2"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6 d-flex justify-content-md-end"p>>',
        language: {
          processing: 'Đang tải...',
          search: 'Tìm:',
          lengthMenu: 'Hiện _MENU_ dòng',
          info: 'Hiện _START_–_END_ trên _TOTAL_ khách',
          infoEmpty: 'Không có khách',
          infoFiltered: '(lọc từ _MAX_)',
          zeroRecords: 'Không tìm thấy khách phù hợp',
          emptyTable: 'Chưa có khách hàng',
          paginate: { first: '«', last: '»', next: '›', previous: '‹' }
        }
      });

      $('#f-source, #f-city').on('change', function () { table.ajax.reload(); });

      $('#tbl-customers tbody').on('click', '.js-del', function () {
        if (confirm('Xoá khách hàng này?')) {
          var f = document.getElementById('delete-form');
          f.querySelector('input[name="id"]').value = this.getAttribute('data-id');
          f.submit();
        }
      });
    });
  </script>
}
