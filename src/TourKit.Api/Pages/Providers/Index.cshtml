@page
@model TourKit.Api.Pages.Providers.IndexModel
@{ ViewData["Title"] = "Nhà cung cấp"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 3 thẻ thống kê — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng số NCC", Model.Stats.Total.ToString("#,##0"), "ti ti-building-store", "primary"),
        ("Đang hoạt động", Model.Stats.Active.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("Ngừng hoạt động", Model.Stats.Inactive.ToString("#,##0"), "ti ti-circle-x", "secondary"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Nhà cung cấp <span class="mx-1">/</span> <span class="text-body">Danh sách</span></div>
    <h4 class="mb-0">Nhà cung cấp</h4>
  </div>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm NCC</button>
  </div>
</div>

@* MỘT MẶT TRẮNG liền mạch — các vùng ngăn nhau bằng kẻ ngang mảnh, không chia hộp. *@
<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tabs loại NCC — bám SegmentTabs hệ cũ (lọc ở SERVER qua tiêu chí type) *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="type">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả</a></li>
      @foreach (var t in TourKit.Api.Pages.Providers.IndexModel.TypeOptions)
      {
        <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="@t.Value">@t.Label</a></li>
      }
    </ul>
    <input type="hidden" id="f-type" value="" />

    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã / tên / SĐT / email / người liên hệ" /></div>
      <div class="col-md-2"><input type="text" id="f-province" class="form-control" placeholder="Tỉnh thành" /></div>
      <div class="col-md-2">
        <select id="f-branchId" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-marketTypeId" class="form-select tk-s2f" data-placeholder="Thị trường"><option value=""></option>@foreach (var m in Model.MarketTypes) { <option value="@m.Id">@m.Name</option> }</select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="Ngày tạo từ" /></div>
      <div class="col-md-3"><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="Ngày tạo đến" /></div>
      <div class="col-md-3">
        <select id="f-status" class="form-select tk-auto"><option value="">Trạng thái</option><option value="1">Hoạt động</option><option value="0">Ngừng</option></select>
      </div>
    </div>
  </div>

  @* Thanh tác vụ hàng loạt — chỉ hiện khi có dòng được chọn *@
  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> NCC đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-danger" id="bulk-delete"><i class="ti ti-trash me-1"></i> Xoá</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-providers"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:560px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">nhà cung cấp</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      <input type="hidden" name="Id" />
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Mã <span class="text-danger">*</span></label><input type="text" name="Input.Code" class="form-control" placeholder="Nhập mã NCC" /></div>
        <div class="col-6 mb-3"><label class="form-label">Tên <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên NCC" /></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Loại <span class="text-danger">*</span></label>
        <select name="Input.Type" class="form-select">
          @foreach (var t in TourKit.Api.Pages.Providers.IndexModel.TypeOptions)
          {
            <option value="@t.Value">@t.Label</option>
          }
        </select>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Số điện thoại</label><input type="text" name="Input.Phone" class="form-control" placeholder="Nhập số điện thoại" /></div>
        <div class="col-6 mb-3"><label class="form-label">Email</label><input type="text" name="Input.Email" class="form-control" placeholder="Nhập email" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Địa chỉ</label><input type="text" name="Input.Address" class="form-control" placeholder="Nhập địa chỉ" /></div>
      <div class="mb-3"><label class="form-label">Tỉnh thành</label><input type="text" name="Input.Province" class="form-control" placeholder="Nhập tỉnh thành" /></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Mã số thuế</label><input type="text" name="Input.TaxCode" class="form-control" placeholder="Nhập MST" /></div>
        <div class="col-6 mb-3"><label class="form-label">Người liên hệ</label><input type="text" name="Input.ContactPerson" class="form-control" placeholder="Nhập người liên hệ" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngân hàng</label><input type="text" name="Input.BankName" class="form-control" placeholder="Nhập ngân hàng" /></div>
        <div class="col-6 mb-3"><label class="form-label">Số TK</label><input type="text" name="Input.BankAccount" class="form-control" placeholder="Nhập số tài khoản" /></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Điều khoản thanh toán</label>
        <select name="Input.PaymentTermId" class="form-select tk-s2" data-placeholder="Chọn điều khoản">
          <option value="">— Không —</option>
          @foreach (var p in Model.PaymentTerms) { <option value="@p.Id">@p.Name</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Chi nhánh</label>
        <select name="Input.BranchId" class="form-select tk-s2" data-placeholder="Chọn chi nhánh">
          <option value="">— Không —</option>
          @foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Nhóm/Thị trường</label>
        <select name="Input.MarketTypeId" class="form-select tk-s2" data-placeholder="Chọn nhóm/thị trường">
          <option value="">— Không —</option>
          @foreach (var m in Model.MarketTypes) { <option value="@m.Id">@m.Name</option> }
        </select>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Đánh giá</label><input type="number" name="Input.Rate" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
          <select name="Input.Status" class="form-select"><option value="1">Hoạt động</option><option value="0">Ngừng</option></select>
        </div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Tên tài khoản</label><input type="text" name="Input.BankAccountName" class="form-control" placeholder="Nhập tên chủ tài khoản" /></div>
        <div class="col-6 mb-3"><label class="form-label">Website</label><input type="text" name="Input.Website" class="form-control" placeholder="Nhập link" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Nhập ghi chú"></textarea></div>

      @* Trường riêng theo LOẠI nhà cung cấp — hệ cũ tách hẳn 4 màn sửa (Edit/EditHotel/
         EditPlaneTicket/EditVoucher) dùng chung phần trên rồi mỗi màn thêm vài ô của riêng nó.
         Ở đây gộp một form và chỉ hiện khối khớp loại đang chọn. Ô ẩn KHÔNG bị gửi lên vô nghĩa:
         phía máy chủ (HoSoTuInput) loại bỏ trường không thuộc loại đang chọn. *@
      <div class="tk-loai tk-loai-ks d-none">
        <div class="row">
          <div class="col-6 mb-3"><label class="form-label">Năm xây dựng</label><input type="number" name="Input.BuiltYear" class="form-control" placeholder="VD 2015" /></div>
          <div class="col-6 mb-3"><label class="form-label">Quốc gia</label><input type="text" name="Input.Country" class="form-control" placeholder="Nhập quốc gia" /></div>
        </div>
      </div>
      <div class="tk-loai tk-loai-xe d-none">
        <div class="mb-3">
          <label class="form-label">Thông tin xe</label>
          <select name="Input.VehicleOwnership" class="form-select">
            <option value="">— Không —</option>
            @foreach (var o in TourKit.Application.Providers.ProviderProfile.VehicleOwnerships) { <option value="@o">@o</option> }
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Loại xe</label>
          <div class="d-flex flex-wrap gap-3" id="ds-loai-xe">
            @foreach (var o in TourKit.Application.Providers.ProviderProfile.VehicleTypeOptions)
            {
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Input.VehicleTypes" value="@o" id="xe-@o.Replace(" ", "-")" />
                <label class="form-check-label" for="xe-@o.Replace(" ", "-")">@o</label>
              </div>
            }
          </div>
        </div>
      </div>

      @* Hệ cũ (EditVoucher.aspx) đánh dấu * cho cả hai ô này. Bắt buộc CÓ ĐIỀU KIỆN — chỉ khi loại
         là Voucher, vì với 6 loại còn lại khối này không hiện. Luật kiểm tra gắn ở dưới phần JS. *@
      <div class="tk-loai tk-loai-vc d-none">
        <div class="row">
          <div class="col-6 mb-3"><label class="form-label">Class Hotel <span class="text-danger">*</span></label><input type="text" name="Input.HotelClass" class="form-control" placeholder="VD 4 sao" /></div>
          <div class="col-6 mb-3"><label class="form-label">Tên dự án <span class="text-danger">*</span></label><input type="text" name="Input.ProjectName" class="form-control" placeholder="Nhập tên dự án" /></div>
        </div>
      </div>

      @* Panel SẢN PHẨM/DỊCH VỤ — tái lập EditHotel.aspx của hệ cũ: thông tin NCC và bảng giá nằm
         chung một form, bấm Lưu ghi cả hai trong một transaction (uspInsertHotel).
         Chỉ hiện khi SỬA: form tạo mới chưa có đường ghi kèm dịch vụ. *@
      <div id="pnl-dv" class="d-none border-top pt-3 mt-2">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h6 class="mb-0"><i class="ti ti-package me-2"></i>Sản phẩm / Dịch vụ</h6>
          <button type="button" class="btn btn-sm btn-label-primary" id="btn-them-dv"><i class="ti ti-plus me-1"></i>Thêm dòng</button>
        </div>
        <div id="ds-dv" class="d-flex flex-column gap-2"></div>
        <div class="text-muted small mt-2" id="dv-trong">Chưa có dịch vụ nào. Bấm "Thêm dòng" để khai bảng giá.</div>
      </div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc;

    // Loại đang chọn có phải Voucher không — quyết định hai ô bắt buộc có điều kiện.
    function laVoucher() { return Number($('#frm [name="Input.Type"]').val()) === 7; }

    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'nhà cung cấp',
        // Class Hotel và Tên dự án bắt buộc CÓ ĐIỀU KIỆN: hệ cũ đánh dấu * cho chúng ở EditVoucher,
        // nhưng khối đó chỉ hiện khi loại là Voucher. Dùng hàm thay vì true để 6 loại còn lại không
        // bị đòi điền một ô đang ẩn — người dùng sẽ thấy "bắt buộc" mà không biết ô nằm ở đâu.
        rules: {
          'Input.Code': { required: true },
          'Input.Name': { required: true },
          'Input.HotelClass': { required: laVoucher },
          'Input.ProjectName': { required: laVoucher },
        },
        messages: {
          'Input.Code': { required: 'Bắt buộc nhập mã' },
          'Input.Name': { required: 'Bắt buộc nhập tên' },
          'Input.HotelClass': { required: 'Bắt buộc nhập Class Hotel' },
          'Input.ProjectName': { required: 'Bắt buộc nhập tên dự án' },
        },
        // Mã NCC không đổi được khi sửa (UpdateProviderDto không nhận Code).
        fill: function ($form, data) {
          $form.find('[name="Input.Code"]').prop('readonly', !!(data && data.id));
          napDichVu(data && data.id ? data.id : null);

          // Ô chọn nhiều phải tự điền: bộ điền sẵn của tk.form gán .val() cho từng ô, với một NHÓM
          // checkbox cùng tên thì việc đó không tích được ô nào. Xoá sạch trước rồi tích theo mảng —
          // không xoá thì lần mở sau còn dấu tích của bản ghi trước.
          var xe = (data && data.vehicleTypes) || [];
          $form.find('[name="Input.VehicleTypes"]').each(function () {
            this.checked = xe.indexOf(this.value) >= 0;
          });

          hienTheoLoai($form);
        } });

      // Hiện đúng khối trường của loại NCC đang chọn. Giá trị số phải so bằng Number: giá trị của
      // <option> luôn là chuỗi, còn dữ liệu từ lưới là số.
      function hienTheoLoai($form) {
        var loai = Number($form.find('[name="Input.Type"]').val());
        $form.find('.tk-loai-ks').toggleClass('d-none', loai !== 1);   // ProviderType.Hotel
        $form.find('.tk-loai-xe').toggleClass('d-none', loai !== 2);   // ProviderType.Vehicle
        $form.find('.tk-loai-vc').toggleClass('d-none', loai !== 7);   // ProviderType.Voucher

        // Cột riêng của DÒNG bảng giá. Gọi lại cả sau khi nạp xong dòng, vì lúc đổi loại có thể chưa
        // có dòng nào trên màn.
        $form.find('.tk-cot-ks').toggleClass('d-none', loai !== 1);
        $form.find('.tk-cot-ve').toggleClass('d-none', loai !== 5);    // ProviderType.Airline
      }

      $('#frm').on('change', '[name="Input.Type"]', function () { hienTheoLoai($('#frm')); });

      // ---- Panel Sản phẩm / Dịch vụ ----
      var dmDichVu = [];   // danh mục dịch vụ, nạp cùng lượt với bảng giá

      function oSo(ten, gt, buoc) {
        return '<input type="number" step="' + (buoc || 'any') + '" class="form-control form-control-sm" ' +
               'name="' + ten + '" value="' + (gt == null ? '' : gt) + '" />';
      }

      function dongDv(d, i) {
        d = d || {};
        var p = 'Services[' + i + '].';
        var opt = '<option value="">— Chọn dịch vụ —</option>' + dmDichVu.map(function (x) {
          return '<option value="' + x.id + '"' + (x.id === d.serviceItemId ? ' selected' : '') + '>' + esc(x.name) + '</option>';
        }).join('');

        return '<div class="border rounded p-2 tk-dong-dv">' +
          '<input type="hidden" name="' + p + 'Id" value="' + (d.id || '') + '" />' +
          '<div class="row g-2 align-items-end">' +
            '<div class="col-md-4"><label class="form-label small mb-1">Dịch vụ</label>' +
              '<select class="form-select form-select-sm" name="' + p + 'ServiceItemId">' + opt + '</select></div>' +
            '<div class="col-md-5"><label class="form-label small mb-1">Tên gói giá</label>' +
              '<input type="text" class="form-control form-control-sm" name="' + p + 'PriceName" value="' + esc(d.priceName || '') + '" placeholder="VD: Phòng Deluxe 2 khách" /></div>' +
            '<div class="col-md-3"><label class="form-label small mb-1">Số khách</label>' + oSo(p + 'AmountOfPeople', d.amountOfPeople == null ? 1 : d.amountOfPeople, '1') + '</div>' +
            '<div class="col-md-4"><label class="form-label small mb-1">Giá hợp đồng</label>' + oSo(p + 'ContractPrice', d.contractPrice || 0) + '</div>' +
            '<div class="col-md-4"><label class="form-label small mb-1">Giá công bố</label>' + oSo(p + 'PublicPrice', d.publicPrice || 0) + '</div>' +
            '<div class="col-md-2"><label class="form-label small mb-1">Tiền tệ</label>' +
              '<input type="text" class="form-control form-control-sm" name="' + p + 'CurrencyCode" value="' + esc(d.currencyCode || 'VND') + '" /></div>' +
            '<div class="col-md-2 text-end">' +
              '<input type="hidden" name="' + p + 'Status" value="' + (d.status == null ? 1 : d.status) + '" />' +
              '<input type="hidden" name="' + p + 'Note" value="' + esc(d.note || '') + '" />' +
              '<button type="button" class="btn btn-sm btn-icon text-danger js-xoa-dv" title="Bỏ dòng này"><i class="ti ti-trash"></i></button></div>' +
            cotRieng(p, d) +
          '</div></div>';
      }

      // Cột riêng của DÒNG giá theo loại NCC — hệ cũ để chúng trong chính hàng tiêu đề bảng giá, tức
      // mỗi gói giá một bộ giá trị. Dựng cả hai khối rồi ẩn/hiện, không dựng lại dòng khi đổi loại:
      // dựng lại là mất những gì người dùng đang gõ dở.
      function cotRieng(p, d) {
        // Ô ngày dùng type="date" gốc của trình duyệt, KHÔNG gắn .tk-date. flatpickr chỉ chạy một lần
        // lúc dựng form, còn dòng giá sinh ra sau đó nên sẽ không được gắn — mà nếu gắn sau thì
        // altInput lại giấu ô gốc đi và kéo theo đúng cái bẫy đã làm luật kiểm tra bị bỏ qua trước
        // đây. type="date" gửi thẳng yyyy-MM-dd, khớp DateOnly, không cần khởi tạo gì.
        function o(nhan, ten, gt, loai, chuMo) {
          return '<div class="col-md-3"><label class="form-label small mb-1">' + nhan + '</label>' +
            '<input type="' + (loai || 'text') + '" class="form-control form-control-sm"' +
            ' name="' + ten + '" value="' + esc(gt == null ? '' : gt) +
            '" placeholder="' + esc(chuMo || '') + '" /></div>';
        }
        function chon(nhan, ten, gt, ds) {
          return '<div class="col-md-3"><label class="form-label small mb-1">' + nhan + '</label>' +
            '<select class="form-select form-select-sm" name="' + ten + '"><option value="">— Không —</option>' +
            ds.map(function (x) { return '<option value="' + esc(x) + '"' + (x === gt ? ' selected' : '') + '>' + esc(x) + '</option>'; }).join('') +
            '</select></div>';
        }

        return '<div class="col-12 tk-cot-loai tk-cot-ks d-none"><div class="row g-2 align-items-end">' +
            o('Giai đoạn từ', p + 'PeriodFrom', d.periodFrom, 'date') +
            o('Đến', p + 'PeriodTo', d.periodTo, 'date') +
            chon('Loại ngày', p + 'DayType', d.dayType, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TourKit.Application.Providers.ProviderServiceLineProfile.DayTypes))) +
            o('Chi phí NET/ngày', p + 'NetCostPerDay', d.netCostPerDay, 'number') +
            o('Giá bán/ngày', p + 'SellPricePerDay', d.sellPricePerDay, 'number') +
          '</div></div>' +
          '<div class="col-12 tk-cot-loai tk-cot-ve d-none"><div class="row g-2 align-items-end">' +
            chon('Loại vé', p + 'TicketType', d.ticketType, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TourKit.Application.Providers.ProviderServiceLineProfile.TicketTypes))) +
            o('Hành trình vé', p + 'Route', d.route, 'text', 'VD SGN-HAN-SGN') +
            o('Giờ đi', p + 'DepartTime', d.departTime, 'text', 'VD 08:30') +
            o('Giờ về', p + 'ReturnTime', d.returnTime, 'text', 'VD 17:45') +
            o('Hạn cắt cọc', p + 'DepositDeadline', d.depositDeadline, 'date') +
            o('Hành lý', p + 'Baggage', d.baggage, 'text', 'VD 23kg') +
          '</div></div>';
      }

      // Đánh số lại name="Services[i]." sau mỗi lần thêm/bỏ. Model binding của .NET dừng ở chỉ số
      // đầu tiên bị khuyết — bỏ dòng giữa mà không đánh lại thì các dòng sau BIẾN MẤT không báo gì.
      function danhSoLai() {
        $('#ds-dv .tk-dong-dv').each(function (i) {
          $(this).find('[name^="Services["]').each(function () {
            this.name = this.name.replace(/^Services\[\d+\]\./, 'Services[' + i + '].');
          });
        });
        $('#dv-trong').toggleClass('d-none', $('#ds-dv .tk-dong-dv').length > 0);
      }

      function napDichVu(providerId) {
        $('#ds-dv').empty();
        $('#pnl-dv').toggleClass('d-none', !providerId);
        if (!providerId) { return; }

        fetch('?handler=Services&providerId=' + encodeURIComponent(providerId))
          .then(function (r) { return r.ok ? r.json() : null; })
          .catch(function () { return null; })
          .then(function (res) {
            var d = (res && res.isSuccess && res.data) || { lines: [], items: [] };
            dmDichVu = d.items || [];
            $('#ds-dv').html((d.lines || []).map(dongDv).join(''));
            danhSoLai();
            hienTheoLoai($('#frm'));
          });
      }

      $('#btn-them-dv').on('click', function () {
        $('#ds-dv').append(dongDv({}, $('#ds-dv .tk-dong-dv').length));
        danhSoLai();
        hienTheoLoai($('#frm'));
      });

      $('#ds-dv').on('click', '.js-xoa-dv', function () {
        $(this).closest('.tk-dong-dv').remove();
        danhSoLai();
      });

      function delRow(d) {
        tk.confirmDelete({ title: 'Xoá nhà cung cấp?', text: d.name || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = d.id;
          f.submit();
        });
      }

      // Menu hành động theo nghiệp vụ NCC: sửa · dịch vụ · công nợ · gọi/email (chỉ khi có) · xoá.
      function actionsFor(d) {
        var items = [
          { label: '<i class="ti ti-edit me-2"></i>Sửa thông tin', action: function () { oc.open(d); } },
          { label: '<i class="ti ti-list-details me-2"></i>Bảng giá dịch vụ', action: function () { window.location = '/bang-gia-ncc?providerId=' + encodeURIComponent(d.id); } },
          { label: '<i class="ti ti-report-money me-2"></i>Công nợ nhà cung cấp', action: function () { window.location = '/cong-no-ncc?providerId=' + encodeURIComponent(d.id); } }
        ];
        if (d.phone) { items.push({ label: '<i class="ti ti-phone me-2"></i>Gọi ' + esc(d.phone), action: function () { window.location = 'tel:' + String(d.phone).replace(/\s/g, ''); } }); }
        if (d.email) { items.push({ label: '<i class="ti ti-mail me-2"></i>Gửi email', action: function () { window.location = 'mailto:' + d.email; } }); }
        items.push({ separator: true });
        items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá NCC</span>', action: function () { delRow(d); } });
        return items;
      }

      var grid = tk.grid('#grid-providers', {
        // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['type', 'province', 'branchId', 'marketTypeId', 'createdFrom', 'createdTo', 'status'],
        exportName: 'nha-cung-cap-da-chon.csv',
        actions: actionsFor,
        columns: [
          {
            title: 'Nhà cung cấp', field: 'name', widthGrow: 3, minWidth: 210,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-row-media">' + g.avatar(r.name) +
                g.stack(r.name, [r.code, r.typeLabel].filter(Boolean).join(' · ')) + '</div>';
            }
          },
          {
            title: 'Người liên hệ', field: 'contactPerson', widthGrow: 2, minWidth: 165,
            formatter: function (c) {
              var r = c.getData();
              if (!r.contactPerson && !r.phone) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-cell"><div class="tk-cell-main">' + esc(r.contactPerson || '—') + '</div>' +
                g.icLine('ti ti-phone', r.phone, 'tk-cell-sub') + '</div>';
            }
          },
          {
            title: 'Email & địa chỉ', field: 'email', widthGrow: 3, minWidth: 200,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell">' + g.icLine('ti ti-mail', r.email || '—', 'tk-cell-main') +
                g.icLine('ti ti-map-pin', [r.address, r.province].filter(Boolean).join(', '), 'tk-cell-sub') + '</div>';
            }
          },
          {
            title: 'Tổng mua', field: 'totalCost', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            // Dòng tổng của TRANG hiện tại đặt ngay dưới tiêu đề (thay dòng tfoot hệ cũ).
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var paid = c.getTable().getData().reduce(function (a, r) { return a + (r.paid || 0); }, 0);
              return '<span class="fw-semibold" title="Đã trả trang này: ' + money(paid) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main" title="Tổng mua">' + money(r.totalCost) + '</div>' +
                '<div class="tk-cell-sub text-success" title="Đã trả">' + money(r.paid) + '</div></div>';
            }
          },
          {
            title: 'Còn nợ', field: 'outstanding', width: 140, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var v = c.getValue();
              return '<span class="fw-semibold ' + (v > 0 ? 'text-danger' : '') + '">' + money(v) + '</span>';
            },
            formatter: function (c) {
              var v = c.getValue();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main ' + (v > 0 ? 'text-danger' : '') + '">' + money(v) + '</div></div>';
            }
          },
          {
            title: 'Đánh giá & TT', field: 'status', width: 150,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell"><span class="badge bg-label-' + (r.status === 1 ? 'success' : 'secondary') + '">' + esc(r.statusLabel) + '</span>' +
                '<div class="tk-cell-sub mt-1">Đánh giá: ' + (r.rate || 0) + '</div></div>';
            }
          }
        ]
      });

      // Ô "Tỉnh thành" là ô chữ tự do → tìm lại khi rời ô hoặc bấm Enter.
      $('#f-province').on('blur', function () { grid.reload(); })
        .on('keydown', function (e) { if (e.key === 'Enter') { grid.reload(); } });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
