@page
@model TourKit.Api.Pages.CommissionTiers.IndexModel
@{ ViewData["Title"] = "Chính sách hoa hồng bậc thang"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Hoa hồng <span class="mx-1">/</span> <span class="text-body">Chính sách bậc thang</span></div>
    <h4 class="mb-0">Chính sách hoa hồng (bậc thang)</h4>
  </div>
</div>

<div class="tk-surface">
  <div id="grid-commission-tiers"></div>
</div>

@* Modal chi tiết (chỉ xem): nhân viên áp dụng + bảng bậc lợi nhuận. *@
<div class="modal fade" id="md-detail" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Chi tiết chính sách</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><div id="detail-body"></div></div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    function openDetail(row) {
      $('#md-detail .modal-title').text('Chi tiết — ' + row.name);
      $('#detail-body').html('<div class="text-muted">Đang tải…</div>');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('md-detail')).show();
      $.getJSON('?handler=Detail&campaignId=' + row.id, function (d) {
        var users = (d.userNames || []).length
          ? d.userNames.map(function (n) { return '<span class="badge bg-label-primary me-1 mb-1">' + tk.escape(n) + '</span>'; }).join('')
          : '<span class="text-muted">Chưa gán nhân viên</span>';
        var tiers = (d.tiers || []).length
          ? '<table class="table table-sm"><thead><tr><th class="text-end">Từ (doanh số)</th><th class="text-end">Đến (doanh số)</th><th class="text-end">% hoa hồng</th></tr></thead><tbody>' +
            d.tiers.map(function (t) {
              return '<tr><td class="text-end">' + tk.money(t.startAmount) + '</td><td class="text-end">' + tk.money(t.endAmount) +
                '</td><td class="text-end">' + (Number(t.percentage) || 0).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + '%</td></tr>';
            }).join('') + '</tbody></table>'
          : '<div class="text-muted">Chưa có bậc lợi nhuận</div>';
        $('#detail-body').html(
          '<div class="mb-3"><small class="text-muted d-block">Khoảng thời gian áp dụng</small><span class="fw-medium">' + tk.escape(d.rangeText) + '</span>' +
          ' <span class="badge bg-label-' + d.statusColor + ' ms-2">' + tk.escape(d.statusLabel) + '</span></div>' +
          '<div class="mb-3"><small class="text-muted d-block mb-1">Nhân viên áp dụng</small>' + users + '</div>' +
          '<div><small class="text-muted d-block mb-1">Bậc lợi nhuận</small>' + tiers + '</div>');
      });
    }

    $(function () {
      var g = tk.g, money = g.money;

      // Server-side: mỗi lần chỉ tải 1 trang (không get-all ra view).
      var grid = tk.grid('#grid-commission-tiers', {
        filters: [],
        selectable: false,   // màn chỉ để xem, không có tác vụ hàng loạt
        actions: function (r) {
          return [{ label: '<i class="ti ti-eye me-2"></i>Xem chi tiết chính sách', action: function () { openDetail(r); } }];
        },
        onRowClick: openDetail,
        columns: [
          { title: 'Tên chính sách', field: 'name', widthGrow: 4, minWidth: 250, formatter: 'tkMedia' },
          {
            title: 'Khoảng ngày', field: 'startDateText', widthGrow: 2, minWidth: 180,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.startDateText + ' → ' + r.endDateText, null);
            }
          },
          {
            title: 'Số NV', field: 'userCount', width: 110, hozAlign: 'right', headerHozAlign: 'right',
            formatter: function (c) { return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(c.getValue()) + '</div></div>'; }
          },
          {
            title: 'Số bậc', field: 'tierCount', width: 110, hozAlign: 'right', headerHozAlign: 'right',
            formatter: function (c) { return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(c.getValue()) + '</div></div>'; }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 150,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });
    });
  </script>
}
