@page
@model TourKit.Api.Pages.AgentQuotes.IndexModel
@{ ViewData["Title"] = "Báo giá đại lý (B2B)"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Yêu cầu báo giá (Đại lý B2B)</h4>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
    @if (Model.CanManage)
    {
      <button type="button" class="btn btn-primary" id="btn-create"><i class="ti ti-plus me-1"></i> Gửi yêu cầu</button>
    }
  </div>
</div>

@* 6 KPI — bám StatGrid hệ cũ *@
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng yêu cầu</small><h5 class="mb-0 tk-num" id="kpi-total">@Model.Stats.Total.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Chờ chào</small><h5 class="mb-0 text-warning tk-num" id="kpi-requested">@Model.Stats.Requested.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã chào</small><h5 class="mb-0 text-info tk-num" id="kpi-quoted">@Model.Stats.Quoted.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Xác nhận</small><h5 class="mb-0 text-success tk-num" id="kpi-confirmed">@Model.Stats.Confirmed.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Từ chối</small><h5 class="mb-0 text-danger tk-num" id="kpi-rejected">@Model.Stats.Rejected.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng giá chào</small><h5 class="mb-0 tk-num" id="kpi-totalquoted">@Model.Stats.TotalQuoted.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — MỌI tiêu chí đẩy xuống server (AgentQuoteRequestListFilter) *@
<div class="card mb-4">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Sản phẩm/Tour" /></div>
      <div class="col-md-4">
        <select id="f-agentId" class="form-select tk-s2f" data-placeholder="Đại lý"><option value=""></option>@foreach (var a in Model.Agents) { <option value="@a.Id">@a.Name</option> }</select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search"></i></button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>
</div>

@* Tab theo trạng thái — bám Segmented hệ cũ *@
<input type="hidden" id="f-status" value="" />
<ul class="nav nav-pills flex-wrap mb-3" id="tabs">
  <li class="nav-item"><button type="button" class="nav-link active" data-val="">Tất cả (<span data-count="total">@Model.Stats.Total.ToString("#,##0")</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-val="1">Gửi yêu cầu (<span data-count="requested">@Model.Stats.Requested.ToString("#,##0")</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-val="2">Đã chào giá (<span data-count="quoted">@Model.Stats.Quoted.ToString("#,##0")</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-val="3">Đã xác nhận (<span data-count="confirmed">@Model.Stats.Confirmed.ToString("#,##0")</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-val="4">Từ chối (<span data-count="rejected">@Model.Stats.Rejected.ToString("#,##0")</span>)</button></li>
</ul>

<div class="card">
  <div class="card-header"><h5 class="mb-0">Danh sách báo giá đại lý</h5></div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>Đại lý / Tour</th><th class="text-center">Số khách</th><th>Ngày đi</th>
          <th class="text-end">Giá chào</th><th>Trạng thái</th><th></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="7" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

@Html.AntiForgeryToken()

@* Modal gửi yêu cầu báo giá *@
<div class="modal fade" id="create-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Gửi yêu cầu báo giá</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <form id="frm-create" onsubmit="return false">
          <div class="mb-3">
            <label class="form-label">Đại lý <span class="text-danger">*</span></label>
            <select name="agentId" id="cr-agent" class="form-select" data-placeholder="Chọn đại lý">
              <option value=""></option>
              @foreach (var a in Model.Agents) { <option value="@a.Id">@a.Name</option> }
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Sản phẩm/Tour <span class="text-danger">*</span></label><input type="text" name="productName" class="form-control" placeholder="Tên sản phẩm/tour cần báo giá" /></div>
          <div class="row">
            <div class="col-6 mb-3"><label class="form-label">Ngày đi</label><input type="text" name="travelDate" class="form-control tk-datef" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
            <div class="col-6 mb-3"><label class="form-label">Ngày về</label><input type="text" name="returnDate" class="form-control tk-datef" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
          </div>
          <div class="mb-3"><label class="form-label">Số khách <span class="text-danger">*</span></label><input type="number" name="paxCount" class="form-control" placeholder="1" value="1" /></div>
          <div class="mb-1"><label class="form-label">Yêu cầu riêng</label><textarea name="specialRequests" class="form-control" rows="2" placeholder="Ghi chú yêu cầu riêng"></textarea></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Huỷ</button>
        <button type="button" class="btn btn-primary" id="cr-submit">Gửi yêu cầu</button>
      </div>
    </div>
  </div>
</div>

@* Modal chào giá *@
<div class="modal fade" id="quote-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Chào giá</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <form id="frm-quote" onsubmit="return false">
          <input type="hidden" name="id" id="qt-id" />
          <div class="mb-3"><label class="form-label">Giá chào <span class="text-danger">*</span></label><input type="number" step="any" name="quotedAmount" class="form-control" placeholder="0" value="0" /></div>
          <div class="mb-1"><label class="form-label">Ghi chú</label><textarea name="quotedNote" class="form-control" rows="2" placeholder="Ghi chú chào giá"></textarea></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Huỷ</button>
        <button type="button" class="btn btn-primary" id="qt-submit">Chào giá</button>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var dt;
    var CAN_MANAGE = @(Model.CanManage ? "true" : "false");
    var REQUESTED = 1, QUOTED = 2;
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    var FILTERS = ['agentId', 'status'];

    function filterValues() {
      var o = {};
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { o[k] = v; } });
      return o;
    }
    function collectFilters(d) {
      var o = filterValues();
      Object.keys(o).forEach(function (k) { d[k] = o[k]; });
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }
    function refreshStats() {
      $.getJSON('?handler=Stats', function (s) {
        $('#kpi-total').text(tk.money(s.total));
        $('#kpi-requested').text(tk.money(s.requested));
        $('#kpi-quoted').text(tk.money(s.quoted));
        $('#kpi-confirmed').text(tk.money(s.confirmed));
        $('#kpi-rejected').text(tk.money(s.rejected));
        $('#kpi-totalquoted').text(tk.money(s.totalQuoted));
        $('#tabs [data-count]').each(function () { $(this).text(tk.money(s[$(this).data('count')] || 0)); });
      });
    }
    function act(url, fd, ok) {
      tk.post(url, fd).then(function (res) {
        if (res && res.isSuccess) { dt.ajax.reload(null, false); refreshStats(); tk.toast(res.message || ok); }
        else { tk.error((res && res.message) || 'Thao tác thất bại.'); }
      });
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      $('#cr-agent').select2({ width: '100%', allowClear: true, placeholder: 'Chọn đại lý', dropdownParent: $('#create-modal') });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          // Đại lý / Tour (title = yêu cầu riêng)
          { data: null, render: function (r) {
              return '<div class="fw-medium" title="' + tk.escape(r.specialRequests || r.productName) + '">' + (r.agentName ? tk.trunc(r.agentName, 220) : '—') + '</div>' +
                     '<div class="small text-muted">' + tk.trunc(r.productName, 240) + '</div>';
            } },
          { data: 'paxCount', className: 'text-center', render: function (v) { return v + ' khách'; } },
          // Ngày đi (chính) + ngày về (phụ)
          { data: null, render: function (r) {
              return '<div>' + tk.escape(r.travelDate || '—') + '</div>' +
                     (r.returnDate ? '<div class="small text-muted">→ ' + tk.escape(r.returnDate) + '</div>' : '');
            } },
          // Giá chào + ghi chú chào giá
          { data: null, className: 'text-end', render: function (r) {
              return '<div class="fw-medium">' + (r.quotedAmount == null ? '—' : tk.money(r.quotedAmount)) + '</div>' +
                     (r.quotedNote ? '<div class="small text-muted">' + tk.trunc(r.quotedNote, 180) + '</div>' : '');
            } },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, className: 'text-end text-nowrap', render: function (r) {
              if (!CAN_MANAGE) { return ''; }
              var h = '';
              if (r.status === REQUESTED) { h += '<button type="button" class="btn btn-sm btn-label-primary js-quote">Chào giá</button>'; }
              if (r.status === QUOTED) {
                h += '<button type="button" class="btn btn-sm btn-label-success me-1 js-confirm">Xác nhận</button>' +
                     '<button type="button" class="btn btn-sm btn-label-danger js-reject">Từ chối</button>';
              }
              return h;
            } }
        ]
      });

      // Dòng "Tổng cộng (trang này)".
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.pageSum;
        if (!s) { return; }
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' +
          '<span class="me-3 text-muted">Số khách: <span class="fw-medium">' + tk.money(s.pax) + '</span></span>' +
          '<span class="me-3 text-muted">Tổng giá chào: <span class="fw-medium">' + tk.money(s.quoted) + '</span></span>');
      });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { dt.ajax.reload(); } });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('#tabs .nav-link').removeClass('active').first().addClass('active');
        dt.ajax.reload();
      });
      $('#tabs').on('click', '.nav-link', function () {
        $('#tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        $('#f-status').val($(this).data('val'));
        dt.ajax.reload();
      });
      $('#btn-export').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(filterValues());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });

      // ---- Gửi yêu cầu ----
      if ($.fn.validate) {
        $('#frm-create').validate({
          ignore: ':hidden', errorElement: 'span', errorClass: 'text-danger d-block small mt-1',
          rules: { productName: { required: true }, paxCount: { required: true, min: 1 } },
          messages: { productName: { required: 'Bắt buộc nhập sản phẩm/tour' }, paxCount: { required: 'Bắt buộc nhập số khách', min: 'Tối thiểu 1 khách' } },
          highlight: function (el) { $(el).addClass('is-invalid'); }, unhighlight: function (el) { $(el).removeClass('is-invalid'); }
        });
      }
      $('#btn-create').on('click', function () {
        document.getElementById('frm-create').reset();
        $('#cr-agent').val(null).trigger('change');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('create-modal')).show();
      });
      $('#cr-submit').on('click', function () {
        if (!$('#cr-agent').val()) { tk.error('Chọn đại lý gửi yêu cầu.'); return; }
        if ($.fn.validate && !$('#frm-create').valid()) { return; }
        tk.post('?handler=Create', new FormData(document.getElementById('frm-create'))).then(function (res) {
          if (res && res.isSuccess) {
            bootstrap.Modal.getInstance(document.getElementById('create-modal')).hide();
            dt.ajax.reload(null, false); refreshStats(); tk.toast(res.message || 'Đã gửi yêu cầu.');
          } else { tk.error((res && res.message) || 'Gửi yêu cầu thất bại.'); }
        });
      });

      // ---- Chào giá / Xác nhận / Từ chối ----
      $('#tbl tbody').on('click', '.js-quote', function () {
        var r = dt.row($(this).closest('tr')).data();
        document.getElementById('frm-quote').reset();
        $('#qt-id').val(r.id);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('quote-modal')).show();
      });
      $('#qt-submit').on('click', function () {
        tk.post('?handler=Quote', new FormData(document.getElementById('frm-quote'))).then(function (res) {
          if (res && res.isSuccess) {
            bootstrap.Modal.getInstance(document.getElementById('quote-modal')).hide();
            dt.ajax.reload(null, false); refreshStats(); tk.toast(res.message || 'Đã chào giá.');
          } else { tk.error((res && res.message) || 'Chào giá thất bại.'); }
        });
      });
      $('#tbl tbody').on('click', '.js-confirm', function () {
        var r = dt.row($(this).closest('tr')).data();
        tk.confirmDelete({ title: 'Xác nhận báo giá này?', text: 'Báo giá đã xác nhận mới tạo được booking.', confirm: 'Xác nhận' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          act('?handler=Confirm', fd, 'Đã xác nhận.');
        });
      });
      $('#tbl tbody').on('click', '.js-reject', function () {
        var r = dt.row($(this).closest('tr')).data();
        tk.confirmDelete({ title: 'Từ chối báo giá này?', text: 'Yêu cầu sẽ chuyển sang trạng thái Từ chối.', confirm: 'Từ chối' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          act('?handler=Reject', fd, 'Đã từ chối.');
        });
      });
    });
  </script>
}
