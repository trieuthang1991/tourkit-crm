@page
@model TourKit.Api.Pages.AgentQuotes.IndexModel
@using TourKit.Shared.Enums
@{ ViewData["Title"] = "Báo giá đại lý (B2B)"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Báo giá đại lý (B2B)</h5>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Sản phẩm</th><th>Đại lý</th><th class="text-end">Số khách</th><th>Trạng thái</th><th class="text-end">Giá chào</th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr>
          <td class="fw-medium">@x.ProductName</td>
          <td>@(x.AgentName ?? "—")</td>
          <td class="text-end">@x.PaxCount</td>
          <td><span class="badge bg-label-@TourKit.Api.Pages.AgentQuotes.IndexModel.StatusColor(x.Status)">@TourKit.Api.Pages.AgentQuotes.IndexModel.StatusLabel(x.Status)</span></td>
          <td class="text-end">@(x.QuotedAmount?.ToString("#,##0") ?? "—")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl'); });
  </script>
}
