@page
@model TourKit.Api.Pages.Notifications.IndexModel
@{ ViewData["Title"] = "Thông báo"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Thông báo</h5>
    <form method="post" asp-page-handler="MarkAll">
      <button type="submit" class="btn btn-label-primary btn-sm"><i class="ti ti-checks me-1"></i> Đánh dấu tất cả đã đọc</button>
    </form>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th style="width:30%">Tiêu đề</th><th style="width:40%">Nội dung</th><th style="width:15%">Thời gian</th><th style="width:15%"></th></tr></thead>
      <tbody>
      @foreach (var n in Model.Items)
      {
        <tr class="@(n.IsRead ? "" : "fw-medium")">
          <td>
            @if (!n.IsRead) { <span class="badge badge-dot bg-primary me-1"></span> }
            @n.Title
          </td>
          <td class="text-muted">@n.Message</td>
          <td>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
          <td class="text-end">
            @if (!string.IsNullOrEmpty(n.LinkUrl))
            {
              <a href="@n.LinkUrl" class="btn btn-icon btn-sm" title="Mở"><i class="ti ti-external-link"></i></a>
            }
            @if (!n.IsRead)
            {
              <form method="post" asp-page-handler="MarkRead" asp-route-id="@n.Id" class="d-inline">
                <button type="submit" class="btn btn-icon btn-sm" title="Đánh dấu đã đọc"><i class="ti ti-check"></i></button>
              </form>
            }
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl', { columnDefs: [{ orderable: false, targets: [3] }] }); });
  </script>
}
