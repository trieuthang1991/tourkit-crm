@page
@model TourKit.Api.Pages.TicketFunds.IndexModel
@{ ViewData["Title"] = "Series Vé / Quỹ vé"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@{
    (string Label, string Value, string Icon, string Color, string Sub)[] statCards =
    {
        ("Tổng quỹ vé", Model.Stats.Total.ToString("#,##0"), "ti ti-ticket", "primary", "toàn bộ series"),
        ("Đã đóng", Model.Stats.Closed.ToString("#,##0"), "ti ti-lock", "secondary", "quỹ vé đã đóng"),
        ("Đang mở", Model.Stats.Open.ToString("#,##0"), "ti ti-lock-open", "success", "quỹ vé đang mở"),
    };
}
<div class="row g-4 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color">
                <i class="@s.Icon ti-md"></i>
              </span>
            </div>
            <div>
              <span class="d-block text-muted small">@s.Label</span>
              <h4 class="mb-0">@s.Value</h4>
            </div>
          </div>
          <div class="text-muted small mt-2">@s.Sub</div>
        </div>
      </div>
    </div>
  }
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Series vé / Quỹ vé ứng</h5>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Mã vé</th><th>Mã đơn</th><th>Nhà cung cấp</th><th class="text-center">Trạng thái</th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr>
          <td class="fw-medium">@(string.IsNullOrEmpty(x.TicketCode) ? "—" : x.TicketCode)</td>
          <td>@(string.IsNullOrEmpty(x.OrderCode) ? "—" : x.OrderCode)</td>
          <td>@(string.IsNullOrEmpty(x.ProviderName) ? "—" : x.ProviderName)</td>
          <td class="text-center">
            @if (x.IsClosed)
            {
              <span class="badge bg-label-secondary">Đã đóng</span>
            }
            else
            {
              <span class="badge bg-label-success">Đang mở</span>
            }
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl'); });
  </script>
}
