@page
@model TourKit.Api.Pages.TicketFunds.IndexModel
@{ ViewData["Title"] = "Series Vé / Quỹ vé"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 3 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng quỹ vé", Model.Stats.Total.ToString("#,##0"), "ti ti-ticket", "primary"),
        ("kpi-closed", "Đã đóng", Model.Stats.Closed.ToString("#,##0"), "ti ti-lock", "secondary"),
        ("kpi-open", "Chưa đóng", Model.Stats.Open.ToString("#,##0"), "ti ti-lock-open", "success"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Vé máy bay <span class="mx-1">/</span> <span class="text-body">Quỹ vé ứng</span></div>
    <h4 class="mb-0">Quỹ vé ứng</h4>
  </div>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    @if (Model.CanManage)
    {
      <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm quỹ vé</button>
    }
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value" id="@s.Id">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tab Tất cả / Chưa đóng / Đã đóng — bám SegmentTabs hệ cũ *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="isClosed">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1" id="tab-total">@Model.Stats.Total.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="false">Chưa đóng <span class="badge bg-label-success ms-1" id="tab-open">@Model.Stats.Open.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="true">Đã đóng <span class="badge bg-label-secondary ms-1" id="tab-closed">@Model.Stats.Closed.ToString("#,##0")</span></a></li>
    </ul>
    <input type="hidden" id="f-isClosed" value="" />

    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Mã vé" /></div>
      <div class="col-md-4">
        <select id="f-providerId" class="form-select" data-placeholder="Nhà cung cấp"></select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Lọc nâng cao — MỌI tiêu chí đẩy xuống server (TicketFundListFilter) *@
    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="number" id="f-status" class="form-control" placeholder="Trạng thái (mã số)" /></div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> quỹ vé đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-ticket-funds"></div>
</div>

@Html.AntiForgeryToken()

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">quỹ vé</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      <input type="hidden" name="Id" />
      @* Đơn hàng: tìm phía server (gõ mã đơn hoặc tên khách), KHÔNG dán GUID và cũng không đổ hết
         hàng nghìn đơn vào một dropdown. Không gắn class tk-s2 để tk.form đừng khởi tạo select2
         thường đè lên bản có tìm kiếm. *@
      <div class="mb-3">
        <label class="form-label">Đơn hàng <span class="text-danger">*</span></label>
        <select name="Input.OrderId" id="oc-order" class="form-select" data-placeholder="Gõ mã đơn hoặc tên khách để tìm…"></select>
        <div class="form-text">Gõ mã đơn hoặc tên khách để tìm. Quỹ vé gắn theo đơn — không đổi được sau khi tạo.</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Nhà cung cấp</label>
        <select name="Input.ProviderId" class="form-select" data-placeholder="Chọn nhà cung cấp"></select>
      </div>
      @* Giá dịch vụ LỌC THEO nhà cung cấp đang chọn ở trên — không lọc thì rất dễ gắn nhầm giá của
         NCC khác vào quỹ vé, mà nhìn vào bảng không thể phát hiện ra. *@
      <div class="mb-3">
        <label class="form-label">Giá dịch vụ</label>
        <select name="Input.ProviderServiceId" id="oc-service" class="form-select" data-placeholder="Chọn nhà cung cấp trước…"></select>
        <div class="form-text">Chọn nhà cung cấp trước để lọc danh sách giá.</div>
      </div>
      <div class="mb-3"><label class="form-label">Mã vé</label><input type="text" name="Input.TicketCode" class="form-control" placeholder="Nhập mã vé" /></div>
      <div class="mb-3"><label class="form-label">Trạng thái (mã số)</label><input type="number" name="Input.Status" class="form-control" placeholder="0" value="0" /></div>
      <div class="form-check form-switch mb-4">
        <input class="form-check-input" type="checkbox" name="Input.IsClosed" value="true" id="chk-closed" />
        <label class="form-check-label" for="chk-closed">Đã đóng quỹ</label>
      </div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc;
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      var CAN_MANAGE = @(Model.CanManage ? "true" : "false");

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      // Ô chọn NCC gọi SERVER — xem ghi chú ở màn vé đoàn và TranDanhMuc.
      tk.s2ajax('#f-providerId', { url: '?handler=ProviderLookup', placeholder: 'Nhà cung cấp' });
      tk.s2ajax('#frm [name="Input.ProviderId"]', {
        url: '?handler=ProviderLookup', parent: '#oc', placeholder: 'Chọn nhà cung cấp'
      });

      function refreshStats() {
        $.getJSON('?handler=Stats', function (s) {
          $('#kpi-total, #tab-total').text(money(s.total));
          $('#kpi-closed, #tab-closed').text(money(s.closed));
          $('#kpi-open, #tab-open').text(money(s.open));
        });
      }

      var ocForm = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'quỹ vé',
        rules: { 'Input.OrderId': { required: true } }, messages: { 'Input.OrderId': { required: 'Bắt buộc chọn đơn hàng' } } });
      $('#frm').on('submit', function () { setTimeout(refreshStats, 600); });

      // --- Hai ô chọn có TÌM KIẾM PHÍA SERVER ---------------------------------------------------
      // Đơn hàng và giá dịch vụ không đổ sẵn vào dropdown được (hàng nghìn đơn), nên select2 gọi
      // server theo từ khoá. Đổi lại: lúc mở form sửa, select2 chưa có option nào cho giá trị đang
      // lưu → phải tự nạp nhãn vào, nếu không ô sẽ trống và lần Lưu kế tiếp xoá mất liên kết.
      $('#oc-order').select2({
        dropdownParent: $('#oc'), width: '100%', allowClear: true,
        placeholder: 'Gõ mã đơn hoặc tên khách…',
        ajax: {
          url: '?handler=OrderSearch', dataType: 'json', delay: 250,
          data: function (p) { return { q: p.term }; },
          processResults: function (d) { return d; }
        }
      });

      $('#oc-service').select2({
        dropdownParent: $('#oc'), width: '100%', allowClear: true,
        placeholder: 'Chọn nhà cung cấp trước…',
        ajax: {
          url: '?handler=ServiceSearch', dataType: 'json', delay: 250,
          data: function (p) { return { q: p.term, providerId: $('[name="Input.ProviderId"]').val() }; },
          processResults: function (d) { return d; }
        }
      });

      // Đổi NCC thì giá dịch vụ cũ không còn thuộc NCC mới — xoá đi thay vì để lại một liên kết sai.
      $('#frm').on('change', '[name="Input.ProviderId"]', function () {
        $('#oc-service').val(null).trigger('change');
      });

      function setPicked(sel, id, label) {
        var $s = $(sel);
        $s.empty();
        if (id) { $s.append(new Option(label || id, id, true, true)); }
        $s.trigger('change');
      }

      oc = {
        open: function (row) {
          ocForm.open(row);
          // Nhãn đơn hàng lấy từ chính dòng lưới; nhãn giá dịch vụ phải hỏi server vì lưới không có.
          setPicked('#oc-order', row && row.orderId, row && row.orderCode);
          // NCC nay cũng là ô gọi server nên phải nạp sẵn nhãn y như hai ô trên — không nạp thì ô
          // trống khi mở sửa và lần Lưu kế tiếp xoá mất liên kết NCC.
          setPicked('[name="Input.ProviderId"]', row && row.providerId, row && row.providerName);
          setPicked('#oc-service', null, null);

          if (row && row.providerServiceId && row.providerId) {
            $.getJSON('?handler=ServiceSearch', { providerId: row.providerId }, function (d) {
              var hit = (d.results || []).filter(function (x) { return x.id === row.providerServiceId; })[0];
              // Không tìm thấy (giá đã xoá, hoặc đổi NCC) thì hiện thẳng như vậy chứ không im lặng bỏ trống.
              setPicked('#oc-service', row.providerServiceId, hit ? hit.text : 'Giá dịch vụ không còn trong danh sách');
            });
          }
        }
      };

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá quỹ vé ' + (r.ticketCode || '') + '?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { grid.reload(); refreshStats(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      }

      function actionsFor(r) {
        if (!CAN_MANAGE) { return []; }
        var items = [{ label: '<i class="ti ti-edit me-2"></i>Sửa quỹ vé', action: function () { oc.open(r); } }];
        if (r.orderId) {
          items.push({ label: '<i class="ti ti-external-link me-2"></i>Mở đơn liên quan', action: function () { window.location = '/don-hang/' + r.orderId; } });
        }
        items.push({ separator: true });
        items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá quỹ vé</span>', action: function () { delRow(r); } });
        return items;
      }

      var grid = tk.grid('#grid-ticket-funds', {
        // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['providerId', 'status', 'isClosed'],
        exportName: 'quy-ve-da-chon.csv',
        actions: CAN_MANAGE ? actionsFor : null,
        columns: [
          {
            title: 'Mã vé', field: 'ticketCode', widthGrow: 2, minWidth: 170,
            formatter: function (c) { var r = c.getData(); return g.stack(r.ticketCode, r.orderCode ? ('Đơn ' + r.orderCode) : null); }
          },
          {
            title: 'Nhà cung cấp', field: 'providerName', widthGrow: 3, minWidth: 210,
            formatter: function (c) {
              var v = c.getValue();
              if (!v) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-row-media">' + g.avatar(v) + g.stack(v, null) + '</div>';
            }
          },
          {
            title: 'Trạng thái', field: 'status', width: 130, hozAlign: 'center',
            formatter: function (c) { return '<span class="badge bg-label-secondary">' + esc(c.getValue()) + '</span>'; }
          },
          {
            title: 'Đóng quỹ', field: 'isClosed', width: 150,
            formatter: function (c) {
              return c.getValue()
                ? '<span class="badge bg-label-secondary">Đã đóng</span>'
                : '<span class="badge bg-label-success">Đang mở</span>';
            }
          }
        ]
      });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
