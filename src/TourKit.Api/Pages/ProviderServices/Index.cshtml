@page
@model TourKit.Api.Pages.ProviderServices.IndexModel
@{ ViewData["Title"] = "Bảng giá NCC"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}


<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Bảng giá NCC</h4>
  <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm bảng giá</button>
</div>

@* Thanh lọc — chỉ tiêu chí NCC (tiêu chí duy nhất service hỗ trợ), đẩy xuống SERVER *@
<div class="card mb-4">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <select id="f-providerId" class="form-select" data-placeholder="Lọc theo nhà cung cấp"><option value=""></option></select>
      </div>
      <div class="col-md-4 d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btn-search"><i class="ti ti-search me-1"></i> Tìm kiếm</button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset"><i class="ti ti-rotate me-1"></i> Đặt lại</button>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          @* min-width để bảng cuộn ngang thay vì bóp cột NCC/tên gói/giá trên màn hẹp. *@
          <th class="text-center" style="min-width:52px">#</th><th style="min-width:180px">NCC</th><th style="min-width:200px">Tên gói giá</th>
          <th class="text-end" style="min-width:130px">Giá hợp đồng</th><th class="text-end" style="min-width:130px">Giá công bố</th>
          <th class="text-center" style="min-width:90px">Số khách</th><th style="min-width:90px">Tiền tệ</th><th style="min-width:120px">Trạng thái</th><th style="min-width:56px"></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="9" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">bảng giá NCC</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3">
        <label class="form-label">Nhà cung cấp <span class="text-danger">*</span></label>
        @* Danh sách NCC lớn → Select2 ajax (handler ProviderOptions), không nạp sẵn *@
        <select name="Input.ProviderId" id="in-provider" class="form-select" data-placeholder="Chọn nhà cung cấp"><option value=""></option></select>
        <small class="text-muted d-block mt-1 d-none" id="provider-lock-note">Không đổi được NCC khi sửa bảng giá.</small>
      </div>
      <div class="mb-3">
        <label class="form-label">Dịch vụ</label>
        <select name="Input.ServiceItemId" class="form-select tk-s2" data-placeholder="Chọn dịch vụ">
          <option value="">— Không —</option>
          @foreach (var s in Model.ServiceItems) { <option value="@s.Id">@s.Name</option> }
        </select>
      </div>
      <div class="mb-3"><label class="form-label">Tên gói giá</label><input type="text" name="Input.PriceName" class="form-control" placeholder="Nhập tên gói giá" /></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Giá hợp đồng <span class="text-danger">*</span></label><input type="number" step="any" name="Input.ContractPrice" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-6 mb-3"><label class="form-label">Giá công bố <span class="text-danger">*</span></label><input type="number" step="any" name="Input.PublicPrice" class="form-control" placeholder="0" value="0" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label">Tiền tệ giá vốn</label>
          <select name="Input.CurrencyCode" class="form-select tk-s2" data-placeholder="Chọn tiền tệ">
            <option value="VND">VND</option>
            @foreach (var c in Model.Currencies.Where(c => !string.Equals(c.Code, "VND", StringComparison.OrdinalIgnoreCase)))
            {
              <option value="@c.Code">@c.Code — @c.Name</option>
            }
          </select>
        </div>
        <div class="col-6 mb-3"><label class="form-label">Số khách <span class="text-danger">*</span></label><input type="number" name="Input.AmountOfPeople" class="form-control" placeholder="1" value="1" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Nhập ghi chú"></textarea></div>
      <div class="mb-3">
        <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
        <select name="Input.Status" class="form-select"><option value="1">Hoạt động</option><option value="0">Ngừng</option></select>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt;
    function collectFilters(d) {
      var v = $('#f-providerId').val(); if (v) { d.providerId = v; }
    }
    // Select2 ajax dùng chung cho 2 ô chọn NCC (danh sách lớn → lọc ở SERVER, không nạp sẵn).
    function providerAjax() {
      return {
        url: '?handler=ProviderOptions',
        dataType: 'json',
        delay: 250,
        data: function (params) { return { q: params.term }; },
        processResults: function (data) { return { results: data.results }; }
      };
    }

    $(function () {
      $('#f-providerId').select2({ width: '100%', allowClear: true, placeholder: 'Lọc theo nhà cung cấp', ajax: providerAjax() });

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: 'providerName', render: function (v) { return '<span class="fw-medium">' + tk.escape(v) + '</span>'; } },
          { data: null, render: function (r) {
              return '<div>' + tk.escape(r.priceName || '—') + '</div>' +
                     (r.serviceItemName ? '<div class="small text-muted">' + tk.escape(r.serviceItemName) + '</div>' : '');
            } },
          { data: null, className: 'text-end', render: function (r) {
              // Ngoại tệ: hiện nguyên tệ + quy đổi VND (bám cột "Giá hợp đồng" hệ cũ).
              if (r.currencyCode && r.currencyCode !== 'VND') {
                return '<div>' + tk.money(r.contractPrice) + ' ' + tk.escape(r.currencyCode) + '</div>' +
                       '<div class="small text-muted">= ' + tk.money(r.contractPriceVnd) + '</div>';
              }
              return tk.money(r.contractPriceVnd);
            } },
          { data: 'publicPriceVnd', className: 'text-end', render: function (v) { return tk.money(v); } },
          { data: 'amountOfPeople', className: 'text-center' },
          { data: 'currencyCode' },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + (r.status === 1 ? 'success' : 'secondary') + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, className: 'text-end', render: function () {
              return '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" title="Xoá"><i class="ti ti-trash"></i></button>';
            } }
        ]
      });

      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.pageSum;
        if (!s) { return; }
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' +
          '<span class="me-3 text-muted">Giá hợp đồng (VND): <span class="fw-medium">' + tk.money(s.contractPriceVnd) + '</span></span>' +
          '<span class="me-3 text-muted">Giá công bố (VND): <span class="fw-medium">' + tk.money(s.publicPriceVnd) + '</span></span>');
      });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'bảng giá NCC',
        rules: { 'Input.ProviderId': { required: true }, 'Input.ContractPrice': { required: true }, 'Input.PublicPrice': { required: true }, 'Input.AmountOfPeople': { required: true } },
        messages: { 'Input.ProviderId': { required: 'Bắt buộc chọn NCC' }, 'Input.ContractPrice': { required: 'Bắt buộc nhập giá hợp đồng' }, 'Input.PublicPrice': { required: 'Bắt buộc nhập giá công bố' }, 'Input.AmountOfPeople': { required: 'Bắt buộc nhập số khách' } },
        fill: function ($form, data) {
          // NCC dùng Select2 ajax → phải nạp option đã chọn thủ công; sửa thì KHOÁ (service không đổi NCC).
          var $p = $('#in-provider');
          $p.empty();
          if (data && data.providerId) {
            $p.append(new Option(data.providerName || '', data.providerId, true, true));
          }
          $p.val(data && data.providerId ? data.providerId : null).trigger('change');
          $p.prop('disabled', !!(data && data.id));
          $('#provider-lock-note').toggleClass('d-none', !(data && data.id));
        }
      });

      // Select2 ajax cho ô NCC trong offcanvas (khởi tạo sau tk.form để dùng dropdownParent riêng).
      $('#in-provider').select2({ width: '100%', allowClear: true, placeholder: 'Chọn nhà cung cấp',
        dropdownParent: $('#oc'), ajax: providerAjax() });

      // Server-side: dữ liệu dòng lấy từ DataTables API (không còn data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = dt.row($(this).closest('tr')).data().id;
        tk.confirmDelete({ title: 'Xoá bảng giá NCC?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-providerId').on('change', function () { dt.ajax.reload(); });
      $('#btn-reset').on('click', function () { $('#f-providerId').val(null).trigger('change'); dt.ajax.reload(); });
    });
  </script>
}
