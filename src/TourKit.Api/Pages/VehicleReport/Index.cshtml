@page
@model TourKit.Api.Pages.VehicleReport.IndexModel
@{ ViewData["Title"] = "Báo cáo (Xe)"; }

@{
    (string Label, string Value, string Icon, string Color, string Sub)[] statCards =
    {
        ("Tổng lượt điều", Model.Stats.Total.ToString("#,##0"), "ti ti-clipboard-list", "primary", "toàn bộ lịch điều xe"),
        ("Đã khởi tạo", Model.Stats.Created.ToString("#,##0"), "ti ti-file-plus", "secondary", "mới lập lịch"),
        ("Đang chạy", Model.Stats.Active.ToString("#,##0"), "ti ti-steering-wheel", "success", "đang thực hiện"),
        ("Số xe", Model.Stats.VehicleCount.ToString("#,##0"), "ti ti-car", "info", "phương tiện tham gia"),
    };
}
<div class="row g-4 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color">
                <i class="@s.Icon ti-md"></i>
              </span>
            </div>
            <div>
              <span class="d-block text-muted small">@s.Label</span>
              <h4 class="mb-0">@s.Value</h4>
            </div>
          </div>
          <div class="text-muted small mt-2">@s.Sub</div>
        </div>
      </div>
    </div>
  }
</div>
