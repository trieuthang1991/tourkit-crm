@page
@model TourKit.Api.Pages.ServiceItems.IndexModel
@{ ViewData["Title"] = "Danh mục dịch vụ"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Danh mục <span class="mx-1">/</span> <span class="text-body">Dịch vụ</span></div>
    <h4 class="mb-0">Danh mục dịch vụ</h4>
  </div>
  <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm dịch vụ</button>
</div>

<div class="tk-surface">

  <div class="tk-pad">
    @* Service danh mục dịch vụ chỉ nhận từ khoá — không thêm ô lọc chết. *@
    <div class="row g-2 align-items-center">
      <div class="col-md-9"><input type="text" id="f-q" class="form-control" placeholder="Mã / tên dịch vụ…" /></div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2">
    <span class="fw-medium"><span id="bulk-count">0</span> dịch vụ đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-service-items"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">dịch vụ</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Mã <span class="text-danger">*</span></label><input type="text" name="Input.Code" class="form-control" placeholder="Nhập mã dịch vụ" /></div>
      <div class="mb-3"><label class="form-label">Tên <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên dịch vụ" /></div>
      <div class="mb-3">
        <label class="form-label">Loại <span class="text-danger">*</span></label>
        <select name="Input.Category" class="form-select">
          @foreach (var c in TourKit.Api.Pages.ServiceItems.IndexModel.CategoryOptions)
          {
            <option value="@c.Value">@c.Label</option>
          }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
        <select name="Input.Status" class="form-select"><option value="1">Hoạt động</option><option value="0">Ngừng</option></select>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;
    $(function () {
      var g = tk.g, esc = g.esc;

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'dịch vụ',
        rules: { 'Input.Code': { required: true }, 'Input.Name': { required: true } },
        messages: { 'Input.Code': { required: 'Bắt buộc nhập mã' }, 'Input.Name': { required: 'Bắt buộc nhập tên' } },
        // Mã dịch vụ không đổi được khi sửa (UpdateServiceItemDto không nhận Code).
        fill: function ($form, data) { $form.find('[name="Input.Code"]').prop('readonly', !!(data && data.id)); } });

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá dịch vụ?', text: r.name || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = r.id;
          f.submit();
        });
      }

      // Server-side: mỗi lần chỉ tải 1 trang (không get-all).
      grid = tk.grid('#grid-service-items', {
        filters: [],
        exportName: 'danh-muc-dich-vu.csv',
        actions: function (r) {
          return [
            { label: '<i class="ti ti-edit me-2"></i>Sửa dịch vụ', action: function () { oc.open(r); } },
            { separator: true },
            { label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá dịch vụ</span>', action: function () { delRow(r); } }
          ];
        },
        columns: [
          {
            title: 'Dịch vụ', field: 'name', widthGrow: 3, minWidth: 220,
            formatter: 'tkMedia', formatterParams: { sub: 'code' }
          },
          { title: 'Loại', field: 'categoryLabel', widthGrow: 2, minWidth: 150, formatter: 'tkStack' },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 150,
            formatter: function (c) {
              var r = c.getData();
              return '<span class="badge bg-label-' + (r.status === 1 ? 'success' : 'secondary') + '">' + esc(r.statusLabel) + '</span>';
            }
          }
        ]
      });
    });
  </script>
}
