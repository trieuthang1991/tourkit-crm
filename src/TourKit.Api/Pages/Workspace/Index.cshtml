@page
@model TourKit.Api.Pages.Workspace.IndexModel
@{ ViewData["Title"] = "Bàn làm việc"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@* Khuôn Dashboards/Ecommerce (docs/vuexy-reference): card chào mừng + Statistics card. *@

<div class="row">
  <!-- Chào mừng (khuôn "Congratulations" card) -->
  <div class="col-xl-4 col-lg-5 col-12 mb-4">
    <div class="card h-100">
      <div class="d-flex align-items-end row h-100">
        <div class="col-7">
          <div class="card-body text-nowrap">
            <h5 class="card-title mb-0">Chào @Model.UserName! 👋</h5>
            <p class="mb-2">Hôm nay của bạn</p>
            <h4 class="text-primary mb-1">@Model.OpenTaskCount việc đang mở</h4>
            <a href="/WorkTasks" class="btn btn-primary">Xem công việc</a>
          </div>
        </div>
        <div class="col-5 text-center text-sm-left">
          <div class="card-body pb-0 px-0 px-md-4">
            <img src="~/img/illustrations/card-advance-sale.png" height="140" alt="workspace">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Thống kê cá nhân (khuôn "Statistics" card) -->
  <div class="col-xl-8 col-lg-7 col-12 mb-4">
    <div class="card h-100">
      <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
          <h5 class="card-title mb-0">Công việc của tôi</h5>
          <small class="text-muted">Cập nhật theo thời gian thực</small>
        </div>
      </div>
      <div class="card-body">
        <div class="row gy-3">
          <div class="col-md-3 col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-primary me-3 p-2"><i class="ti ti-checklist ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.OpenTaskCount</h5><small>Đang mở</small></div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-danger me-3 p-2"><i class="ti ti-alarm ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.OverdueTaskCount</h5><small>Quá hạn</small></div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-success me-3 p-2"><i class="ti ti-circle-check ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.DoneTaskCount</h5><small>Hoàn thành</small></div>
            </div>
          </div>
          <div class="col-md-3 col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-warning me-3 p-2"><i class="ti ti-calendar-time ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.UpcomingCareCount</h5><small>Lịch hẹn chờ</small></div>
            </div>
          </div>
        </div>
        <hr class="my-3" />
        <!-- Lối tắt module chính -->
        <div class="row g-2">
          <div class="col-6 col-md-3"><a href="/Customers" class="btn btn-label-primary w-100"><i class="ti ti-users me-1"></i> Khách hàng</a></div>
          <div class="col-6 col-md-3"><a href="/Quotes/Edit" class="btn btn-label-info w-100"><i class="ti ti-calculator me-1"></i> Tạo báo giá</a></div>
          <div class="col-6 col-md-3"><a href="/Orders" class="btn btn-label-success w-100"><i class="ti ti-shopping-cart me-1"></i> Đơn hàng</a></div>
          <div class="col-6 col-md-3"><a href="/CustomerCares" class="btn btn-label-warning w-100"><i class="ti ti-calendar-plus me-1"></i> Lịch hẹn</a></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Việc của tôi -->
  <div class="col-lg-6 col-12 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0 card-title">Việc cần làm</h5><a href="/WorkTasks" class="btn btn-sm btn-label-primary">Tất cả</a></div>
      <div class="table-responsive">
        <table id="tbl-tasks" class="table table-hover mb-0">
          <thead><tr><th>Tiêu đề</th><th>Hạn</th><th>Ưu tiên</th><th>Trạng thái</th></tr></thead>
          <tbody>
          @if (Model.MyTasks.Count == 0)
          {
            <tr><td colspan="4" class="text-center text-muted py-4">Không có công việc nào.</td></tr>
          }
          @foreach (var t in Model.MyTasks)
          {
            <tr>
              <td class="fw-medium">@t.Title</td>
              <td data-order="@(t.DueDate?.ToUnixTimeSeconds() ?? 0)">@(t.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
              <td>@TourKit.Api.Pages.Workspace.IndexModel.PriorityLabel(t.Priority)</td>
              <td><span class="badge bg-label-@TourKit.Api.Pages.Workspace.IndexModel.TaskStatusColor(t.Status)">@TourKit.Api.Pages.Workspace.IndexModel.TaskStatusLabel(t.Status)</span></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Lịch hẹn của tôi -->
  <div class="col-lg-6 col-12 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0 card-title">Lịch hẹn của tôi</h5><a href="/CustomerCares" class="btn btn-sm btn-label-primary">Tất cả</a></div>
      <div class="table-responsive">
        <table id="tbl-cares" class="table table-hover mb-0">
          <thead><tr><th>Khách hàng</th><th>Nội dung</th><th>Nhắc lúc</th><th>Trạng thái</th></tr></thead>
          <tbody>
          @if (Model.MyCares.Count == 0)
          {
            <tr><td colspan="4" class="text-center text-muted py-4">Không có lịch hẹn nào.</td></tr>
          }
          @foreach (var c in Model.MyCares)
          {
            <tr>
              <td class="fw-medium">@(c.CustomerName ?? "—")</td>
              <td>@c.Title</td>
              <td data-order="@(c.RemindAt?.ToUnixTimeSeconds() ?? 0)">@(c.RemindAt?.ToString("dd/MM/yyyy") ?? "—")</td>
              <td><span class="badge bg-label-@TourKit.Api.Pages.Workspace.IndexModel.CareStatusColor(c.Status)">@TourKit.Api.Pages.Workspace.IndexModel.CareStatusLabel(c.Status)</span></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () {
      tk.tableClient('#tbl-tasks', { pageLength: 5, order: [[1, 'asc']] });
      tk.tableClient('#tbl-cares', { pageLength: 5, order: [[2, 'asc']] });
    });
  </script>
}
