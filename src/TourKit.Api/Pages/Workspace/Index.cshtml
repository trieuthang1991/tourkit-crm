@page
@using System.Globalization
@model TourKit.Api.Pages.Workspace.IndexModel
@{
    ViewData["Title"] = "Bàn làm việc";
    var vi = new CultureInfo("vi-VN");
    var today = DateTimeOffset.Now;

    // Tiền hiển thị ở thẻ tóm tắt rút gọn (94,3 tỷ) — con số đầy đủ nằm ở tooltip và ở màn báo cáo.
    // Thẻ tóm tắt để LIẾC, "94.323.595.000" ở cỡ chữ lớn thì không liếc được.
    string Short(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000_000m) { return (v / 1_000_000_000m).ToString("0.#", vi) + " tỷ"; }
        if (a >= 1_000_000m) { return (v / 1_000_000m).ToString("0.#", vi) + " tr"; }
        if (a >= 1_000m) { return (v / 1_000m).ToString("0.#", vi) + " ng"; }
        return v.ToString("#,##0", vi);
    }
    string Full(decimal v) => v.ToString("#,##0", vi) + " ₫";
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
  <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@* ===== Lời chào + ngày hôm nay ===== *@
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Xin chào, @Model.UserName 👋</h4>
    <p class="text-muted mb-0">Chúc bạn một ngày làm việc hiệu quả!</p>
  </div>
  <span class="tk-datechip"><i class="ti ti-calendar me-2"></i>@today.ToString("dddd, d 'tháng' M, yyyy", vi)</span>
</div>

@* ===== 5 thẻ số liệu ===== *@
@{
    // Mỗi thẻ: nhãn · số lớn · một dòng phụ NÓI ĐƯỢC điều gì đó. Không có số so sánh thật thì
    // ghi thông tin thật khác, không bịa "+12,5% so với tuần trước".
    var revDelta = TourKit.Api.Pages.Workspace.IndexModel.Delta(Model.Pulse.Revenue7, Model.Pulse.RevenuePrev7);
    var ordDelta = TourKit.Api.Pages.Workspace.IndexModel.Delta(Model.Pulse.Orders7, Model.Pulse.OrdersPrev7);
    var cusDelta = TourKit.Api.Pages.Workspace.IndexModel.Delta(Model.Pulse.Customers7, Model.Pulse.CustomersPrev7);

    string DeltaHtml(decimal? d)
    {
        if (d is null) { return "<span class=\"tk-kpi-sub text-muted\">chưa có kỳ trước để so</span>"; }
        var up = d >= 0;
        var icon = up ? "ti-arrow-up-right" : "ti-arrow-down-right";
        var tone = up ? "text-success" : "text-danger";
        return $"<span class=\"tk-kpi-sub {tone}\"><i class=\"ti {icon}\"></i>{Math.Abs(d.Value).ToString("0.#", vi)}% so với tuần trước</span>";
    }
}
<div class="tk-kpi-row mb-4">
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-primary"><i class="ti ti-cash"></i></span>
    <div class="tk-kpi-label">Doanh thu (đã ghi nhận)</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.TotalReceived)">@Short(Model.Summary.TotalReceived)</div>
    @Html.Raw(DeltaHtml(revDelta))
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-info"><i class="ti ti-shopping-cart"></i></span>
    <div class="tk-kpi-label">Đơn hàng</div>
    <div class="tk-kpi-value">@Model.Summary.OrderCount.ToString("#,##0", vi)</div>
    @Html.Raw(DeltaHtml(ordDelta))
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-success"><i class="ti ti-users"></i></span>
    <div class="tk-kpi-label">Khách hàng</div>
    <div class="tk-kpi-value">@Model.CustomerCount.ToString("#,##0", vi)</div>
    @Html.Raw(DeltaHtml(cusDelta))
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-warning"><i class="ti ti-briefcase"></i></span>
    <div class="tk-kpi-label">Tour hôm nay</div>
    <div class="tk-kpi-value">@Model.TodayDepartures</div>
    <span class="tk-kpi-sub text-muted">@Model.TodayDepartures khởi hành, @Model.RunningDepartures đang diễn ra</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-danger"><i class="ti ti-report-money"></i></span>
    <div class="tk-kpi-label">Công nợ phải thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.ReceivableOutstanding)">@Short(Model.Summary.ReceivableOutstanding)</div>
    <span class="tk-kpi-sub text-muted">@Model.DebtOrders.ToString("#,##0", vi) đơn còn nợ</span>
  </div>
</div>

<div class="row g-4">

  @* ===== Doanh thu theo thời gian ===== *@
  <div class="col-12 col-xl-8">
    <div class="tk-card h-100">
      <div class="tk-card-head align-items-start">
        <div>
          <h6 class="mb-2">Doanh thu theo thời gian</h6>
          <div class="d-flex align-items-baseline gap-2">
            <span class="tk-big" id="rev-total" title="@Full(Model.RevenueRangeTotal)">@Short(Model.RevenueRangeTotal)</span>
            @* Mức tăng giảm chỉ đúng cho 7 ngày gần nhất; đổi sang kỳ khác thì đổi thành TÊN KỲ,
               giữ nguyên "so với tuần trước" là nói sai về con số đang hiện. *@
            <span id="rev-note" class="tk-kpi-sub text-muted">tháng này</span>
          </div>
        </div>
        @* Đổi kỳ xem: gọi ?handler=Revenue rồi vẽ lại tại chỗ, không tải lại cả trang. *@
        <select id="rev-range" class="form-select form-select-sm" style="width:auto" aria-label="Kỳ xem doanh thu">
          <option value="month" selected>Tháng này</option>
          <option value="prevmonth">Tháng trước</option>
          <option value="week">7 ngày qua</option>
          <option value="year">Năm nay</option>
        </select>
      </div>
      <div id="chart-revenue" style="min-height:290px"></div>
      <div class="tk-minis">
        <div class="tk-mini"><small>Hôm nay</small><b title="@Full(Model.Pulse.Today)">@Short(Model.Pulse.Today)</b></div>
        <div class="tk-mini"><small>Tuần này</small><b title="@Full(Model.Pulse.ThisWeek)">@Short(Model.Pulse.ThisWeek)</b></div>
        <div class="tk-mini"><small>Tháng này</small><b title="@Full(Model.Pulse.ThisMonth)">@Short(Model.Pulse.ThisMonth)</b></div>
        <div class="tk-mini"><small>Năm nay</small><b title="@Full(Model.Pulse.ThisYear)">@Short(Model.Pulse.ThisYear)</b></div>
      </div>
    </div>
  </div>

  @* ===== Trung tâm cần xử lý ===== *@
  <div class="col-12 col-xl-4">
    <div class="tk-card h-100">
      <div class="tk-card-head"><h6 class="mb-0">Trung tâm cần xử lý</h6></div>
      <div class="tk-card-body">
        @{
            // Chỉ liệt kê việc CÓ số thật để bấm vào là ra đúng danh sách đó.
            var todos = new List<(bool Show, string Icon, string Color, string Title, string Sub, int Count, string Url)>
            {
                (Model.CanReceipt, "ti ti-file-invoice", "danger", "Phiếu cần duyệt", "phiếu đang chờ duyệt", Model.PendingReceiptTotal + Model.PendingPaymentTotal, "/phieu-thu-cho"),
                (Model.CanDashboard, "ti ti-report-money", "warning", "Công nợ phải thu", "đơn còn nợ tiền khách", Model.DebtOrders, "/cong-no-khach"),
                (Model.CanDeparture, "ti ti-plane-departure", "success", "Tour sắp khởi hành", "chuyến trong 7 ngày tới", Model.WeekDepartures.Count, "/chuyen-di"),
                (Model.CanCare, "ti ti-alarm", "info", "Lịch hẹn quá hạn", "lịch chăm sóc đã qua ngày", Model.OverdueCares, "/lich-hen"),
                (Model.CanTask, "ti ti-checklist", "primary", "Công việc quá hạn", "việc đã qua hạn chưa xong", Model.TaskStats.Overdue, "/cong-viec"),
            };
        }
        <div class="tk-todo-list">
          @foreach (var t in todos.Where(x => x.Show))
          {
            <a class="tk-todo" href="@t.Url">
              <span class="tk-todo-ic bg-label-@t.Color"><i class="@t.Icon"></i></span>
              <span class="tk-todo-text">
                <b>@t.Title</b>
                <small>@t.Count.ToString("#,##0", vi) @t.Sub</small>
              </span>
              <span class="badge bg-label-@(t.Count > 0 ? t.Color : "secondary")">@t.Count.ToString("#,##0", vi)</span>
            </a>
          }
        </div>
        @if (Model.CanTask)
        {
          <a class="tk-more" href="/cong-viec">Xem tất cả công việc <i class="ti ti-chevron-right"></i></a>
        }
      </div>
    </div>
  </div>

  @* ===== Việc của tôi ===== *@
  @if (Model.CanTask)
  {
    <div class="col-12 col-lg-6 col-xxl-4">
      <div class="tk-card h-100">
        <div class="tk-card-head">
          <h6 class="mb-0">Việc của tôi</h6>
          <a class="small" href="/cong-viec/cua-toi">Xem tất cả</a>
        </div>
        <div class="tk-card-body">
          @if (Model.MyTasks.Count == 0)
          {
            <p class="text-muted mb-0 py-4 text-center">Bạn chưa được giao việc nào.</p>
          }
          else
          {
            @* Lọc ngay tại thẻ (không gọi lại server): 6 dòng đang có sẵn ở client. *@
            var dayNow = today.Date;
            var todayTasks = Model.MyTasks.Where(t => t.DueDate is { } d && d.Date == dayNow).ToList();
            var lateTasks = Model.MyTasks.Where(t => t.DueDate is { } d && d.Date < dayNow && t.Status != 2 && t.Status != 3).ToList();

            <ul class="nav nav-tabs tk-tabs mb-2" role="tablist">
              <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#task-all" type="button">Tất cả (@Model.MyTasks.Count)</button></li>
              <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#task-today" type="button">Hôm nay (@todayTasks.Count)</button></li>
              <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#task-late" type="button">Quá hạn (@lateTasks.Count)</button></li>
            </ul>
            <div class="tab-content p-0">
              @foreach (var pane in new[] { ("task-all", Model.MyTasks), ("task-today", (IReadOnlyList<TourKit.Application.Work.WorkTaskDto>)todayTasks), ("task-late", (IReadOnlyList<TourKit.Application.Work.WorkTaskDto>)lateTasks) })
              {
                <div class="tab-pane fade @(pane.Item1 == "task-all" ? "show active" : "")" id="@pane.Item1">
                  @if (pane.Item2.Count == 0)
                  {
                    <p class="text-muted mb-0 py-4 text-center">Không có việc nào ở nhóm này.</p>
                  }
                  else
                  {
                    <div class="tk-list">
                      @foreach (var t in pane.Item2)
                      {
                        var over = t.DueDate is { } d && d < today && t.Status != 2 && t.Status != 3;
                        <div class="tk-line">
                          <span class="tk-line-ic bg-label-@TourKit.Api.Pages.Workspace.IndexModel.TaskStatusColor(t.Status)"><i class="ti ti-checklist"></i></span>
                          <span class="tk-line-text">
                            <b>@t.Title</b>
                            <small class="@(over ? "text-danger" : "")">@(t.DueDate?.ToString("dd/MM/yyyy", vi) ?? "Chưa đặt hạn")</small>
                          </span>
                          <span class="badge bg-label-@(t.Priority == 2 ? "danger" : t.Priority == 0 ? "secondary" : "info")">@TourKit.Api.Pages.Workspace.IndexModel.PriorityLabel(t.Priority)</span>
                        </div>
                      }
                    </div>
                  }
                </div>
              }
            </div>
          }
        </div>
      </div>
    </div>
  }

  @* ===== Phiếu cần duyệt ===== *@
  @if (Model.CanReceipt || Model.CanPayment)
  {
    <div class="col-12 col-lg-6 col-xxl-4">
      <div class="tk-card h-100">
        <div class="tk-card-head">
          <h6 class="mb-0">Phiếu cần duyệt</h6>
          <a class="small" href="/phieu-thu-cho">Xem tất cả</a>
        </div>
        <div class="tk-card-body">
          <ul class="nav nav-tabs tk-tabs mb-2" role="tablist">
            @if (Model.CanReceipt)
            {
              <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-receipt" type="button">Phiếu thu (@Model.PendingReceiptTotal.ToString("#,##0", vi))</button></li>
            }
            @if (Model.CanPayment)
            {
              <li class="nav-item"><button class="nav-link @(Model.CanReceipt ? "" : "active")" data-bs-toggle="tab" data-bs-target="#tab-payment" type="button">Phiếu chi (@Model.PendingPaymentTotal.ToString("#,##0", vi))</button></li>
            }
          </ul>
          <div class="tab-content p-0">
            @if (Model.CanReceipt)
            {
              <div class="tab-pane fade show active" id="tab-receipt">
                @if (Model.PendingReceipts.Count == 0)
                {
                  <p class="text-muted mb-0 py-4 text-center">Không còn phiếu thu nào chờ duyệt.</p>
                }
                else
                {
                  <div class="tk-list">
                    @foreach (var r in Model.PendingReceipts)
                    {
                      <div class="tk-line">
                        <span class="tk-line-ic bg-label-success"><i class="ti ti-arrow-down-circle"></i></span>
                        <span class="tk-line-text"><b>@r.Code</b><small>@(r.Partner ?? "—")</small></span>
                        <span class="tk-line-money" title="@Full(r.Amount)">@Short(r.Amount)</span>
                      </div>
                    }
                  </div>
                }
              </div>
            }
            @if (Model.CanPayment)
            {
              <div class="tab-pane fade @(Model.CanReceipt ? "" : "show active")" id="tab-payment">
                @if (Model.PendingPayments.Count == 0)
                {
                  <p class="text-muted mb-0 py-4 text-center">Không còn phiếu chi nào chờ duyệt.</p>
                }
                else
                {
                  <div class="tk-list">
                    @foreach (var p in Model.PendingPayments)
                    {
                      <div class="tk-line">
                        <span class="tk-line-ic bg-label-danger"><i class="ti ti-arrow-up-circle"></i></span>
                        <span class="tk-line-text"><b>@p.Code</b><small>@(p.Partner ?? "—")</small></span>
                        <span class="tk-line-money" title="@Full(p.Amount)">@Short(p.Amount)</span>
                      </div>
                    }
                  </div>
                }
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  }

  @* ===== Lịch hẹn tuần này ===== *@
  @if (Model.CanCare)
  {
    <div class="col-12 col-xxl-4">
      <div class="tk-card h-100">
        <div class="tk-card-head">
          <div>
            <h6 class="mb-0">Lịch hẹn tuần này</h6>
            <small class="text-muted">@Model.WeekCares.Sum(x => x.Items.Count) lịch trong 7 ngày tới</small>
          </div>
          <a class="small" href="/lich-hen">Xem lịch đầy đủ</a>
        </div>
        <div class="tk-card-body">
          @if (Model.WeekCares.Count == 0)
          {
            <p class="text-muted mb-0 py-4 text-center">7 ngày tới bạn không có lịch hẹn nào.</p>
          }
          else
          {
            @* Gom THEO NGÀY: một danh sách phẳng 7 ngày trộn lẫn thì phải tự dò xem cái nào của
               hôm nay. Mỗi ngày một đầu mục dính trên khi cuộn, ngày hôm nay tô nhấn. *@
            var dayNow = TourKit.Api.Pages.Shared.TkDate.Day(DateTimeOffset.Now);
            <div class="tk-week">
              @foreach (var g in Model.WeekCares)
              {
                var isToday = g.Day == dayNow;
                var dayLabel = isToday ? "Hôm nay" : (g.Day == dayNow.AddDays(1) ? "Ngày mai" : g.Day.ToString("dddd", vi));
                <div class="tk-week-day @(isToday ? "is-today" : "")">
                  <div class="tk-week-head">
                    <span class="tk-week-name">@dayLabel</span>
                    <span class="tk-week-date">@g.Day.ToString("dd/MM", vi)</span>
                    <span class="badge bg-label-@(isToday ? "primary" : "secondary")">@g.Items.Count</span>
                  </div>
                  @foreach (var c in g.Items)
                  {
                    <a class="tk-week-item" href="/lich-hen">
                      <span class="tk-time-dot bg-@TourKit.Api.Pages.Workspace.IndexModel.CareStatusColor(c.Status)"></span>
                      <span class="tk-line-text">
                        <b>@c.Title</b>
                        <small>@(c.CustomerName ?? "—")</small>
                      </span>
                    </a>
                  }
                </div>
              }
            </div>
          }
        </div>
      </div>
    </div>
  }

  @* ===== Top công nợ ===== *@
  @if (Model.CanDashboard)
  {
    <div class="col-12 col-xl-8">
      <div class="tk-card h-100">
        <div class="tk-card-head">
          <h6 class="mb-0">Top công nợ phải thu</h6>
          <a class="small" href="/cong-no-khach">Xem tất cả</a>
        </div>
        <div class="tk-card-body">
          @if (Model.TopDebt.Count == 0)
          {
            <p class="text-muted mb-0 py-4 text-center">Không còn khoản nợ nào.</p>
          }
          else
          {
            @* Biểu đồ cột NGANG: tên khách dài nên nằm ngang mới đọc được, và so độ dài cột là
               thấy ngay ai nợ nhiều nhất — trực quan hơn bảng số. *@
            <div id="chart-debt" style="min-height:320px"></div>
            <div class="tk-legend">
              <span><i class="bg-danger"></i>Trên 50tr</span>
              <span><i class="bg-warning"></i>20tr – 50tr</span>
              <span><i class="bg-success"></i>Dưới 20tr</span>
            </div>
          }
        </div>
      </div>
    </div>
  }

  @* ===== Thông báo mới ===== *@
  <div class="col-12 col-xl-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <h6 class="mb-0">Thông báo mới</h6>
        <a class="small" href="/thong-bao">Xem tất cả</a>
      </div>
      <div class="tk-card-body">
        @if (Model.Notifications.Count == 0)
        {
          <p class="text-muted mb-0 py-4 text-center">Chưa có thông báo nào.</p>
        }
        else
        {
          <div class="tk-list">
            @foreach (var n in Model.Notifications.Take(6))
            {
              <div class="tk-line">
                <span class="tk-line-ic bg-label-@(n.IsRead ? "secondary" : "primary")"><i class="ti ti-bell"></i></span>
                <span class="tk-line-text"><b>@n.Title</b><small>@(n.Message ?? "")</small></span>
                <small class="text-muted flex-shrink-0">@n.CreatedAt.ToLocalTime().ToString("HH:mm", vi)</small>
              </div>
            }
          </div>
        }
      </div>
    </div>
  </div>

  @* ===== Lịch khởi hành ===== *@
  @if (Model.CanDeparture)
  {
    <div class="col-12">
      <div class="tk-card">
        <div class="tk-card-head">
          <div>
            <h6 class="mb-0">Lịch khởi hành</h6>
            <small class="text-muted">@Model.MonthDepartureTotal.ToString("#,##0", vi) chuyến trong 30 ngày tới · @Model.RunningDepartures chuyến đang chạy</small>
          </div>
          <a class="small" href="/lich-dieu-hanh">Xem lịch điều hành</a>
        </div>
        @* Lưới THÁNG dễ theo dõi hơn dải thẻ ngang: nhìn một cái là thấy tuần nào dày, tuần nào trống.
           Dùng chung nguồn sự kiện với màn Lịch điều hành, chỉ nạp khoảng đang xem. *@
        <div class="tk-minis mb-3">
          <div class="tk-mini"><small>Khởi hành hôm nay</small><b>@Model.TodayDepartures</b></div>
          <div class="tk-mini"><small>Đang diễn ra</small><b>@Model.RunningDepartures</b></div>
          <div class="tk-mini"><small>7 ngày tới</small><b>@Model.WeekDepartures.Count</b></div>
          <div class="tk-mini"><small>Tổng chỗ 7 ngày</small><b>@Model.WeekSlots.ToString("#,##0", vi)</b></div>
        </div>
        <div id="cal"></div>
      </div>
    </div>
  }
</div>

@section VendorScripts {
  <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
  <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
}

@section PageScripts {
  <script>
    $(function () {
      // Lịch khởi hành — lưới tháng, dùng chung nguồn sự kiện với màn Lịch điều hành.
      var calEl = document.querySelector('#cal');
      if (calEl && window.Calendar) {
        new Calendar(calEl, {
          plugins: [dayGridPlugin, interactionPlugin],
          initialView: 'dayGridMonth', locale: 'vi',
          // height:'auto' — KHÔNG ép chiều cao: lưới tháng cần ~710px, ép thấp hơn thì nội dung
          // tràn ra ngoài thẻ vì FullCalendar cắt bằng overflow:hidden.
          height: 'auto', firstDay: 1, dayMaxEvents: 3,
          headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
          buttonText: { today: 'Hôm nay' },
          events: function (info, success, failure) {
            $.getJSON('/OperationCalendar?handler=Events&start=' + info.startStr + '&end=' + info.endStr)
              .done(function (d) { success((d && d.events) || []); })
              .fail(failure);
          },
          eventClick: function (i) {
            i.jsEvent.preventDefault();
            var p = i.event.extendedProps || {};
            tk.panel({
              title: i.event.title,
              rows: [
                { label: 'Mã chuyến', value: p.code },
                { label: 'Loại tour', value: p.tourType },
                { label: 'Ngày khởi hành', value: i.event.start ? i.event.start.toLocaleDateString('vi-VN') : null },
                { label: 'Ngày kết thúc', value: i.event.end ? new Date(i.event.end.getTime() - 86400000).toLocaleDateString('vi-VN') : null },
                { label: 'Tổng số chỗ', value: p.totalSlots != null ? tk.money(p.totalSlots) : null },
                { label: 'Trạng thái', value: p.statusLabel }
              ]
            });
          }
        }).render();
      }

      // Top công nợ — cột NGANG, tô màu theo mức nợ (trên 50tr đỏ · 20–50tr cam · dưới 20tr xanh).
      var debtEl = document.querySelector('#chart-debt');
      if (debtEl && window.ApexCharts) {
        var debtNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopDebt.Select(d => Model.DebtNames.TryGetValue(d.CustomerId, out var n) ? n : d.OrderCode)));
        var debtValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopDebt.Select(d => d.Outstanding)));
        var debtColors = debtValues.map(function (v) { return v >= 5e7 ? '#ff3e1d' : v >= 2e7 ? '#ffab00' : '#71dd37'; });
        new ApexCharts(debtEl, {
          chart: { type: 'bar', height: 320, toolbar: { show: false }, parentHeightOffset: 0 },
          series: [{ name: 'Còn nợ', data: debtValues }],
          colors: debtColors,
          plotOptions: { bar: { horizontal: true, distributed: true, borderRadius: 4, barHeight: '55%' } },
          dataLabels: {
            enabled: true, textAnchor: 'start', offsetX: 4,
            style: { fontSize: '11px', colors: ['#5d596c'] },
            formatter: function (v) { return v >= 1e9 ? (v / 1e9).toFixed(1) + ' tỷ' : Math.round(v / 1e6) + ' tr'; }
          },
          legend: { show: false },
          grid: { borderColor: 'rgba(0,0,0,.06)', xaxis: { lines: { show: true } }, padding: { left: 4, right: 16 } },
          xaxis: { categories: debtNames, axisBorder: { show: false }, axisTicks: { show: false },
                   labels: { formatter: function (v) { return Math.round(v / 1e6) + ' tr'; }, style: { colors: '#a5a3ae' } } },
          yaxis: { labels: { style: { colors: '#a5a3ae' }, maxWidth: 140 } },
          tooltip: { y: { formatter: function (v) { return (v || 0).toLocaleString('vi-VN') + ' ₫'; } } }
        }).render();
      }

      var el = document.querySelector('#chart-revenue');
      if (!el || !window.ApexCharts) { return; }
      var series = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueSeries.Select(p => p.Amount)));
      var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueSeries.Select(p => p.Day.ToString("dd/MM"))));
      var muted = getComputedStyle(document.documentElement).getPropertyValue('--bs-secondary-color') || '#8a8d93';
      var primary = getComputedStyle(document.documentElement).getPropertyValue('--bs-primary') || '#7367f0';

      var chart = new ApexCharts(el, {
        chart: { type: 'area', height: 290, toolbar: { show: false }, parentHeightOffset: 0 },
        series: [{ name: 'Doanh thu', data: series }],
        colors: [primary.trim()],
        stroke: { curve: 'smooth', width: 2.5 },
        fill: { type: 'gradient', gradient: { opacityFrom: .35, opacityTo: .02, stops: [0, 100] } },
        dataLabels: { enabled: false },
        grid: { borderColor: 'rgba(0,0,0,.06)', padding: { left: 8, right: 8 } },
        markers: { size: 0, hover: { size: 5 } },
        xaxis: { categories: labels, axisBorder: { show: false }, axisTicks: { show: false },
                 labels: { style: { colors: muted } } },
        yaxis: { labels: { style: { colors: muted },
                 // Trục tiền rút gọn để không chiếm nửa bề ngang biểu đồ.
                 formatter: function (v) { return v >= 1e9 ? (v / 1e9).toFixed(1) + ' tỷ' : v >= 1e6 ? Math.round(v / 1e6) + ' tr' : v; } } },
        tooltip: { y: { formatter: function (v) { return (v || 0).toLocaleString('vi-VN') + ' ₫'; } } }
      });
      chart.render();

      // Đổi kỳ: hỏi server đúng khoảng đó rồi vẽ lại, không tải lại cả trang.
      $('#rev-range').on('change', function () {
        var range = this.value;
        $.getJSON('?handler=Revenue&range=' + encodeURIComponent(range)).done(function (d) {
          chart.updateOptions({ xaxis: { categories: d.labels } }, false, false);
          chart.updateSeries([{ name: 'Doanh thu', data: d.values }]);
          var t = Number(d.total) || 0;
          var short = t >= 1e9 ? (t / 1e9).toFixed(1).replace('.', ',') + ' tỷ'
                    : t >= 1e6 ? Math.round(t / 1e6) + ' tr'
                    : t.toLocaleString('vi-VN');
          $('#rev-total').text(short).attr('title', t.toLocaleString('vi-VN') + ' ₫');
          $('#rev-note').text((d.label || '').toLowerCase());
        });
      });
    });
  </script>
}
