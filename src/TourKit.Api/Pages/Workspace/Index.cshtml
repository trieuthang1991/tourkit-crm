@page
@using System.Globalization
@model TourKit.Api.Pages.Workspace.IndexModel
@{
  ViewData["Title"] = "Bàn làm việc";
  string Money(decimal v) => v.ToString("#,##0", CultureInfo.InvariantCulture);
  string Compact(decimal v) => v >= 1_000_000_000 ? (v / 1_000_000_000).ToString("0.#", CultureInfo.InvariantCulture) + " tỷ"
    : v >= 1_000_000 ? (v / 1_000_000).ToString("0.#", CultureInfo.InvariantCulture) + " tr"
    : Money(v);
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
  @if (Model.CanDeparture)
  {
    <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
  }
}

<div class="mb-4">
  <h4 class="mb-1">Bàn làm việc</h4>
  <p class="text-muted mb-0">Chào mừng, @Model.UserName — tổng quan công việc và hoạt động hôm nay.</p>
</div>

@* Thao tác nhanh — chỉ hiện nút mà người dùng có quyền (bám quickActions hệ cũ). *@
<div class="d-flex flex-wrap gap-2 mb-4">
  @if (Model.CanTask)     { <a href="/WorkTasks" class="btn btn-label-primary btn-sm"><i class="ti ti-checkbox me-1"></i> Tạo việc</a> }
  @if (Model.CanLead)     { <a href="/Leads" class="btn btn-label-primary btn-sm"><i class="ti ti-target me-1"></i> Tạo cơ hội</a> }
  @if (Model.CanCare)     { <a href="/CustomerCares" class="btn btn-label-primary btn-sm"><i class="ti ti-calendar-event me-1"></i> Tạo lịch hẹn</a> }
  @if (Model.CanCustomer) { <a href="/Customers" class="btn btn-label-primary btn-sm"><i class="ti ti-user-plus me-1"></i> Tạo Data khách</a> }
  @if (Model.CanBooking)  { <a href="/Orders" class="btn btn-label-primary btn-sm"><i class="ti ti-shopping-cart me-1"></i> Tạo đơn</a> }
</div>

@if (Model.CanDashboard)
{
  @* 4 KPI của bản cũ: doanh thu · đơn hàng · khách hàng · công nợ phải thu *@
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100"><div class="card-body d-flex align-items-center">
        <div class="avatar me-3"><span class="avatar-initial rounded bg-label-success"><i class="ti ti-wallet"></i></span></div>
        <div><small class="text-muted d-block">Doanh thu (đã ghi nhận)</small><h5 class="mb-0" title="@Money(Model.Summary.TotalRevenue)">@Compact(Model.Summary.TotalRevenue)</h5></div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100"><div class="card-body d-flex align-items-center">
        <div class="avatar me-3"><span class="avatar-initial rounded bg-label-info"><i class="ti ti-shopping-cart"></i></span></div>
        <div><small class="text-muted d-block">Đơn hàng</small><h5 class="mb-0">@Model.Summary.OrderCount.ToString("#,##0")</h5></div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100"><div class="card-body d-flex align-items-center">
        <div class="avatar me-3"><span class="avatar-initial rounded bg-label-primary"><i class="ti ti-users"></i></span></div>
        <div><small class="text-muted d-block">Khách hàng</small><h5 class="mb-0">@Model.CustomerCount.ToString("#,##0")</h5></div>
      </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card h-100"><div class="card-body d-flex align-items-center">
        <div class="avatar me-3"><span class="avatar-initial rounded bg-label-danger"><i class="ti ti-cash"></i></span></div>
        <div><small class="text-muted d-block">Công nợ phải thu</small><h5 class="mb-0" title="@Money(Model.Summary.ReceivableOutstanding)">@Compact(Model.Summary.ReceivableOutstanding)</h5></div>
      </div></div>
    </div>
  </div>
}

@* ---- Hàng 1: tỉ lệ công việc · thông báo · công nợ khách hàng ---- *@
<div class="row g-4 mb-4">
  @if (Model.CanTask)
  {
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header"><h5 class="mb-0">Tỉ lệ công việc</h5></div>
        <div class="card-body">
          <div id="task-donut"></div>
          <div class="d-flex flex-wrap justify-content-center gap-3 mt-2">
            <span class="small"><span class="badge bg-label-secondary">Cần làm</span> @Model.TaskStats.Todo</span>
            <span class="small"><span class="badge bg-label-info">Đang làm</span> @Model.TaskStats.InProgress</span>
            <span class="small"><span class="badge bg-label-success">Hoàn thành</span> @Model.TaskStats.Done</span>
            <span class="small"><span class="badge bg-label-danger">Huỷ</span> @Model.TaskStats.Cancelled</span>
          </div>
        </div>
      </div>
    </div>
  }

  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Thông báo bạn cần quan tâm</h5>
        <a href="/Notifications" class="small">Xem tất cả</a>
      </div>
      <div class="card-body p-0" style="max-height:340px;overflow-y:auto">
        @if (Model.Notifications.Count == 0)
        {
          <div class="text-muted text-center py-5">Không có thông báo</div>
        }
        else
        {
          <ul class="list-group list-group-flush">
            @foreach (var n in Model.Notifications)
            {
              <li class="list-group-item d-flex align-items-start">
                <div class="avatar avatar-sm me-3 flex-shrink-0">
                  <span class="avatar-initial rounded-circle @(n.IsRead ? "bg-label-secondary" : "bg-label-primary")"><i class="ti ti-bell"></i></span>
                </div>
                <div class="flex-grow-1" style="min-width:0">
                  <div class="d-flex justify-content-between gap-2">
                    <span class="@(n.IsRead ? "" : "fw-medium") text-truncate">
                      @if (!string.IsNullOrWhiteSpace(n.LinkUrl))
                      {
                        <a href="@n.LinkUrl" class="text-body">@n.Title</a>
                      }
                      else
                      {
                        @n.Title
                      }
                    </span>
                    <small class="text-muted flex-shrink-0">@n.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM", CultureInfo.InvariantCulture)</small>
                  </div>
                  @if (!string.IsNullOrWhiteSpace(n.Message))
                  {
                    <small class="text-muted d-block text-truncate">@n.Message</small>
                  }
                </div>
              </li>
            }
          </ul>
        }
      </div>
    </div>
  </div>

  @if (Model.CanDashboard)
  {
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Công nợ khách hàng</h5>
          <a href="/CustomerDebtReport" class="small">Xem báo cáo</a>
        </div>
        <div class="card-body p-0" style="max-height:340px;overflow-y:auto">
          @if (Model.TopDebt.Count == 0)
          {
            <div class="text-muted text-center py-5">Không có công nợ</div>
          }
          else
          {
            <ul class="list-group list-group-flush">
              @{ var rank = 0; }
              @foreach (var d in Model.TopDebt)
              {
                rank++;
                <li class="list-group-item d-flex align-items-center">
                  <div class="avatar avatar-sm me-3 flex-shrink-0"><span class="avatar-initial rounded-circle bg-label-secondary">@rank</span></div>
                  <div class="flex-grow-1" style="min-width:0">
                    <div class="fw-medium text-truncate">@d.OrderCode</div>
                    <small class="text-muted">Tổng @Money(d.Total) · đã thu @Money(d.Paid)</small>
                  </div>
                  <span class="fw-medium text-danger flex-shrink-0">@Money(d.Outstanding)</span>
                </li>
              }
            </ul>
          }
        </div>
      </div>
    </div>
  }
</div>

@* ---- Hàng 2: lịch hẹn hôm nay · phiếu cần duyệt · thông tin doanh nghiệp ---- *@
<div class="row g-4 mb-4">
  @if (Model.CanCare)
  {
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Lịch hẹn hôm nay</h5>
          <a href="/CustomerCares" class="small">Xem tất cả →</a>
        </div>
        <div class="card-body">
          @if (Model.TodayCares.Count == 0)
          {
            <div class="text-muted">Hôm nay không có lịch hẹn</div>
          }
          else
          {
            foreach (var c in Model.TodayCares)
            {
              <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <div style="min-width:0">
                  <div class="text-truncate">@c.Title</div>
                  @if (!string.IsNullOrWhiteSpace(c.CustomerName))
                  {
                    <small class="text-muted">@c.CustomerName</small>
                  }
                </div>
                <span class="badge bg-label-warning flex-shrink-0">@c.RemindAt!.Value.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
              </div>
            }
          }
        </div>
      </div>
    </div>
  }

  @if (Model.CanReceipt || Model.CanPayment)
  {
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header pb-0"><h5 class="mb-0">Phiếu cần duyệt</h5></div>
        <div class="card-body">
          <ul class="nav nav-tabs" role="tablist">
            @if (Model.CanReceipt)
            {
              <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-receipt" type="button">Phiếu thu (@Model.PendingReceiptTotal)</button></li>
            }
            @if (Model.CanPayment)
            {
              <li class="nav-item"><button class="nav-link @(Model.CanReceipt ? "" : "active")" data-bs-toggle="tab" data-bs-target="#tab-payment" type="button">Phiếu chi (@Model.PendingPaymentTotal)</button></li>
            }
          </ul>
          <div class="tab-content px-0" style="max-height:280px;overflow-y:auto">
            @if (Model.CanReceipt)
            {
              <div class="tab-pane fade show active" id="tab-receipt">
                @if (Model.PendingReceipts.Count == 0)
                {
                  <div class="text-muted py-3">Không có phiếu chờ</div>
                }
                else
                {
                  foreach (var r in Model.PendingReceipts)
                  {
                    <div class="d-flex justify-content-between align-items-center gap-2 py-2 border-bottom">
                      <div style="min-width:0">
                        <a href="/Receipts" class="fw-medium d-block text-truncate">@r.Code</a>
                        <small class="text-muted">@(r.CustomerName ?? r.OrderCode ?? "—")</small>
                      </div>
                      <div class="text-end flex-shrink-0">
                        <div class="fw-medium">@Money(r.Amount)</div>
                        <span class="badge bg-label-success">THU</span>
                      </div>
                    </div>
                  }
                }
              </div>
            }
            @if (Model.CanPayment)
            {
              <div class="tab-pane fade @(Model.CanReceipt ? "" : "show active")" id="tab-payment">
                @if (Model.PendingPayments.Count == 0)
                {
                  <div class="text-muted py-3">Không có phiếu chờ</div>
                }
                else
                {
                  foreach (var p in Model.PendingPayments)
                  {
                    <div class="d-flex justify-content-between align-items-center gap-2 py-2 border-bottom">
                      <div style="min-width:0">
                        <a href="/Payments" class="fw-medium d-block text-truncate">@p.Code</a>
                        <small class="text-muted">@(p.ProviderName ?? p.OrderCode ?? "—")</small>
                      </div>
                      <div class="text-end flex-shrink-0">
                        <div class="fw-medium">@Money(p.Amount)</div>
                        <span class="badge bg-label-danger">CHI</span>
                      </div>
                    </div>
                  }
                }
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  }

  @if (Model.CanPost)
  {
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Thông tin doanh nghiệp</h5>
          <a href="/Posts" class="small">Xem thêm</a>
        </div>
        <div class="card-body p-0" style="max-height:300px;overflow-y:auto">
          @if (Model.Posts.Count == 0)
          {
            <div class="text-muted text-center py-5">Chưa có bài viết</div>
          }
          else
          {
            <ul class="list-group list-group-flush">
              @foreach (var p in Model.Posts)
              {
                <li class="list-group-item d-flex align-items-start">
                  <div class="avatar avatar-sm me-3 flex-shrink-0"><span class="avatar-initial rounded-circle bg-label-info"><i class="ti ti-article"></i></span></div>
                  <div style="min-width:0">
                    <a href="/Posts" class="fw-medium d-block text-truncate">@p.Title</a>
                    <small class="text-muted">
                      @if (!string.IsNullOrWhiteSpace(p.CategoryName))
                      {
                        <span class="badge bg-label-info me-1">@p.CategoryName</span>
                      }
                      @(p.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "")
                    </small>
                  </div>
                </li>
              }
            </ul>
          }
        </div>
      </div>
    </div>
  }
</div>

@if (Model.CanTask)
{
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Công việc của tôi</h5>
      <a href="/WorkTasks" class="small">Xem tất cả →</a>
    </div>
    <div class="card-body pb-0">
      <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="badge bg-label-secondary">Cần làm · @Model.TaskStats.Todo</span>
        <span class="badge bg-label-info">Đang làm · @Model.TaskStats.InProgress</span>
        <span class="badge bg-label-success">Hoàn thành · @Model.TaskStats.Done</span>
        <span class="badge bg-label-danger">Quá hạn · @Model.TaskStats.Overdue</span>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Công việc</th><th>Phụ trách</th><th>Ưu tiên</th><th>Hạn</th><th>Trạng thái</th></tr></thead>
        <tbody>
          @if (Model.MyTasks.Count == 0)
          {
            <tr><td colspan="5" class="text-center text-muted py-4">Không có công việc</td></tr>
          }
          else
          {
            foreach (var t in Model.MyTasks)
            {
              <tr>
                <td class="fw-medium">@t.Title</td>
                <td>@(t.AssigneeName ?? "—")</td>
                <td>@TourKit.Api.Pages.Workspace.IndexModel.PriorityLabel(t.Priority)</td>
                <td>@(t.DueDate?.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "—")</td>
                <td><span class="badge bg-label-@TourKit.Api.Pages.Workspace.IndexModel.TaskStatusColor(t.Status)">@TourKit.Api.Pages.Workspace.IndexModel.TaskStatusLabel(t.Status)</span></td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </div>
}

@if (Model.CanCare)
{
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Lịch chăm sóc của tôi</h5>
      <a href="/CustomerCares" class="small">Xem tất cả →</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Tiêu đề</th><th>Khách hàng</th><th>Nhắc lúc</th><th>Trạng thái</th></tr></thead>
        <tbody>
          @if (Model.MyCares.Count == 0)
          {
            <tr><td colspan="4" class="text-center text-muted py-4">Không có lịch chăm sóc</td></tr>
          }
          else
          {
            foreach (var c in Model.MyCares)
            {
              <tr>
                <td class="fw-medium">@c.Title</td>
                <td>@(c.CustomerName ?? "—")</td>
                <td>@(c.RemindAt?.ToLocalTime().ToString("HH:mm dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "—")</td>
                <td><span class="badge bg-label-@TourKit.Api.Pages.Workspace.IndexModel.CareStatusColor(c.Status)">@TourKit.Api.Pages.Workspace.IndexModel.CareStatusLabel(c.Status)</span></td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </div>
}

@if (Model.CanDeparture)
{
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Lịch khởi hành</h5>
      <a href="/OperationCalendar" class="small">Xem lịch điều hành →</a>
    </div>
    <div class="card-body"><div id="cal"></div></div>
  </div>
}

@section VendorScripts {
  <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
  @if (Model.CanDeparture)
  {
    <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
  }
}

@section PageScripts {
  <script>
    $(function () {
      @if (Model.CanTask)
      {
        <text>
      // Vòng tròn tỉ lệ công việc — ApexCharts của template (không tự vẽ SVG).
      var donutEl = document.querySelector('#task-donut');
      if (donutEl && window.ApexCharts) {
        new ApexCharts(donutEl, {
          chart: { type: 'donut', height: 220 },
          series: [@Model.TaskStats.Todo, @Model.TaskStats.InProgress, @Model.TaskStats.Done, @Model.TaskStats.Cancelled],
          labels: ['Cần làm', 'Đang làm', 'Hoàn thành', 'Huỷ'],
          colors: ['#a8aaae', '#03c3ec', '#71dd37', '#ff3e1d'],
          legend: { show: false },
          dataLabels: { enabled: false },
          plotOptions: { pie: { donut: { labels: { show: true,
            total: { show: true, label: 'Tổng việc', formatter: function () { return '@Model.TaskStats.Total'; } } } } } }
        }).render();
      }
        </text>
      }

      @if (Model.CanDeparture)
      {
        <text>
      // Lịch khởi hành: dùng CHUNG nguồn sự kiện của màn Lịch điều hành — chỉ nạp khoảng đang xem.
      var calEl = document.querySelector('#cal');
      if (calEl && window.Calendar) {
        new Calendar(calEl, {
          plugins: [dayGridPlugin, interactionPlugin],
          initialView: 'dayGridMonth', locale: 'vi', height: 520,
          headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
          events: function (info, success, failure) {
            $.getJSON('/OperationCalendar?handler=Events&start=' + info.startStr + '&end=' + info.endStr)
              .done(function (d) { success((d && d.events) || []); })
              .fail(failure);
          },
          eventClick: function (i) { location.href = '/Departures/Detail/' + i.event.id; }
        }).render();
      }
        </text>
      }
    });
  </script>
}
