@page
@model TourKit.Api.Pages.Payments.IndexModel
@{ ViewData["Title"] = "Phiếu chi"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 5 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng số phiếu", Model.Stats.Total.ToString("#,##0"), "ti ti-file-invoice", "primary"),
        ("kpi-amount", "Tổng tiền", Model.Stats.TotalAmount.ToString("#,##0"), "ti ti-cash-off", "danger"),
        ("kpi-pending", "Chờ duyệt", Model.Stats.Pending.ToString("#,##0"), "ti ti-clock", "warning"),
        ("kpi-approved", "Đã duyệt", Model.Stats.Approved.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("kpi-rejected", "Từ chối", Model.Stats.Rejected.ToString("#,##0"), "ti ti-circle-x", "danger"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Tài chính <span class="mx-1">/</span> <span class="text-body">Phiếu chi</span></div>
    <h4 class="mb-0">Phiếu chi</h4>
  </div>
  <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value" id="@s.Id">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã phiếu / mã đơn / NCC / người nhận" /></div>
      <div class="col-md-3">
        <select id="f-status" class="form-select tk-auto">
          <option value="">Trạng thái</option>
          <option value="0">Chờ duyệt</option><option value="1">Đã duyệt</option><option value="2">Từ chối</option>
        </select>
      </div>
      <div class="col-md-3"><input type="text" id="f-paymentMethod" class="form-control" placeholder="PT thanh toán" /></div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Lọc nâng cao — đủ 9 tiêu chí hệ cũ, MỌI tiêu chí đẩy xuống server *@
    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-from" class="form-control tk-datef" placeholder="Ngày từ" autocomplete="off" /></div>
      <div class="col-md-3"><input type="text" id="f-to" class="form-control tk-datef" placeholder="Ngày đến" autocomplete="off" /></div>
      <div class="col-md-3"><input type="number" min="0" id="f-amountFrom" class="form-control" placeholder="Số tiền từ" /></div>
      <div class="col-md-3"><input type="number" min="0" id="f-amountTo" class="form-control" placeholder="Số tiền đến" /></div>
      <div class="col-md-3"><select id="f-branchId" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-salesUserId" class="form-select tk-s2f" data-placeholder="NV phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
    </div>
  </div>

  @* Thanh tác vụ hàng loạt — phiếu chi KHÔNG xoá hàng loạt (chỉ duyệt/từ chối từng phiếu). *@
  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> phiếu đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    @if (Model.CanApprove)
    {
      <button type="button" class="btn btn-sm btn-label-primary" id="bulk-approve"><i class="ti ti-check me-1"></i> Duyệt</button>
    }
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-payments"></div>
</div>

@Html.AntiForgeryToken()

@* Modal chi tiết phiếu — mở khi kích 1 dòng (bám PaymentDetailModal hệ cũ) *@
<div class="modal fade" id="detail-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="dm-title">Phiếu chi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <h4 class="mb-0 text-danger" id="dm-amount">0</h4>
          <span id="dm-status"></span>
        </div>
        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Ngày lập</span><span class="fw-medium small" id="dm-issuedAt"></span></div>
        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Nhà cung cấp</span><span class="fw-medium small" id="dm-provider"></span></div>
        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Mã đơn</span><span class="fw-medium small" id="dm-order"></span></div>
        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Người nhận</span><span class="fw-medium small" id="dm-receiver"></span></div>
        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Đối tác</span><span class="fw-medium small" id="dm-partner"></span></div>
        <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted small">Hình thức</span><span class="fw-medium small" id="dm-method"></span></div>
        <div class="d-flex justify-content-between py-2"><span class="text-muted small">Ghi nhận dòng tiền</span><span class="fw-medium small" id="dm-recognized"></span></div>
      </div>
      <div class="modal-footer justify-content-between">
        <a href="#" class="btn btn-label-secondary" id="dm-order-link"><i class="ti ti-external-link me-1"></i> Mở đơn liên quan</a>
        <span id="dm-actions"></span>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      var CAN_APPROVE = @(Model.CanApprove ? "true" : "false");

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      // KPI đọc lại sau mỗi lần duyệt/từ chối (số liệu đổi ngay, không phải tải lại trang).
      function refreshStats() {
        $.getJSON('?handler=Stats', function (s) {
          $('#kpi-total').text(money(s.total));
          $('#kpi-amount').text(money(s.totalAmount));
          $('#kpi-pending').text(money(s.pending));
          $('#kpi-approved').text(money(s.approved));
          $('#kpi-rejected').text(money(s.rejected));
        });
      }
      function act(id, handler) {
        var fd = new FormData(); fd.append('id', id);
        return tk.post('?handler=' + handler, fd).then(function (res) {
          if (res && res.isSuccess) { grid.reload(); refreshStats(); tk.toast(res.message || 'Đã xử lý.'); }
          else { tk.error((res && res.message) || 'Thao tác thất bại.'); }
        });
      }
      function confirmAct(r, kind) {
        var approve = kind === 'Approve';
        Swal.fire({
          title: (approve ? 'Duyệt phiếu chi ' : 'Từ chối phiếu ') + r.code + '?',
          icon: approve ? 'question' : 'warning', showCancelButton: true,
          confirmButtonText: approve ? 'Duyệt' : 'Từ chối', cancelButtonText: 'Huỷ',
          customClass: { confirmButton: (approve ? 'btn btn-primary' : 'btn btn-danger') + ' me-2', cancelButton: 'btn btn-label-secondary' },
          buttonsStyling: false
        }).then(function (x) { if (x.isConfirmed) { act(r.id, kind); } });
      }

      function showDetail(r) {
        $('#dm-title').text('Phiếu chi ' + r.code);
        $('#dm-amount').text(money(r.amount));
        $('#dm-status').html('<span class="badge bg-label-' + r.statusColor + '">' + esc(r.statusLabel) + '</span>');
        $('#dm-issuedAt').text(r.issuedAt);
        $('#dm-provider').text(r.providerName);
        $('#dm-order').text(r.orderCode);
        $('#dm-receiver').text(r.receiverName);
        $('#dm-partner').text(r.partner);
        $('#dm-method').text(r.paymentMethod);
        $('#dm-recognized').text(r.isRecognized ? 'Đã ghi nhận' : 'Chưa ghi nhận');
        $('#dm-order-link').attr('href', '/don-hang/' + r.orderId);
        var $a = $('#dm-actions').empty();
        if (CAN_APPROVE && r.status === 0) {
          $a.append('<button type="button" class="btn btn-label-danger me-2" id="dm-reject">Từ chối</button>' +
                    '<button type="button" class="btn btn-primary" id="dm-approve">Duyệt</button>');
          $('#dm-reject').on('click', function () { bootstrap.Modal.getInstance(document.getElementById('detail-modal')).hide(); act(r.id, 'Reject'); });
          $('#dm-approve').on('click', function () { bootstrap.Modal.getInstance(document.getElementById('detail-modal')).hide(); act(r.id, 'Approve'); });
        }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('detail-modal')).show();
      }

      // Duyệt/từ chối chỉ hiện khi CÓ quyền và phiếu đang chờ duyệt — bám đúng luật hệ cũ.
      function actionsFor(r) {
        var items = [
          { label: '<i class="ti ti-eye me-2"></i>Xem chi tiết phiếu', action: function () { showDetail(r); } },
          { label: '<i class="ti ti-external-link me-2"></i>Mở đơn liên quan', action: function () { window.location = '/don-hang/' + r.orderId; } }
        ];
        if (CAN_APPROVE && r.status === 0) {
          items.push({ separator: true });
          items.push({ label: '<i class="ti ti-check me-2"></i>Duyệt phiếu', action: function () { confirmAct(r, 'Approve'); } });
          items.push({ label: '<span class="text-danger"><i class="ti ti-x me-2"></i>Từ chối</span>', action: function () { confirmAct(r, 'Reject'); } });
        }
        return items;
      }

      var grid = tk.grid('#grid-payments', {
        // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['status', 'paymentMethod', 'from', 'to', 'amountFrom', 'amountTo', 'branchId', 'salesUserId'],
        exportName: 'phieu-chi-da-chon.csv',
        actions: actionsFor,
        onRowClick: showDetail,   // kích dòng → modal chi tiết (bám hệ cũ)
        columns: [
          {
            title: 'Phiếu chi', field: 'code', widthGrow: 2, minWidth: 160,
            formatter: function (c) { var r = c.getData(); return g.stack(r.code, r.issuedAt); }
          },
          {
            title: 'Đối tượng nhận', field: 'providerName', widthGrow: 3, minWidth: 220,
            formatter: function (c) {
              var r = c.getData();
              var sub = [r.orderCode, r.receiverName].filter(Boolean).join(' · ');
              return '<div class="tk-row-media">' + g.avatar(r.providerName) + g.stack(r.providerName, sub) + '</div>';
            }
          },
          { title: 'Hình thức', field: 'paymentMethod', widthGrow: 2, minWidth: 150,
            formatter: function (c) { return g.stack(c.getValue(), null); } },
          {
            title: 'Số tiền', field: 'amount', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold text-danger">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main text-danger">' + money(r.amount) + '</div>' +
                (r.isRecognized ? '<div class="tk-cell-sub">Đã ghi nhận</div>' : '') + '</div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 130,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });

      // Duyệt hàng loạt: chỉ áp cho phiếu ĐANG CHỜ trong số đã chọn (phiếu đã xử lý thì bỏ qua).
      $('#bulk-approve').on('click', function () {
        var pending = grid.table.getSelectedData().filter(function (r) { return r.status === 0; });
        if (!pending.length) { tk.toast('Không có phiếu nào đang chờ duyệt trong số đã chọn.'); return; }
        Swal.fire({ title: 'Duyệt ' + pending.length + ' phiếu chi?', icon: 'question', showCancelButton: true,
          confirmButtonText: 'Duyệt', cancelButtonText: 'Huỷ',
          customClass: { confirmButton: 'btn btn-primary me-2', cancelButton: 'btn btn-label-secondary' }, buttonsStyling: false })
          .then(function (x) {
            if (!x.isConfirmed) { return; }
            var chain = Promise.resolve();
            pending.forEach(function (r) {
              chain = chain.then(function () {
                var fd = new FormData(); fd.append('id', r.id);
                return tk.post('?handler=Approve', fd);
              });
            });
            chain.then(function () {
              grid.table.deselectRow(); grid.reload(); refreshStats();
              tk.toast('Đã duyệt ' + pending.length + ' phiếu chi.');
            });
          });
      });

      $('#f-paymentMethod').on('keydown', function (e) { if (e.key === 'Enter') { grid.reload(); } })
        .on('blur', function () { grid.reload(); });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
