@page
@model TourKit.Api.Pages.Workflows.IndexModel
@{ ViewData["Title"] = "Dự án"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Dự án</h5>
    <button type="button" class="btn btn-primary btn-sm" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm dự án</button>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Tên</th><th>Bắt đầu</th><th>Kết thúc</th><th class="text-end">Cột / Việc</th><th class="text-center">Trạng thái</th><th></th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr data-json='@System.Text.Json.JsonSerializer.Serialize(new { id = x.Id, name = x.Name, startDate = x.StartDate != null ? x.StartDate.Value.ToString("yyyy-MM-dd") : null, endDate = x.EndDate != null ? x.EndDate.Value.ToString("yyyy-MM-dd") : null, status = x.Status })'>
          <td class="fw-medium">@x.Name</td>
          <td>@(x.StartDate?.ToString("dd/MM/yyyy") ?? "—")</td>
          <td>@(x.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td>
          <td class="text-end">@x.SectionCount / @x.TaskCount</td>
          <td class="text-center"><span class="badge bg-label-@TourKit.Api.Pages.Workflows.IndexModel.StatusColor(x.Status)">@TourKit.Api.Pages.Workflows.IndexModel.StatusLabel(x.Status)</span></td>
          <td class="text-end">
            <button type="button" class="btn btn-icon btn-sm js-status" data-id="@x.Id" data-next="@(x.Status == 1 ? 0 : 1)" title="@(x.Status == 1 ? "Khôi phục" : "Lưu trữ")"><i class="ti @(x.Status == 1 ? "ti-archive-off" : "ti-archive")"></i></button>
            <button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>
            <button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="@x.Id" title="Xoá"><i class="ti ti-trash"></i></button>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>
<form id="status-form" method="post" asp-page-handler="SetStatus" class="d-none"><input type="hidden" name="id" /><input type="hidden" name="status" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">dự án</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      <input type="hidden" name="Id" />
      <input type="hidden" name="Input.Status" value="0" />
      <div class="mb-3"><label class="form-label">Tên <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên dự án" /></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Bắt đầu</label><input type="text" name="Input.StartDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3"><label class="form-label">Kết thúc</label><input type="text" name="Input.EndDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc;
    $(function () {
      tk.tableClient('#tbl', { columnDefs: [{ orderable: false, targets: [5] }] });
      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'dự án',
        rules: { 'Input.Name': { required: true } }, messages: { 'Input.Name': { required: 'Bắt buộc nhập tên' } } });
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open($(this).closest('tr').data('json')); });
      // Lưu trữ / khôi phục dự án — submit form ẩn (cùng lối với Xoá; trang tải lại hiện trạng thái mới).
      $('#tbl tbody').on('click', '.js-status', function () {
        var f = document.getElementById('status-form');
        f.querySelector('[name="id"]').value = this.getAttribute('data-id');
        f.querySelector('[name="status"]').value = this.getAttribute('data-next');
        f.submit();
      });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá dự án?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
