@page
@model TourKit.Api.Pages.Leads.IndexModel
@{ ViewData["Title"] = "Khách tiềm năng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  <link rel="stylesheet" href="~/vendor/libs/jkanban/jkanban.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/app-kanban.css" />
}

@{
    // 7 thẻ pipeline — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng cơ hội", Model.Stats.Total.ToString("#,##0"), "ti ti-target", "primary"),
        ("Mới", Model.Stats.New.ToString("#,##0"), "ti ti-seeding", "secondary"),
        ("Đã liên hệ", Model.Stats.Contacted.ToString("#,##0"), "ti ti-phone-call", "warning"),
        ("Tiềm năng", Model.Stats.Qualified.ToString("#,##0"), "ti ti-star", "info"),
        ("Chốt", Model.Stats.Won.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("Mất", Model.Stats.Lost.ToString("#,##0"), "ti ti-circle-x", "danger"),
        ("Đã chuyển KH", Model.Stats.Converted.ToString("#,##0"), "ti ti-user-check", "success"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">CRM <span class="mx-1">/</span> <span class="text-body">Khách tiềm năng</span></div>
    <h4 class="mb-0">Khách tiềm năng<partial name="_FlowHelp" model="@("lead")" /></h4>
  </div>
  <div class="d-flex gap-2">
    @* Chuyển Bảng / Kanban — bám nút List/Kanban hệ cũ *@
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-label-secondary active" id="view-list" title="Dạng bảng"><i class="ti ti-list"></i></button>
      <button type="button" class="btn btn-label-secondary" id="view-kanban" title="Dạng Kanban"><i class="ti ti-layout-kanban"></i></button>
    </div>
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm khách tiềm năng</button>
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — đủ 7 tiêu chí service hỗ trợ (4 lọc nhanh + panel nâng cao) *@
  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Tên cơ hội, SĐT, email, nguồn…" /></div>
      <div class="col-md-2">
        <select id="f-status" class="form-select tk-auto">
          <option value="">Trạng thái</option>
          <option value="1">Mới</option><option value="2">Đã liên hệ</option><option value="3">Tiềm năng</option>
          <option value="4">Đã chốt</option><option value="5">Thất bại</option>
        </select>
      </div>
      <div class="col-md-2">
        <select id="f-source" class="form-select tk-s2f" data-placeholder="Nguồn khách hàng"><option value=""></option>@foreach (var s in Model.Sources) { <option value="@s">@s</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-assignedToUserId" class="form-select tk-s2f" data-placeholder="NV phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><select id="f-createdByUserId" class="form-select tk-s2f" data-placeholder="Người tạo"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-branchId" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
      <div class="col-md-3"><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="Ngày lập từ" /></div>
      <div class="col-md-3"><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="Ngày lập đến" /></div>
    </div>

    @* Ô lọc ẨN cho chiến dịch — nạp sẵn khi vào từ màn Chia số Sale. Không có nó thì campaignId
       trên đường dẫn bị '?handler=Data' của lưới nuốt mất (xem LocCampaignId trong PageModel). *@
    <input type="hidden" id="f-campaignId" value="@(Model.LocCampaignId?.ToString())" />
    @if (Model.LocCampaignId is not null)
    {
      <div class="alert alert-info d-flex align-items-center gap-2 mt-3 mb-0 py-2">
        <i class="ti ti-filter"></i>
        <span class="small">Đang lọc theo một chiến dịch chia số.</span>
        <a href="/khach-tiem-nang" class="btn btn-sm btn-label-secondary ms-auto">Bỏ lọc</a>
      </div>
    }
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> cơ hội đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-leads"></div>

  @* Kanban dựng bằng component CHUNG tk.kanban (nó bọc jKanban bên trong) — CÙNG khuôn với màn
     Cơ hội bán hàng. MỖI CỘT chỉ tải TOP N theo trạng thái của nó + nút "Tải thêm" — KHÔNG get-all.
     Nằm TRONG .tk-surface như màn Cơ hội: CSS kanban được chỉnh cho mặt trắng đó, để lọt ra ngoài
     thì bảng rơi xuống nền xám của trang và lệch hẳn với lưới nó vừa thay chỗ. *@
  <div id="pane-kanban" class="app-kanban tk-pad d-none">
    <div class="kanban-wrapper"></div>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>
<form id="convert-form" method="post" asp-page-handler="Convert" class="d-none"><input type="hidden" name="id" /><input type="hidden" name="assignedToUserId" /></form>

<div class="offcanvas offcanvas-end tk-oc-wide" tabindex="-1" id="oc">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">cơ hội</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      @* Hai cột: TRÁI nhập liệu · PHẢI ngữ cảnh (trợ lý AI + trao đổi). Dưới lg tự xếp dọc —
         xem .tk-oc-split trong tourkit.css. *@
      <div class="tk-oc-split">
      <div class="tk-oc-col">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Họ tên <span class="text-danger">*</span></label><input type="text" name="Input.FullName" class="form-control" placeholder="Nhập họ tên" /></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Số điện thoại</label><input type="text" name="Input.Phone" class="form-control" placeholder="Nhập số điện thoại" /></div>
        <div class="col-6 mb-3"><label class="form-label">Email</label><input type="text" name="Input.Email" class="form-control" placeholder="Nhập email" /></div>
      </div>
      @* Nguồn lấy từ DANH MỤC (/nguon-khach), không cho gõ tay: gõ tay thì "Facebook", "facebook",
         "FB", "Face book" thành bốn nguồn khác nhau, và mọi báo cáo theo nguồn hỏng theo. *@
      <div class="mb-3">
        <label class="form-label">Nguồn</label>
        <select name="Input.Source" class="form-select tk-s2" data-placeholder="Chọn nguồn">
          <option value="">— Chưa xác định —</option>
          @foreach (var s in Model.SourceCatalog) { <option value="@s">@s</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Trạng thái</label>
        <select name="Input.Status" class="form-select">
          <option value="1">Mới</option><option value="2">Đã liên hệ</option><option value="3">Tiềm năng</option>
          <option value="4">Đã chốt</option><option value="5">Thất bại</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">NV phụ trách</label>
        <select name="Input.AssignedToUserId" class="form-select tk-s2" data-placeholder="Chọn NV">
          <option value="">— Chưa gán —</option>
          @foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Chi nhánh</label>
        <select name="Input.BranchId" class="form-select tk-s2" data-placeholder="Chọn chi nhánh">
          <option value="">— Không —</option>
          @foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }
        </select>
      </div>

      @* Nhu cầu khách tự nêu. Trước đây KHÔNG có ô nào giữ thứ này, nên một khách tiềm năng chỉ
         còn tên với số điện thoại: người gọi lại phải hỏi lại từ đầu, và phần chấm điểm AI luôn
         kết luận "hồ sơ gần như trống" vì đúng là nó trống thật. *@
      <div class="mb-3">
        <label class="form-label">Nhu cầu khách nêu</label>
        <textarea name="Input.Note" class="form-control" rows="3"
                  placeholder="Khách cần gì: điểm đến, thời gian đi, số khách, ngân sách…"></textarea>
      </div>

      @* Nguồn CHI TIẾT. Ô "Nguồn" bên trên là giá trị CHUẨN lấy từ danh mục — chiều để gộp báo cáo,
         nên không cho gõ tự do. Còn ở đây là phần mở rộng tuỳ ý: dán nguyên đường dẫn chiến dịch
         (…?utm_source=zns&utm_medium=sms) là hệ thống tự tách, khỏi điền từng ô. *@
      <div class="mb-3">
        <label class="form-label">Nguồn chi tiết</label>
        <input type="text" name="Input.AttributionRaw" class="form-control"
               placeholder="Dán link có utm_source=… hoặc để trống" />
        <div class="form-text">Dán nguyên đường dẫn chiến dịch; hệ thống tự tách utm_source, utm_medium, utm_campaign…</div>
        <div id="lead-utm" class="small text-muted mt-2 d-none"></div>
      </div>
      @* Trao đổi nằm cùng cột SỬA: nó là việc người dùng GÕ VÀO, cùng loại thao tác với các ô trên,
         khác hẳn thẻ AI bên phải vốn chỉ để đọc.
         An toàn khi ở trong <form> vì luồng bình luận không tự dựng <form> và nút Gửi là
         type="button" — nó không kích hoạt form cha; textarea không có name nên cũng không bị
         gửi kèm khi lưu cơ hội. Id đổi theo từng cơ hội nên gắn lúc mở offcanvas (xem oc.open). *@
      <div id="lead-comments" class="tk-oc-comments d-none" data-comments data-entity="Lead"></div>
      </div>
      @* Cột phải: CHỈ trợ lý AI — thứ để đọc, không phải chỗ điền. *@
      <aside class="tk-oc-col tk-oc-aside">
        <div id="lead-review" class="tk-oc-comments d-none" data-ai-review data-entity="Lead"></div>
      </aside>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
  <script src="~/vendor/libs/jkanban/jkanban.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script src="~/js/tk-comments.js" asp-append-version="true"></script>
  <script>
    var oc, grid;
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    // Danh bạ nhân viên cho hộp xác nhận chuyển đổi — đổ sẵn từ server, không gọi thêm một vòng ajax.
    var NHAN_VIEN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Users.Select(u => new { id = u.Id, name = u.Name })));

    var FILTERS = ['status', 'source', 'assignedToUserId', 'createdByUserId', 'branchId', 'createdFrom', 'createdTo', 'campaignId'];

    // ---- Kanban (component CHUNG tk.kanban — CÙNG khuôn với màn Cơ hội bán hàng) ----
    // Mỗi cột = 1 trạng thái, chỉ tải TOP N của cột đó + nút "Tải thêm". KHÔNG get-all.
    var KB_STATUSES = [
      { id: 1, name: 'Mới', color: 'secondary' },
      { id: 2, name: 'Đã liên hệ', color: 'info' },
      { id: 3, name: 'Tiềm năng', color: 'warning' },
      { id: 4, name: 'Chốt', color: 'success' },
      { id: 5, name: 'Mất', color: 'danger' }
    ];
    var kb = null;

    function kbBuild() {
      kb = tk.kanban({
        pane: '#pane-kanban',
        columns: KB_STATUSES,
        moveUrl: '?handler=Move',
        url: function (colId, page, size) {
          var d = grid ? grid.filters() : {};
          var p = new URLSearchParams();
          Object.keys(d).forEach(function (k) { if (k !== 'status') { p.set(k, d[k]); } });   // cột tự quyết trạng thái
          p.set('status', colId); p.set('page', page); p.set('size', size);
          return '?handler=KanbanColumn&' + p.toString();
        },
        // Thẻ cùng khuôn Cơ hội: tiêu đề = tên · dòng phụ = SĐT · chân thẻ = nguồn + avatar NV.
        card: function (c) {
          return {
            title: c.fullName,
            meta: c.phone || '',
            foot: c.source || 'Chưa rõ nguồn',
            footIcon: 'ti ti-tag',
            who: c.assigneeName,
            badges: c.convertedCustomerId ? [{ text: 'Đã chuyển KH', color: 'success' }] : []
          };
        },
        onCardClick: function (row) { oc.open(row); },
        onMoved: function () { if (grid) { grid.reload(); } }
      });
      kb.render();
    }

    $(function () {
      var g = tk.g, esc = g.esc;

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      var ocForm = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'cơ hội',
        rules: { 'Input.FullName': { required: true } }, messages: { 'Input.FullName': { required: 'Bắt buộc nhập họ tên' } } });

      // Bọc tk.form để gắn luồng trao đổi theo ĐÚNG khách đang mở. Khách mới chưa có id nên
      // ẩn hẳn — không có gì để bình luận, và gắn vào id rỗng sẽ tạo một luồng mồ côi.
      oc = {
        open: function (row) {
          ocForm.open(row);
          var box = document.getElementById('lead-comments');
          var id = row && row.id;
          var review = document.getElementById('lead-review');
          box.classList.toggle('d-none', !id);
          review.classList.toggle('d-none', !id);
          if (id) {
            box.dataset.entityId = id;
            tk.comments.mount(box);
            review.dataset.entityId = id;
            if (window.tkAiReview) { window.tkAiReview.init(); }
          } else {
            // Xoá hẳn id cũ, đừng chỉ ẩn đi: để sót thì lần gắn sau (hoặc vòng quét lúc tải trang)
            // sẽ hiện trao đổi của cơ hội TRƯỚC ĐÓ trên form đang tạo mới.
            delete box.dataset.entityId;
            box.innerHTML = '';
            delete review.dataset.entityId;
            review.innerHTML = '';
          }
        }
      };

      // Đường dẫn sâu /co-hoi?mo={id}: mở thẳng cơ hội đó. Người bấm vào thông báo "@@nhắc bạn
      // trong Khách tiềm năng" phải thấy ngay đúng bản ghi, không phải tự dò trong 3.000 dòng.
      // Nạp riêng theo id chứ không tìm trong dữ liệu lưới — cơ hội cần mở hiếm khi ở trang đầu.
      var openId = new URLSearchParams(location.search).get('mo');
      if (openId) {
        fetch('?handler=One&id=' + encodeURIComponent(openId), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (row) {
            if (row) { oc.open(row); }
            else { tk.error('Không mở được cơ hội này — có thể đã bị xoá.'); }
          })
          .catch(function () { tk.error('Không mở được cơ hội này.'); });
      }

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá cơ hội?', text: r.fullName || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = r.id;
          f.submit();
        });
      }
      // Chuyển đổi hỏi luôn NGƯỜI PHỤ TRÁCH, mặc định là người đang giữ khách tiềm năng này.
      // Người phụ trách phải đi theo sang hồ sơ khách hàng, nhưng bàn giao thì phải do người bấm
      // nút quyết định — âm thầm gán thì đến lúc khách gọi lại không ai biết hỏi ai.
      function convertRow(r) {
        tk.confirmNguoiPhuTrach({
          title: 'Chuyển thành khách hàng?',
          text: 'Hệ thống sẽ tạo hồ sơ khách hàng từ khách tiềm năng này.',
          confirm: 'Chuyển',
          nguoi: NHAN_VIEN,
          macDinh: r.assignedToUserId || ''
        }).then(function (kq) {
          if (!kq.ok) { return; }
          var f = document.getElementById('convert-form');
          f.querySelector('[name="id"]').value = r.id;
          f.querySelector('[name="assignedToUserId"]').value = kq.nguoiId || '';
          f.submit();
        });
      }

      // Menu hành động theo nghiệp vụ Lead: sửa · chuyển thành khách (hoặc mở khách đã chuyển) · gọi/email · xoá.
      function actionsFor(r) {
        var items = [{ label: '<i class="ti ti-edit me-2"></i>Sửa cơ hội', action: function () { oc.open(r); } }];
        if (r.convertedCustomerId) {
          items.push({ label: '<i class="ti ti-user me-2"></i>Mở khách hàng đã chuyển', action: function () { window.location = '/khach-hang/' + r.convertedCustomerId; } });
        } else {
          items.push({ label: '<i class="ti ti-user-check me-2"></i>Chuyển thành khách hàng', action: function () { convertRow(r); } });
        }
        if (r.phone) { items.push({ label: '<i class="ti ti-phone me-2"></i>Gọi ' + esc(r.phone), action: function () { window.location = 'tel:' + String(r.phone).replace(/\s/g, ''); } }); }
        if (r.email) { items.push({ label: '<i class="ti ti-mail me-2"></i>Gửi email', action: function () { window.location = 'mailto:' + r.email; } }); }
        items.push({ separator: true });
        items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá cơ hội</span>', action: function () { delRow(r); } });
        return items;
      }

      grid = tk.grid('#grid-leads', {
        filters: FILTERS,
        exportName: 'co-hoi-da-chon.csv',
        actions: actionsFor,
        columns: [
          {
            title: 'Khách tiềm năng', field: 'fullName', widthGrow: 3, minWidth: 200,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-row-media">' + g.avatar(r.fullName) + g.stack(r.fullName, r.branchName) + '</div>';
            }
          },
          {
            title: 'Liên hệ', field: 'phone', widthGrow: 2, minWidth: 165,
            formatter: function (c) {
              var r = c.getData();
              if (!r.phone && !r.email) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-cell">' + g.icLine('ti ti-phone', r.phone, 'tk-cell-main') +
                g.icLine('ti ti-mail', r.email, 'tk-cell-sub') + '</div>';
            }
          },
          { title: 'Nguồn', field: 'source', widthGrow: 2, minWidth: 140,
            formatter: function (c) { return g.stack(c.getValue(), null); } },
          {
            title: 'Phụ trách', field: 'assigneeName', widthGrow: 2, minWidth: 160,
            formatter: function (c) {
              var v = c.getValue();
              if (!v) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-row-media">' + g.avatar(v, true) + g.stack(v, null) + '</div>';
            }
          },
          g.statusCol({
            field: 'status', title: 'Trạng thái', width: 160, hozAlign: 'center',
            handler: '?handler=SetStatus',
            options: [
              { v: 1, label: 'Mới', color: 'secondary' },
              { v: 2, label: 'Đã liên hệ', color: 'warning' },
              { v: 3, label: 'Tiềm năng', color: 'info' },
              { v: 4, label: 'Đã chốt', color: 'success' },
              { v: 5, label: 'Thất bại', color: 'danger', confirm: 'Đổi sang "Thất bại"?' }
            ],
            // Phễu Lead: Mới→Đã liên hệ/Thất bại→Tiềm năng→Đã chốt (chốt là ngõ cụt, chuyển KH là
            // hành động riêng ở menu dòng); Thất bại mở lại được về Mới.
            allowed: function (r) {
              return ({ 1: [2, 5], 2: [3, 5], 3: [4, 5], 4: [], 5: [1] })[r.status] || [];
            },
            sub: function (r) { return r.convertedCustomerId ? 'Đã chuyển KH' : null; }
          })
        ]
      });

      // Khung Kanban không dùng lưới nên tk.grid không tự làm tươi được — bắt cùng những
      // ô lọc đó để vẽ lại bảng kanban khi nó đang hiện.
      function kbRefreshIfVisible() { if (kb && !$('#pane-kanban').hasClass('d-none')) { kb.render(); } }
      $('#btn-search, #btn-reset').on('click', function () { setTimeout(kbRefreshIfVisible, 50); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { setTimeout(kbRefreshIfVisible, 50); } });
      $('#f-status, #f-source, #f-assignedToUserId, #f-createdByUserId, #f-branchId, #f-createdFrom, #f-createdTo')
        .on('change', function () { setTimeout(kbRefreshIfVisible, 50); });

      // Chuyển khung Bảng ↔ Kanban (kanban chỉ tải khi mở lần đầu).
      // CHỈ ẩn phần bảng — dải thống kê và thanh lọc phải còn đó vì kanban cũng dùng chung bộ lọc.
      $('#view-list').on('click', function () {
        $('#pane-kanban').addClass('d-none'); $('#grid-leads').removeClass('d-none');
        $(this).addClass('active'); $('#view-kanban').removeClass('active');
        grid.table.redraw(true);
      });
      $('#view-kanban').on('click', function () {
        $('#grid-leads').addClass('d-none'); $('#pane-kanban').removeClass('d-none');
        $(this).addClass('active'); $('#view-list').removeClass('active');
        // Vẽ lại mỗi lần mở: bộ lọc có thể đã đổi lúc đang ở khung Bảng, refit() giữ nguyên dữ
        // liệu cũ nên kanban sẽ nói dối so với thanh lọc đang hiện.
        if (!kb) { kbBuild(); } else { kb.render(); }
      });

      // "Xuất file" mở POPUP CHUNG (tk.exportDialog): chọn số dòng xuất theo bộ lọc đang áp.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var f = grid.filters(); var q = $('#f-q').val(); if (q) { f.search = q; }
        tk.exportDialog({
          url: '?handler=Export', filters: f, filteredTotal: grid.filteredTotal(),
          pageSize: grid.table.getPageSize(), max: 20000
        });
      });
    });
  </script>
}
