@page
@model TourKit.Api.Pages.CommissionConfig.IndexModel
@{ ViewData["Title"] = "Thiết lập hoa hồng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Cấu hình hoa hồng</h4>
  <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm quy tắc</button>
</div>

@{
    // 4 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng quy tắc", Model.Stats.Total.ToString("#,##0"), "ti ti-percentage", "primary"),
        ("Đang áp dụng", Model.Stats.Active.ToString("#,##0"), "ti ti-check", "success"),
        ("Tạm ngừng", Model.Stats.Inactive.ToString("#,##0"), "ti ti-player-pause", "secondary"),
        ("Tỉ lệ TB", Model.Stats.AvgPercentage.ToString("0.##") + "%", "ti ti-chart-bar", "info"),
    };
}

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — đủ tiêu chí CommissionRuleListFilter (Q · UserId · Status), đẩy hết xuống service. *@
  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Tên nhân viên…" /></div>
      <div class="col-md-4">
        <select id="f-userId" class="form-select tk-s2f" data-placeholder="Nhân viên">
          <option value=""></option>
          @foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Trạng thái (Segmented hệ cũ) — chuyển sang chip lọc nhanh chuẩn của tk.grid *@
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
      <span class="text-muted small fw-medium" style="min-width:110px">Trạng thái</span>
      <input type="hidden" id="f-status" value="" />
      <button type="button" class="btn btn-sm btn-primary tk-chip" data-k="status" data-v="">Tất cả <span class="badge bg-white text-dark ms-1">@Model.Stats.Total.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="1">Đang áp dụng <span class="badge bg-secondary ms-1">@Model.Stats.Active.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="0">Tạm ngừng <span class="badge bg-secondary ms-1">@Model.Stats.Inactive.ToString("#,##0")</span></button>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2">
    <span class="fw-medium"><span id="bulk-count">0</span> quy tắc đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-commission-config"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">quy tắc hoa hồng</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3">
        <label class="form-label">Nhân viên <span class="text-danger">*</span></label>
        <select name="Input.UserId" class="form-select tk-s2" data-placeholder="Chọn nhân viên">
          <option value=""></option>
          @foreach (var u in Model.Users)
          {
            <option value="@u.Id">@u.Name</option>
          }
        </select>
        <small class="text-muted">Không đổi được nhân viên khi sửa quy tắc đã có.</small>
      </div>
      <div class="mb-3"><label class="form-label">% hoa hồng <span class="text-danger">*</span></label><input type="number" step="any" min="0" name="Input.Percentage" class="form-control" placeholder="Nhập % hoa hồng" /></div>
      <div class="mb-3">
        <label class="form-label">Trạng thái</label>
        <select name="Input.Status" class="form-select"><option value="1">Đang áp dụng</option><option value="0">Tạm ngừng</option></select>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;

    $(function () {
      var g = tk.g, esc = g.esc;
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'quy tắc hoa hồng',
        rules: { 'Input.UserId': { required: true }, 'Input.Percentage': { required: true, number: true, min: 0 } },
        messages: { 'Input.UserId': { required: 'Bắt buộc chọn nhân viên' }, 'Input.Percentage': { required: 'Bắt buộc nhập %' } },
        // Sửa: UpdateCommissionRuleDto không nhận UserId → khoá ô nhân viên.
        afterOpen: function (data) { $('#frm [name="Input.UserId"]').prop('disabled', !!data).trigger('change.select2'); }
      });

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá quy tắc hoa hồng?', text: r.userName || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = r.id;
          f.submit();
        });
      }

      // Server-side: mỗi lần chỉ tải 1 trang (không get-all).
      grid = tk.grid('#grid-commission-config', {
        filters: ['userId', 'status'],
        chipGroups: ['status'],
        exportName: 'quy-tac-hoa-hong.csv',
        actions: function (r) {
          return [
            { label: '<i class="ti ti-edit me-2"></i>Sửa quy tắc', action: function () { oc.open(r); } },
            { separator: true },
            { label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá quy tắc</span>', action: function () { delRow(r); } }
          ];
        },
        columns: [
          { title: 'Nhân viên', field: 'userName', widthGrow: 5, minWidth: 260, formatter: 'tkMedia' },
          {
            title: 'Tỉ lệ (%)', field: 'percentage', width: 140, hozAlign: 'right', headerHozAlign: 'right',
            formatter: function (c) {
              var v = (Number(c.getValue()) || 0).toLocaleString('vi-VN', { maximumFractionDigits: 2 });
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + v + '%</div></div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 150,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });
    });
  </script>
}
