@page
@model TourKit.Api.Pages.Orders.IndexModel
@{ ViewData["Title"] = "Đơn hàng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

<div class="row g-4 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body">
      <div class="d-flex justify-content-between"><div><p class="mb-1 text-muted">Tổng đơn</p><h4 class="mb-0">@Model.Stats.Total</h4></div><span class="badge bg-label-primary rounded p-2"><i class="ti ti-shopping-cart ti-md"></i></span></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body">
      <div class="d-flex justify-content-between"><div><p class="mb-1 text-muted">Doanh thu</p><h4 class="mb-0">@Model.Stats.TotalRevenue.ToString("#,##0")</h4></div><span class="badge bg-label-success rounded p-2"><i class="ti ti-cash ti-md"></i></span></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body">
      <div class="d-flex justify-content-between"><div><p class="mb-1 text-muted">Đã thu</p><h4 class="mb-0">@Model.Stats.TotalPaid.ToString("#,##0")</h4></div><span class="badge bg-label-info rounded p-2"><i class="ti ti-wallet ti-md"></i></span></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card"><div class="card-body">
      <div class="d-flex justify-content-between"><div><p class="mb-1 text-muted">Còn nợ</p><h4 class="mb-0 text-danger">@Model.Stats.TotalOutstanding.ToString("#,##0")</h4></div><span class="badge bg-label-danger rounded p-2"><i class="ti ti-alert-triangle ti-md"></i></span></div>
    </div></div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <h5 class="mb-0">Danh sách đơn hàng — @Model.TypeLabel</h5>
    <select id="f-status" class="form-select form-select-sm" style="width:auto">
      <option value="">Tất cả trạng thái</option>
      <option value="1">Nháp/Giữ chỗ</option>
      <option value="2">Đã xác nhận</option>
      <option value="3">Đã huỷ</option>
      <option value="4">Đã tất toán</option>
    </select>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Tour</th><th>Ngày đi</th><th class="text-end">Doanh thu</th><th class="text-end">Đã thu</th><th class="text-end">Còn nợ</th><th class="text-center">Khách</th><th>Sales</th><th>Trạng thái</th></tr></thead>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () {
      // Server-side: mỗi lần chỉ tải 1 trang (không get-all).
      var dt = tk.table('#tbl', {
        url: '?handler=Data@(Model.BookingType is int bt ? "&bookingType=" + bt : "")',
        extraData: function (d) { d.status = $('#f-status').val(); },
        columns: [
          { data: 'code', render: function (v, t, r) { return '<a href="/Orders/Detail/' + r.id + '" class="fw-medium">' + tk.escape(v) + '</a>'; } },
          { data: 'customerName', render: function (v) { return tk.trunc(v, 180); } },
          { data: 'tourTitle', render: function (v) { return tk.trunc(v, 200); } },
          { data: 'departureDate' },
          { data: 'totalRevenue', className: 'text-end', render: function (v) { return tk.money(v); } },
          { data: 'amountPaid', className: 'text-end', render: function (v) { return tk.money(v); } },
          { data: 'outstanding', className: 'text-end', render: function (v) { return v > 0 ? '<span class="text-danger">' + tk.money(v) + '</span>' : tk.money(v); } },
          { data: 'seats', className: 'text-center' },
          { data: 'salesName' },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } }
        ]
      });
      $('#f-status').on('change', function () { dt.ajax.reload(); });
    });
  </script>
}
