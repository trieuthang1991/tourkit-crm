@page
@model TourKit.Api.Pages.Orders.IndexModel
@{ ViewData["Title"] = "Đơn hàng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Đơn hàng — @Model.TypeLabel</h4>
  <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
</div>

@* 6 KPI — bám thẻ thống kê hệ cũ *@
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng số đơn</small><h5 class="mb-0">@Model.Stats.Total.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Doanh thu</small><h5 class="mb-0">@Model.Stats.TotalRevenue.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã thu</small><h5 class="mb-0 text-success">@Model.Stats.TotalPaid.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Còn nợ</small><h5 class="mb-0 text-danger">@Model.Stats.TotalOutstanding.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã chốt</small><h5 class="mb-0">@Model.Stats.Confirmed.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã huỷ</small><h5 class="mb-0">@Model.Stats.Cancelled.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — 4 lọc nhanh + panel nâng cao giữ đủ 17 tiêu chí như hệ cũ *@
<div class="card mb-4">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã, tên tour, SĐT, tên khách…" /></div>
      <div class="col-md-2">
        <select id="f-status" class="form-select"><option value="">Tình trạng đơn</option><option value="1">Nháp/Giữ chỗ</option><option value="2">Đã xác nhận</option><option value="3">Đã huỷ</option><option value="4">Đã tất toán</option></select>
      </div>
      <div class="col-md-2">
        <select id="f-salesUserId" class="form-select tk-s2f" data-placeholder="NV phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-branchId" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
    @* Nút mở lọc nâng cao có NHÃN + badge đếm số lọc đang bật — trước đây chỉ là icon trơn nên
       người dùng không biết thị trường/nhóm/CTV… nằm trong đó. *@
    <div class="mt-2">
      <button type="button" class="btn btn-sm btn-label-primary" id="btn-adv">
        <i class="ti ti-adjustments-horizontal me-1"></i> Lọc nâng cao
        <span class="badge bg-primary ms-1 d-none" id="adv-count">0</span>
        <i class="ti ti-chevron-down ms-1" id="adv-caret"></i>
      </button>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><label class="form-label small mb-1">Ngày tạo từ</label><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="dd/mm/yyyy" /></div>
      <div class="col-md-3"><label class="form-label small mb-1">đến</label><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="dd/mm/yyyy" /></div>
      <div class="col-md-3"><label class="form-label small mb-1">Ngày khởi hành từ</label><input type="text" id="f-departureFrom" class="form-control tk-datef" placeholder="dd/mm/yyyy" /></div>
      <div class="col-md-3"><label class="form-label small mb-1">đến</label><input type="text" id="f-departureTo" class="form-control tk-datef" placeholder="dd/mm/yyyy" /></div>

      <div class="col-md-3"><label class="form-label small mb-1">Người tạo</label><select id="f-createdByUserId" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
      <div class="col-md-3"><label class="form-label small mb-1">Phòng ban</label><select id="f-departmentId" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }</select></div>
      <div class="col-md-3"><label class="form-label small mb-1">Loại hình</label><select id="f-tourType" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var t in Model.Options.TourTypes) { <option value="@t">@t</option> }</select></div>
      <div class="col-md-3"><label class="form-label small mb-1">Nhà cung cấp</label><select id="f-providerId" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var p in Model.Options.Providers) { <option value="@p.Id">@p.Name</option> }</select></div>

      <div class="col-md-3"><label class="form-label small mb-1">Loại tour</label>
        <select id="f-bookingType" class="form-select"><option value="">Tất cả</option>
          @for (var i = 0; i < TourKit.Api.Pages.Orders.IndexModel.BookingTypeLabels.Length; i++)
          {
            <option value="@i" selected="@(Model.BookingType == i)">@TourKit.Api.Pages.Orders.IndexModel.BookingTypeLabels[i]</option>
          }
        </select>
      </div>
      <div class="col-md-3"><label class="form-label small mb-1">Thị trường</label><select id="f-marketTypeId" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var m in Model.Markets) { <option value="@m.Id">@m.Name</option> }</select></div>
      <div class="col-md-3"><label class="form-label small mb-1">Nhóm</label><select id="f-tourGroupId" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var g in Model.Groups) { <option value="@g.Id">@g.Name</option> }</select></div>
      <div class="col-md-3"><label class="form-label small mb-1">CTV</label><select id="f-collaboratorId" class="form-select tk-s2f" data-placeholder="Tất cả"><option value=""></option>@foreach (var c in Model.Options.Collaborators) { <option value="@c.Id">@c.Name</option> }</select></div>

      <div class="col-md-3"><label class="form-label small mb-1">TT thanh toán</label><select id="f-paymentStatus" class="form-select"><option value="">Tất cả</option><option value="0">Chưa thanh toán</option><option value="1">Đã cọc</option><option value="2">Thanh toán đủ</option></select></div>
      <div class="col-md-3"><label class="form-label small mb-1">TT hoa hồng</label><select id="f-commissionSettled" class="form-select"><option value="">Tất cả</option><option value="true">Đã quyết</option><option value="false">Chưa quyết</option></select></div>
      <div class="col-md-3"><label class="form-label small mb-1">Tình trạng vận hành</label><select id="f-operationalStatus" class="form-select"><option value="">Tất cả</option><option value="0">Sắp chạy</option><option value="1">Đang chạy</option><option value="2">Hoàn thành</option><option value="3">Đã huỷ</option></select></div>
      <div class="col-md-3"><label class="form-label small mb-1">TT hoá đơn</label><select id="f-invoiceStatus" class="form-select"><option value="">Tất cả</option><option value="0">Chưa xuất</option><option value="1">Đã xuất</option></select></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          @* min-width cho từng cột: bảng nằm trong .table-responsive nên màn hẹp sẽ CUỘN NGANG
             thay vì bóp các cột lại đến mức chữ xuống dòng lem nhem. *@
          <th class="text-center" style="min-width:52px">#</th>
          <th style="min-width:130px">Mã đơn</th>
          <th style="min-width:190px">Khách hàng</th>
          <th style="min-width:240px">Tour</th>
          <th class="text-center" style="min-width:110px">Khách (chỗ)</th>
          <th style="min-width:120px">Ngày đi</th>
          <th class="text-end" style="min-width:130px">Thu tiền</th>
          <th class="text-end" style="min-width:130px">Chi tiền</th>
          <th class="text-end" style="min-width:130px">Lợi nhuận</th>
          <th style="min-width:130px">Sales</th>
          <th style="min-width:150px">Trạng thái</th>
          <th style="min-width:56px"></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="12" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@section PageScripts {
  <script>
    var dt;
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    var FILTERS = ['status', 'salesUserId', 'branchId', 'createdFrom', 'createdTo', 'departureFrom', 'departureTo',
      'createdByUserId', 'departmentId', 'tourType', 'providerId', 'bookingType', 'marketTypeId', 'tourGroupId',
      'collaboratorId', 'paymentStatus', 'commissionSettled', 'operationalStatus', 'invoiceStatus'];

    // Trả object phẳng {tênLọc: giá trị} — dùng chung cho ajax DataTables và link export.
    function filterValues() {
      var o = {};
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { o[k] = v; } });
      return o;
    }
    function collectFilters(d) {
      var o = filterValues();
      Object.keys(o).forEach(function (k) { d[k] = o[k]; });
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: 'code', render: function (v, t, r) { return '<a href="/don-hang/' + r.id + '" class="fw-medium">' + tk.escape(v) + '</a>'; } },
          { data: 'customerName', render: function (v) { return tk.trunc(v, 170); } },
          { data: 'tourTitle', render: function (v) { return tk.trunc(v, 210); } },
          { data: null, className: 'text-center', render: function (r) {
              // Tổng · giữ chỗ · đã bán · còn lại (bám SeatTags hệ cũ)
              return '<span class="badge bg-label-secondary me-1" title="Tổng">' + r.seatTotal + '</span>' +
                     '<span class="badge bg-label-warning me-1" title="Giữ chỗ">' + r.seatHeld + '</span>' +
                     '<span class="badge bg-label-success me-1" title="Đã bán">' + r.seatSold + '</span>' +
                     '<span class="badge bg-label-info" title="Còn lại">' + r.seatRemaining + '</span>';
            } },
          { data: 'departureDate' },
          { data: null, className: 'text-end', render: function (r) {
              return '<div title="Tổng thu">' + tk.money(r.totalRevenue) + '</div>' +
                     '<div class="small text-success" title="Thực thu">' + tk.money(r.amountPaid) + '</div>';
            } },
          { data: null, className: 'text-end', render: function (r) {
              return '<div title="Tổng chi">' + tk.money(r.totalCost) + '</div>' +
                     '<div class="small text-danger" title="Thực chi">' + tk.money(r.actualCost) + '</div>';
            } },
          { data: 'profit', className: 'text-end', render: function (v) {
              return '<span class="fw-medium ' + (v < 0 ? 'text-danger' : 'text-success') + '">' + tk.money(v) + '</span>';
            } },
          { data: 'salesName' },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, className: 'text-center', render: function (r) { return '<a href="/don-hang/' + r.id + '" class="text-muted" title="Chi tiết"><i class="ti ti-chevron-right"></i></a>'; } }
        ]
      });

      // tk.table không nhận drawCallback → gắn sau qua sự kiện xhr.
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.pageSum;
        if (!s) { return; }
        var parts = [['Tổng thu', s.revenue, ''], ['Thực thu', s.paid, 'text-success'], ['Tổng chi', s.cost, ''],
                     ['Thực chi', s.actualCost, 'text-danger'], ['Lợi nhuận', s.profit, s.profit < 0 ? 'text-danger' : 'text-success'],
                     ['Phải thu', s.outstanding, '']];
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' + parts.map(function (p) {
          return '<span class="me-3 text-muted">' + p[0] + ': <span class="fw-medium ' + p[2] + '">' + tk.money(p[1]) + '</span></span>';
        }).join(''));
      });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { dt.ajax.reload(); } });
      $('#f-status, #f-bookingType, #f-paymentStatus, #f-commissionSettled, #f-operationalStatus, #f-invoiceStatus').on('change', function () { dt.ajax.reload(); });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      tk.advFilter();   // nút "Lọc nâng cao" có nhãn + badge đếm + tự mở khi có lọc (dùng chung tk.js)
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('.tk-datef').each(function () { if (this._flatpickr) { this._flatpickr.clear(); } });
        dt.ajax.reload();
      });
      $('#btn-export').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(filterValues());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
