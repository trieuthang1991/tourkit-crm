@page
@model TourKit.Api.Pages.Orders.IndexModel
@{ ViewData["Title"] = "Đơn hàng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Đơn hàng — @Model.TypeLabel</h4>
  <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
</div>

@* 6 KPI — bám thẻ thống kê hệ cũ *@
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng số đơn</small><h5 class="mb-0 tk-num">@Model.Stats.Total.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Doanh thu</small><h5 class="mb-0 tk-num">@Model.Stats.TotalRevenue.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã thu</small><h5 class="mb-0 text-success tk-num">@Model.Stats.TotalPaid.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Còn nợ</small><h5 class="mb-0 text-danger tk-num">@Model.Stats.TotalOutstanding.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã chốt</small><h5 class="mb-0 tk-num">@Model.Stats.Confirmed.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-md-4 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã huỷ</small><h5 class="mb-0 tk-num">@Model.Stats.Cancelled.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — 4 lọc nhanh + panel nâng cao giữ đủ 17 tiêu chí như hệ cũ *@
<div class="card mb-4">
  <div class="card-body">
    @* Hàng lọc CHÍNH — bám staging /all-orders: Nguồn KH · Loại KH · Người tạo · Chi nhánh (Nhóm KH: model chưa có → bỏ, không bịa) + Tình trạng/NV *@
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã, tên tour, SĐT, tên khách…" /></div>
      <div class="col-md-2"><select id="f-customerSource" class="form-select tk-s2f" data-placeholder="Nguồn khách"><option value=""></option>@foreach (var s in Model.Sources) { <option value="@s">@s</option> }</select></div>
      <div class="col-md-2"><select id="f-customerType" class="form-select"><option value="">Loại khách</option><option value="0">Khách lẻ</option><option value="1">Doanh nghiệp</option><option value="2">Đối tác</option><option value="3">CTV</option></select></div>
      <div class="col-md-2"><select id="f-createdByUserId" class="form-select tk-s2f" data-placeholder="Người tạo"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
      <div class="col-md-2"><select id="f-branchId" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
    </div>
    <div class="row g-2 align-items-center mt-2">
      <div class="col-md-2"><select id="f-status" class="form-select"><option value="">Tình trạng đơn</option><option value="1">Nháp/Giữ chỗ</option><option value="2">Đã xác nhận</option><option value="3">Đã huỷ</option><option value="4">Đã tất toán</option></select></div>
      <div class="col-md-3"><select id="f-salesUserId" class="form-select tk-s2f" data-placeholder="NV phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
      <div class="col-auto ms-auto d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-sm btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @if (Model.IsVisa)
    {
      <div class="row g-2 mt-2">
        <div class="col-md-3"><select id="f-visaStatus" class="form-select"><option value="">Tất cả trạng thái Visa</option><option value="0">Tạo mới</option><option value="1">Đã tiếp nhận</option><option value="2">Đang xử lý</option><option value="3">Đã nộp</option><option value="4">Yêu cầu bổ sung</option><option value="5">Chờ kết quả</option><option value="6">Đậu</option><option value="7">Rớt</option><option value="8">Rút hồ sơ</option><option value="9">Hủy hồ sơ</option><option value="10">Hoàn tất dịch vụ</option></select></div>
      </div>
    }

    @* Lọc nâng cao — placeholder-only, KHÔNG label (đồng nhất toàn thanh lọc). *@
    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="Ngày tạo từ" /></div>
      <div class="col-md-3"><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="Ngày tạo đến" /></div>
      <div class="col-md-3"><input type="text" id="f-departureFrom" class="form-control tk-datef" placeholder="Ngày khởi hành từ" /></div>
      <div class="col-md-3"><input type="text" id="f-departureTo" class="form-control tk-datef" placeholder="Ngày khởi hành đến" /></div>

      <div class="col-md-3"><select id="f-departmentId" class="form-select tk-s2f" data-placeholder="Phòng ban"><option value=""></option>@foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-tourType" class="form-select tk-s2f" data-placeholder="Loại hình"><option value=""></option>@foreach (var t in Model.Options.TourTypes) { <option value="@t">@t</option> }</select></div>
      <div class="col-md-3"><select id="f-providerId" class="form-select tk-s2f" data-placeholder="Nhà cung cấp"><option value=""></option>@foreach (var p in Model.Options.Providers) { <option value="@p.Id">@p.Name</option> }</select></div>

      <div class="col-md-3">
        <select id="f-bookingType" class="form-select"><option value="">Loại tour</option>
          @for (var i = 0; i < TourKit.Api.Pages.Orders.IndexModel.BookingTypeLabels.Length; i++)
          {
            <option value="@i" selected="@(Model.BookingType == i)">@TourKit.Api.Pages.Orders.IndexModel.BookingTypeLabels[i]</option>
          }
        </select>
      </div>
      <div class="col-md-3"><select id="f-marketTypeId" class="form-select tk-s2f" data-placeholder="Thị trường"><option value=""></option>@foreach (var m in Model.Markets) { <option value="@m.Id">@m.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-tourGroupId" class="form-select tk-s2f" data-placeholder="Nhóm tour"><option value=""></option>@foreach (var g in Model.Groups) { <option value="@g.Id">@g.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-collaboratorId" class="form-select tk-s2f" data-placeholder="CTV"><option value=""></option>@foreach (var c in Model.Options.Collaborators) { <option value="@c.Id">@c.Name</option> }</select></div>
      @* Nguồn khách / Loại khách / Người tạo đã lên hàng lọc CHÍNH (bám staging) — không lặp ở đây. Nhóm KH: model chưa có. *@
      <div class="col-md-3"><select id="f-paymentStatus" class="form-select"><option value="">TT thanh toán</option><option value="0">Chưa thanh toán</option><option value="1">Đã cọc</option><option value="2">Thanh toán đủ</option></select></div>
      <div class="col-md-3"><select id="f-commissionSettled" class="form-select"><option value="">TT hoa hồng</option><option value="true">Đã quyết</option><option value="false">Chưa quyết</option></select></div>
      <div class="col-md-3"><select id="f-operationalStatus" class="form-select"><option value="">Tình trạng vận hành</option><option value="1">Sắp chạy</option><option value="8">Kích hoạt giá</option><option value="2">Đang chạy</option><option value="3">Chưa quyết toán</option><option value="4">Đã quyết toán</option><option value="5">Hoàn thành</option><option value="6">Hủy</option><option value="7">Hủy không đi</option></select></div>
      <div class="col-md-3"><select id="f-invoiceStatus" class="form-select"><option value="">TT hoá đơn</option><option value="0">Chưa xuất</option><option value="1">Đã xuất</option></select></div>
    </div>
  </div>
</div>

@* Chip lọc nhanh theo Thị trường (bám staging "Lọc nhanh theo thị trường / nhóm tour") — điều khiển #f-marketTypeId *@
@if (Model.Markets.Count > 0)
{
  <div class="card mb-4"><div class="card-body d-flex flex-wrap align-items-center gap-2">
    <span class="text-muted small fw-medium me-1"><i class="ti ti-map-pin me-1"></i>Lọc nhanh theo thị trường</span>
    <button type="button" class="btn btn-sm btn-primary tk-market-chip" data-market="">Tất cả</button>
    @foreach (var m in Model.Markets)
    {
      <button type="button" class="btn btn-sm btn-label-secondary tk-market-chip" data-market="@m.Id">@m.Name</button>
    }
  </div></div>
}

@* Tab trạng thái thanh toán (bám staging: Tất cả / Chưa TT / Đã cọc / TT hết) — điều khiển #f-paymentStatus *@
<ul class="nav nav-tabs mb-3" id="pay-tabs">
  <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-pay="">Tất cả <span class="badge bg-label-secondary ms-1">@Model.Stats.Total.ToString("#,##0")</span></a></li>
  <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-pay="0">Chưa thanh toán <span class="badge bg-label-warning ms-1">@Model.Stats.Unpaid.ToString("#,##0")</span></a></li>
  <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-pay="1">Đã cọc <span class="badge bg-label-info ms-1">@Model.Stats.Deposit.ToString("#,##0")</span></a></li>
  <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-pay="2">Thanh toán hết <span class="badge bg-label-success ms-1">@Model.Stats.Paid.ToString("#,##0")</span></a></li>
</ul>

<div class="card">
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          @* min-width cho từng cột: bảng nằm trong .table-responsive nên màn hẹp sẽ CUỘN NGANG
             thay vì bóp các cột lại đến mức chữ xuống dòng lem nhem. *@
          <th class="text-center" style="min-width:52px">#</th>
          <th style="min-width:130px">Mã đơn</th>
          <th style="min-width:190px">Khách hàng</th>
          <th style="min-width:240px">@(Model.IsVisa ? "Nội dung đơn" : "Tour")</th>
          <th class="text-center" style="min-width:110px">Khách (chỗ)</th>
          <th style="min-width:120px">Ngày đi</th>
          <th class="text-end" style="min-width:130px">Thu tiền</th>
          <th class="text-end" style="min-width:130px">Chi tiền</th>
          <th class="text-end" style="min-width:130px">Lợi nhuận</th>
          <th style="min-width:110px">Ngày nhận</th>
          <th style="min-width:120px">Ngày nộp/lăn tay</th>
          <th style="min-width:110px">Ngày trả</th>
          <th class="text-center" style="min-width:90px">TG xét duyệt</th>
          <th style="min-width:130px">Sales</th>
          <th style="min-width:150px">Trạng thái</th>
          <th style="min-width:56px"></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="16" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

@Html.AntiForgeryToken()

@* Offcanvas XEM NHANH đơn (bám ý "view = popup") *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="oc-view" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title" id="ov-title">Đơn hàng</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <dl class="row mb-0">
      <dt class="col-5 text-muted">Khách hàng</dt><dd class="col-7" id="ov-cust">—</dd>
      <dt class="col-5 text-muted">Nội dung / Tour</dt><dd class="col-7" id="ov-tour">—</dd>
      <dt class="col-5 text-muted">Trạng thái</dt><dd class="col-7" id="ov-status">—</dd>
      <dt class="col-5 text-muted">Tổng thu</dt><dd class="col-7 text-heading" id="ov-rev">—</dd>
      <dt class="col-5 text-muted">Đã thu</dt><dd class="col-7 text-success" id="ov-paid">—</dd>
      <dt class="col-5 text-muted">Còn nợ</dt><dd class="col-7 text-danger" id="ov-out">—</dd>
      <dt class="col-5 text-muted">Lợi nhuận</dt><dd class="col-7" id="ov-profit">—</dd>
    </dl>
    <div class="d-flex gap-2 mt-3">
      <button type="button" class="btn btn-sm btn-primary flex-fill" id="ov-receipt"><i class="ti ti-cash me-1"></i> Phiếu thu</button>
      <button type="button" class="btn btn-sm btn-label-secondary flex-fill" id="ov-payment"><i class="ti ti-file-invoice me-1"></i> Phiếu chi</button>
      <a class="btn btn-sm btn-label-secondary" id="ov-detail"><i class="ti ti-external-link"></i></a>
    </div>
  </div>
</div>

@* Offcanvas TẠO PHIẾU (thu/chi) — dùng chung, đổi tiêu đề + handler theo loại *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="oc-phieu" style="width:460px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title" id="op-title">Tạo phiếu</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <div class="mb-2 small text-muted" id="op-order">Đơn: —</div>
    <div class="mb-3"><label class="form-label">Số tiền <span class="text-danger">*</span></label><input type="number" id="op-amount" class="form-control" min="0" step="1000" /></div>
    <div class="mb-3"><label class="form-label">Phương thức</label>
      <select id="op-method" class="form-select"><option value="cash">Tiền mặt</option><option value="bank">Chuyển khoản</option><option value="momo">MoMo</option><option value="vnpay">VNPay</option></select>
    </div>
    <div class="mb-3" id="op-receiver-wrap"><label class="form-label">Người nhận</label><input type="text" id="op-receiver" class="form-control" placeholder="Tên người nhận (phiếu chi)" /></div>
    <div class="mb-3"><label class="form-label">Ghi chú</label><textarea id="op-note" class="form-control" rows="2"></textarea></div>
    <button type="button" class="btn btn-primary" id="op-save">Lưu phiếu</button>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@section PageScripts {
  <script>
    var dt;

    // ================= Trạng thái đổi TRÊN DÒNG (bám staging) — bộ trạng thái theo LOẠI đơn =================
    // Tour (vận hành): value = OrderOperationalStatus. Visa: 0..10 (11 bước). Booking/Dịch vụ/Xe: vòng đời thô.
    var OP_LABELS = { 1: ['Sắp chạy', 'secondary'], 8: ['Kích hoạt giá', 'info'], 2: ['Đang chạy', 'primary'], 3: ['Chưa quyết toán', 'warning'], 4: ['Đã quyết toán', 'success'], 5: ['Hoàn thành', 'success'], 6: ['Hủy', 'danger'], 7: ['Hủy không đi', 'danger'] };
    function opOptsFor(bt) { return bt === 1 ? [1, 2, 3, 4, 5, 6, 7] : [1, 8, 2, 3, 4, 5, 6]; }   // GIT có "Hủy không đi"; FIT/LandTour có "Kích hoạt giá"
    var VISA_LABELS = ['Tạo mới', 'Đã tiếp nhận', 'Đang xử lý', 'Đã nộp', 'Yêu cầu bổ sung', 'Chờ kết quả', 'Đậu', 'Rớt', 'Rút hồ sơ', 'Hủy hồ sơ', 'Hoàn tất dịch vụ'];
    var VISA_COLORS = ['secondary', 'info', 'primary', 'primary', 'warning', 'info', 'success', 'danger', 'warning', 'danger', 'success'];

    function statusDropdown(current, options, handler, id) {
      // options: [{v,label,color}] — badge hiện tại làm nút mở, menu là các trạng thái chọn được.
      var cur = null; for (var i = 0; i < options.length; i++) { if (options[i].v === current) { cur = options[i]; break; } }
      if (!cur) { cur = { label: '—', color: 'secondary' }; }
      var menu = options.map(function (o) {
        return '<li><a class="dropdown-item js-setstatus' + (o.v === current ? ' active' : '') + '" href="javascript:void(0)" data-id="' + id + '" data-handler="' + handler + '" data-status="' + o.v + '"><span class="badge bg-label-' + o.color + '">' + tk.escape(o.label) + '</span></a></li>';
      }).join('');
      return '<div class="dropdown">' +
        '<a href="javascript:void(0)" class="text-decoration-none" data-bs-toggle="dropdown" data-bs-boundary="viewport" title="Đổi trạng thái">' +
          '<span class="badge bg-label-' + cur.color + '">' + tk.escape(cur.label) + '</span> <i class="ti ti-chevron-down text-muted"></i></a>' +
        '<ul class="dropdown-menu">' + menu + '</ul></div>';
    }

    function statusCell(r) {
      var bt = r.bookingType;
      if (bt === 5) {   // Visa: 11 bước
        var vopts = VISA_LABELS.map(function (l, i) { return { v: i, label: l, color: VISA_COLORS[i] }; });
        return statusDropdown(r.visaStatus, vopts, 'VisaStatus', r.id);
      }
      if (bt === 0 || bt === 1 || bt === 2) {   // Tour FIT/GIT/LandTour: tình trạng vận hành
        var oopts = opOptsFor(bt).map(function (v) { return { v: v, label: OP_LABELS[v][0], color: OP_LABELS[v][1] }; });
        return statusDropdown(r.opStatus, oopts, 'OpStatus', r.id);
      }
      return coarseStatusCell(r);   // Booking phòng/Dịch vụ/Xe: vòng đời thô.
    }

    function coarseStatusCell(r) {
      var badge = '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>';
      var items = [];
      if (r.status === 1) { items.push(['confirm', 'ti-check', 'Xác nhận đơn', '']); items.push(['cancel', 'ti-x', 'Huỷ đơn', 'text-danger']); }
      else if (r.status === 2) { items.push(['close', 'ti-lock', 'Tất toán đơn', '']); items.push(['cancel', 'ti-x', 'Huỷ đơn', 'text-danger']); }
      else if (r.status === 4) { items.push(['reopen', 'ti-lock-open', 'Mở lại đơn', '']); }
      if (!items.length) { return badge; }
      var menu = items.map(function (it) {
        return '<li><a class="dropdown-item js-status ' + it[3] + '" href="javascript:void(0)" data-id="' + r.id + '" data-act="' + it[0] + '"><i class="ti ' + it[1] + ' me-2"></i>' + it[2] + '</a></li>';
      }).join('');
      return '<div class="dropdown">' +
        '<a href="javascript:void(0)" class="text-decoration-none" data-bs-toggle="dropdown" data-bs-boundary="viewport" title="Đổi trạng thái">' + badge + ' <i class="ti ti-chevron-down text-muted"></i></a>' +
        '<ul class="dropdown-menu">' + menu + '</ul></div>';
    }

    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    var FILTERS = ['status', 'salesUserId', 'branchId', 'createdFrom', 'createdTo', 'departureFrom', 'departureTo',
      'createdByUserId', 'departmentId', 'tourType', 'providerId', 'bookingType', 'marketTypeId', 'tourGroupId',
      'collaboratorId', 'paymentStatus', 'commissionSettled', 'operationalStatus', 'invoiceStatus', 'visaStatus',
      'customerType', 'customerSource'];

    // Trả object phẳng {tênLọc: giá trị} — dùng chung cho ajax DataTables và link export.
    function filterValues() {
      var o = {};
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { o[k] = v; } });
      return o;
    }
    function collectFilters(d) {
      var o = filterValues();
      Object.keys(o).forEach(function (k) { d[k] = o[k]; });
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: 'code', render: function (v, t, r) { return '<a href="/don-hang/' + r.id + '" class="fw-medium">' + tk.escape(v) + '</a>'; } },
          { data: 'customerName', render: function (v) { return tk.trunc(v, 170); } },
          { data: 'tourTitle', render: function (v) { return tk.trunc(v, 210); } },
          { data: null, className: 'text-center', visible: !@(Model.HideTourColumns ? "true" : "false"), render: function (r) {
              // Tổng · giữ chỗ · đã bán · còn lại (bám SeatTags hệ cũ) — chỉ loại TOUR mới có chỗ/pax.
              return '<span class="badge bg-label-secondary me-1" title="Tổng">' + r.seatTotal + '</span>' +
                     '<span class="badge bg-label-warning me-1" title="Giữ chỗ">' + r.seatHeld + '</span>' +
                     '<span class="badge bg-label-success me-1" title="Đã bán">' + r.seatSold + '</span>' +
                     '<span class="badge bg-label-info" title="Còn lại">' + r.seatRemaining + '</span>';
            } },
          { data: 'departureDate', visible: !@(Model.IsVisa ? "true" : "false") },
          { data: null, className: 'text-end', render: function (r) {
              return '<div title="Tổng thu">' + tk.money(r.totalRevenue) + '</div>' +
                     '<div class="small text-success" title="Thực thu">' + tk.money(r.amountPaid) + '</div>';
            } },
          { data: null, className: 'text-end', render: function (r) {
              return '<div title="Tổng chi">' + tk.money(r.totalCost) + '</div>' +
                     '<div class="small text-danger" title="Thực chi">' + tk.money(r.actualCost) + '</div>';
            } },
          { data: 'profit', className: 'text-end', render: function (v) {
              return '<span class="fw-medium ' + (v < 0 ? 'text-danger' : 'text-success') + '">' + tk.money(v) + '</span>';
            } },
          @{ var vv = Model.IsVisa ? "true" : "false"; }
          { data: 'visaReceiveDate', className: 'text-nowrap', visible: @vv },
          { data: 'visaSubmitDate', className: 'text-nowrap', visible: @vv },
          { data: 'visaReturnDate', className: 'text-nowrap', visible: @vv },
          { data: 'visaReviewDays', className: 'text-center', visible: @vv, render: function (v) { return v == null ? '<span class="text-muted">—</span>' : (v + ' ngày'); } },
          { data: 'salesName' },
          { data: null, orderable: false, render: function (r) { return statusCell(r); } },
          { data: null, className: 'text-center', orderable: false, render: function (r) {
              // Menu "Thao tác" bám staging (không tự chế): xem nhanh · phiếu thu · đề nghị TT · lịch nhắc · chứng từ · email · xoá.
              return '<div class="dropdown">' +
                '<button type="button" class="btn btn-icon btn-sm" data-bs-toggle="dropdown" data-bs-boundary="viewport"><i class="ti ti-dots-vertical"></i></button>' +
                '<ul class="dropdown-menu dropdown-menu-end">' +
                  '<li><a class="dropdown-item js-view" href="javascript:void(0)" data-id="' + r.id + '"><i class="ti ti-eye me-2"></i>Xem nhanh</a></li>' +
                  '<li><a class="dropdown-item" href="/don-hang/' + r.id + '"><i class="ti ti-external-link me-2"></i>Trang chi tiết</a></li>' +
                  '<li><hr class="dropdown-divider"></li>' +
                  '<li><a class="dropdown-item js-receipt" href="javascript:void(0)" data-id="' + r.id + '" data-code="' + tk.escape(r.code) + '" data-out="' + (r.outstanding || 0) + '"><i class="ti ti-cash me-2"></i>Tạo phiếu thu tiền</a></li>' +
                  '<li><a class="dropdown-item js-payment" href="javascript:void(0)" data-id="' + r.id + '" data-code="' + tk.escape(r.code) + '"><i class="ti ti-file-invoice me-2"></i>Đề nghị thanh toán</a></li>' +
                  '<li><hr class="dropdown-divider"></li>' +
                  '<li><a class="dropdown-item text-muted disabled" href="javascript:void(0)" title="Cần cấu hình mẫu chứng từ"><i class="ti ti-file-text me-2"></i>Xuất chứng từ (đang phát triển)</a></li>' +
                  '<li><a class="dropdown-item text-muted disabled" href="javascript:void(0)" title="Cần cấu hình email"><i class="ti ti-mail me-2"></i>Gửi Email đơn (đang phát triển)</a></li>' +
                  '<li><a class="dropdown-item text-muted disabled" href="javascript:void(0)" title="Lịch nhắc CSKH — đợt sau"><i class="ti ti-calendar-plus me-2"></i>Tạo lịch nhắc hẹn (đang phát triển)</a></li>' +
                '</ul></div>';
            } }
        ]
      });

      // tk.table không nhận drawCallback → gắn sau qua sự kiện xhr.
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.pageSum;
        if (!s) { return; }
        var parts = [['Tổng thu', s.revenue, ''], ['Thực thu', s.paid, 'text-success'], ['Tổng chi', s.cost, ''],
                     ['Thực chi', s.actualCost, 'text-danger'], ['Lợi nhuận', s.profit, s.profit < 0 ? 'text-danger' : 'text-success'],
                     ['Phải thu', s.outstanding, '']];
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' + parts.map(function (p) {
          return '<span class="me-3 text-muted">' + p[0] + ': <span class="fw-medium ' + p[2] + '">' + tk.money(p[1]) + '</span></span>';
        }).join(''));
      });

      // ---- Action ngay trên dòng (menu Thao tác) — bám staging ----
      var ocView = new bootstrap.Offcanvas('#oc-view');
      var ocPhieu = new bootstrap.Offcanvas('#oc-phieu');
      var phieuCtx = { id: null, kind: 'receipt' };

      function rowOf(elem) { return dt.row($(elem).closest('tr')).data(); }

      // Xem nhanh (popup)
      $('#tbl tbody').on('click', '.js-view', function () {
        var r = rowOf(this); if (!r) { return; }
        $('#ov-title').text('Đơn ' + r.code);
        $('#ov-cust').text(r.customerName || '—');
        $('#ov-tour').text(r.tourTitle || '—');
        $('#ov-status').html('<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>');
        $('#ov-rev').text(tk.money(r.totalRevenue)); $('#ov-paid').text(tk.money(r.amountPaid));
        $('#ov-out').text(tk.money(r.outstanding)); $('#ov-profit').text(tk.money(r.profit));
        $('#ov-detail').attr('href', '/don-hang/' + r.id);
        $('#ov-receipt').data('r', r); $('#ov-payment').data('r', r);
        ocView.show();
      });

      // Mở form phiếu (thu/chi)
      function openPhieu(kind, id, code, out) {
        phieuCtx = { id: id, kind: kind };
        $('#op-title').text(kind === 'receipt' ? 'Tạo phiếu thu tiền' : 'Đề nghị thanh toán (phiếu chi)');
        $('#op-order').text('Đơn: ' + (code || ''));
        $('#op-amount').val(kind === 'receipt' ? (out || '') : '');
        $('#op-receiver-wrap').toggle(kind === 'payment');
        $('#op-receiver,#op-note').val('');
        ocView.hide(); ocPhieu.show();
      }
      $('#tbl tbody').on('click', '.js-receipt', function () { openPhieu('receipt', this.getAttribute('data-id'), this.getAttribute('data-code'), this.getAttribute('data-out')); });
      $('#tbl tbody').on('click', '.js-payment', function () { openPhieu('payment', this.getAttribute('data-id'), this.getAttribute('data-code'), 0); });
      $('#ov-receipt').on('click', function () { var r = $(this).data('r'); openPhieu('receipt', r.id, r.code, r.outstanding); });
      $('#ov-payment').on('click', function () { var r = $(this).data('r'); openPhieu('payment', r.id, r.code, 0); });

      // Đổi trạng thái vận hành/visa ngay trên dòng (staging) → handler OpStatus/VisaStatus + status → reload.
      $('#tbl tbody').on('click', '.js-setstatus', function () {
        var id = this.getAttribute('data-id'), handler = this.getAttribute('data-handler'), status = this.getAttribute('data-status');
        var fd = new FormData(); fd.append('id', id); fd.append('status', status);
        tk.post('?handler=' + handler, fd).then(function (res) {
          if (res.isSuccess) { tk.toast(res.message || 'Đã cập nhật trạng thái.'); dt.ajax.reload(null, false); }
          else { tk.error(res.message || 'Không đổi được trạng thái.'); }
        });
      });

      // Đổi trạng thái vòng đời thô ngay trên dòng: confirm/cancel/close/reopen → handler tương ứng → reload.
      $('#tbl tbody').on('click', '.js-status', function () {
        var id = this.getAttribute('data-id'), act = this.getAttribute('data-act');
        if (act === 'cancel' && !confirm('Xác nhận HUỶ đơn hàng này?')) { return; }
        var handler = act.charAt(0).toUpperCase() + act.slice(1);   // Confirm | Cancel | Close | Reopen
        var fd = new FormData(); fd.append('id', id);
        tk.post('?handler=' + handler, fd).then(function (res) {
          if (res.isSuccess) { tk.toast(res.message || 'Đã cập nhật trạng thái.'); dt.ajax.reload(null, false); }
          else { tk.error(res.message || 'Không đổi được trạng thái.'); }
        });
      });

      // Lưu phiếu → AJAX handler tương ứng → reload bảng
      $('#op-save').on('click', function () {
        var amt = Number($('#op-amount').val()) || 0;
        if (amt <= 0) { tk.toast('Nhập số tiền hợp lệ.'); return; }
        var fd = new FormData();
        fd.append('id', phieuCtx.id); fd.append('amount', amt); fd.append('method', $('#op-method').val()); fd.append('note', $('#op-note').val());
        if (phieuCtx.kind === 'payment') { fd.append('receiver', $('#op-receiver').val()); }
        tk.post('?handler=' + (phieuCtx.kind === 'receipt' ? 'Receipt' : 'Payment'), fd).then(function (res) {
          if (res.isSuccess) { tk.toast(res.message || 'Đã lưu.'); ocPhieu.hide(); dt.ajax.reload(null, false); }
          else { tk.error(res.message || 'Không lưu được.'); }
        });
      });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { dt.ajax.reload(); } });
      $('#f-status, #f-bookingType, #f-paymentStatus, #f-commissionSettled, #f-operationalStatus, #f-invoiceStatus, #f-visaStatus, #f-customerType').on('change', function () { dt.ajax.reload(); });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      tk.advFilter();   // nút "Lọc nâng cao" có nhãn + badge đếm + tự mở khi có lọc (dùng chung tk.js)

      // Tab trạng thái thanh toán → điều khiển #f-paymentStatus (select đã có ở panel nâng cao).
      $('#pay-tabs').on('click', '.nav-link', function () {
        $('#pay-tabs .nav-link').removeClass('active'); $(this).addClass('active');
        $('#f-paymentStatus').val(this.getAttribute('data-pay') || ''); dt.ajax.reload();
      });
      // Chip thị trường → điều khiển #f-marketTypeId (select2 ở panel nâng cao).
      $('.tk-market-chip').on('click', function () {
        var v = this.getAttribute('data-market') || '';
        $('.tk-market-chip').removeClass('btn-primary').addClass('btn-label-secondary');
        $(this).removeClass('btn-label-secondary').addClass('btn-primary');
        $('#f-marketTypeId').val(v).trigger('change.select2'); dt.ajax.reload();
      });

      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('.tk-datef').each(function () { if (this._flatpickr) { this._flatpickr.clear(); } });
        $('#pay-tabs .nav-link').removeClass('active').first().addClass('active');
        $('.tk-market-chip').removeClass('btn-primary').addClass('btn-label-secondary').first().removeClass('btn-label-secondary').addClass('btn-primary');
        dt.ajax.reload();
      });
      $('#btn-export').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(filterValues());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
