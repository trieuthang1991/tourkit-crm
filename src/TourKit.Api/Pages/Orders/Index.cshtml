@page
@model TourKit.Api.Pages.Orders.IndexModel
@{ ViewData["Title"] = "Đơn hàng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 6 KPI — bám thẻ thống kê hệ cũ, gói vào dải mảnh (giống màn Data khách hàng).
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng số đơn", Model.Stats.Total.ToString("#,##0"), "ti ti-file-text", "primary"),
        ("Doanh thu", Model.Stats.TotalRevenue.ToString("#,##0"), "ti ti-cash", "info"),
        ("Đã thu", Model.Stats.TotalPaid.ToString("#,##0"), "ti ti-arrow-down-circle", "success"),
        ("Còn nợ", Model.Stats.TotalOutstanding.ToString("#,##0"), "ti ti-alert-circle", "danger"),
        ("Đã chốt", Model.Stats.Confirmed.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("Đã huỷ", Model.Stats.Cancelled.ToString("#,##0"), "ti ti-circle-x", "warning"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Đơn hàng <span class="mx-1">/</span> <span class="text-body">@Model.TypeLabel</span></div>
    <h4 class="mb-0">Đơn hàng — @Model.TypeLabel</h4>
  </div>
  <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
</div>

@* MỘT MẶT TRẮNG liền mạch — các vùng ngăn nhau bằng kẻ ngang mảnh, không chia hộp. *@
<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tab trạng thái thanh toán (bám staging: Tất cả / Chưa TT / Đã cọc / TT hết) — điều khiển #f-paymentStatus *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="paymentStatus">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1">@Model.Stats.Total.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="0">Chưa thanh toán <span class="badge bg-label-warning ms-1">@Model.Stats.Unpaid.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="1">Đã cọc <span class="badge bg-label-info ms-1">@Model.Stats.Deposit.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="2">Thanh toán hết <span class="badge bg-label-success ms-1">@Model.Stats.Paid.ToString("#,##0")</span></a></li>
    </ul>

    @* Hàng lọc CHÍNH — bám staging /all-orders: Nguồn KH · Loại KH · Người tạo · Chi nhánh + Tình trạng/NV *@
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã, tên tour, SĐT, tên khách…" /></div>
      <div class="col-md-2"><select id="f-customerSource" class="form-select tk-s2f" data-placeholder="Nguồn khách"><option value=""></option>@foreach (var s in Model.Sources) { <option value="@s">@s</option> }</select></div>
      <div class="col-md-2"><select id="f-customerType" class="form-select tk-auto"><option value="">Loại khách</option><option value="0">Khách lẻ</option><option value="1">Doanh nghiệp</option><option value="2">Đối tác</option><option value="3">CTV</option></select></div>
      <div class="col-md-2"><select id="f-createdByUserId" class="form-select tk-s2f" data-placeholder="Người tạo"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
      <div class="col-md-2"><select id="f-branchId" class="form-select tk-s2f" data-placeholder="Chi nhánh"><option value=""></option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
    </div>
    <div class="row g-2 align-items-center mt-2">
      <div class="col-md-2"><select id="f-status" class="form-select tk-auto"><option value="">Tình trạng đơn</option><option value="1">Nháp/Giữ chỗ</option><option value="2">Đã xác nhận</option><option value="3">Đã huỷ</option><option value="4">Đã tất toán</option></select></div>
      <div class="col-md-3"><select id="f-salesUserId" class="form-select tk-s2f" data-placeholder="NV phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select></div>
      @if (Model.IsVisa)
      {
        <div class="col-md-3"><select id="f-visaStatus" class="form-select tk-auto"><option value="">Tất cả trạng thái Visa</option><option value="0">Tạo mới</option><option value="1">Đã tiếp nhận</option><option value="2">Đang xử lý</option><option value="3">Đã nộp</option><option value="4">Yêu cầu bổ sung</option><option value="5">Chờ kết quả</option><option value="6">Đậu</option><option value="7">Rớt</option><option value="8">Rút hồ sơ</option><option value="9">Hủy hồ sơ</option><option value="10">Hoàn tất dịch vụ</option></select></div>
      }
      <div class="col-auto ms-auto d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* Lọc nâng cao — placeholder-only, KHÔNG label (đồng nhất toàn thanh lọc). *@
    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-createdFrom" class="form-control tk-datef" placeholder="Ngày tạo từ" /></div>
      <div class="col-md-3"><input type="text" id="f-createdTo" class="form-control tk-datef" placeholder="Ngày tạo đến" /></div>
      <div class="col-md-3"><input type="text" id="f-departureFrom" class="form-control tk-datef" placeholder="Ngày khởi hành từ" /></div>
      <div class="col-md-3"><input type="text" id="f-departureTo" class="form-control tk-datef" placeholder="Ngày khởi hành đến" /></div>

      <div class="col-md-3"><select id="f-departmentId" class="form-select tk-s2f" data-placeholder="Phòng ban"><option value=""></option>@foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-tourType" class="form-select tk-s2f" data-placeholder="Loại hình"><option value=""></option>@foreach (var t in Model.Options.TourTypes) { <option value="@t">@t</option> }</select></div>
      <div class="col-md-3"><select id="f-providerId" class="form-select tk-s2f" data-placeholder="Nhà cung cấp"><option value=""></option>@foreach (var p in Model.Options.Providers) { <option value="@p.Id">@p.Name</option> }</select></div>

      <div class="col-md-3">
        <select id="f-bookingType" class="form-select tk-auto"><option value="">Loại tour</option>
          @for (var i = 0; i < TourKit.Api.Pages.Orders.IndexModel.BookingTypeLabels.Length; i++)
          {
            <option value="@i" selected="@(Model.BookingType == i)">@TourKit.Api.Pages.Orders.IndexModel.BookingTypeLabels[i]</option>
          }
        </select>
      </div>
      <div class="col-md-3"><select id="f-marketTypeId" class="form-select tk-s2f" data-placeholder="Thị trường"><option value=""></option>@foreach (var m in Model.Markets) { <option value="@m.Id">@m.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-tourGroupId" class="form-select tk-s2f" data-placeholder="Nhóm tour"><option value=""></option>@foreach (var g in Model.Groups) { <option value="@g.Id">@g.Name</option> }</select></div>
      <div class="col-md-3"><select id="f-collaboratorId" class="form-select tk-s2f" data-placeholder="CTV"><option value=""></option>@foreach (var c in Model.Options.Collaborators) { <option value="@c.Id">@c.Name</option> }</select></div>
      @* Nguồn khách / Loại khách / Người tạo đã lên hàng lọc CHÍNH (bám staging) — không lặp ở đây. Nhóm KH: model chưa có. *@
      <div class="col-md-3"><select id="f-paymentStatus" class="form-select tk-auto"><option value="">TT thanh toán</option><option value="0">Chưa thanh toán</option><option value="1">Đã cọc</option><option value="2">Thanh toán đủ</option></select></div>
      <div class="col-md-3"><select id="f-commissionSettled" class="form-select tk-auto"><option value="">TT hoa hồng</option><option value="true">Đã quyết</option><option value="false">Chưa quyết</option></select></div>
      <div class="col-md-3"><select id="f-operationalStatus" class="form-select tk-auto"><option value="">Tình trạng vận hành</option><option value="1">Sắp chạy</option><option value="8">Kích hoạt giá</option><option value="2">Đang chạy</option><option value="3">Chưa quyết toán</option><option value="4">Đã quyết toán</option><option value="5">Hoàn thành</option><option value="6">Hủy</option><option value="7">Hủy không đi</option></select></div>
      <div class="col-md-3"><select id="f-invoiceStatus" class="form-select tk-auto"><option value="">TT hoá đơn</option><option value="0">Chưa xuất</option><option value="1">Đã xuất</option></select></div>
    </div>

    @* Chip lọc nhanh theo Thị trường (bám staging) — điều khiển #f-marketTypeId *@
    @if (Model.Markets.Count > 0)
    {
      <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
        <span class="text-muted small fw-medium" style="min-width:110px"><i class="ti ti-map-pin me-1"></i>Thị trường</span>
        <button type="button" class="btn btn-sm btn-primary tk-chip" data-k="marketTypeId" data-v="">Tất cả</button>
        @foreach (var m in Model.Markets)
        {
          <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="marketTypeId" data-v="@m.Id">@m.Name</button>
        }
      </div>
    }
  </div>

  @* Thanh tác vụ hàng loạt — đơn hàng KHÔNG xoá hàng loạt (nghiệp vụ dùng huỷ/tất toán trên từng đơn). *@
  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> đơn đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-orders"></div>
</div>

@Html.AntiForgeryToken()

@* Offcanvas XEM NHANH đơn (bám ý "view = popup") *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="oc-view" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title" id="ov-title">Đơn hàng</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    <div class="tk-oc-fields">
    <dl class="row mb-0">
      <dt class="col-5 text-muted">Khách hàng</dt><dd class="col-7" id="ov-cust">—</dd>
      <dt class="col-5 text-muted">Nội dung / Tour</dt><dd class="col-7" id="ov-tour">—</dd>
      <dt class="col-5 text-muted">Trạng thái</dt><dd class="col-7" id="ov-status">—</dd>
      <dt class="col-5 text-muted">Tổng thu</dt><dd class="col-7 text-heading" id="ov-rev">—</dd>
      <dt class="col-5 text-muted">Đã thu</dt><dd class="col-7 text-success" id="ov-paid">—</dd>
      <dt class="col-5 text-muted">Còn nợ</dt><dd class="col-7 text-danger" id="ov-out">—</dd>
      <dt class="col-5 text-muted">Lợi nhuận</dt><dd class="col-7" id="ov-profit">—</dd>
    </dl>
    </div>
    <div class="tk-oc-actions">
      <button type="button" class="btn btn-sm btn-primary flex-fill" id="ov-receipt"><i class="ti ti-cash me-1"></i> Phiếu thu</button>
      <button type="button" class="btn btn-sm btn-label-secondary flex-fill" id="ov-payment"><i class="ti ti-file-invoice me-1"></i> Phiếu chi</button>
      <a class="btn btn-sm btn-label-secondary" id="ov-detail" title="Mở trang chi tiết"><i class="ti ti-external-link"></i></a>
    </div>
  </div>
</div>

@* Offcanvas TẠO PHIẾU (thu/chi) — dùng chung, đổi tiêu đề + handler theo loại *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="oc-phieu" style="width:460px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title" id="op-title">Tạo phiếu</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    <div class="tk-oc-fields">
    <div class="mb-2 small text-muted" id="op-order">Đơn: —</div>
    <div class="mb-3"><label class="form-label">Số tiền <span class="text-danger">*</span></label><input type="number" id="op-amount" class="form-control" min="0" step="1000" placeholder="Nhập số tiền" /></div>
    <div class="mb-3"><label class="form-label">Phương thức</label>
      <select id="op-method" class="form-select"><option value="cash">Tiền mặt</option><option value="bank">Chuyển khoản</option><option value="momo">MoMo</option><option value="vnpay">VNPay</option></select>
    </div>
    <div class="mb-3" id="op-receiver-wrap"><label class="form-label">Người nhận</label><input type="text" id="op-receiver" class="form-control" placeholder="Tên người nhận (phiếu chi)" /></div>
    <div class="mb-3"><label class="form-label">Ghi chú</label><textarea id="op-note" class="form-control" rows="2" placeholder="Nội dung phiếu, số chứng từ…"></textarea></div>
    </div>
    <div class="tk-oc-actions">
      <button type="button" class="btn btn-primary" id="op-save">Lưu phiếu</button>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      var IS_VISA = @(Model.IsVisa ? "true" : "false");
      var HIDE_SEATS = @(Model.HideTourColumns ? "true" : "false");

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      // ===== Trạng thái đổi TRÊN DÒNG (bám staging) — bộ trạng thái theo LOẠI đơn =====
      // Tour (vận hành): value = OrderOperationalStatus. Visa: 0..10 (11 bước). Booking/Dịch vụ/Xe: vòng đời thô.
      var OP_LABELS = { 1: ['Sắp chạy', 'secondary'], 8: ['Kích hoạt giá', 'info'], 2: ['Đang chạy', 'primary'], 3: ['Chưa quyết toán', 'warning'], 4: ['Đã quyết toán', 'success'], 5: ['Hoàn thành', 'success'], 6: ['Hủy', 'danger'], 7: ['Hủy không đi', 'danger'] };
      function opOptsFor(bt) { return bt === 1 ? [1, 2, 3, 4, 5, 6, 7] : [1, 8, 2, 3, 4, 5, 6]; }   // GIT có "Hủy không đi"; FIT/LandTour có "Kích hoạt giá"
      var VISA_LABELS = ['Tạo mới', 'Đã tiếp nhận', 'Đang xử lý', 'Đã nộp', 'Yêu cầu bổ sung', 'Chờ kết quả', 'Đậu', 'Rớt', 'Rút hồ sơ', 'Hủy hồ sơ', 'Hoàn tất dịch vụ'];
      var VISA_COLORS = ['secondary', 'info', 'primary', 'primary', 'warning', 'info', 'success', 'danger', 'warning', 'danger', 'success'];

      function badge(label, color) { return '<span class="badge bg-label-' + color + '">' + esc(label) + '</span>'; }

      // Ô trạng thái: nút g.pick (badge hiện tại + mũi tên). Bấm vào mở menu của Tabulator (clickMenu) —
      // KHÔNG dùng dropdown Bootstrap vì menu bị ô của lưới cắt mất. Việc nắn menu cho vừa màn hình
      // do tk-grid.js lo (xem placeMenu), trang không phải xử lý gì thêm.
      function statusOf(r) {
        if (r.bookingType === 5) { return { label: VISA_LABELS[r.visaStatus] || '—', color: VISA_COLORS[r.visaStatus] || 'secondary' }; }
        if (r.bookingType === 0 || r.bookingType === 1 || r.bookingType === 2) {
          var o = OP_LABELS[r.opStatus];
          return { label: o ? o[0] : '—', color: o ? o[1] : 'secondary' };
        }
        return { label: r.statusLabel, color: r.statusColor };
      }

      function setStatus(handler, id, status) {
        var fd = new FormData(); fd.append('id', id); if (status != null) { fd.append('status', status); }
        tk.post('?handler=' + handler, fd).then(function (res) {
          if (res.isSuccess) { tk.toast(res.message || 'Đã cập nhật trạng thái.'); grid.reload(); }
          else { tk.error(res.message || 'Không đổi được trạng thái.'); }
        });
      }

      // Menu đổi trạng thái đúng theo LOẠI đơn (giữ nguyên luật của hệ cũ, không chế thêm bước).
      function statusMenu(r) {
        if (r.bookingType === 5) {
          return VISA_LABELS.map(function (l, i) {
            return { label: badge(l, VISA_COLORS[i]) + (i === r.visaStatus ? ' <i class="ti ti-check ms-1"></i>' : ''),
                     action: function () { setStatus('VisaStatus', r.id, i); } };
          });
        }
        if (r.bookingType === 0 || r.bookingType === 1 || r.bookingType === 2) {
          return opOptsFor(r.bookingType).map(function (v) {
            return { label: badge(OP_LABELS[v][0], OP_LABELS[v][1]) + (v === r.opStatus ? ' <i class="ti ti-check ms-1"></i>' : ''),
                     action: function () { setStatus('OpStatus', r.id, v); } };
          });
        }
        // Booking phòng/Dịch vụ/Xe: vòng đời thô — chỉ những bước hợp lệ với trạng thái hiện tại.
        var items = [];
        if (r.status === 1) {
          items.push({ label: '<i class="ti ti-check me-2"></i>Xác nhận đơn', action: function () { setStatus('Confirm', r.id); } });
          items.push({ label: '<span class="text-danger"><i class="ti ti-x me-2"></i>Huỷ đơn</span>', action: function () { confirmCancel(r); } });
        } else if (r.status === 2) {
          items.push({ label: '<i class="ti ti-lock me-2"></i>Tất toán đơn', action: function () { setStatus('Close', r.id); } });
          items.push({ label: '<span class="text-danger"><i class="ti ti-x me-2"></i>Huỷ đơn</span>', action: function () { confirmCancel(r); } });
        } else if (r.status === 4) {
          items.push({ label: '<i class="ti ti-lock-open me-2"></i>Mở lại đơn', action: function () { setStatus('Reopen', r.id); } });
        }
        return items;
      }
      function confirmCancel(r) {
        tk.confirmDelete({ title: 'Huỷ đơn hàng?', text: r.code || '', confirmText: 'Huỷ đơn' })
          .then(function (ok) { if (ok) { setStatus('Cancel', r.id); } });
      }

      // ===== Xem nhanh + phiếu thu/chi (giữ nguyên như bản cũ) =====
      var ocView = new bootstrap.Offcanvas('#oc-view');
      var ocPhieu = new bootstrap.Offcanvas('#oc-phieu');
      var phieuCtx = { id: null, kind: 'receipt' };

      function viewRow(r) {
        $('#ov-title').text('Đơn ' + r.code);
        $('#ov-cust').text(r.customerName || '—');
        $('#ov-tour').text(r.tourTitle || '—');
        $('#ov-status').html(badge(r.statusLabel, r.statusColor));
        $('#ov-rev').text(money(r.totalRevenue)); $('#ov-paid').text(money(r.amountPaid));
        $('#ov-out').text(money(r.outstanding)); $('#ov-profit').text(money(r.profit));
        $('#ov-detail').attr('href', '/don-hang/' + r.id);
        $('#ov-receipt').data('r', r); $('#ov-payment').data('r', r);
        ocView.show();
      }
      function openPhieu(kind, id, code, out) {
        phieuCtx = { id: id, kind: kind };
        $('#op-title').text(kind === 'receipt' ? 'Tạo phiếu thu tiền' : 'Đề nghị thanh toán (phiếu chi)');
        $('#op-order').text('Đơn: ' + (code || ''));
        $('#op-amount').val(kind === 'receipt' ? (out || '') : '');
        $('#op-receiver-wrap').toggle(kind === 'payment');
        $('#op-receiver,#op-note').val('');
        ocView.hide(); ocPhieu.show();
      }
      $('#ov-receipt').on('click', function () { var r = $(this).data('r'); openPhieu('receipt', r.id, r.code, r.outstanding); });
      $('#ov-payment').on('click', function () { var r = $(this).data('r'); openPhieu('payment', r.id, r.code, 0); });
      $('#op-save').on('click', function () {
        var amt = Number($('#op-amount').val()) || 0;
        if (amt <= 0) { tk.toast('Nhập số tiền hợp lệ.'); return; }
        var fd = new FormData();
        fd.append('id', phieuCtx.id); fd.append('amount', amt); fd.append('method', $('#op-method').val()); fd.append('note', $('#op-note').val());
        if (phieuCtx.kind === 'payment') { fd.append('receiver', $('#op-receiver').val()); }
        tk.post('?handler=' + (phieuCtx.kind === 'receipt' ? 'Receipt' : 'Payment'), fd).then(function (res) {
          if (res.isSuccess) { tk.toast(res.message || 'Đã lưu.'); ocPhieu.hide(); grid.reload(); }
          else { tk.error(res.message || 'Không lưu được.'); }
        });
      });

      // Menu "Thao tác" bám staging (không tự chế): xem nhanh · chi tiết · phiếu thu · đề nghị TT · đổi trạng thái.
      function actionsFor(r) {
        var items = [
          { label: '<i class="ti ti-eye me-2"></i>Xem nhanh', action: function () { viewRow(r); } },
          { label: '<i class="ti ti-external-link me-2"></i>Trang chi tiết', action: function () { window.location = '/don-hang/' + r.id; } },
          { separator: true },
          { label: '<i class="ti ti-cash me-2"></i>Tạo phiếu thu tiền', action: function () { openPhieu('receipt', r.id, r.code, r.outstanding); } },
          { label: '<i class="ti ti-file-invoice me-2"></i>Đề nghị thanh toán', action: function () { openPhieu('payment', r.id, r.code, 0); } }
        ];
        // Đơn tour/visa có 7–11 bước trạng thái → để riêng ở ô "Trạng thái", không nhồi vào đây
        // cho menu dài lê thê. Chỉ đơn vòng đời thô (booking phòng/dịch vụ/xe) mới gắn kèm.
        var coarse = !(r.bookingType === 5 || r.bookingType === 0 || r.bookingType === 1 || r.bookingType === 2);
        if (coarse) {
          var st = statusMenu(r);
          if (st.length) { items.push({ separator: true }); items = items.concat(st); }
        }
        return items;
      }

      var grid = tk.grid('#grid-orders', {
        // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['status', 'salesUserId', 'branchId', 'createdFrom', 'createdTo', 'departureFrom', 'departureTo',
          'createdByUserId', 'departmentId', 'tourType', 'providerId', 'bookingType', 'marketTypeId', 'tourGroupId',
          'collaboratorId', 'paymentStatus', 'commissionSettled', 'operationalStatus', 'invoiceStatus', 'visaStatus',
          'customerType', 'customerSource'],
        chipGroups: ['marketTypeId'],
        exportName: 'don-hang-da-chon.csv',
        actions: actionsFor,
        columns: [
          {
            title: 'Mã đơn', field: 'code', widthGrow: 2, minWidth: 160,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell"><a class="tk-cell-main" href="/don-hang/' + r.id + '">' + esc(r.code) + '</a>' +
                '<div class="tk-cell-sub">' + esc(r.salesName || '—') + '</div></div>';
            }
          },
          {
            title: 'Khách hàng', field: 'customerName', widthGrow: 3, minWidth: 200,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-row-media">' + g.avatar(r.customerName) + g.stack(r.customerName, r.tourTitle) + '</div>';
            }
          },
          {
            title: IS_VISA ? 'Nội dung đơn' : 'Tour', field: 'tourTitle', widthGrow: 3, minWidth: 210,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.tourTitle, IS_VISA ? null : ('Ngày đi: ' + (r.departureDate || '—')));
            }
          },
          {
            // Tổng · giữ chỗ · đã bán · còn lại (bám SeatTags hệ cũ) — chỉ loại TOUR mới có chỗ/pax.
            title: 'Khách (chỗ)', field: 'seatTotal', width: 150, hozAlign: 'center', visible: !HIDE_SEATS,
            formatter: function (c) {
              var r = c.getData();
              return '<span class="badge bg-label-secondary me-1" title="Tổng">' + r.seatTotal + '</span>' +
                '<span class="badge bg-label-warning me-1" title="Giữ chỗ">' + r.seatHeld + '</span>' +
                '<span class="badge bg-label-success me-1" title="Đã bán">' + r.seatSold + '</span>' +
                '<span class="badge bg-label-info" title="Còn lại">' + r.seatRemaining + '</span>';
            }
          },
          {
            title: 'Thu tiền', field: 'totalRevenue', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            // Dòng tổng NGAY DƯỚI tiêu đề (bám dòng tfoot hệ cũ: tổng của TRANG hiện tại).
            // Chỉ MỘT số cho vừa cột — số phụ (thực thu) đưa vào tooltip, nhồi 2 số vào 1 dòng 30px sẽ bị cắt cụt.
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var paid = c.getTable().getData().reduce(function (a, r) { return a + (r.amountPaid || 0); }, 0);
              return '<span class="fw-semibold" title="Thực thu trang này: ' + money(paid) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main" title="Tổng thu">' + money(r.totalRevenue) + '</div>' +
                '<div class="tk-cell-sub text-success" title="Thực thu">' + money(r.amountPaid) + '</div></div>';
            }
          },
          {
            title: 'Chi tiền', field: 'totalCost', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var act = c.getTable().getData().reduce(function (a, r) { return a + (r.actualCost || 0); }, 0);
              return '<span class="fw-semibold" title="Thực chi trang này: ' + money(act) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main" title="Tổng chi">' + money(r.totalCost) + '</div>' +
                '<div class="tk-cell-sub text-danger" title="Thực chi">' + money(r.actualCost) + '</div></div>';
            }
          },
          {
            title: 'Lợi nhuận', field: 'profit', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var v = c.getValue();
              var owe = c.getTable().getData().reduce(function (a, r) { return a + (r.outstanding || 0); }, 0);
              return '<span class="fw-semibold ' + (v < 0 ? 'text-danger' : 'text-success') + '" title="Phải thu trang này: ' + money(owe) + '">' + money(v) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main ' + (r.profit < 0 ? 'text-danger' : 'text-success') + '">' + money(r.profit) + '</div>' +
                '<div class="tk-cell-sub" title="Còn nợ">nợ ' + money(r.outstanding) + '</div></div>';
            }
          },
          { title: 'Ngày nhận', field: 'visaReceiveDate', width: 120, visible: IS_VISA },
          { title: 'Ngày nộp/lăn tay', field: 'visaSubmitDate', width: 140, visible: IS_VISA },
          { title: 'Ngày trả', field: 'visaReturnDate', width: 120, visible: IS_VISA },
          {
            title: 'TG xét duyệt', field: 'visaReviewDays', width: 110, hozAlign: 'center', visible: IS_VISA,
            formatter: function (c) { var v = c.getValue(); return v == null ? '<span class="tk-cell-sub">—</span>' : (v + ' ngày'); }
          },
          {
            title: 'Trạng thái', field: 'status', width: 170,
            clickMenu: function (e, cell) { return statusMenu(cell.getRow().getData()); },
            formatter: function (c) {
              var r = c.getData();
              var s = statusOf(r);
              // Trạng thái không còn bước hợp lệ nào (đơn đã huỷ…) → badge TĨNH.
              // Vẽ nút mà bấm vào không ra menu thì người dùng tưởng hỏng.
              if (!statusMenu(r).length) { return '<span class="badge bg-label-' + s.color + '">' + esc(s.label) + '</span>'; }
              return g.pick(s.label, s.color, 'Bấm để đổi trạng thái');
            }
          }
        ]
      });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
