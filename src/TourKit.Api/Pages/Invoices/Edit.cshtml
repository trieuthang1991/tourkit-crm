@page "{id:guid?}"
@model TourKit.Api.Pages.Invoices.EditModel
@{
  var inv = Model.Invoice;
  ViewData["Title"] = inv == null ? "Tạo hoá đơn" : $"Hoá đơn {inv.Number}";
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">@(inv == null ? "Tạo hoá đơn mới" : $"Hoá đơn {inv.Series} {inv.Number}")</h4>
  <a href="/Invoices" class="btn btn-label-secondary"><i class="ti ti-arrow-left me-1"></i> Danh sách</a>
</div>

@Html.AntiForgeryToken()
<form id="frm" data-action="?handler=Save" onsubmit="return false">
  <input type="hidden" name="Id" value="@(inv?.Id)" />
  <input type="hidden" name="Input.OrderId" id="OrderId" value="@(inv?.OrderId)" />
  <input type="hidden" name="LinesJson" id="LinesJson" value="[]" />

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0">Thông tin hoá đơn</h5></div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-3 mb-3">
              <label class="form-label">Ký hiệu</label>
              <input type="text" name="Input.Series" class="form-control" value="@(inv?.Series)" placeholder="VD: 1C25TAA" />
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Số hoá đơn</label>
              <input type="text" name="Input.Number" class="form-control" value="@(inv?.Number)" placeholder="VD: 0000123" />
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Ngày hoá đơn <span class="text-danger">*</span></label>
              <input type="text" name="Input.InvoiceDate" id="InvoiceDate" class="form-control" value="@(inv?.InvoiceDate.ToString("dd/MM/yyyy") ?? DateTimeOffset.Now.ToString("dd/MM/yyyy"))" placeholder="dd/mm/yyyy" />
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Trạng thái</label>
              <select name="Input.Status" class="form-select">
                <option value="0">Nháp</option>
                <option value="1">Đã phát hành</option>
                <option value="2">Đã huỷ</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Người mua <span class="text-danger">*</span></label>
              <input type="text" name="Input.BuyerName" class="form-control" value="@(inv?.BuyerName)" placeholder="Tên tổ chức / cá nhân mua hàng" />
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Mã số thuế</label>
              <input type="text" name="Input.BuyerTaxCode" class="form-control" value="@(inv?.BuyerTaxCode)" placeholder="VD: 0101234567" />
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Đơn hàng liên kết</label>
              <select id="order-picker" class="form-select"></select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Địa chỉ</label>
            <input type="text" name="Input.BuyerAddress" class="form-control" value="@(inv?.BuyerAddress)" placeholder="Địa chỉ trên hoá đơn" />
          </div>
          <div class="mb-1">
            <label class="form-label">Ghi chú</label>
            <textarea name="Input.Note" class="form-control" rows="2" placeholder="Hình thức thanh toán, ghi chú...">@(inv?.Note)</textarea>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Hàng hoá &amp; dịch vụ</h5>
          <button type="button" class="btn btn-sm btn-primary" id="add-line"><i class="ti ti-plus me-1"></i> Thêm dòng</button>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0" id="lines">
            <thead><tr>
              <th style="min-width:220px">Mô tả</th>
              <th class="text-end" style="width:90px">SL</th>
              <th class="text-end" style="width:140px">Đơn giá</th>
              <th class="text-end" style="width:90px">Thuế %</th>
              <th class="text-end" style="min-width:130px">Tiền hàng</th>
              <th class="text-end" style="min-width:120px">Tiền thuế</th>
              <th style="width:40px"></th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-header"><h5 class="mb-0">Tổng hợp</h5></div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Cộng tiền hàng</span><span class="fw-medium" id="r-subtotal">0</span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Tiền thuế GTGT</span><span id="r-vat">0</span></div>
          <hr />
          <div class="d-flex justify-content-between mb-3"><span class="text-muted">Tổng thanh toán</span><span class="fw-medium text-primary fs-5" id="r-total">0</span></div>
          <button type="submit" class="btn btn-primary w-100"><i class="ti ti-device-floppy me-1"></i> Lưu hoá đơn</button>
          <div class="text-muted small mt-2">Số tiền do máy chủ tính lại khi lưu — bảng bên là số dự trù.</div>
        </div>
      </div>
    </div>
  </div>
</form>

@section VendorScripts {
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var SEED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.Invoice?.Lines ?? System.Array.Empty<TourKit.Application.Sales.Dtos.InvoiceLineDto>()).Select(l => new {
      description = l.Description, quantity = l.Quantity, unitPrice = l.UnitPrice, vatRate = l.VatRate
    })));

    function num(v){ var n = parseFloat(v); return isNaN(n) ? 0 : n; }
    function fmt(n){ return Math.round(n).toLocaleString('vi-VN'); }

    function lineRow(d){
      d = d || {};
      return $('<tr>').html(
        '<td><input class="form-control form-control-sm l-desc" value="'+ (d.description ? tk.escape(d.description) : '') +'" placeholder="Tên hàng hoá, dịch vụ..."></td>'+
        '<td><input type="number" class="form-control form-control-sm text-end l-qty" value="'+(d.quantity != null ? d.quantity : 1)+'" min="0"></td>'+
        '<td><input type="number" class="form-control form-control-sm text-end l-price" value="'+(d.unitPrice || 0)+'" min="0"></td>'+
        '<td><input type="number" class="form-control form-control-sm text-end l-vat" value="'+(d.vatRate != null ? d.vatRate : 10)+'" min="0" max="100"></td>'+
        '<td class="text-end l-amount">0</td>'+
        '<td class="text-end l-tax">0</td>'+
        '<td class="text-center"><button type="button" class="btn btn-icon btn-sm text-danger l-del"><i class="ti ti-x"></i></button></td>'
      );
    }

    function recompute(){
      var subtotal = 0, vat = 0;
      $('#lines tbody tr').each(function(){
        var r = $(this);
        var amount = num(r.find('.l-qty').val()) * num(r.find('.l-price').val());
        var tax = amount * num(r.find('.l-vat').val()) / 100;
        r.find('.l-amount').text(fmt(amount));
        r.find('.l-tax').text(fmt(tax));
        subtotal += amount; vat += tax;
      });
      $('#r-subtotal').text(fmt(subtotal));
      $('#r-vat').text(fmt(vat));
      $('#r-total').text(fmt(subtotal + vat));
    }

    function collect(){
      return $('#lines tbody tr').map(function(){
        var r = $(this);
        return { description: r.find('.l-desc').val() || '—', quantity: num(r.find('.l-qty').val()),
                 unitPrice: num(r.find('.l-price').val()), vatRate: num(r.find('.l-vat').val()) };
      }).get();
    }

    $(function(){
      $('#order-picker').select2({ placeholder:'Tìm mã đơn / khách...', allowClear:true, width:'100%',
        ajax:{ url:'?handler=OrderSearch', dataType:'json', delay:250, data:function(p){ return { q:p.term }; }, processResults:function(d){ return d; } } });
      @if (Model.Invoice?.OrderId != null) {
        <text>$('#order-picker').append(new Option(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderLabel ?? "")), '@Model.Invoice!.OrderId', true, true)).trigger('change');</text>
      }
      $('#order-picker').on('select2:select', function(e){ $('#OrderId').val(e.params.data.id); });
      $('#order-picker').on('select2:clear', function(){ $('#OrderId').val(''); });
      if (window.flatpickr) { flatpickr('#InvoiceDate', { dateFormat:'d/m/Y', allowInput:true }); }

      var seed = SEED.length ? SEED : [{}];
      seed.forEach(function(d){ $('#lines tbody').append(lineRow(d)); });

      $('#add-line').on('click', function(){ $('#lines tbody').append(lineRow()); recompute(); });
      $('#lines').on('click', '.l-del', function(){ if ($('#lines tbody tr').length > 1){ $(this).closest('tr').remove(); } recompute(); });
      $('#lines').on('input change', 'input', recompute);

      @if (inv != null) {
        <text>$('select[name="Input.Status"]').val('@inv!.Status');</text>
      }

      $('#frm').validate({
        rules: { 'Input.BuyerName': { required:true }, 'Input.InvoiceDate': { required:true } },
        messages: { 'Input.BuyerName': { required:'Bắt buộc nhập tên người mua' }, 'Input.InvoiceDate': { required:'Bắt buộc nhập ngày hoá đơn' } },
        errorClass:'text-danger small', submitHandler: function(){ save(); return false; } });

      recompute();
    });

    function save(){
      $('#LinesJson').val(JSON.stringify(collect()));
      // FormData (multipart) — KHÔNG dùng $.serialize(): fetch gửi chuỗi dưới dạng text/plain
      // nên Request.Form rỗng và mọi trường bind ra null.
      tk.post('?handler=Save', new FormData(document.getElementById('frm'))).then(function(res){
        if (res && res.isSuccess){ tk.toast(res.message || 'Đã lưu'); setTimeout(function(){ location.href = '/Invoices/Edit/' + res.data.id; }, 600); }
        else { tk.error((res && res.message) || 'Lưu thất bại'); }
      });
    }
  </script>
}
