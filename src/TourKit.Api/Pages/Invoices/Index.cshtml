@page
@model TourKit.Api.Pages.Invoices.IndexModel
@{ ViewData["Title"] = "Hoá đơn VAT"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 6 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng hoá đơn", Model.Stats.Total.ToString("#,##0"), "ti ti-file-text", "primary"),
        ("kpi-amount", "Tổng tiền", Model.Stats.TotalAmount.ToString("#,##0"), "ti ti-cash", "primary"),
        ("kpi-vat", "Tổng VAT", Model.Stats.TotalVat.ToString("#,##0"), "ti ti-percentage", "info"),
        ("kpi-issued", "Đã phát hành", Model.Stats.Issued.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("kpi-draft", "Nháp", Model.Stats.Draft.ToString("#,##0"), "ti ti-pencil", "secondary"),
        ("kpi-cancelled", "Huỷ", Model.Stats.Cancelled.ToString("#,##0"), "ti ti-circle-x", "danger"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Tài chính <span class="mx-1">/</span> <span class="text-body">Hoá đơn VAT</span></div>
    <h4 class="mb-0">Hoá đơn VAT</h4>
  </div>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    @if (Model.CanManage)
    {
      <a href="/hoa-don/soan" class="btn btn-primary"><i class="ti ti-plus me-1"></i> Thêm hoá đơn</a>
    }
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value" id="@s.Id">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Ký hiệu / số / người mua / MST" /></div>
      <div class="col-md-3">
        <select id="f-status" class="form-select tk-auto">
          <option value="">Trạng thái</option>
          <option value="0">Nháp</option><option value="1">Đã phát hành</option><option value="2">Đã huỷ</option>
        </select>
      </div>
      <div class="col-md-3"></div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-dateFrom" class="form-control tk-datef" placeholder="Ngày HĐ từ" autocomplete="off" /></div>
      <div class="col-md-3"><input type="text" id="f-dateTo" class="form-control tk-datef" placeholder="Ngày HĐ đến" autocomplete="off" /></div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> hoá đơn đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-invoices"></div>
</div>

@Html.AntiForgeryToken()

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      var CAN_MANAGE = @(Model.CanManage ? "true" : "false");

      function refreshStats() {
        $.getJSON('?handler=Stats', function (s) {
          $('#kpi-total').text(money(s.total));
          $('#kpi-amount').text(money(s.totalAmount));
          $('#kpi-vat').text(money(s.totalVat));
          $('#kpi-issued').text(money(s.issued));
          $('#kpi-draft').text(money(s.draft));
          $('#kpi-cancelled').text(money(s.cancelled));
        });
      }

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá hoá đơn ' + r.number + '?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { grid.reload(); refreshStats(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      }

      // Sửa/xoá chỉ dành cho người CÓ quyền quản lý hoá đơn (giữ nguyên luật cũ).
      function actionsFor(r) {
        if (!CAN_MANAGE) { return []; }
        return [
          { label: '<i class="ti ti-edit me-2"></i>Sửa hoá đơn', action: function () { window.location = '/hoa-don/soan/' + r.id; } },
          { separator: true },
          { label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá hoá đơn</span>', action: function () { delRow(r); } }
        ];
      }

      var grid = tk.grid('#grid-invoices', {
        // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['status', 'dateFrom', 'dateTo'],
        exportName: 'hoa-don-da-chon.csv',
        actions: CAN_MANAGE ? actionsFor : null,
        onRowClick: CAN_MANAGE ? function (r) { window.location = '/hoa-don/soan/' + r.id; } : null,
        columns: [
          {
            title: 'Hoá đơn', field: 'number', widthGrow: 2, minWidth: 160,
            formatter: function (c) { var r = c.getData(); return g.stack(r.number, r.series); }
          },
          { title: 'Ngày', field: 'invoiceDate', width: 130,
            formatter: function (c) { return g.stack(c.getValue(), null); } },
          {
            title: 'Người mua', field: 'buyerName', widthGrow: 4, minWidth: 240,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-row-media">' + g.avatar(r.buyerName) +
                g.stack(r.buyerName, r.buyerTaxCode ? ('MST ' + r.buyerTaxCode) : null) + '</div>';
            }
          },
          {
            title: 'Giá trị', field: 'totalAmount', width: 160, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var vat = c.getTable().getData().reduce(function (a, r) { return a + (r.vatAmount || 0); }, 0);
              return '<span class="fw-semibold" title="Tổng VAT trang này: ' + money(vat) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(r.totalAmount) + '</div>' +
                '<div class="tk-cell-sub">VAT ' + money(r.vatAmount) + '</div></div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 140,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
