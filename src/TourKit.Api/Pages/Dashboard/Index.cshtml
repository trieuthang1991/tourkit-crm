@page
@model TourKit.Api.Pages.Dashboard.IndexModel
@{ ViewData["Title"] = "Tổng quan"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
  @if (Model.CanDeparture)
  {
    <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
  }
}

@section VendorScripts {
  <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
  @if (Model.CanDeparture)
  {
    <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
  }
}

@* Bám bố cục Dashboards/CRM (docs/vuexy-reference) — số liệu thật từ PageModel. *@

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h4 class="mb-1">Tổng quan điều hành</h4>
    <p class="text-muted mb-0">Dữ liệu kinh doanh thời gian thực</p>
  </div>
  @* Thao tác nhanh — bám dải nút QUICK của bản cũ, chỉ hiện nút có quyền. *@
  <div class="d-flex flex-wrap gap-2">
    @if (Model.CanBooking)  { <a href="/Orders" class="btn btn-label-primary btn-sm"><i class="ti ti-shopping-cart me-1"></i> Tạo đơn</a> }
    @if (Model.CanDeparture){ <a href="/Departures" class="btn btn-label-primary btn-sm"><i class="ti ti-flag me-1"></i> Tạo tour / LKH</a> }
    @if (Model.CanQuote)    { <a href="/Quotes/Edit" class="btn btn-label-primary btn-sm"><i class="ti ti-file-description me-1"></i> Tạo báo giá</a> }
    @if (Model.CanCustomer) { <a href="/Customers" class="btn btn-label-primary btn-sm"><i class="ti ti-user-plus me-1"></i> Tạo Data khách</a> }
    @if (Model.CanLead)     { <a href="/Leads" class="btn btn-label-primary btn-sm"><i class="ti ti-target me-1"></i> Tạo cơ hội</a> }
    @if (Model.CanTask)     { <a href="/WorkTasks" class="btn btn-label-primary btn-sm"><i class="ti ti-checkbox me-1"></i> Tạo công việc</a> }
  </div>
</div>

<h6 class="text-muted text-uppercase small mb-2">Doanh thu &amp; cơ hội</h6>
<div class="row">
  <!-- 4 thẻ số liệu (khuôn "Total Profit" card của CRM dashboard) -->
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="badge p-2 bg-label-primary mb-2 rounded"><i class="ti ti-cash ti-md"></i></div>
        <h5 class="card-title mb-1 pt-2">Doanh thu</h5>
        <small class="text-muted">Toàn bộ đơn hàng</small>
        <p class="mb-0 mt-1 fw-medium">@Model.Summary.TotalRevenue.ToString("#,##0")</p>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="badge p-2 bg-label-success mb-2 rounded"><i class="ti ti-wallet ti-md"></i></div>
        <h5 class="card-title mb-1 pt-2">Đã thu</h5>
        <small class="text-muted">Phiếu thu đã ghi nhận</small>
        <p class="mb-0 mt-1 fw-medium">@Model.Summary.TotalReceived.ToString("#,##0")</p>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="badge p-2 bg-label-warning mb-2 rounded"><i class="ti ti-alert-triangle ti-md"></i></div>
        <h5 class="card-title mb-1 pt-2">Còn phải thu</h5>
        <small class="text-muted">Công nợ khách</small>
        <p class="mb-0 mt-1 fw-medium">@Model.Summary.ReceivableOutstanding.ToString("#,##0")</p>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="badge p-2 bg-label-info mb-2 rounded"><i class="ti ti-trending-up ti-md"></i></div>
        <h5 class="card-title mb-1 pt-2">Lợi nhuận gộp</h5>
        <small class="text-muted">Doanh thu − chi phí</small>
        <p class="mb-0 mt-1 fw-medium @(Model.Summary.GrossProfit < 0 ? "text-danger" : "")">@Model.Summary.GrossProfit.ToString("#,##0")</p>
      </div>
    </div>
  </div>
</div>

@* ---- KPI nhóm 2: Chi phí & Công nợ (bản cũ có, bản trước thiếu hẳn) ---- *@
<h6 class="text-muted text-uppercase small mb-2">Chi phí &amp; công nợ</h6>
<div class="row">
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-secondary mb-2 rounded"><i class="ti ti-receipt-2 ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Tổng chi</h5><small class="text-muted">Chi phí trên sổ</small>
      <p class="mb-0 mt-1 fw-medium">@Model.Summary.TotalCost.ToString("#,##0")</p>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-info mb-2 rounded"><i class="ti ti-arrow-down-circle ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Tổng chi thực tế</h5><small class="text-muted">Phiếu chi đã ghi nhận</small>
      <p class="mb-0 mt-1 fw-medium">@Model.Summary.TotalPaid.ToString("#,##0")</p>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-danger mb-2 rounded"><i class="ti ti-building-store ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Công nợ NCC</h5><small class="text-muted">Còn phải trả</small>
      <p class="mb-0 mt-1 fw-medium">@Model.Summary.PayableOutstanding.ToString("#,##0")</p>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-success mb-2 rounded"><i class="ti ti-coin ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Lợi nhuận thực tế</h5><small class="text-muted">Đã thu − đã chi</small>
      <p class="mb-0 mt-1 fw-medium @(Model.ActualProfit < 0 ? "text-danger" : "")">@Model.ActualProfit.ToString("#,##0")</p>
    </div></div>
  </div>
</div>

@* ---- KPI nhóm 3: Lợi nhuận & Hiệu quả ---- *@
<h6 class="text-muted text-uppercase small mb-2">Lợi nhuận &amp; hiệu quả</h6>
<div class="row">
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-warning mb-2 rounded"><i class="ti ti-gift ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Tiền hoa hồng</h5><small class="text-muted">Toàn hệ thống</small>
      <p class="mb-0 mt-1 fw-medium">@Model.CommissionTotal.ToString("#,##0")</p>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-info mb-2 rounded"><i class="ti ti-percentage ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Tỉ lệ thu tiền</h5><small class="text-muted">Đã thu / doanh thu</small>
      <p class="mb-0 mt-1 fw-medium">@((Model.Kpi.CollectionRate * 100).ToString("0.0"))%</p>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-primary mb-2 rounded"><i class="ti ti-calculator ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Giá trị TB / đơn</h5><small class="text-muted">Doanh thu / số đơn</small>
      <p class="mb-0 mt-1 fw-medium">@Model.Kpi.AvgOrderValue.ToString("#,##0")</p>
    </div></div>
  </div>
  <div class="col-xl-3 col-md-6 col-6 mb-4">
    <div class="card h-100"><div class="card-body">
      <div class="badge p-2 bg-label-success mb-2 rounded"><i class="ti ti-shopping-cart ti-md"></i></div>
      <h5 class="card-title mb-1 pt-2">Số đơn</h5><small class="text-muted">Toàn hệ thống</small>
      <p class="mb-0 mt-1 fw-medium">@Model.Summary.OrderCount.ToString("#,##0")</p>
    </div></div>
  </div>
</div>

<div class="row">
  <!-- Doanh thu theo phòng ban (bar) -->
  <div class="col-12 col-xl-8 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between">
        <div class="card-title mb-0">
          <h5 class="mb-0">Doanh thu theo phòng ban</h5>
          <small class="text-muted">Doanh thu và lợi nhuận từng phòng</small>
        </div>
      </div>
      <div class="card-body">
        <div id="deptChart"></div>
      </div>
    </div>
  </div>

  <!-- Dòng tiền theo phương thức (donut) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="card h-100">
      <div class="card-header">
        <div class="card-title mb-0">
          <h5 class="mb-0">Tiền thu theo phương thức</h5>
          <small class="text-muted">Phiếu thu đã ghi nhận</small>
        </div>
      </div>
      <div class="card-body">
        <div id="cashDonut"></div>
      </div>
    </div>
  </div>

  <!-- Đơn hàng (khuôn "Statistics" card của Ecommerce dashboard) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title mb-0">Đơn hàng</h5>
        <small class="text-muted">Theo trạng thái và thanh toán</small>
      </div>
      <div class="card-body">
        <div class="row gy-3">
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-primary me-3 p-2"><i class="ti ti-shopping-cart ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.Orders.Total</h5><small>Tổng đơn</small></div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-info me-3 p-2"><i class="ti ti-check ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.Orders.Confirmed</h5><small>Đã xác nhận</small></div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-warning me-3 p-2"><i class="ti ti-clock ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.Orders.Draft</h5><small>Nháp/Giữ chỗ</small></div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-secondary me-3 p-2"><i class="ti ti-x ti-sm"></i></div>
              <div class="card-info"><h5 class="mb-0">@Model.Orders.Cancelled</h5><small>Đã huỷ</small></div>
            </div>
          </div>
        </div>
        <hr class="my-3" />
        <div class="row gy-3">
          <div class="col-4 text-center">
            <span class="badge bg-label-danger mb-1">@Model.Orders.Unpaid</span>
            <small class="d-block">Chưa TT</small>
          </div>
          <div class="col-4 text-center">
            <span class="badge bg-label-warning mb-1">@Model.Orders.Deposit</span>
            <small class="d-block">Đã cọc</small>
          </div>
          <div class="col-4 text-center">
            <span class="badge bg-label-success mb-1">@Model.Orders.Paid</span>
            <small class="d-block">TT đủ</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Phễu báo giá (KPI) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title mb-0">Phễu báo giá</h5>
        <small class="text-muted">Báo giá → chấp nhận → chuyển đơn</small>
      </div>
      <div class="card-body">
        <ul class="list-unstyled mb-0">
          <li class="d-flex justify-content-between align-items-center mb-3">
            <span><i class="ti ti-file-text text-primary me-2"></i>Báo giá đã tạo</span>
            <h5 class="mb-0">@Model.Kpi.QuoteCount</h5>
          </li>
          <li class="d-flex justify-content-between align-items-center mb-3">
            <span><i class="ti ti-thumb-up text-success me-2"></i>Được chấp nhận</span>
            <h5 class="mb-0">@Model.Kpi.QuoteAcceptedCount</h5>
          </li>
          <li class="d-flex justify-content-between align-items-center mb-3">
            <span><i class="ti ti-transform text-info me-2"></i>Đã chuyển đơn</span>
            <h5 class="mb-0">@Model.Kpi.QuoteConvertedCount</h5>
          </li>
        </ul>
        <hr class="my-3" />
        <div class="mb-3">
          <div class="d-flex justify-content-between mb-1"><small>Tỉ lệ chấp nhận</small><small class="fw-medium">@((Model.Kpi.AcceptanceRate * 100).ToString("0.#"))%</small></div>
          <div class="progress" style="height:6px"><div class="progress-bar bg-success" style="width:@Math.Min(100, Model.Kpi.AcceptanceRate * 100)%"></div></div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between mb-1"><small>Tỉ lệ chuyển đơn</small><small class="fw-medium">@((Model.Kpi.ConversionRate * 100).ToString("0.#"))%</small></div>
          <div class="progress" style="height:6px"><div class="progress-bar bg-info" style="width:@Math.Min(100, Model.Kpi.ConversionRate * 100)%"></div></div>
        </div>
        <div>
          <div class="d-flex justify-content-between mb-1"><small>Tỉ lệ thu tiền</small><small class="fw-medium">@((Model.Kpi.CollectionRate * 100).ToString("0.#"))%</small></div>
          <div class="progress" style="height:6px"><div class="progress-bar bg-primary" style="width:@Math.Min(100, Model.Kpi.CollectionRate * 100)%"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top khách hàng -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between">
        <div class="card-title mb-0">
          <h5 class="mb-0">Top khách hàng</h5>
          <small class="text-muted">Theo doanh thu</small>
        </div>
        <a href="/Customers" class="btn btn-sm btn-label-primary">Tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Khách hàng</th><th class="text-end">Doanh thu</th><th class="text-end">Đã thu</th></tr></thead>
          <tbody>
          @if (Model.TopCustomers.Count == 0)
          {
            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr>
          }
          @foreach (var c in Model.TopCustomers)
          {
            <tr>
              <td><a href="/Customers/Details/@c.CustomerId" class="fw-medium">@c.CustomerName</a></td>
              <td class="text-end">@c.Revenue.ToString("#,##0")</td>
              <td class="text-end">@c.Received.ToString("#,##0")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@if (Model.CanCare)
{
  @* Quản lý lịch hẹn — bản cũ có bảng CSKH ngay trên Tổng quan. *@
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Quản lý lịch hẹn</h5>
      <a href="/CustomerCares" class="btn btn-sm btn-label-primary">Tất cả</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Tiêu đề</th><th>Khách hàng</th><th>Nội dung</th><th>Nhắc lúc</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @if (Model.Cares.Count == 0)
        {
          <tr><td colspan="5" class="text-center text-muted py-4">Chưa có lịch hẹn</td></tr>
        }
        @foreach (var c in Model.Cares)
        {
          <tr>
            <td class="fw-medium">@c.Title</td>
            <td>@(c.CustomerName ?? "—")</td>
            <td class="text-muted">@(string.IsNullOrWhiteSpace(c.Detail) ? "—" : c.Detail)</td>
            <td>@(c.RemindAt?.ToLocalTime().ToString("HH:mm dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td>
            <td><span class="badge bg-label-@TourKit.Api.Pages.Dashboard.IndexModel.CareStatusColor(c.Status)">@TourKit.Api.Pages.Dashboard.IndexModel.CareStatusLabel(c.Status)</span></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
}

@* Hiệu suất theo CHI NHÁNH — khác với "theo phòng ban" ở trên, bản cũ có cả hai. *@
<div class="card mb-4">
  <div class="card-header"><h5 class="mb-0">Hiệu suất theo chi nhánh</h5></div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr>
        <th>Chi nhánh</th><th class="text-end">Số đơn</th><th class="text-end">Doanh thu</th>
        <th class="text-end">Thực thu</th><th class="text-end">Còn thiếu</th><th class="text-end">Lợi nhuận</th>
      </tr></thead>
      <tbody>
      @if (Model.ByBranch.Count == 0)
      {
        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu chi nhánh</td></tr>
      }
      @foreach (var b in Model.ByBranch)
      {
        <tr>
          <td class="fw-medium">@b.BranchName</td>
          <td class="text-end">@b.OrderCount.ToString("#,##0")</td>
          <td class="text-end">@b.Turnover.ToString("#,##0")</td>
          <td class="text-end text-success">@b.Received.ToString("#,##0")</td>
          <td class="text-end @(b.Outstanding > 0 ? "text-danger" : "")">@b.Outstanding.ToString("#,##0")</td>
          <td class="text-end">@b.Profit.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@* Vinh danh chiến binh sales — top 5 theo doanh thu, kèm hoa hồng. *@
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Vinh danh chiến binh sales</h5>
    <a href="/CommissionBySourceReport" class="btn btn-sm btn-label-primary">Báo cáo hoa hồng</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Nhân viên</th><th class="text-end">Doanh thu</th><th class="text-end">Hoa hồng</th></tr></thead>
      <tbody>
      @if (Model.TopSales.Count == 0)
      {
        <tr><td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
      }
      @foreach (var s in Model.TopSales)
      {
        <tr>
          <td class="fw-medium">@s.Name</td>
          <td class="text-end">@s.Turnover.ToString("#,##0")</td>
          <td class="text-end text-success">@s.Commission.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@if (Model.CanDeparture)
{
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Lịch khởi hành</h5>
      <a href="/OperationCalendar" class="small">Xem lịch điều hành →</a>
    </div>
    <div class="card-body"><div id="cal"></div></div>
  </div>
}

@section PageScripts {
  <script>
    // Data thật serialize từ PageModel — option/style bám dashboards-crm.js của template.
    var DEPT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDepartment.Select(d => new { name = d.DepartmentName, turnover = d.Turnover, profit = d.Profit })));
    var CASH = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlow.Where(c => c.Inflow > 0).Select(c => new { method = c.PaymentMethod, inflow = c.Inflow })));

    $(function () {
      var label = '#a8aaae', border = '#dbdade';

      if (DEPT.length) {
        new ApexCharts(document.querySelector('#deptChart'), {
          chart: { type: 'bar', height: 320, toolbar: { show: false } },
          series: [
            { name: 'Doanh thu', data: DEPT.map(function (d) { return d.turnover; }) },
            { name: 'Lợi nhuận', data: DEPT.map(function (d) { return d.profit; }) }
          ],
          colors: ['#7367f0', '#28c76f'],
          plotOptions: { bar: { columnWidth: '40%', borderRadius: 4 } },
          dataLabels: { enabled: false },
          legend: { labels: { colors: label } },
          xaxis: { categories: DEPT.map(function (d) { return d.name; }), labels: { style: { colors: label } }, axisBorder: { show: false } },
          yaxis: { labels: { style: { colors: label }, formatter: function (v) { return tk.money(v); } } },
          grid: { borderColor: border, strokeDashArray: 6 },
          tooltip: { y: { formatter: function (v) { return tk.money(v); } } }
        }).render();
      } else {
        $('#deptChart').html('<p class="text-muted text-center py-5 mb-0">Chưa có dữ liệu doanh thu.</p>');
      }

      if (CASH.length) {
        new ApexCharts(document.querySelector('#cashDonut'), {
          chart: { type: 'donut', height: 320 },
          series: CASH.map(function (c) { return c.inflow; }),
          labels: CASH.map(function (c) { return c.method; }),
          colors: ['#7367f0', '#28c76f', '#00cfe8', '#ff9f43', '#ea5455', '#a8aaae'],
          legend: { position: 'bottom', labels: { colors: label } },
          dataLabels: { enabled: false },
          stroke: { width: 0 },
          tooltip: { y: { formatter: function (v) { return tk.money(v); } } }
        }).render();
      } else {
        $('#cashDonut').html('<p class="text-muted text-center py-5 mb-0">Chưa có phiếu thu nào.</p>');
      }

      @if (Model.CanDeparture)
      {
        <text>
      // Lịch khởi hành: dùng CHUNG nguồn sự kiện của màn Lịch điều hành — chỉ nạp khoảng đang xem.
      var calEl = document.querySelector('#cal');
      if (calEl && window.Calendar) {
        new Calendar(calEl, {
          plugins: [dayGridPlugin, interactionPlugin],
          initialView: 'dayGridMonth', locale: 'vi',
          // height:'auto' — KHÔNG ép chiều cao. Lưới tháng cần ~710px; ép 520 thì thanh cuộn trong
          // của FullCalendar bị overflow:hidden nên nội dung TRÀN ra ngoài card, đè lên chân trang.
          // Giống hệt cấu hình màn Lịch điều hành đang chạy đúng.
          height: 'auto',
          firstDay: 1,        // tuần bắt đầu Thứ 2, đồng bộ với màn Lịch điều hành
          dayMaxEvents: 3,    // ngày nhiều chuyến thì gộp "+n" thay vì kéo dãn hàng
          headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
          buttonText: { today: 'Hôm nay' },
          events: function (info, success, failure) {
            $.getJSON('/OperationCalendar?handler=Events&start=' + info.startStr + '&end=' + info.endStr)
              .done(function (d) { success((d && d.events) || []); })
              .fail(failure);
          },
          eventClick: function (i) { location.href = '/Departures/Detail/' + i.event.id; }
        }).render();
      }
        </text>
      }
    });
  </script>
}
