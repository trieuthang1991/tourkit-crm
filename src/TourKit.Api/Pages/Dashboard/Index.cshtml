@page
@using System.Globalization
@model TourKit.Api.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Tổng quan";
    var vi = new CultureInfo("vi-VN");

    // Số tiền ở thẻ tóm tắt rút gọn; số đầy đủ nằm ở tooltip. "94.323.595.000" ở cỡ chữ lớn
    // thì không liếc được, mà thẻ tổng quan là chỗ để LIẾC.
    string Short(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000_000m) { return (v / 1_000_000_000m).ToString("0.#", vi) + " tỷ"; }
        if (a >= 1_000_000m) { return (v / 1_000_000m).ToString("0.#", vi) + " tr"; }
        if (a >= 1_000m) { return (v / 1_000m).ToString("0.#", vi) + " ng"; }
        return v.ToString("#,##0", vi);
    }
    string Full(decimal v) => v.ToString("#,##0", vi) + " ₫";

    // Avatar chữ cái + tông màu bám TÊN — cùng một người luôn ra một màu, nhận ra nhanh hơn đọc chữ.
    string[] tones = ["primary", "info", "success", "warning", "danger", "secondary"];
    string ToneOf(string? name)
    {
        var h = 0;
        foreach (var ch in name ?? "") { h = unchecked(h * 31 + ch); }
        return tones[Math.Abs(h) % tones.Length];
    }
    string Initials(string? name)
    {
        var w = (name ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (w.Length == 0) { return "?"; }
        return (w.Length == 1 ? w[0][..Math.Min(2, w[0].Length)] : string.Concat(w[^2][0], w[^1][0])).ToUpperInvariant();
    }
    // Tỉ lệ so với giá trị lớn nhất trong bảng — dài ngắn của thanh nói ngay ai hơn ai.
    int Pct(decimal v, decimal max) => max > 0 ? (int)Math.Round(100m * v / max) : 0;
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
  @if (Model.CanDeparture)
  {
    <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
  }
}

@section VendorScripts {
  <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
  @if (Model.CanDeparture)
  {
    <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
  }
}

@* Bám bố cục Dashboards/CRM (docs/vuexy-reference) — số liệu thật từ PageModel. *@

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h4 class="mb-1">Tổng quan điều hành</h4>
    <p class="text-muted mb-0">Dữ liệu kinh doanh thời gian thực</p>
  </div>
  @* Thao tác nhanh — bám dải nút QUICK của bản cũ, chỉ hiện nút có quyền. *@
  <div class="d-flex flex-wrap gap-2">
    @if (Model.CanBooking)  { <a href="/don-hang" class="btn btn-label-primary btn-sm"><i class="ti ti-shopping-cart me-1"></i> Tạo đơn</a> }
    @if (Model.CanDeparture){ <a href="/chuyen-di" class="btn btn-label-primary btn-sm"><i class="ti ti-flag me-1"></i> Tạo tour / LKH</a> }
    @if (Model.CanQuote)    { <a href="/bao-gia/soan" class="btn btn-label-primary btn-sm"><i class="ti ti-file-description me-1"></i> Tạo báo giá</a> }
    @if (Model.CanCustomer) { <a href="/khach-hang" class="btn btn-label-primary btn-sm"><i class="ti ti-user-plus me-1"></i> Tạo Data khách</a> }
    @if (Model.CanLead)     { <a href="/co-hoi" class="btn btn-label-primary btn-sm"><i class="ti ti-target me-1"></i> Tạo cơ hội</a> }
    @if (Model.CanTask)     { <a href="/cong-viec" class="btn btn-label-primary btn-sm"><i class="ti ti-checkbox me-1"></i> Tạo công việc</a> }
  </div>
</div>

@* Bốn con số TRẢ LỜI câu hỏi hay hỏi nhất: bán được bao nhiêu · thu về bao nhiêu ·
   còn kẹt bao nhiêu · thực lãi bao nhiêu. Mười hai thẻ ngang hàng như bản trước thì
   không con số nào nổi lên, phải đọc hết mới biết cái nào quan trọng. *@
<div class="tk-kpi-row mb-4">
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-primary"><i class="ti ti-cash"></i></span>
    <div class="tk-kpi-label">Doanh thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.TotalRevenue)">@Short(Model.Summary.TotalRevenue)</div>
    <span class="tk-kpi-sub text-muted">toàn bộ đơn hàng</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-success"><i class="ti ti-wallet"></i></span>
    <div class="tk-kpi-label">Đã thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.TotalReceived)">@Short(Model.Summary.TotalReceived)</div>
    <span class="tk-kpi-sub text-muted">@((Model.Kpi.CollectionRate * 100).ToString("0.#", vi))% doanh thu</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-warning"><i class="ti ti-alert-triangle"></i></span>
    <div class="tk-kpi-label">Còn phải thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.ReceivableOutstanding)">@Short(Model.Summary.ReceivableOutstanding)</div>
    <span class="tk-kpi-sub text-muted">công nợ khách</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-info"><i class="ti ti-coin"></i></span>
    <div class="tk-kpi-label">Lợi nhuận thực tế</div>
    <div class="tk-kpi-value @(Model.ActualProfit < 0 ? "text-danger" : "")" title="@Full(Model.ActualProfit)">@Short(Model.ActualProfit)</div>
    <span class="tk-kpi-sub text-muted">đã thu − đã chi</span>
  </div>
</div>

<div class="row g-4 mb-4">
  @* Bốn con số so sánh được (doanh thu vs đã thu, tổng chi vs đã chi) VẼ RA thì thấy ngay phần
     nào còn kẹt — liệt kê rời từng số thì phải tự trừ nhẩm. *@
  <div class="col-12 col-xl-8">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Thu &amp; chi</h6>
          <small class="text-muted">Phần đã thực hiện và phần còn lại</small>
        </div>
      </div>
      <div class="tk-card-body">
        <div id="moneyChart" style="min-height:200px"></div>
      </div>
    </div>
  </div>

  @* Bốn số còn lại là số ĐỘC LẬP, không so với cái gì — để nguyên dạng chữ. *@
  <div class="col-12 col-xl-4">
    <div class="tk-card h-100">
      <div class="tk-card-head"><h6 class="mb-0">Chỉ số kinh doanh</h6></div>
      <div class="tk-card-body">
        <div class="tk-figures">
          <div class="tk-figure"><small>Số đơn</small><b>@Model.Summary.OrderCount.ToString("#,##0", vi)</b></div>
          <div class="tk-figure"><small>Giá trị TB / đơn</small><b title="@Full(Model.Kpi.AvgOrderValue)">@Short(Model.Kpi.AvgOrderValue)</b></div>
          <div class="tk-figure"><small>Tiền hoa hồng</small><b title="@Full(Model.CommissionTotal)">@Short(Model.CommissionTotal)</b></div>
          <div class="tk-figure"><small>Tỉ lệ thu tiền</small><b>@((Model.Kpi.CollectionRate * 100).ToString("0.#", vi))%</b></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <!-- Doanh thu theo phòng ban (bar) -->
  <div class="col-12 col-xl-8 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Doanh thu theo phòng ban</h6>
          <small class="text-muted">Doanh thu và lợi nhuận từng phòng</small>
        </div>
      </div>
      <div class="tk-card-body">
        <div id="deptChart"></div>
      </div>
    </div>
  </div>

  <!-- Dòng tiền theo phương thức (donut) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Tiền thu theo phương thức</h6>
          <small class="text-muted">Phiếu thu đã ghi nhận</small>
        </div>
      </div>
      <div class="tk-card-body">
        <div id="cashDonut"></div>
      </div>
    </div>
  </div>

  <!-- Đơn hàng (khuôn "Statistics" card của Ecommerce dashboard) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Đơn hàng</h6>
          <small class="text-muted">Theo trạng thái và thanh toán</small>
        </div>
      </div>
      <div class="tk-card-body">
        @* Vòng tròn nói ngay tỉ trọng từng trạng thái; bốn con số rời như trước phải tự chia nhẩm. *@
        <div id="orderDonut" style="min-height:210px"></div>
        <div class="tk-split-label">
          <span>Tình trạng thanh toán</span>
          <span class="text-muted">@Model.Orders.Total.ToString("#,##0", vi) đơn</span>
        </div>
        @{
            var oTotal = Math.Max(Model.Orders.Total, 1);
            var pUnpaid = 100m * Model.Orders.Unpaid / oTotal;
            var pDeposit = 100m * Model.Orders.Deposit / oTotal;
            var pPaid = 100m * Model.Orders.Paid / oTotal;
        }
        <div class="tk-split" title="Chưa TT @Model.Orders.Unpaid · Đã cọc @Model.Orders.Deposit · TT đủ @Model.Orders.Paid">
          <span class="bg-danger" style="width:@pUnpaid.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
          <span class="bg-warning" style="width:@pDeposit.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
          <span class="bg-success" style="width:@pPaid.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
        </div>
        <div class="tk-legend">
          <span><i class="bg-danger"></i>Chưa TT @Model.Orders.Unpaid.ToString("#,##0", vi)</span>
          <span><i class="bg-warning"></i>Đã cọc @Model.Orders.Deposit.ToString("#,##0", vi)</span>
          <span><i class="bg-success"></i>TT đủ @Model.Orders.Paid.ToString("#,##0", vi)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Phễu báo giá (KPI) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Phễu báo giá</h6>
          <small class="text-muted">Báo giá → chấp nhận → chuyển đơn</small>
        </div>
      </div>
      <div class="tk-card-body">
        @* Phễu vẽ thành cột NGANG: độ hụt giữa các bước nhìn là thấy, không phải so ba con số rời. *@
        <div id="quoteFunnel" style="min-height:180px"></div>
        <div class="tk-figures mt-3">
          <div class="tk-figure"><small>Tỉ lệ chấp nhận</small><b>@((Model.Kpi.AcceptanceRate * 100).ToString("0.#", vi))%</b></div>
          <div class="tk-figure"><small>Tỉ lệ chuyển đơn</small><b>@((Model.Kpi.ConversionRate * 100).ToString("0.#", vi))%</b></div>
          <div class="tk-figure"><small>Tỉ lệ thu tiền</small><b>@((Model.Kpi.CollectionRate * 100).ToString("0.#", vi))%</b></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top khách hàng -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Top khách hàng</h6>
          <small class="text-muted">Theo doanh thu</small>
        </div>
        <a href="/khach-hang" class="btn btn-sm btn-label-primary">Tất cả</a>
      </div>
      <div class="tk-card-body">
        @if (Model.TopCustomers.Count == 0)
        {
          <p class="text-muted mb-0 py-4 text-center">Chưa có dữ liệu.</p>
        }
        else
        {
          var maxRev = Model.TopCustomers.Max(x => x.Revenue);
          <div class="tk-rank">
            @{ var i = 0; }
            @foreach (var c in Model.TopCustomers.Take(7))
            {
              i++;
              var rate = c.Revenue > 0 ? (int)Math.Round(100m * c.Received / c.Revenue) : 0;
              <a class="tk-rank-row" href="/khach-hang/@c.CustomerId">
                <span class="tk-rank-no @(i <= 3 ? "is-top" : "")">@i</span>
                <span class="tk-rank-av bg-label-@ToneOf(c.CustomerName)">@Initials(c.CustomerName)</span>
                <span class="tk-rank-main">
                  <b>@c.CustomerName</b>
                  <span class="tk-rank-bar"><i style="width:@Math.Max(Pct(c.Revenue, maxRev), 2)%"></i></span>
                </span>
                <span class="tk-rank-val">
                  <b title="@Full(c.Revenue)">@Short(c.Revenue)</b>
                  <small class="@(rate >= 80 ? "text-success" : rate > 0 ? "text-warning" : "text-danger")">đã thu @rate%</small>
                </span>
              </a>
            }
          </div>
        }
      </div>
    </div>
  </div>
</div>

@* Ba thẻ này nội dung ít: xếp mỗi thẻ một hàng ngang thì trang dài ra mà nửa bề ngang bỏ trống.
   Gom vào MỘT hàng ba cột, màn hẹp thì tự xuống dòng. *@
<div class="row g-4 mb-4">
  @if (Model.CanCare)
  {
    <div class="col-12 col-lg-6 col-xxl-4">
      @* Quản lý lịch hẹn — danh sách quét được: khách + tiêu đề + hạn, việc QUÁ HẠN đỏ lên trước.
         Bảng 5 cột chữ đều nhau thì không biết nên gọi ai trước. *@
      <div class="tk-card h-100">
        <div class="tk-card-head">
          <div>
            <h6 class="mb-0">Quản lý lịch hẹn</h6>
            <small class="text-muted">Lịch chăm sóc chưa hoàn thành</small>
          </div>
          <a href="/lich-hen" class="btn btn-sm btn-label-primary">Tất cả</a>
        </div>
        <div class="tk-card-body">
          @if (Model.Cares.Count == 0)
          {
            <p class="text-muted mb-0 py-4 text-center">Chưa có lịch hẹn</p>
          }
          else
          {
            var todayD = TourKit.Api.Pages.Shared.TkDate.Day(DateTimeOffset.Now);
            @* Giữ 6 dòng cho ba thẻ cùng hàng cao xấp xỉ nhau; xem đủ thì bấm "Tất cả". *@
            <div class="tk-cares">
              @foreach (var c in Model.Cares.Take(6))
              {
                var due = c.RemindAt is { } r0 ? TourKit.Api.Pages.Shared.TkDate.Day(r0) : (DateTimeOffset?)null;
                var late = due is { } d0 && d0 < todayD && c.Status != 2;
                var isToday = due == todayD;
                <div class="tk-care @(late ? "is-late" : "")">
                  <span class="tk-rank-av bg-label-@ToneOf(c.CustomerName)">@Initials(c.CustomerName)</span>
                  <div class="tk-care-main">
                    <b>@c.Title</b>
                    <small>@(c.CustomerName ?? "—")</small>
                  </div>
                  <div class="tk-care-when">
                    <b class="@(late ? "text-danger" : isToday ? "text-primary" : "")">
                      @(due is null ? "Chưa hẹn" : late ? "Quá hạn" : isToday ? "Hôm nay" : due!.Value.ToString("dd/MM", vi))
                    </b>
                    <small>@(due?.ToString("dd/MM/yyyy", vi) ?? "—")</small>
                  </div>
                  <span class="badge bg-label-@TourKit.Api.Pages.Dashboard.IndexModel.CareStatusColor(c.Status)">@TourKit.Api.Pages.Dashboard.IndexModel.CareStatusLabel(c.Status)</span>
                </div>
              }
            </div>
          }
        </div>
      </div>
    </div>
  }
  <div class="col-12 col-lg-6 col-xxl-4">
    @* Hiệu suất theo CHI NHÁNH — cột xếp chồng: phần xanh là tiền đã về, phần đỏ là tiền còn
       kẹt. Nhìn tỉ lệ hai màu là biết chi nhánh nào thu tốt, khỏi đọc sáu cột số. *@
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Hiệu suất theo chi nhánh</h6>
          <small class="text-muted">Đã thu và còn thiếu trên doanh thu</small>
        </div>
      </div>
      <div class="tk-card-body">
        @if (Model.ByBranch.Count == 0)
        {
          <p class="text-muted mb-0 py-4 text-center">Chưa có dữ liệu chi nhánh</p>
        }
        else
        {
          <div id="branchChart" style="min-height:220px"></div>
          <div class="tk-figures mt-3">
            @foreach (var br in Model.ByBranch)
            {
              var rate = br.Turnover > 0 ? (int)Math.Round(100m * br.Received / br.Turnover) : 0;
              <div class="tk-figure">
                <small>@br.BranchName</small>
                <b>@br.OrderCount.ToString("#,##0", vi) đơn · thu @rate%</b>
              </div>
            }
          </div>
        }
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6 col-xxl-4">
    @* Vinh danh chiến binh sales — bảng xếp hạng, không phải bảng số: thứ hạng và tỉ trọng
       doanh thu phải nhìn ra ngay, đọc con số là bước sau. *@
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Vinh danh chiến binh sales</h6>
          <small class="text-muted">Doanh thu và hoa hồng theo nhân viên</small>
        </div>
        <a href="/hoa-hong-theo-nguon" class="btn btn-sm btn-label-primary">Báo cáo hoa hồng</a>
      </div>
      <div class="tk-card-body">
        @if (Model.TopSales.Count == 0)
        {
          <p class="text-muted mb-0 py-4 text-center">Chưa có dữ liệu</p>
        }
        else
        {
          var maxSale = Model.TopSales.Max(x => x.Turnover);
          <div class="tk-rank">
            @{ var si = 0; }
            @foreach (var sale in Model.TopSales)
            {
              si++;
              <div class="tk-rank-row">
                <span class="tk-rank-no @(si <= 3 ? "is-top" : "")">@si</span>
                <span class="tk-rank-av bg-label-@ToneOf(sale.Name)">@Initials(sale.Name)</span>
                <span class="tk-rank-main">
                  <b>@sale.Name</b>
                  <span class="tk-rank-bar"><i style="width:@Math.Max(Pct(sale.Turnover, maxSale), 2)%"></i></span>
                </span>
                <span class="tk-rank-val">
                  <b title="@Full(sale.Turnover)">@Short(sale.Turnover)</b>
                  <small class="@(sale.Commission > 0 ? "text-success" : "text-muted")">HH @Short(sale.Commission)</small>
                </span>
              </div>
            }
          </div>
        }
      </div>
    </div>
  </div>
</div>


@if (Model.CanDeparture)
{
  <div class="tk-card mb-4">
    <div class="tk-card-head">
      <h6 class="mb-0">Lịch khởi hành</h6>
      <a href="/lich-dieu-hanh" class="small">Xem lịch điều hành →</a>
    </div>
    <div class="tk-card-body"><div id="cal"></div></div>
  </div>
}

@section PageScripts {
  <script>
    // Data thật serialize từ PageModel — option/style bám dashboards-crm.js của template.
    var DEPT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDepartment.Select(d => new { name = d.DepartmentName, turnover = d.Turnover, profit = d.Profit })));
    var CASH = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlow.Where(c => c.Inflow > 0).Select(c => new { method = c.PaymentMethod, inflow = c.Inflow })));

    $(function () {
      var label = '#a8aaae', border = '#dbdade';
      // Rút gọn tiền cho nhãn biểu đồ — số đầy đủ vẫn nằm ở tooltip.
      function money(v) {
        v = Number(v) || 0;
        if (Math.abs(v) >= 1e9) { return (v / 1e9).toFixed(1).replace('.', ',') + ' tỷ'; }
        if (Math.abs(v) >= 1e6) { return Math.round(v / 1e6) + ' tr'; }
        return v.toLocaleString('vi-VN');
      }

      if (DEPT.length) {
        new ApexCharts(document.querySelector('#deptChart'), {
          chart: { type: 'bar', height: 320, toolbar: { show: false } },
          series: [
            { name: 'Doanh thu', data: DEPT.map(function (d) { return d.turnover; }) },
            { name: 'Lợi nhuận', data: DEPT.map(function (d) { return d.profit; }) }
          ],
          colors: ['#7367f0', '#28c76f'],
          plotOptions: { bar: { columnWidth: '40%', borderRadius: 4 } },
          dataLabels: { enabled: false },
          legend: { labels: { colors: label } },
          xaxis: { categories: DEPT.map(function (d) { return d.name; }), labels: { style: { colors: label } }, axisBorder: { show: false } },
          // Trục tiền RÚT GỌN: "50.000.000.000" chiếm gần nửa bề ngang biểu đồ, đọc cũng không kịp.
          yaxis: { labels: { style: { colors: label }, formatter: money } },
          grid: { borderColor: border, strokeDashArray: 6 },
          tooltip: { y: { formatter: function (v) { return tk.money(v); } } }
        }).render();
      } else {
        $('#deptChart').html('<p class="text-muted text-center py-5 mb-0">Chưa có dữ liệu doanh thu.</p>');
      }

      // Thu & chi — hai thanh xếp chồng: phần đã thực hiện và phần còn lại.
      var moneyEl = document.querySelector('#moneyChart');
      if (moneyEl) {
        new ApexCharts(moneyEl, {
          // KHÔNG dùng stackType 100%: chi thực tế đang LỚN HƠN chi trên sổ (chi vượt), quy về
          // 100% thì thanh đó đầy xanh trông như "đã chi đủ", che mất chuyện vượt chi.
          chart: { type: 'bar', height: 200, stacked: true, toolbar: { show: false }, parentHeightOffset: 0 },
          series: [
            { name: 'Đã thực hiện', data: [@Model.Summary.TotalReceived, @Model.Summary.TotalPaid] },
            { name: 'Còn lại', data: [@Model.Summary.ReceivableOutstanding, @(Model.Summary.PayableOutstanding < 0 ? 0 : Model.Summary.PayableOutstanding)] }
          ],
          colors: ['#28c76f', '#ff9f43'],
          plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: '58%' } },
          dataLabels: { enabled: true, style: { fontSize: '11px', colors: ['#fff'] },
                        // Chỉ ghi nhãn trên khúc đủ rộng, khúc mỏng ghi vào là chữ đè lên nhau.
                        formatter: function (v, o) {
                          var row = o.w.globals.stackedSeriesTotals[o.dataPointIndex] || 1;
                          return v / row >= .12 ? money(v) : '';
                        } },
          legend: { position: 'bottom', labels: { colors: label }, markers: { width: 8, height: 8 } },
          // TẮT kẻ ngang: biểu đồ cột NGANG thì đường kẻ ngang chạy xuyên qua thân cột, nhìn như
          // gạch chéo đè lên hình. Kẻ dọc theo trục tiền mới là thứ giúp ước lượng.
          grid: { borderColor: border, strokeDashArray: 6,
                  xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } },
                  padding: { left: 4, right: 12 } },
          xaxis: { categories: ['Doanh thu', 'Chi phí'],
                   labels: { formatter: money, style: { colors: label } }, axisBorder: { show: false }, axisTicks: { show: false } },
          yaxis: { labels: { style: { colors: label, fontWeight: 500 }, maxWidth: 160 } },
          tooltip: { y: { formatter: function (v) { return tk.money(v) + ' ₫'; } } }
        }).render();
      }

      // Hiệu suất chi nhánh — đã thu vs còn thiếu trên cùng một cột.
      var branchEl = document.querySelector('#branchChart');
      if (branchEl) {
        new ApexCharts(branchEl, {
          chart: { type: 'bar', height: 220, stacked: true, toolbar: { show: false }, parentHeightOffset: 0 },
          series: [
            { name: 'Đã thu', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByBranch.Select(x => x.Received))) },
            { name: 'Còn thiếu', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByBranch.Select(x => x.Outstanding))) }
          ],
          colors: ['#28c76f', '#ea5455'],
          plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: '46%' } },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', labels: { colors: label }, markers: { width: 8, height: 8 } },
          grid: { borderColor: border, strokeDashArray: 6,
                  xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } },
                  padding: { left: 4, right: 8 } },
          xaxis: { categories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByBranch.Select(x => x.BranchName))),
                   labels: { formatter: money, style: { colors: label } }, axisBorder: { show: false }, axisTicks: { show: false } },
          yaxis: { labels: { style: { colors: label }, maxWidth: 130 } },
          tooltip: { y: { formatter: function (v) { return tk.money(v) + ' ₫'; } } }
        }).render();
      }

      // Đơn hàng theo trạng thái — vòng tròn có TỔNG ở giữa.
      var ORDER = [@Model.Orders.Confirmed, @Model.Orders.Draft, @Model.Orders.Cancelled];
      if (ORDER.some(function (v) { return v > 0; })) {
        new ApexCharts(document.querySelector('#orderDonut'), {
          chart: { type: 'donut', height: 210 },
          series: ORDER,
          labels: ['Đã xác nhận', 'Nháp/Giữ chỗ', 'Đã huỷ'],
          colors: ['#28c76f', '#ff9f43', '#a8aaae'],
          legend: { position: 'bottom', labels: { colors: label }, fontSize: '12px', markers: { width: 8, height: 8 } },
          dataLabels: { enabled: false }, stroke: { width: 0 },
          plotOptions: { pie: { donut: { size: '70%', labels: { show: true,
            value: { formatter: function (v) { return Number(v).toLocaleString('vi-VN'); } },
            total: { show: true, label: 'Tổng đơn', color: label,
                     formatter: function () { return (@Model.Orders.Total).toLocaleString('vi-VN'); } } } } } },
          tooltip: { y: { formatter: function (v) { return Number(v).toLocaleString('vi-VN') + ' đơn'; } } }
        }).render();
      } else {
        $('#orderDonut').html('<p class="text-muted text-center py-5 mb-0">Chưa có đơn hàng nào.</p>');
      }

      // Phễu báo giá — cột ngang, độ hụt giữa các bước nhìn là thấy.
      var FUNNEL = [@Model.Kpi.QuoteCount, @Model.Kpi.QuoteAcceptedCount, @Model.Kpi.QuoteConvertedCount];
      if (FUNNEL[0] > 0) {
        new ApexCharts(document.querySelector('#quoteFunnel'), {
          chart: { type: 'bar', height: 180, toolbar: { show: false }, parentHeightOffset: 0 },
          series: [{ name: 'Số lượng', data: FUNNEL }],
          colors: ['#7367f0', '#00cfe8', '#28c76f'],
          plotOptions: { bar: { horizontal: true, distributed: true, borderRadius: 4, barHeight: '58%' } },
          dataLabels: { enabled: true, textAnchor: 'start', offsetX: 4,
                        style: { fontSize: '11px', colors: ['#5d596c'] },
                        formatter: function (v) { return Number(v).toLocaleString('vi-VN'); } },
          legend: { show: false },
          grid: { borderColor: border, strokeDashArray: 6,
                  xaxis: { lines: { show: true } }, yaxis: { lines: { show: false } },
                  padding: { left: 4, right: 16 } },
          xaxis: { categories: ['Báo giá đã tạo', 'Được chấp nhận', 'Đã chuyển đơn'],
                   labels: { style: { colors: label } }, axisBorder: { show: false }, axisTicks: { show: false } },
          yaxis: { labels: { style: { colors: label }, maxWidth: 120 } },
          tooltip: { y: { formatter: function (v) { return Number(v).toLocaleString('vi-VN'); } } }
        }).render();
      } else {
        $('#quoteFunnel').html('<p class="text-muted text-center py-5 mb-0">Chưa có báo giá nào.</p>');
      }

      if (CASH.length) {
        new ApexCharts(document.querySelector('#cashDonut'), {
          chart: { type: 'donut', height: 320 },
          series: CASH.map(function (c) { return c.inflow; }),
          labels: CASH.map(function (c) { return c.method; }),
          colors: ['#7367f0', '#28c76f', '#00cfe8', '#ff9f43', '#ea5455', '#a8aaae'],
          legend: { position: 'bottom', labels: { colors: label } },
          dataLabels: { enabled: false },
          stroke: { width: 0 },
          // Vòng tròn rỗng ruột mà không có TỔNG ở giữa thì phải tự cộng nhẩm mới biết quy mô.
          plotOptions: { pie: { donut: { labels: { show: true,
            value: { formatter: money },
            total: { show: true, label: 'Tổng thu', color: label,
                     formatter: function (w) { return money(w.globals.seriesTotals.reduce(function (a, b) { return a + b; }, 0)); } } } } } },
          tooltip: { y: { formatter: function (v) { return tk.money(v) + ' ₫'; } } }
        }).render();
      } else {
        $('#cashDonut').html('<p class="text-muted text-center py-5 mb-0">Chưa có phiếu thu nào.</p>');
      }

      @if (Model.CanDeparture)
      {
        <text>
      // Lịch khởi hành: dùng CHUNG nguồn sự kiện của màn Lịch điều hành — chỉ nạp khoảng đang xem.
      var calEl = document.querySelector('#cal');
      if (calEl && window.Calendar) {
        new Calendar(calEl, {
          plugins: [dayGridPlugin, interactionPlugin],
          initialView: 'dayGridMonth', locale: 'vi',
          // height:'auto' — KHÔNG ép chiều cao. Lưới tháng cần ~710px; ép 520 thì thanh cuộn trong
          // của FullCalendar bị overflow:hidden nên nội dung TRÀN ra ngoài card, đè lên chân trang.
          // Giống hệt cấu hình màn Lịch điều hành đang chạy đúng.
          height: 'auto',
          firstDay: 1,        // tuần bắt đầu Thứ 2, đồng bộ với màn Lịch điều hành
          dayMaxEvents: 3,    // ngày nhiều chuyến thì gộp "+n" thay vì kéo dãn hàng
          headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
          buttonText: { today: 'Hôm nay' },
          events: function (info, success, failure) {
            $.getJSON('/OperationCalendar?handler=Events&start=' + info.startStr + '&end=' + info.endStr)
              .done(function (d) { success((d && d.events) || []); })
              .fail(failure);
          },
          eventClick: function (i) {
            // Mở panel trượt từ phải thay vì điều hướng — giữ nguyên tháng đang xem.
            i.jsEvent.preventDefault();
            var p = i.event.extendedProps || {};
            tk.panel({
              title: i.event.title,
              rows: [
                { label: 'Mã chuyến', value: p.code },
                { label: 'Loại tour', value: p.tourType },
                { label: 'Ngày khởi hành', value: i.event.start ? i.event.start.toLocaleDateString('vi-VN') : null },
                { label: 'Ngày kết thúc', value: i.event.end ? new Date(i.event.end.getTime() - 86400000).toLocaleDateString('vi-VN') : null },
                { label: 'Tổng số chỗ', value: p.totalSlots != null ? tk.money(p.totalSlots) : null },
                { label: 'Trạng thái', value: p.statusLabel }
              ],
              actionUrl: '/chuyen-di/' + i.event.id,
              actionText: 'Mở chi tiết chuyến'
            });
          }
        }).render();
      }
        </text>
      }
    });
  </script>
}
