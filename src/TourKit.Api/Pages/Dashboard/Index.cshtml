@page
@using System.Globalization
@model TourKit.Api.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Tổng quan";
    var vi = new CultureInfo("vi-VN");

    // Số tiền ở thẻ tóm tắt rút gọn; số đầy đủ nằm ở tooltip. "94.323.595.000" ở cỡ chữ lớn
    // thì không liếc được, mà thẻ tổng quan là chỗ để LIẾC.
    string Short(decimal v)
    {
        var a = Math.Abs(v);
        if (a >= 1_000_000_000m) { return (v / 1_000_000_000m).ToString("0.#", vi) + " tỷ"; }
        if (a >= 1_000_000m) { return (v / 1_000_000m).ToString("0.#", vi) + " tr"; }
        if (a >= 1_000m) { return (v / 1_000m).ToString("0.#", vi) + " ng"; }
        return v.ToString("#,##0", vi);
    }
    string Full(decimal v) => v.ToString("#,##0", vi) + " ₫";
}

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/apex-charts/apex-charts.css" />
  @if (Model.CanDeparture)
  {
    <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
  }
}

@section VendorScripts {
  <script src="~/vendor/libs/apex-charts/apexcharts.js"></script>
  @if (Model.CanDeparture)
  {
    <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
  }
}

@* Bám bố cục Dashboards/CRM (docs/vuexy-reference) — số liệu thật từ PageModel. *@

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h4 class="mb-1">Tổng quan điều hành</h4>
    <p class="text-muted mb-0">Dữ liệu kinh doanh thời gian thực</p>
  </div>
  @* Thao tác nhanh — bám dải nút QUICK của bản cũ, chỉ hiện nút có quyền. *@
  <div class="d-flex flex-wrap gap-2">
    @if (Model.CanBooking)  { <a href="/don-hang" class="btn btn-label-primary btn-sm"><i class="ti ti-shopping-cart me-1"></i> Tạo đơn</a> }
    @if (Model.CanDeparture){ <a href="/chuyen-di" class="btn btn-label-primary btn-sm"><i class="ti ti-flag me-1"></i> Tạo tour / LKH</a> }
    @if (Model.CanQuote)    { <a href="/bao-gia/soan" class="btn btn-label-primary btn-sm"><i class="ti ti-file-description me-1"></i> Tạo báo giá</a> }
    @if (Model.CanCustomer) { <a href="/khach-hang" class="btn btn-label-primary btn-sm"><i class="ti ti-user-plus me-1"></i> Tạo Data khách</a> }
    @if (Model.CanLead)     { <a href="/co-hoi" class="btn btn-label-primary btn-sm"><i class="ti ti-target me-1"></i> Tạo cơ hội</a> }
    @if (Model.CanTask)     { <a href="/cong-viec" class="btn btn-label-primary btn-sm"><i class="ti ti-checkbox me-1"></i> Tạo công việc</a> }
  </div>
</div>

@* Bốn con số TRẢ LỜI câu hỏi hay hỏi nhất: bán được bao nhiêu · thu về bao nhiêu ·
   còn kẹt bao nhiêu · thực lãi bao nhiêu. Mười hai thẻ ngang hàng như bản trước thì
   không con số nào nổi lên, phải đọc hết mới biết cái nào quan trọng. *@
<div class="tk-kpi-row mb-4">
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-primary"><i class="ti ti-cash"></i></span>
    <div class="tk-kpi-label">Doanh thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.TotalRevenue)">@Short(Model.Summary.TotalRevenue)</div>
    <span class="tk-kpi-sub text-muted">toàn bộ đơn hàng</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-success"><i class="ti ti-wallet"></i></span>
    <div class="tk-kpi-label">Đã thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.TotalReceived)">@Short(Model.Summary.TotalReceived)</div>
    <span class="tk-kpi-sub text-muted">@((Model.Kpi.CollectionRate * 100).ToString("0.#", vi))% doanh thu</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-warning"><i class="ti ti-alert-triangle"></i></span>
    <div class="tk-kpi-label">Còn phải thu</div>
    <div class="tk-kpi-value" title="@Full(Model.Summary.ReceivableOutstanding)">@Short(Model.Summary.ReceivableOutstanding)</div>
    <span class="tk-kpi-sub text-muted">công nợ khách</span>
  </div>
  <div class="tk-kpi">
    <span class="tk-kpi-ic bg-label-info"><i class="ti ti-coin"></i></span>
    <div class="tk-kpi-label">Lợi nhuận thực tế</div>
    <div class="tk-kpi-value @(Model.ActualProfit < 0 ? "text-danger" : "")" title="@Full(Model.ActualProfit)">@Short(Model.ActualProfit)</div>
    <span class="tk-kpi-sub text-muted">đã thu − đã chi</span>
  </div>
</div>

@* Các số còn lại là số THAM CHIẾU: gom vào một dải mảnh, không cần mỗi số một thẻ to. *@
<div class="tk-card mb-4">
  <div class="tk-figures">
    @foreach (var f in new (string Label, string Value, string Title, string Tone)[]
    {
        ("Tổng chi", Short(Model.Summary.TotalCost), Full(Model.Summary.TotalCost), ""),
        ("Tổng chi thực tế", Short(Model.Summary.TotalPaid), Full(Model.Summary.TotalPaid), ""),
        ("Công nợ NCC", Short(Model.Summary.PayableOutstanding), Full(Model.Summary.PayableOutstanding), ""),
        ("Lợi nhuận gộp", Short(Model.Summary.GrossProfit), Full(Model.Summary.GrossProfit), Model.Summary.GrossProfit < 0 ? "text-danger" : ""),
        ("Tiền hoa hồng", Short(Model.CommissionTotal), Full(Model.CommissionTotal), ""),
        ("Giá trị TB / đơn", Short(Model.Kpi.AvgOrderValue), Full(Model.Kpi.AvgOrderValue), ""),
        ("Số đơn", Model.Summary.OrderCount.ToString("#,##0", vi), "", ""),
        ("Tỉ lệ thu tiền", (Model.Kpi.CollectionRate * 100).ToString("0.#", vi) + "%", "", ""),
    })
    {
      <div class="tk-figure">
        <small>@f.Label</small>
        <b class="@f.Tone" title="@f.Title">@f.Value</b>
      </div>
    }
  </div>
</div>

<div class="row">
  <!-- Doanh thu theo phòng ban (bar) -->
  <div class="col-12 col-xl-8 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Doanh thu theo phòng ban</h6>
          <small class="text-muted">Doanh thu và lợi nhuận từng phòng</small>
        </div>
      </div>
      <div class="tk-card-body">
        <div id="deptChart"></div>
      </div>
    </div>
  </div>

  <!-- Dòng tiền theo phương thức (donut) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Tiền thu theo phương thức</h6>
          <small class="text-muted">Phiếu thu đã ghi nhận</small>
        </div>
      </div>
      <div class="tk-card-body">
        <div id="cashDonut"></div>
      </div>
    </div>
  </div>

  <!-- Đơn hàng (khuôn "Statistics" card của Ecommerce dashboard) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Đơn hàng</h6>
          <small class="text-muted">Theo trạng thái và thanh toán</small>
        </div>
      </div>
      <div class="tk-card-body">
        <div class="row gy-3">
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-primary me-3 p-2"><i class="ti ti-shopping-cart ti-sm"></i></div>
              <div class="card-info"><h6 class="mb-0">@Model.Orders.Total</h6><small>Tổng đơn</small></div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-info me-3 p-2"><i class="ti ti-check ti-sm"></i></div>
              <div class="card-info"><h6 class="mb-0">@Model.Orders.Confirmed</h6><small>Đã xác nhận</small></div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-warning me-3 p-2"><i class="ti ti-clock ti-sm"></i></div>
              <div class="card-info"><h6 class="mb-0">@Model.Orders.Draft</h6><small>Nháp/Giữ chỗ</small></div>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <div class="badge rounded-pill bg-label-secondary me-3 p-2"><i class="ti ti-x ti-sm"></i></div>
              <div class="card-info"><h6 class="mb-0">@Model.Orders.Cancelled</h6><small>Đã huỷ</small></div>
            </div>
          </div>
        </div>
        <hr class="my-3" />
        <div class="row gy-3">
          <div class="col-4 text-center">
            <span class="badge bg-label-danger mb-1">@Model.Orders.Unpaid</span>
            <small class="d-block">Chưa TT</small>
          </div>
          <div class="col-4 text-center">
            <span class="badge bg-label-warning mb-1">@Model.Orders.Deposit</span>
            <small class="d-block">Đã cọc</small>
          </div>
          <div class="col-4 text-center">
            <span class="badge bg-label-success mb-1">@Model.Orders.Paid</span>
            <small class="d-block">TT đủ</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Phễu báo giá (KPI) -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Phễu báo giá</h6>
          <small class="text-muted">Báo giá → chấp nhận → chuyển đơn</small>
        </div>
      </div>
      <div class="tk-card-body">
        <ul class="list-unstyled mb-0">
          <li class="d-flex justify-content-between align-items-center mb-3">
            <span><i class="ti ti-file-text text-primary me-2"></i>Báo giá đã tạo</span>
            <h6 class="mb-0">@Model.Kpi.QuoteCount</h6>
          </li>
          <li class="d-flex justify-content-between align-items-center mb-3">
            <span><i class="ti ti-thumb-up text-success me-2"></i>Được chấp nhận</span>
            <h6 class="mb-0">@Model.Kpi.QuoteAcceptedCount</h6>
          </li>
          <li class="d-flex justify-content-between align-items-center mb-3">
            <span><i class="ti ti-transfer-in text-info me-2"></i>Đã chuyển đơn</span>
            <h6 class="mb-0">@Model.Kpi.QuoteConvertedCount</h6>
          </li>
        </ul>
        <hr class="my-3" />
        <div class="mb-3">
          <div class="d-flex justify-content-between mb-1"><small>Tỉ lệ chấp nhận</small><small class="fw-medium">@((Model.Kpi.AcceptanceRate * 100).ToString("0.#"))%</small></div>
          <div class="progress" style="height:6px"><div class="progress-bar bg-success" style="width:@Math.Min(100, Model.Kpi.AcceptanceRate * 100)%"></div></div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between mb-1"><small>Tỉ lệ chuyển đơn</small><small class="fw-medium">@((Model.Kpi.ConversionRate * 100).ToString("0.#"))%</small></div>
          <div class="progress" style="height:6px"><div class="progress-bar bg-info" style="width:@Math.Min(100, Model.Kpi.ConversionRate * 100)%"></div></div>
        </div>
        <div>
          <div class="d-flex justify-content-between mb-1"><small>Tỉ lệ thu tiền</small><small class="fw-medium">@((Model.Kpi.CollectionRate * 100).ToString("0.#"))%</small></div>
          <div class="progress" style="height:6px"><div class="progress-bar bg-primary" style="width:@Math.Min(100, Model.Kpi.CollectionRate * 100)%"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Top khách hàng -->
  <div class="col-12 col-xl-4 mb-4">
    <div class="tk-card h-100">
      <div class="tk-card-head">
        <div>
          <h6 class="mb-0">Top khách hàng</h6>
          <small class="text-muted">Theo doanh thu</small>
        </div>
        <a href="/khach-hang" class="btn btn-sm btn-label-primary">Tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Khách hàng</th><th class="text-end">Doanh thu</th><th class="text-end">Đã thu</th></tr></thead>
          <tbody>
          @if (Model.TopCustomers.Count == 0)
          {
            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr>
          }
          @foreach (var c in Model.TopCustomers)
          {
            <tr>
              <td><a href="/khach-hang/@c.CustomerId" class="fw-medium">@c.CustomerName</a></td>
              <td class="text-end">@c.Revenue.ToString("#,##0")</td>
              <td class="text-end">@c.Received.ToString("#,##0")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@if (Model.CanCare)
{
  @* Quản lý lịch hẹn — bản cũ có bảng CSKH ngay trên Tổng quan. *@
  <div class="tk-card mb-4">
    <div class="tk-card-head">
      <h6 class="mb-0">Quản lý lịch hẹn</h6>
      <a href="/lich-hen" class="btn btn-sm btn-label-primary">Tất cả</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        @* Bỏ cột "Nội dung": trên màn tổng quan nó chỉ là một đoạn văn dài cắt cụt, không giúp
           quyết định gì. Cần đọc chi tiết thì bấm sang màn Lịch hẹn. *@
        <thead><tr><th>Tiêu đề</th><th>Khách hàng</th><th>Nhắc lúc</th><th class="text-end">Trạng thái</th></tr></thead>
        <tbody>
        @if (Model.Cares.Count == 0)
        {
          <tr><td colspan="4" class="text-center text-muted py-4">Chưa có lịch hẹn</td></tr>
        }
        @foreach (var c in Model.Cares)
        {
          @* Ô "Nhắc hẹn" là ô NGÀY nên phần lớn bản ghi không có giờ — hiện giờ giả là nói dối. *@
          var hasTime = c.RemindAt is { } rt && rt.UtcDateTime.TimeOfDay != TimeSpan.Zero;
          <tr>
            <td class="fw-medium">@c.Title</td>
            <td>@(c.CustomerName ?? "—")</td>
            <td>@(c.RemindAt is { } r ? (hasTime ? r.ToLocalTime().ToString("HH:mm dd/MM/yyyy", vi) : r.ToString("dd/MM/yyyy", vi)) : "—")</td>
            <td class="text-end"><span class="badge bg-label-@TourKit.Api.Pages.Dashboard.IndexModel.CareStatusColor(c.Status)">@TourKit.Api.Pages.Dashboard.IndexModel.CareStatusLabel(c.Status)</span></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
}

@* Hiệu suất theo CHI NHÁNH — khác với "theo phòng ban" ở trên, bản cũ có cả hai. *@
<div class="tk-card mb-4">
  <div class="tk-card-head"><h6 class="mb-0">Hiệu suất theo chi nhánh</h6></div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr>
        <th>Chi nhánh</th><th class="text-end">Số đơn</th><th class="text-end">Doanh thu</th>
        <th class="text-end">Thực thu</th><th class="text-end">Còn thiếu</th><th class="text-end">Lợi nhuận</th>
      </tr></thead>
      <tbody>
      @if (Model.ByBranch.Count == 0)
      {
        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu chi nhánh</td></tr>
      }
      @foreach (var b in Model.ByBranch)
      {
        <tr>
          <td class="fw-medium">@b.BranchName</td>
          <td class="text-end">@b.OrderCount.ToString("#,##0")</td>
          <td class="text-end">@b.Turnover.ToString("#,##0")</td>
          <td class="text-end text-success">@b.Received.ToString("#,##0")</td>
          <td class="text-end @(b.Outstanding > 0 ? "text-danger" : "")">@b.Outstanding.ToString("#,##0")</td>
          <td class="text-end">@b.Profit.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@* Vinh danh chiến binh sales — top 5 theo doanh thu, kèm hoa hồng. *@
<div class="tk-card mb-4">
  <div class="tk-card-head">
    <h6 class="mb-0">Vinh danh chiến binh sales</h6>
    <a href="/hoa-hong-theo-nguon" class="btn btn-sm btn-label-primary">Báo cáo hoa hồng</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Nhân viên</th><th class="text-end">Doanh thu</th><th class="text-end">Hoa hồng</th></tr></thead>
      <tbody>
      @if (Model.TopSales.Count == 0)
      {
        <tr><td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu</td></tr>
      }
      @foreach (var s in Model.TopSales)
      {
        <tr>
          <td class="fw-medium">@s.Name</td>
          <td class="text-end">@s.Turnover.ToString("#,##0")</td>
          <td class="text-end text-success">@s.Commission.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@if (Model.CanDeparture)
{
  <div class="tk-card mb-4">
    <div class="tk-card-head">
      <h6 class="mb-0">Lịch khởi hành</h6>
      <a href="/lich-dieu-hanh" class="small">Xem lịch điều hành →</a>
    </div>
    <div class="tk-card-body"><div id="cal"></div></div>
  </div>
}

@section PageScripts {
  <script>
    // Data thật serialize từ PageModel — option/style bám dashboards-crm.js của template.
    var DEPT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDepartment.Select(d => new { name = d.DepartmentName, turnover = d.Turnover, profit = d.Profit })));
    var CASH = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashFlow.Where(c => c.Inflow > 0).Select(c => new { method = c.PaymentMethod, inflow = c.Inflow })));

    $(function () {
      var label = '#a8aaae', border = '#dbdade';
      // Rút gọn tiền cho nhãn biểu đồ — số đầy đủ vẫn nằm ở tooltip.
      function money(v) {
        v = Number(v) || 0;
        if (Math.abs(v) >= 1e9) { return (v / 1e9).toFixed(1).replace('.', ',') + ' tỷ'; }
        if (Math.abs(v) >= 1e6) { return Math.round(v / 1e6) + ' tr'; }
        return v.toLocaleString('vi-VN');
      }

      if (DEPT.length) {
        new ApexCharts(document.querySelector('#deptChart'), {
          chart: { type: 'bar', height: 320, toolbar: { show: false } },
          series: [
            { name: 'Doanh thu', data: DEPT.map(function (d) { return d.turnover; }) },
            { name: 'Lợi nhuận', data: DEPT.map(function (d) { return d.profit; }) }
          ],
          colors: ['#7367f0', '#28c76f'],
          plotOptions: { bar: { columnWidth: '40%', borderRadius: 4 } },
          dataLabels: { enabled: false },
          legend: { labels: { colors: label } },
          xaxis: { categories: DEPT.map(function (d) { return d.name; }), labels: { style: { colors: label } }, axisBorder: { show: false } },
          // Trục tiền RÚT GỌN: "50.000.000.000" chiếm gần nửa bề ngang biểu đồ, đọc cũng không kịp.
          yaxis: { labels: { style: { colors: label }, formatter: money } },
          grid: { borderColor: border, strokeDashArray: 6 },
          tooltip: { y: { formatter: function (v) { return tk.money(v); } } }
        }).render();
      } else {
        $('#deptChart').html('<p class="text-muted text-center py-5 mb-0">Chưa có dữ liệu doanh thu.</p>');
      }

      if (CASH.length) {
        new ApexCharts(document.querySelector('#cashDonut'), {
          chart: { type: 'donut', height: 320 },
          series: CASH.map(function (c) { return c.inflow; }),
          labels: CASH.map(function (c) { return c.method; }),
          colors: ['#7367f0', '#28c76f', '#00cfe8', '#ff9f43', '#ea5455', '#a8aaae'],
          legend: { position: 'bottom', labels: { colors: label } },
          dataLabels: { enabled: false },
          stroke: { width: 0 },
          // Vòng tròn rỗng ruột mà không có TỔNG ở giữa thì phải tự cộng nhẩm mới biết quy mô.
          plotOptions: { pie: { donut: { labels: { show: true,
            value: { formatter: money },
            total: { show: true, label: 'Tổng thu', color: label,
                     formatter: function (w) { return money(w.globals.seriesTotals.reduce(function (a, b) { return a + b; }, 0)); } } } } } },
          tooltip: { y: { formatter: function (v) { return tk.money(v) + ' ₫'; } } }
        }).render();
      } else {
        $('#cashDonut').html('<p class="text-muted text-center py-5 mb-0">Chưa có phiếu thu nào.</p>');
      }

      @if (Model.CanDeparture)
      {
        <text>
      // Lịch khởi hành: dùng CHUNG nguồn sự kiện của màn Lịch điều hành — chỉ nạp khoảng đang xem.
      var calEl = document.querySelector('#cal');
      if (calEl && window.Calendar) {
        new Calendar(calEl, {
          plugins: [dayGridPlugin, interactionPlugin],
          initialView: 'dayGridMonth', locale: 'vi',
          // height:'auto' — KHÔNG ép chiều cao. Lưới tháng cần ~710px; ép 520 thì thanh cuộn trong
          // của FullCalendar bị overflow:hidden nên nội dung TRÀN ra ngoài card, đè lên chân trang.
          // Giống hệt cấu hình màn Lịch điều hành đang chạy đúng.
          height: 'auto',
          firstDay: 1,        // tuần bắt đầu Thứ 2, đồng bộ với màn Lịch điều hành
          dayMaxEvents: 3,    // ngày nhiều chuyến thì gộp "+n" thay vì kéo dãn hàng
          headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
          buttonText: { today: 'Hôm nay' },
          events: function (info, success, failure) {
            $.getJSON('/OperationCalendar?handler=Events&start=' + info.startStr + '&end=' + info.endStr)
              .done(function (d) { success((d && d.events) || []); })
              .fail(failure);
          },
          eventClick: function (i) {
            // Mở panel trượt từ phải thay vì điều hướng — giữ nguyên tháng đang xem.
            i.jsEvent.preventDefault();
            var p = i.event.extendedProps || {};
            tk.panel({
              title: i.event.title,
              rows: [
                { label: 'Mã chuyến', value: p.code },
                { label: 'Loại tour', value: p.tourType },
                { label: 'Ngày khởi hành', value: i.event.start ? i.event.start.toLocaleDateString('vi-VN') : null },
                { label: 'Ngày kết thúc', value: i.event.end ? new Date(i.event.end.getTime() - 86400000).toLocaleDateString('vi-VN') : null },
                { label: 'Tổng số chỗ', value: p.totalSlots != null ? tk.money(p.totalSlots) : null },
                { label: 'Trạng thái', value: p.statusLabel }
              ],
              actionUrl: '/chuyen-di/' + i.event.id,
              actionText: 'Mở chi tiết chuyến'
            });
          }
        }).render();
      }
        </text>
      }
    });
  </script>
}
