@page
@model TourKit.Api.Pages.TourRatings.ByTourModel
@{ ViewData["Title"] = "Feedback theo Tour"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Feedback theo Tour</h4>
  <a class="btn btn-label-secondary" href="/danh-gia"><i class="ti ti-list me-1"></i> Xem từng đánh giá</a>
</div>

<div class="card">
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>Chuyến đi</th>
          <th class="text-center">Số lượt đánh giá</th><th class="text-center">Sao trung bình</th>
        </tr>
      </thead>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () {
      // Server-side: mỗi lần chỉ tải 1 trang (không get-all). Dữ liệu đã GOM THEO CHUYẾN ở SQL.
      tk.table('#tbl', {
        url: '?handler=Data',
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: null, render: function (r) { return r.departureName ? tk.escape(r.departureName) : '<span class="text-muted">—</span>'; } },
          { data: 'ratingCount', className: 'text-center', render: function (v) { return '<span class="badge bg-label-primary">' + tk.escape(v) + '</span>'; } },
          { data: 'averageStars', className: 'text-center', render: function (v) {
              var avg = Number(v) || 0, full = Math.round(avg);
              return '<span class="text-warning">' + '★'.repeat(full) + '</span>' +
                     '<span class="text-muted">' + '☆'.repeat(Math.max(0, 5 - full)) + '</span>' +
                     ' <span class="fw-medium">' + avg.toFixed(1) + '</span>';
            } }
        ]
      });
    });
  </script>
}
