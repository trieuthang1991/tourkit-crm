@await Html.PartialAsync("Layouts/Sections/_Variables")
@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
@* lang="vi": toàn bộ giao diện là tiếng Việt. Để "en" thì trình đọc màn hình phát âm tiếng Việt
   theo âm vị tiếng Anh, và Chrome hỏi "Dịch trang này?" mỗi lần vào. *@
<html lang="vi" class='light-style @ViewData["navbarFixed"] @ViewData["menuFixed"] @ViewData["menuCollapsed"] @ViewData["footerFixed"] @ViewData["customizerHidden"]' dir="ltr" data-theme="theme-default" data-assets-path='@(httpContextAccessor.HttpContext!.Request.PathBase + "/")' data-template='@((Convert.ToBoolean(@TempData.Peek("menuHorizontal")).ToString() == "True") ? "horizontal-menu-template" : "vertical-menu-template")'>

<head>
  <meta charset="utf-8" />
  @* Bỏ user-scalable=no/maximum-scale của template: chặn phóng to là vi phạm WCAG 1.4.4, mà
     đây là CRM có bảng số liệu dày — trên điện thoại người dùng CẦN chụm tay phóng to để đọc. *@
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>@ViewData["title"] · TourKit</title>
  <meta name="description" content="TourKit — phần mềm quản lý điều hành tour: khách hàng, báo giá, đơn hàng, chuyến đi, công nợ và hoá đơn." />

  <!-- Canonical SEO -->
  <link rel="canonical" href='@TempData.Peek("productPage")'>
  @* Favicon: dùng chung một file với logo trong ứng dụng (xem Pages/Shared/_BrandMark.cshtml)
     để nhãn hiệu không bao giờ lệch giữa tab trình duyệt và giao diện. *@
  <link rel="icon" type="image/svg+xml" href="~/img/branding/tourkit-mark.svg" />
  <link rel="alternate icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />
  <link rel="apple-touch-icon" href="~/img/branding/tourkit-mark-180.png" />

  <!-- Core Styles -->
  @await Html.PartialAsync("Layouts/Sections/_Styles")

  <!-- Vendor Styles -->
  @RenderSection("VendorStyles", required: false)

  <!-- Page Styles -->
  @RenderSection("PageStyles", required: false)

  <!-- Include Scripts for customizer, helper, analytics, config -->
  @await Html.PartialAsync("Layouts/Sections/_ScriptsIncludes")
</head>

<body>
  <!-- Layout Content -->
  @RenderBody()
  <!--/ Layout Content -->

  <!-- Core Scripts -->
  @await Html.PartialAsync("Layouts/Sections/_Scripts")

  <!-- Vendor Scripts -->
  @RenderSection("VendorScripts", required: false)

  <script src="~/js/main.js"></script>

  <!-- Page Scripts-->
  @RenderSection("PageScripts", required: false)


</body>

</html>
