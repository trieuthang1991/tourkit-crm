@* Template Customizer (công cụ demo Vuexy) đã gỡ: không nạp template-customizer.js
   -> TemplateCustomizer undefined -> config.js bỏ qua init, main.js đều có guard -> theme cố định theme-default (sáng, tím). *@
<environment include="Development">
  @* Template helper js *@
  <script src="~/vendor/js/helpers.js"></script>
  @* Config file contain global vars & default theme options *@
  <script src="~/js/config.js"></script>
</environment>

<environment exclude="Development">
  <script src="~/vendor/js/helpers.js" asp-append-version="true"></script>
  <script src="~/js/config.js" asp-append-version="true"></script>
</environment>
