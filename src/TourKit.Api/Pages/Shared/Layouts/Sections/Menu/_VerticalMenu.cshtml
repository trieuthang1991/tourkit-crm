@using TourKit.Api.Pages.Shared
@{
    TempData.Keep();
    bool Has(string p) => User.HasClaim("perm", p);
    var groups = MenuData.FilterByPerm(MenuData.Groups, Has);
    var current = ViewContext.HttpContext.Request.Path.Value ?? "/";
    // Giữ cả query (vd "?f=zalo-uid") để phân biệt các mục cùng path /ComingSoon nhưng khác tính năng.
    var currentQuery = ViewContext.HttpContext.Request.QueryString.Value ?? "";

    // Route KHỚP DÀI NHẤT với đường dẫn hiện tại là route "đúng" đang mở. Chỉ tô đậm route đó.
    // Nếu không: "/don-hang" (Tất cả đơn hàng) là tiền tố của "/don-hang/loai/tour-fit" nên cả hai
    // cùng sáng — đúng lỗi nhập nhằng cần trị. So khớp theo ĐOẠN (segment) để "/don" không khớp bừa.
    var bestRoute = BestMatch(groups, current, currentQuery);
}
@functions {
    static bool Matches(string to, string path, string query)
    {
        if (to == "#") { return false; }
        var qi = to.IndexOf('?');
        if (qi >= 0)
        {
            // Route có query (vd /ComingSoon?f=zalo-uid): khớp CHÍNH XÁC cả path lẫn query,
            // nếu không mọi mục /ComingSoon đều không bao giờ sáng (path trần không chứa query).
            return path.Equals(to[..qi], StringComparison.OrdinalIgnoreCase)
                && query.Equals(to[qi..], StringComparison.OrdinalIgnoreCase);
        }
        return path.Equals(to, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(to + "/", StringComparison.OrdinalIgnoreCase);
    }

    static string? BestMatch(IReadOnlyList<MenuNode> nodes, string path, string query)
    {
        string? best = null;
        void Walk(IReadOnlyList<MenuNode> ns)
        {
            foreach (var n in ns)
            {
                if (n.Children is { Count: > 0 }) { Walk(n.Children); }
                else if (n.To is { } to && Matches(to, path, query) && (best is null || to.Length > best.Length))
                {
                    best = to;
                }
            }
        }
        Walk(nodes);
        return best;
    }

    static bool IsActive(MenuNode n, string? bestRoute) =>
        n.To is { } to && to != "#" && bestRoute is not null
            && to.Equals(bestRoute, StringComparison.OrdinalIgnoreCase);

    static bool GroupActive(MenuNode g, string? bestRoute) =>
        g.Children?.Any(c => IsActive(c, bestRoute) || GroupActive(c, bestRoute)) ?? false;
}
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
  <div class="app-brand demo">
    <a href="/tong-quan" class="app-brand-link">
      @await Html.PartialAsync("_BrandMark", "menu-text fw-bold ms-2")
    </a>
  </div>

  <div class="menu-inner-shadow"></div>

  <ul class="menu-inner py-1">
    @foreach (var g in groups)
    {
        var gActive = GroupActive(g, bestRoute);
        <li class="menu-item @(gActive ? "active open" : "")">
            <a href="javascript:void(0)" class="menu-link menu-toggle">
                @if (g.Icon != null) { <i class="menu-icon tf-icons @g.Icon"></i> }
                <div>@g.Label</div>
            </a>
            <ul class="menu-sub">
                @foreach (var c in g.Children!)
                {
                    if (c.Children is { Count: > 0 })
                    {
                        <li class="menu-item @(GroupActive(c, bestRoute) ? "active open" : "")">
                            <a href="javascript:void(0)" class="menu-link menu-toggle"><div>@c.Label</div></a>
                            <ul class="menu-sub">
                                @foreach (var sub in c.Children)
                                {
                                    <li class="menu-item @(IsActive(sub, bestRoute) ? "active" : "")">
                                        <a href="@sub.To" class="menu-link"><div>@sub.Label</div></a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="menu-item @(IsActive(c, bestRoute) ? "active" : "")">
                            <a href="@c.To" class="menu-link"><div>@c.Label</div></a>
                        </li>
                    }
                }
            </ul>
        </li>
    }
  </ul>
</aside>
