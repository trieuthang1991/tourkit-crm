@page
@model TourKit.Api.Pages.Vehicles.IndexModel
@{ ViewData["Title"] = "Kho xe"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Kho xe</h5>
    <button type="button" class="btn btn-primary btn-sm" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm xe</button>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr><th class="text-center">#</th><th>Tên xe</th><th>Hãng</th><th class="text-center">Số chỗ</th><th>Trạng thái</th><th></th></tr>
      </thead>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">xe</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Tên xe / biển số <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên xe / biển số" /></div>
      <div class="mb-3"><label class="form-label">Hãng xe</label><input type="text" name="Input.FirmName" class="form-control" placeholder="Nhập hãng xe" /></div>
      <div class="mb-3"><label class="form-label">Số chỗ <span class="text-danger">*</span></label><input type="number" name="Input.SeatType" class="form-control" placeholder="0" value="0" /></div>
      <div class="mb-3">
        <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
        <select name="Input.Status" class="form-select"><option value="1">Hoạt động</option><option value="0">Ngừng</option></select>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt;
    $(function () {
      // Server-side: mỗi lần chỉ tải 1 trang (không get-all).
      dt = tk.table('#tbl', {
        url: '?handler=Data',
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: 'name', className: 'fw-medium' },
          { data: 'firmName', render: function (v) { return tk.escape(v || '—'); } },
          { data: 'seatType', className: 'text-center' },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + (r.status === 1 ? 'success' : 'secondary') + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, className: 'text-end', render: function () {
              return '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" title="Xoá"><i class="ti ti-trash"></i></button>';
            } }
        ]
      });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'xe',
        rules: { 'Input.Name': { required: true }, 'Input.SeatType': { required: true } },
        messages: { 'Input.Name': { required: 'Bắt buộc nhập tên xe' }, 'Input.SeatType': { required: 'Bắt buộc nhập số chỗ' } } });

      // Server-side: dữ liệu dòng lấy từ DataTables API (không còn data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = dt.row($(this).closest('tr')).data().id;
        tk.confirmDelete({ title: 'Xoá xe?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
