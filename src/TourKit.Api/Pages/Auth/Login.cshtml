@page
@model TourKit.Api.Pages.Auth.LoginModel
@{
  Layout = "Layouts/_BlankLayout";
  ViewData["Title"] = "Đăng nhập";
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
  <link rel="stylesheet" href="~/css/auth-visuals.css" asp-append-version="true">
}

@section PageScripts {
  @* KHÔNG nạp pages-auth.js: đó là mã mẫu của theme, kiểm tra các ô tên "username"/"email-username"
     mà form này không có, và nó gọi FormValidation — thư viện chưa từng được nạp. Kết quả là mỗi lần
     mở trang, trình duyệt ném "FormValidation is not defined" và script ngừng giữa chừng, trong khi
     không kiểm tra được ô nào. Form đã có <span asp-validation-for> và máy chủ vẫn kiểm tra đầy đủ. *@
}

@* ************** Content ************** *@

<div class="authentication-wrapper authentication-cover authentication-bg">
  <div class="authentication-inner row">
    <!-- /Left Text -->
    <div class="d-none d-lg-flex col-lg-7 p-0">
      <div class="auth-cover-bg auth-cover-visual">
        <img src="~/img/illustrations/auth-login.webp" alt="" class="auth-cover-visual__image">
        <div class="auth-cover-visual__content">
          <div class="auth-cover-visual__eyebrow">M-Travel Management SaaS</div>
          <h2>Vận hành rõ ràng. Ra quyết định nhanh hơn.</h2>
          <p>Kết nối khách hàng, công việc và dữ liệu vận hành trong một không gian làm việc thống nhất.</p>
        </div>
      </div>
    </div>
    <!-- /Left Text -->

    <!-- Login -->
    <div class="d-flex col-12 col-lg-5 align-items-center p-sm-5 p-4">
      <div class="w-px-400 mx-auto">
        <!-- Logo -->
        <div class="app-brand mb-4">
          <a href="/" class="app-brand-link gap-2">
            @await Html.PartialAsync("_BrandMark", "text-body fw-bold ms-1 fs-4")
          </a>
        </div>
        <!-- /Logo -->
        <h3 class="mb-1 fw-bold">Chào mừng đến M-Travel</h3>
        <p class="mb-4">Đăng nhập để tiếp tục làm việc</p>

        @if (TempData["ok"] is string okMsg)
        {
          <div class="alert alert-success" role="alert">@okMsg</div>
        }
        @if (Model.Error != null)
        {
          <div class="alert alert-danger" role="alert">@Model.Error</div>
        }
        @* Lỗi của chặng Google tới sau một lần chuyển hướng nên phải đi qua TempData, không dùng
           được Model.Error như đăng nhập bằng mật khẩu. *@
        @if (TempData["LoginError"] is string loginErr)
        {
          <div class="alert alert-danger" role="alert">@loginErr</div>
        }

        <form id="formAuthentication" class="mb-3" method="post">
          <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" placeholder="Nhập email của bạn" autofocus>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
          </div>
          <div class="mb-3 form-password-toggle">
            <div class="d-flex justify-content-between">
              <label class="form-label" asp-for="Input.Password">Mật khẩu</label>
              <a asp-page="/Auth/ForgotPassword">
                <small>Quên mật khẩu?</small>
              </a>
            </div>
            <div class="input-group input-group-merge">
              <input asp-for="Input.Password" type="password" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password" />
              <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
          </div>
          <div class="mb-3">
            <div class="form-check">
              <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" id="remember-me">
              <label class="form-check-label" for="remember-me">
                Ghi nhớ đăng nhập
              </label>
            </div>
          </div>
          <button class="btn btn-primary d-grid w-100" type="submit">
            Đăng nhập
          </button>
        </form>

        @* Nút Google nằm NGOÀI form mật khẩu: form lồng nhau là HTML không hợp lệ, và trình duyệt sẽ
           gộp hai nút submit vào cùng một form — bấm "Tiếp tục với Google" lại gửi cả email/mật khẩu. *@
        @if (Model.GoogleEnabled)
        {
          <div class="divider my-4">
            <div class="divider-text">hoặc</div>
          </div>

          <form method="post" asp-page-handler="Google" asp-route-returnUrl="@Model.Request.Query["returnUrl"]">
            <button type="submit" class="btn btn-outline-secondary d-grid w-100">
              <span class="d-flex align-items-center justify-content-center gap-2">
                @* Logo Google vẽ thẳng bằng SVG: nạp ảnh từ máy chủ Google nghĩa là mỗi lần mở trang
                   đăng nhập lại báo cho họ biết ai đang vào — và trang chết theo nếu chặn tên miền đó. *@
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                  <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" />
                  <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" />
                  <path fill="#FBBC05" d="M3.97 10.72a5.41 5.41 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z" />
                  <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" />
                </svg>
                <span>Tiếp tục với Google</span>
              </span>
            </button>
          </form>
        }

        <p class="text-center mt-3">
          <span>Chưa có tài khoản?</span>
          <a asp-page="/Auth/Register">
            <span>Đăng ký doanh nghiệp</span>
          </a>
        </p>
      </div>
    </div>
    <!-- /Login -->
  </div>
</div>
