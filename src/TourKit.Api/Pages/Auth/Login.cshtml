@page
@model TourKit.Api.Pages.Auth.LoginModel
@{
  Layout = "Layouts/_BlankLayout";
  ViewData["Title"] = "Đăng nhập";
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
  <link rel="stylesheet" href="~/css/auth-visuals.css" asp-append-version="true">
}

@section PageScripts {
  <script src="~/js/pages-auth.js"></script>
}

@* ************** Content ************** *@

<div class="authentication-wrapper authentication-cover authentication-bg">
  <div class="authentication-inner row">
    <!-- /Left Text -->
    <div class="d-none d-lg-flex col-lg-7 p-0">
      <div class="auth-cover-bg auth-cover-visual">
        <img src="~/img/illustrations/auth-login.webp" alt="" class="auth-cover-visual__image">
        <div class="auth-cover-visual__content">
          <div class="auth-cover-visual__eyebrow">M-Travel Management SaaS</div>
          <h2>Vận hành rõ ràng. Ra quyết định nhanh hơn.</h2>
          <p>Kết nối khách hàng, công việc và dữ liệu vận hành trong một không gian làm việc thống nhất.</p>
        </div>
      </div>
    </div>
    <!-- /Left Text -->

    <!-- Login -->
    <div class="d-flex col-12 col-lg-5 align-items-center p-sm-5 p-4">
      <div class="w-px-400 mx-auto">
        <!-- Logo -->
        <div class="app-brand mb-4">
          <a href="/" class="app-brand-link gap-2">
            @await Html.PartialAsync("_BrandMark", "text-body fw-bold ms-1 fs-4")
          </a>
        </div>
        <!-- /Logo -->
        <h3 class="mb-1 fw-bold">Chào mừng đến M-Travel</h3>
        <p class="mb-4">Đăng nhập để tiếp tục làm việc</p>

        @if (TempData["ok"] is string okMsg)
        {
          <div class="alert alert-success" role="alert">@okMsg</div>
        }
        @if (Model.Error != null)
        {
          <div class="alert alert-danger" role="alert">@Model.Error</div>
        }

        <form id="formAuthentication" class="mb-3" method="post">
          <div class="mb-3">
            <label asp-for="Input.TenantSlug" class="form-label">Mã doanh nghiệp</label>
            <input asp-for="Input.TenantSlug" class="form-control" placeholder="Nhập mã doanh nghiệp" autofocus>
            <span asp-validation-for="Input.TenantSlug" class="text-danger"></span>
          </div>
          <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" placeholder="Nhập email của bạn">
            <span asp-validation-for="Input.Email" class="text-danger"></span>
          </div>
          <div class="mb-3 form-password-toggle">
            <div class="d-flex justify-content-between">
              <label class="form-label" asp-for="Input.Password">Mật khẩu</label>
              <a asp-page="/Auth/ForgotPassword">
                <small>Quên mật khẩu?</small>
              </a>
            </div>
            <div class="input-group input-group-merge">
              <input asp-for="Input.Password" type="password" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password" />
              <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
          </div>
          <div class="mb-3">
            <div class="form-check">
              <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" id="remember-me">
              <label class="form-check-label" for="remember-me">
                Ghi nhớ đăng nhập
              </label>
            </div>
          </div>
          <button class="btn btn-primary d-grid w-100" type="submit">
            Đăng nhập
          </button>
        </form>

        <p class="text-center">
          <span>Chưa có tài khoản?</span>
          <a asp-page="/Auth/Register">
            <span>Đăng ký doanh nghiệp</span>
          </a>
        </p>
      </div>
    </div>
    <!-- /Login -->
  </div>
</div>
