@page
@model TourKit.Api.Pages.Auth.ResetPasswordModel
@{
  Layout = "Layouts/_BlankLayout";
  ViewData["Title"] = "Đặt lại mật khẩu";
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
}

@section PageScripts {
  <script src="~/js/pages-auth.js"></script>
}

@* ************** Content ************** *@
<div class="authentication-wrapper authentication-cover authentication-bg ">
  <div class="authentication-inner row">

    <!-- /Left Text -->
    <div class="d-none d-lg-flex col-lg-7 p-0">
      <div class="auth-cover-bg auth-cover-bg-color d-flex justify-content-center align-items-center">
        <img src="~/img/illustrations/auth-reset-password-illustration-light.png" alt="" class="img-fluid my-5 auth-illustration" data-app-light-img="illustrations/auth-reset-password-illustration-light.png" data-app-dark-img="illustrations/auth-reset-password-illustration-dark.png">

        <img src="~/img/illustrations/bg-shape-image-light.png" alt="" class="platform-bg" data-app-light-img="illustrations/bg-shape-image-light.png" data-app-dark-img="illustrations/bg-shape-image-dark.png">
      </div>
    </div>
    <!-- /Left Text -->

    <!-- Reset Password -->
    <div class="d-flex col-12 col-lg-5 align-items-center p-4 p-sm-5">
      <div class="w-px-400 mx-auto">
        <!-- Logo -->
        <div class="app-brand mb-4">
          <a href="/" class="app-brand-link gap-2">
            <span class="app-brand-logo demo"><span class="fw-bold fs-3 text-primary">T</span></span>
            <span class="app-brand-text demo text-body fw-bold ms-1 fs-4">TourKit</span>
          </a>
        </div>
        <!-- /Logo -->
        <h3 class="mb-1 fw-bold">Đặt lại mật khẩu 🔒</h3>
        <p class="mb-4">Nhập mật khẩu mới cho tài khoản của bạn</p>

        @if (Model.Error != null)
        {
          <div class="alert alert-danger" role="alert">@Model.Error</div>
        }

        <form id="formAuthentication" class="mb-3" method="post">
          <input type="hidden" asp-for="Token" />
          <div class="mb-3 form-password-toggle">
            <label class="form-label" asp-for="Input.Password">Mật khẩu mới <span class="text-danger">*</span></label>
            <div class="input-group input-group-merge">
              <input asp-for="Input.Password" type="password" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password" />
              <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
            <div class="form-text">Tối thiểu 8 ký tự.</div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
          </div>
          <div class="mb-3 form-password-toggle">
            <label class="form-label" asp-for="Input.ConfirmPassword">Nhập lại mật khẩu <span class="text-danger">*</span></label>
            <div class="input-group input-group-merge">
              <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" aria-describedby="password" />
              <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
          </div>
          <button class="btn btn-primary d-grid w-100 mb-3" type="submit">
            Đặt mật khẩu mới
          </button>
          <div class="text-center">
            <a asp-page="/Auth/Login">
              <i class="ti ti-chevron-left scaleX-n1-rtl"></i>
              Quay lại đăng nhập
            </a>
          </div>
        </form>
      </div>
    </div>
    <!-- /Reset Password -->
  </div>
</div>
