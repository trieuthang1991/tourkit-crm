@page
@model TourKit.Api.Pages.CustomerCares.IndexModel
@{ ViewData["Title"] = "Chăm sóc khách hàng"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 5 thẻ KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng lịch", Model.Stats.Total.ToString("#,##0"), "ti ti-headset", "primary"),
        ("Mới", Model.Stats.New.ToString("#,##0"), "ti ti-sparkles", "warning"),
        ("Đang xử lý", Model.Stats.InProgress.ToString("#,##0"), "ti ti-progress", "info"),
        ("Hoàn thành", Model.Stats.Done.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("Quá hạn", Model.Stats.Overdue.ToString("#,##0"), "ti ti-alarm", "danger"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">CRM <span class="mx-1">/</span> <span class="text-body">Chăm sóc khách hàng</span></div>
    <h4 class="mb-0">Chăm sóc khách hàng</h4>
  </div>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm lịch chăm sóc</button>
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — đủ 4 tiêu chí service hỗ trợ (trạng thái dạng chip bám Segmented hệ cũ) *@
  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Tiêu đề lịch chăm sóc…" /></div>
      <div class="col-md-3"><select id="f-customerId" class="form-select" style="width:100%"><option value=""></option></select></div>
      <div class="col-md-3">
        <select id="f-assignedToUserId" class="form-select tk-s2f" data-placeholder="Người phụ trách"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
      <span class="text-muted small fw-medium" style="min-width:110px">Trạng thái</span>
      <input type="hidden" id="f-status" value="" />
      <button type="button" class="btn btn-sm btn-primary tk-chip" data-k="status" data-v="">Tất cả <span class="badge bg-white text-dark ms-1">@Model.Stats.Total.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="0">Mới <span class="badge bg-secondary ms-1">@Model.Stats.New.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="1">Đang xử lý <span class="badge bg-secondary ms-1">@Model.Stats.InProgress.ToString("#,##0")</span></button>
      <button type="button" class="btn btn-sm btn-label-secondary tk-chip" data-k="status" data-v="2">Hoàn thành <span class="badge bg-secondary ms-1">@Model.Stats.Done.ToString("#,##0")</span></button>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> lịch đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-cares"></div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">lịch chăm sóc</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3" id="row-customer">
        <label class="form-label">Khách hàng <span class="text-danger">*</span></label>
        <select name="Input.CustomerId" id="oc-customer" class="form-select" style="width:100%"></select>
      </div>
      <div class="mb-3 d-none" id="row-customer-name">
        <label class="form-label">Khách hàng</label>
        <input type="text" id="oc-customer-name" class="form-control" disabled />
      </div>
      <div class="mb-3"><label class="form-label">Tiêu đề <span class="text-danger">*</span></label><input type="text" name="Input.Title" class="form-control" placeholder="Nội dung cần chăm sóc" /></div>
      <div class="mb-3"><label class="form-label">Nội dung</label><textarea name="Input.Detail" class="form-control" rows="2" placeholder="Chi tiết nội dung chăm sóc"></textarea></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Nhắc hẹn</label><input type="text" name="Input.RemindAt" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
          <select name="Input.Status" class="form-select"><option value="0">Mới</option><option value="1">Đang xử lý</option><option value="2">Hoàn thành</option></select>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Người phụ trách</label>
        <select name="Input.AssignedToUserId" class="form-select tk-s2" data-placeholder="Chọn NV">
          <option value="">— Chưa gán —</option>
          @foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }
        </select>
      </div>
      <div class="mb-3"><label class="form-label">Phản hồi</label><textarea name="Input.Feedback" class="form-control" rows="2" placeholder="Kết quả / phản hồi của khách"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc;
    $(function () {
      var g = tk.g, esc = g.esc;

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      // Select2 ajax chọn khách ở thanh lọc — dùng chung handler ?handler=CustomerSearch
      $('#f-customerId').select2({ width: '100%', allowClear: true, placeholder: 'Khách hàng',
        ajax: { url: '?handler=CustomerSearch', dataType: 'json', delay: 250, data: function (p) { return { q: p.term }; }, processResults: function (d) { return d; } }, minimumInputLength: 2 });

      // Mở từ nơi khác kèm ?customerId=..&customerName=.. (vd menu hành động ở Data khách hàng)
      // → chọn sẵn khách đó để danh sách lọc đúng ngay, khỏi gõ tìm lại.
      (function () {
        var qs = new URLSearchParams(location.search);
        var cid = qs.get('customerId');
        if (!cid) { return; }
        var name = qs.get('customerName') || 'Khách đã chọn';
        $('#f-customerId').append(new Option(name, cid, true, true)).trigger('change.select2');
      })();

      // Select2 ajax chọn khách trong offcanvas (không dùng tk-s2 vì cần ajax riêng)
      $('#oc-customer').select2({ dropdownParent: $('#oc'), width: '100%', placeholder: 'Gõ tên/SĐT để tìm…',
        ajax: { url: '?handler=CustomerSearch', dataType: 'json', delay: 250, data: function (p) { return { q: p.term }; }, processResults: function (d) { return d; } }, minimumInputLength: 2 });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'lịch chăm sóc',
        rules: { 'Input.Title': { required: true } }, messages: { 'Input.Title': { required: 'Bắt buộc nhập tiêu đề' } },
        afterOpen: function (data) {
          if (data) { // sửa: khoá chọn khách, hiện tên
            $('#row-customer').addClass('d-none'); $('#row-customer-name').removeClass('d-none');
            $('#oc-customer-name').val(data.customerName || '');
          } else { // tạo: hiện picker, reset
            $('#row-customer').removeClass('d-none'); $('#row-customer-name').addClass('d-none');
            $('#oc-customer').val(null).trigger('change');
          }
        }
      });

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá lịch chăm sóc?', text: r.title || '' }).then(function (ok) {
          if (!ok) { return; }
          var f = document.getElementById('delete-form');
          f.querySelector('[name="id"]').value = r.id;
          f.submit();
        });
      }

      function actionsFor(r) {
        var items = [{ label: '<i class="ti ti-edit me-2"></i>Sửa lịch chăm sóc', action: function () { oc.open(r); } }];
        if (r.customerId) {
          items.push({ label: '<i class="ti ti-user me-2"></i>Hồ sơ khách hàng', action: function () { window.location = '/khach-hang/' + r.customerId; } });
        }
        items.push({ separator: true });
        items.push({ label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá lịch</span>', action: function () { delRow(r); } });
        return items;
      }

      var grid = tk.grid('#grid-cares', {
        // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['customerId', 'assignedToUserId', 'status'],
        chipGroups: ['status'],
        exportName: 'cham-soc-da-chon.csv',
        actions: actionsFor,
        columns: [
          {
            title: 'Khách hàng', field: 'customerName', widthGrow: 2, minWidth: 180,
            formatter: function (c) {
              var v = c.getValue();
              if (!v) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-row-media">' + g.avatar(v) + g.stack(v, null) + '</div>';
            }
          },
          {
            title: 'Nội dung', field: 'title', widthGrow: 4, minWidth: 240,
            formatter: function (c) { var r = c.getData(); return g.stack(r.title, r.detail); }
          },
          {
            title: 'Người phụ trách', field: 'assigneeName', widthGrow: 2, minWidth: 160,
            formatter: function (c) {
              var v = c.getValue();
              if (!v) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-row-media">' + g.avatar(v, true) + g.stack(v, null) + '</div>';
            }
          },
          {
            title: 'Nhắc hẹn', field: 'remindAtText', width: 150,
            formatter: function (c) {
              var r = c.getData();
              return r.overdue
                ? '<div class="tk-cell"><div class="tk-cell-main text-danger" title="Quá hạn nhắc">' + esc(r.remindAtText) + '</div>' +
                  '<div class="tk-cell-sub text-danger">Quá hạn</div></div>'
                : g.stack(r.remindAtText, null);
            }
          },
          {
            title: 'Phản hồi', field: 'feedback', widthGrow: 2, minWidth: 170,
            formatter: function (c) { return g.stack(c.getValue(), null); }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 140,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });

      // Select2 ajax của ô khách hàng cũng phải làm tươi lưới.
      $('#f-customerId').on('change', function () { grid.reload(); });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
