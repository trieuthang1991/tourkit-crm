@page
@model TourKit.Api.Pages.ServiceBookings.IndexModel
@{ ViewData["Title"] = "Đặt dịch vụ lẻ"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 6 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng dịch vụ", Model.Stats.Total.ToString("#,##0"), "ti ti-list-details", "primary"),
        ("Tổng tiền", Model.Stats.TotalAmount.ToString("#,##0"), "ti ti-cash", "success"),
        ("Khách sạn", Model.Stats.Hotel.ToString("#,##0"), "ti ti-building", "info"),
        ("Vé máy bay", Model.Stats.Flight.ToString("#,##0"), "ti ti-plane", "warning"),
        ("Visa", Model.Stats.Visa.ToString("#,##0"), "ti ti-id", "secondary"),
        ("Vé / Khác", (Model.Stats.Ticket + Model.Stats.Other).ToString("#,##0"), "ti ti-ticket", "primary"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Điều hành <span class="mx-1">/</span> <span class="text-body">Đặt dịch vụ lẻ</span></div>
    <h4 class="mb-0">Đặt dịch vụ lẻ</h4>
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tab loại dịch vụ — bám Segmented hệ cũ *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="type">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1">@Model.Stats.Total.ToString("#,##0")</span></a></li>
      @foreach (var t in TourKit.Api.Pages.ServiceBookings.IndexModel.TypeTabs)
      {
        <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="@t.Value">@t.Label</a></li>
      }
    </ul>
    <input type="hidden" id="f-type" value="" />

    @* Thanh lọc — đủ 4 tiêu chí hệ cũ (q · NCC · trạng thái · khoảng ngày bắt đầu) *@
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã / mô tả dịch vụ" /></div>
      <div class="col-md-2">
        <select id="f-providerId" class="form-select" data-placeholder="Nhà cung cấp"></select>
      </div>
      <div class="col-md-2">
        <select id="f-status" class="form-select tk-auto"><option value="">Trạng thái</option><option value="0">0</option><option value="1">1</option><option value="2">2</option></select>
      </div>
      @* tk.dateRanges() ẩn CẢ CỘT chứa f-dateTo → KHÔNG để nút chung cột đó (nếu không nút biến mất). *@
      <div class="col-md-2"><input type="text" id="f-dateFrom" class="form-control tk-datef" placeholder="Bắt đầu từ" /></div>
      <div class="col-md-2"><input type="text" id="f-dateTo" class="form-control tk-datef" placeholder="đến" /></div>
    </div>
    <div class="d-flex gap-2 mt-2">
      <button type="button" class="btn btn-primary text-nowrap" id="btn-search"><i class="ti ti-search me-1"></i>Tìm</button>
      <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> booking đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-service-bookings"></div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      // Ô lọc NCC gọi SERVER — xem ghi chú ở màn vé đoàn và TranDanhMuc.
      tk.s2ajax('#f-providerId', { url: '?handler=ProviderLookup', placeholder: 'Nhà cung cấp' });

      var grid = tk.grid('#grid-service-bookings', {
        // Mọi tiêu chí đẩy xuống SERVER (ServiceBookingListFilter) — không lọc ở client.
        filters: ['providerId', 'status', 'dateFrom', 'dateTo', 'type'],
        exportName: 'dat-dich-vu-le.csv',
        actions: function (r) {
          var items = [];
          if (r.orderId) {
            items.push({ label: '<i class="ti ti-external-link me-2"></i>Mở đơn liên quan', action: function () { window.location = '/don-hang/' + r.orderId; } });
          }
          return items;
        },
        columns: [
          {
            title: 'Mã', field: 'code', widthGrow: 2, minWidth: 160,
            formatter: function (c) { var r = c.getData(); return g.stack(r.code, r.orderCode); }
          },
          {
            title: 'Loại', field: 'typeLabel', width: 130,
            formatter: function (c) {
              var r = c.getData();
              return '<span class="badge bg-label-' + r.typeColor + '">' + esc(r.typeLabel) + '</span>';
            }
          },
          {
            title: 'Dịch vụ / NCC', field: 'description', widthGrow: 4, minWidth: 240,
            formatter: function (c) { var r = c.getData(); return g.stack(r.description, r.providerName); }
          },
          {
            title: 'Thời gian sử dụng', field: 'startDateText', width: 160,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.startDateText, r.endDateText ? ('→ ' + r.endDateText) : null);
            }
          },
          {
            title: 'Giá trị', field: 'totalAmount', width: 160, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var qty = c.getTable().getData().reduce(function (a, r) { return a + (r.quantity || 0); }, 0);
              return '<span class="fw-semibold" title="Số lượng trang này: ' + money(qty) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(r.totalAmount) + '</div>' +
                '<div class="tk-cell-sub">' + money(r.quantity) + ' × ' + money(r.unitPrice) + '</div></div>';
            }
          },
          {
            title: 'Trạng thái', field: 'status', width: 120, hozAlign: 'center',
            formatter: function (c) { return '<span class="badge bg-label-secondary">' + esc(c.getValue()) + '</span>'; }
          }
        ]
      });
    });
  </script>
}
