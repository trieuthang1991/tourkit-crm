@page
@model TourKit.Api.Pages.OperationCalendar.IndexModel
@{ ViewData["Title"] = "Lịch điều hành"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/app-calendar.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-0">Lịch điều hành</h4>
    <small class="text-muted">Chuyến khởi hành theo ngày — mặc định xem tháng hiện tại.</small>
  </div>
  <div class="d-flex gap-2">
    @* Chuyển Lịch / Bảng — lịch chỉ nạp chuyến trong khoảng đang xem *@
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-label-secondary active" id="view-cal" title="Dạng lịch"><i class="ti ti-calendar"></i></button>
      <button type="button" class="btn btn-label-secondary" id="view-table" title="Dạng bảng"><i class="ti ti-list"></i></button>
    </div>
    <span id="tbl-nav" class="d-none">
      <button type="button" class="btn btn-label-secondary" id="btn-prev" title="Tháng trước"><i class="ti ti-chevron-left"></i></button>
      <button type="button" class="btn btn-label-secondary" id="btn-today">Tháng này</button>
      <button type="button" class="btn btn-label-secondary" id="btn-next" title="Tháng sau"><i class="ti ti-chevron-right"></i></button>
    </span>
  </div>
</div>

@* 4 KPI — bám StatGrid màn Chuyến đi (cùng nguồn DepartureStatsDto) *@
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng chuyến</small><h5 class="mb-0" id="kpi-total">@Model.Stats.Total.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Sắp khởi hành</small><h5 class="mb-0 text-success" id="kpi-upcoming">@Model.Stats.Upcoming.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã đóng</small><h5 class="mb-0 text-danger" id="kpi-closed">@Model.Stats.Closed.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng chỗ</small><h5 class="mb-0" id="kpi-slots">@Model.Stats.TotalSlots.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — đúng các tiêu chí DepartureListFilter, đẩy hết xuống SERVER *@
<div class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-3"><input type="text" id="f-q" class="form-control" placeholder="Mã / tên chuyến" /></div>
      <div class="col-md-2">
        <select id="f-tourType" class="form-select tk-s2f" data-placeholder="Loại tour"><option value=""></option>@foreach (var t in Model.TourTypes) { <option value="@t">@t</option> }</select>
      </div>
      <div class="col-md-3">
        <select id="f-assignedToUserId" class="form-select tk-s2f" data-placeholder="NV điều hành"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select>
      </div>
      <div class="col-md-2"><input type="text" id="f-departureFrom" class="form-control tk-datef" placeholder="Khởi hành từ" value="@Model.MonthFrom" autocomplete="off" /></div>
      <div class="col-md-2 d-flex gap-2">
        <input type="text" id="f-departureTo" class="form-control tk-datef" placeholder="đến" value="@Model.MonthTo" autocomplete="off" />
        <button type="button" class="btn btn-primary" id="btn-search" title="Tìm kiếm"><i class="ti ti-search"></i></button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>
</div>

@* Tab trạng thái — bám bộ lọc mở/đóng của lịch hệ cũ *@
<ul class="nav nav-pills flex-wrap mb-3" id="tabs">
  <li class="nav-item"><button type="button" class="nav-link active" data-v="">Tất cả (@Model.Stats.Total)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="false">Đang mở</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="true">Đã đóng (@Model.Stats.Closed)</button></li>
</ul>

@* Khung LỊCH — FullCalendar của template; mỗi lần đổi tháng chỉ gọi handler Events cho đúng khoảng đó *@
<div class="card app-calendar-wrapper" id="pane-cal">
  <div class="card-body">
    <div id="calendar"></div>
  </div>
</div>

<div class="card d-none" id="pane-table">
  <div class="card-header"><h5 class="mb-0">Chuyến theo ngày khởi hành</h5></div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>Ngày đi / về</th><th>Tour / LKH</th>
          <th class="text-end">Tổng chỗ</th><th>Điều hành</th><th>Trạng thái</th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="6" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
}

@section PageScripts {
  <script>
    var dt, cal = null, isClosed = '';
    var MONTH_FROM = '@Model.MonthFrom', MONTH_TO = '@Model.MonthTo';

    // ---- Khung LỊCH (FullCalendar của template) ----
    // events: FullCalendar truyền start/end của khung ĐANG XEM → server chỉ trả chuyến trong khoảng đó.
    function calFilterParams() {
      var p = {};
      ['tourType', 'assignedToUserId'].forEach(function (k) { var v = $('#f-' + k).val(); if (v) { p[k] = v; } });
      if (isClosed !== '') { p.isClosed = isClosed; }
      var q = $('#f-q').val(); if (q) { p.q = q; }
      return p;
    }

    function initCalendar() {
      if (cal) { return; }
      // Bundle fullcalendar.js của template expose global Calendar + các plugin (không có namespace FullCalendar).
      cal = new Calendar(document.getElementById('calendar'), {
        initialView: 'dayGridMonth',
        plugins: [dayGridPlugin, listPlugin, interactionPlugin],
        locale: 'vi',
        height: 'auto',
        firstDay: 1,
        dayMaxEvents: 3,
        headerToolbar: { start: 'prev,next today', center: 'title', end: 'dayGridMonth,listMonth' },
        buttonText: { today: 'Hôm nay', month: 'Tháng', list: 'Danh sách' },
        events: function (info, success, failure) {
          var p = calFilterParams();
          p.start = info.startStr; p.end = info.endStr;
          $.getJSON('?handler=Events&' + $.param(p))
            .done(function (res) {
              if (res.truncated) { tk.error('Khoảng này có ' + res.total + ' chuyến, chỉ hiển thị 500. Hãy thu hẹp bộ lọc.'); }
              success(res.events);
            })
            .fail(failure);
        },
        eventDidMount: function (arg) {
          var e = arg.event.extendedProps;
          arg.el.setAttribute('title',
            arg.event.title + ' · ' + e.tourType + ' · ' + e.totalSlots + ' chỗ · ' + e.statusLabel);
        },
        eventClick: function (arg) {
          // Mở panel trượt từ phải thay vì điều hướng — giữ nguyên tháng/bộ lọc đang xem.
          arg.jsEvent.preventDefault();
          var p = arg.event.extendedProps || {};
          tk.panel({
            title: arg.event.title,
            rows: [
              { label: 'Mã chuyến', value: p.code },
              { label: 'Loại tour', value: p.tourType },
              { label: 'Ngày khởi hành', value: arg.event.start ? arg.event.start.toLocaleDateString('vi-VN') : null },
              { label: 'Ngày kết thúc', value: arg.event.end ? new Date(arg.event.end.getTime() - 86400000).toLocaleDateString('vi-VN') : null },
              { label: 'Tổng số chỗ', value: p.totalSlots != null ? tk.money(p.totalSlots) : null },
              { label: 'Trạng thái', value: p.statusLabel }
            ],
            actionUrl: '/Departures/Detail/' + arg.event.id,
            actionText: 'Mở chi tiết chuyến'
          });
        }
      });
      cal.render();
    }
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (DepartureListFilter) — không lọc ở client, không get-all.
    var FILTERS = ['tourType', 'assignedToUserId', 'departureFrom', 'departureTo'];

    function collectFilters(d) {
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { d[k] = v; } });
      if (isClosed !== '') { d.isClosed = isClosed; }
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }
    function setRange(from, to) {
      var a = document.getElementById('f-departureFrom'), b = document.getElementById('f-departureTo');
      if (a._flatpickr) { a._flatpickr.setDate(from, true); } else { a.value = from; }
      if (b._flatpickr) { b._flatpickr.setDate(to, true); } else { b.value = to; }
    }
    // Dịch khoảng lọc đi n tháng (thay cho nút ‹ › của lịch tháng hệ cũ).
    function shiftMonth(n) {
      var from = $('#f-departureFrom').val() || MONTH_FROM;
      var d = new Date(from + 'T00:00:00');
      var first = new Date(d.getFullYear(), d.getMonth() + n, 1);
      var last = new Date(d.getFullYear(), d.getMonth() + n + 1, 0);
      function fmt(x) {
        var m = String(x.getMonth() + 1); if (m.length < 2) { m = '0' + m; }
        var day = String(x.getDate()); if (day.length < 2) { day = '0' + day; }
        return x.getFullYear() + '-' + m + '-' + day;
      }
      setRange(fmt(first), fmt(last));
      dt.ajax.reload();
    }
    function applyStats(s) {
      if (!s) { return; }
      $('#kpi-total').text(tk.money(s.total));
      $('#kpi-upcoming').text(tk.money(s.upcoming));
      $('#kpi-closed').text(tk.money(s.closed));
      $('#kpi-slots').text(tk.money(s.totalSlots));
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          // Ngày đi (+ thứ) / ngày về
          { data: null, render: function (r) {
              return '<div class="fw-medium">' + tk.escape(r.departureDateText) + (r.weekdayText ? ' <span class="small text-muted">(' + tk.escape(r.weekdayText) + ')</span>' : '') + '</div>' +
                     (r.endDateText ? '<div class="small text-muted">→ ' + tk.escape(r.endDateText) + '</div>' : '');
            } },
          // Tour / LKH: tên + mã · loại tour
          { data: null, render: function (r) {
              return '<div class="fw-medium">' + tk.trunc(r.title, 260) + '</div>' +
                     '<div class="small text-muted">' + tk.escape(r.code) + ' · ' + tk.escape(r.tourType) + '</div>';
            } },
          { data: 'totalSlots', className: 'text-end fw-medium', render: function (v) { return tk.money(v); } },
          { data: 'assigneeName', render: function (v) { return tk.trunc(v, 170); } },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } }
        ]
      });

      // Dòng "Tổng cộng (trang này)" — bám nhãn "N chuyến · X chỗ" của ô lịch hệ cũ; KPI lấy từ khối stats.
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        applyStats(json && json.stats);
        var s = json && json.pageSum;
        if (!s) { return; }
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' +
          '<span class="me-3 text-muted">' + tk.money(s.count) + ' chuyến</span>' +
          '<span class="text-muted">Tổng chỗ: <span class="fw-medium">' + tk.money(s.slots) + '</span></span>');
      });

      // Áp bộ lọc cho ĐÚNG khung đang xem.
      function applyFilters() {
        if ($('#pane-cal').hasClass('d-none')) { dt.ajax.reload(); } else if (cal) { cal.refetchEvents(); }
      }

      $('#btn-search').on('click', applyFilters);
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { applyFilters(); } });
      $('.tk-s2f').on('change', applyFilters);
      $('.tk-datef').on('change', function () { dt.ajax.reload(); });
      $('#btn-prev').on('click', function () { shiftMonth(-1); });
      $('#btn-next').on('click', function () { shiftMonth(1); });
      $('#btn-today').on('click', function () { setRange(MONTH_FROM, MONTH_TO); dt.ajax.reload(); });
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        ['tourType', 'assignedToUserId'].forEach(function (k) { $('#f-' + k).val('').trigger('change.select2'); });
        setRange(MONTH_FROM, MONTH_TO);
        isClosed = '';
        $('#tabs .nav-link').removeClass('active').filter('[data-v=""]').addClass('active');
        applyFilters();
      });
      $('#tabs').on('click', '.nav-link', function () {
        $('#tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        isClosed = this.getAttribute('data-v');
        applyFilters();
      });

      // Chuyển khung Lịch ↔ Bảng (nút dịch tháng chỉ dùng cho khung bảng; lịch có sẵn prev/next).
      $('#view-cal').on('click', function () {
        $('#pane-table').addClass('d-none'); $('#pane-cal').removeClass('d-none');
        $(this).addClass('active'); $('#view-table').removeClass('active');
        $('#tbl-nav').addClass('d-none');
        initCalendar();
        cal.updateSize();
      });
      $('#view-table').on('click', function () {
        $('#pane-cal').addClass('d-none'); $('#pane-table').removeClass('d-none');
        $(this).addClass('active'); $('#view-cal').removeClass('active');
        $('#tbl-nav').removeClass('d-none');
        dt.columns.adjust();
      });

      // Mặc định mở khung LỊCH (đúng tên màn "Lịch điều hành").
      initCalendar();
    });
  </script>
}
