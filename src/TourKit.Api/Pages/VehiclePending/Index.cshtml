@page
@model TourKit.Api.Pages.VehiclePending.IndexModel
@{ ViewData["Title"] = "Lịch xe chờ duyệt"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/fullcalendar/fullcalendar.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/app-calendar.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-0">Lịch xe chờ duyệt</h4>
    <small class="text-muted">Phân xe đã điều nhưng chưa đưa vào vận hành — lịch chỉ nạp phân xe trong khoảng đang xem.</small>
  </div>
  <div class="d-flex gap-2">
    @* Chuyển Lịch / Bảng — lịch chỉ nạp phân xe trong khoảng đang xem *@
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-label-secondary active" id="view-cal" title="Dạng lịch"><i class="ti ti-calendar"></i></button>
      <button type="button" class="btn btn-label-secondary" id="view-table" title="Dạng bảng"><i class="ti ti-list"></i></button>
    </div>
    <a class="btn btn-label-secondary" href="/dieu-xe"><i class="ti ti-car me-1"></i> Mở Lịch điều xe</a>
  </div>
</div>

@{
    // 4 KPI — bám StatGrid màn Lịch điều xe (cùng nguồn VehicleAssignmentStatsDto).
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng phân xe", Model.Stats.Total.ToString("#,##0"), "ti ti-clipboard-list", "primary"),
        ("kpi-created", "Chờ duyệt", Model.Stats.Created.ToString("#,##0"), "ti ti-clock", "warning"),
        ("kpi-active", "Đã điều", Model.Stats.Active.ToString("#,##0"), "ti ti-circle-check", "success"),
        ("kpi-vehicles", "Số xe", Model.Stats.VehicleCount.ToString("#,##0"), "ti ti-bus", "info"),
    };
}

<div class="tk-stat-strip tk-surface mb-3">
  @foreach (var s in statCards)
  {
    <div class="tk-stat">
      <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
      <div class="lh-sm">
        <div class="tk-stat-value" id="@s.Id">@s.Value</div>
        <small class="tk-stat-label">@s.Label</small>
      </div>
    </div>
  }
</div>

@* Thanh lọc — đúng các tiêu chí VehicleAssignmentListFilter, đẩy hết xuống SERVER *@
<div class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-3">
        <select id="f-vehicleId" class="form-select tk-s2f" data-placeholder="Xe"><option value=""></option>@foreach (var v in Model.Vehicles) { <option value="@v.Id">@v.Label</option> }</select>
      </div>
      <div class="col-md-3">
        @* Xe nhúng sẵn (đội xe có biên), chuyến gọi server — xem chú thích ở khối script. *@
        <select id="f-departureId" class="form-select" data-placeholder="Chuyến"></select>
      </div>
      <div class="col-md-2">
        <select id="f-status" class="form-select">
          <option value="1" selected>Chờ duyệt</option>
          <option value="2">Đã điều</option>
        </select>
      </div>
      @* tk.dateRanges() ẩn CẢ CỘT chứa f-dateTo → KHÔNG để nút chung cột đó. *@
      <div class="col-md-2"><input type="text" id="f-dateFrom" class="form-control tk-datef" placeholder="Ngày đón từ" autocomplete="off" /></div>
      <div class="col-md-2"><input type="text" id="f-dateTo" class="form-control tk-datef" placeholder="đến" autocomplete="off" /></div>
      <div class="col-auto d-flex gap-2 ms-auto">
        <button type="button" class="btn btn-primary text-nowrap" id="btn-search"><i class="ti ti-search me-1"></i>Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>
</div>

@* Khung LỊCH — FullCalendar của template; mỗi lần đổi tháng chỉ gọi handler Events cho đúng khoảng đó *@
<div class="card app-calendar-wrapper" id="pane-cal">
  <div class="card-body">
    <div id="calendar"></div>
  </div>
</div>

<div class="tk-surface d-none" id="pane-table">
  <div id="grid-vehicle-pending"></div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/fullcalendar/fullcalendar.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var grid, cal = null;
    function applyStats(s) {
      if (!s) { return; }
      $('#kpi-total').text(tk.money(s.total));
      $('#kpi-created').text(tk.money(s.created));
      $('#kpi-active').text(tk.money(s.active));
      $('#kpi-vehicles').text(tk.money(s.vehicleCount));
    }

    // ---- Khung LỊCH (FullCalendar của template) ----
    // events: FullCalendar truyền start/end của khung ĐANG XEM → server chỉ trả phân xe trong khoảng đó.
    // Khoảng ngày của thanh lọc KHÔNG áp cho lịch (khung lịch đã là khoảng ngày).
    function calFilterParams() {
      var p = {};
      ['vehicleId', 'departureId', 'status'].forEach(function (k) { var v = $('#f-' + k).val(); if (v) { p[k] = v; } });
      return p;
    }

    function initCalendar() {
      if (cal) { return; }
      // Bundle fullcalendar.js của template expose global Calendar + các plugin (không có namespace FullCalendar).
      cal = new Calendar(document.getElementById('calendar'), {
        initialView: 'dayGridMonth',
        plugins: [dayGridPlugin, listPlugin, interactionPlugin],
        locale: 'vi',
        height: 'auto',
        firstDay: 1,
        dayMaxEvents: 3,
        headerToolbar: { start: 'prev,next today', center: 'title', end: 'dayGridMonth,listMonth' },
        buttonText: { today: 'Hôm nay', month: 'Tháng', list: 'Danh sách' },
        events: function (info, success, failure) {
          var p = calFilterParams();
          p.start = info.startStr; p.end = info.endStr;
          $.getJSON('?handler=Events&' + $.param(p))
            .done(function (res) {
              if (res.truncated) { tk.error('Khoảng này có ' + res.total + ' phân xe, chỉ hiển thị 500. Hãy thu hẹp bộ lọc.'); }
              success(res.events);
            })
            .fail(failure);
        },
        eventDidMount: function (arg) {
          var e = arg.event.extendedProps;
          arg.el.setAttribute('title',
            e.vehicleName + ' · ' + e.departureCode + ' — ' + e.departureTitle +
            '\nTài xế: ' + e.driverName + (e.driverPhone ? ' (' + e.driverPhone + ')' : '') +
            (e.timeComeText ? '\nTrả: ' + e.timeComeText : '') +
            '\nTrạng thái: ' + e.statusLabel);
        },
        eventClick: function (arg) {
          // Chưa có trang chi tiết phân xe → mở màn Lịch điều xe (nơi sửa/kích hoạt phân xe).
          arg.jsEvent.preventDefault();
          window.location.href = '/dieu-xe';
        }
      });
      cal.render();
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      // Chuyến gọi SERVER: số chuyến chỉ tăng theo thời gian, nạp sẵn thì sớm muộn cũng vượt trần —
      // và vượt trần là hỏng im lặng, ô vẫn hiện nhưng thiếu chuyến. Màn này chỉ có ô LỌC, không có
      // form sửa, nên không cần tk.s2set.
      tk.s2ajax('#f-departureId', { url: '?handler=DepartureLookup', placeholder: 'Chuyến' });

      var g = tk.g, esc = g.esc;

      // Toàn bộ tiêu chí lọc đẩy xuống SERVER (VehicleAssignmentListFilter) — không lọc ở client.
      grid = tk.grid('#grid-vehicle-pending', {
        filters: ['vehicleId', 'departureId', 'status', 'dateFrom', 'dateTo'],
        exportName: 'lich-xe-cho-duyet.csv',
        // Màn này LUÔN quay về "Chờ duyệt" khi đặt lại bộ lọc.
        onReset: function () { $('#f-status').val('1'); },
        // KPI lấy từ khối stats kèm theo mỗi lần tải bảng.
        onData: function (res) { applyStats(res && res.stats); },
        columns: [
          {
            title: 'Xe', field: 'vehicleName', widthGrow: 2, minWidth: 170,
            formatter: function (c) {
              var v = c.getValue();
              if (!v) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-row-media">' + g.avatar(v) + g.stack(v, null) + '</div>';
            }
          },
          {
            title: 'Chuyến', field: 'departureTitle', widthGrow: 3, minWidth: 220,
            formatter: function (c) { var r = c.getData(); return g.stack(r.departureTitle, r.departureCode); }
          },
          {
            title: 'Tài xế', field: 'driverName', widthGrow: 2, minWidth: 160,
            formatter: function (c) { var r = c.getData(); return g.stack(r.driverName, r.driverPhone); }
          },
          {
            title: 'Thời gian', field: 'timeGoText', width: 170,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.timeGoText, r.timeComeText ? ('Trả: ' + r.timeComeText) : null);
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', widthGrow: 2, minWidth: 170,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell"><span class="badge bg-label-' + r.statusColor + '">' + esc(r.statusLabel) + '</span>' +
                (r.note ? '<div class="tk-cell-sub mt-1" title="' + esc(r.note) + '">' + esc(r.note) + '</div>' : '') + '</div>';
            }
          }
        ]
      });

      // Khung LỊCH không dùng lưới nên phải tự vẽ lại khi bộ lọc đổi.
      function calRefreshIfVisible() { if (!$('#pane-cal').hasClass('d-none') && cal) { cal.refetchEvents(); } }
      $('#btn-search, #btn-reset').on('click', function () { setTimeout(calRefreshIfVisible, 50); });
      $('#f-vehicleId, #f-departureId, #f-status').on('change', function () { setTimeout(calRefreshIfVisible, 50); });

      // Chuyển khung Lịch ↔ Bảng.
      $('#view-cal').on('click', function () {
        $('#pane-table').addClass('d-none'); $('#pane-cal').removeClass('d-none');
        $(this).addClass('active'); $('#view-table').removeClass('active');
        initCalendar();
        cal.updateSize();
      });
      $('#view-table').on('click', function () {
        $('#pane-cal').addClass('d-none'); $('#pane-table').removeClass('d-none');
        $(this).addClass('active'); $('#view-cal').removeClass('active');
        grid.table.redraw(true);
      });

      // Mặc định mở khung LỊCH (đúng tên màn "Lịch xe chờ duyệt").
      initCalendar();
    });
  </script>
}
