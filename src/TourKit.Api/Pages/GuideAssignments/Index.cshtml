@page
@model TourKit.Api.Pages.GuideAssignments.IndexModel
@{ ViewData["Title"] = "Lịch điều Hướng dẫn viên"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Lịch điều Hướng dẫn viên</h4>
  @if (Model.CanManage)
  {
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm phân công</button>
  }
</div>

@* 4 KPI — bám StatGrid hệ cũ *@
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng phân công</small><h5 class="mb-0 tk-num" id="kpi-total">@Model.Stats.Total.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã điều</small><h5 class="mb-0 text-info tk-num" id="kpi-created">@Model.Stats.Created.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đang thực hiện</small><h5 class="mb-0 text-success tk-num" id="kpi-active">@Model.Stats.Active.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Số HDV</small><h5 class="mb-0 tk-num" id="kpi-guides">@Model.Stats.GuideCount.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — đúng các tiêu chí GuideAssignmentListFilter (HDV · chuyến · khoảng ngày đi), đẩy hết xuống SERVER *@
<div class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-3">
        <select id="f-providerId" class="form-select tk-s2f" data-placeholder="Hướng dẫn viên"><option value=""></option>@foreach (var g in Model.Guides) { <option value="@g.Id">@g.Name</option> }</select>
      </div>
      <div class="col-md-4">
        <select id="f-departureId" class="form-select tk-s2f" data-placeholder="Chuyến"><option value=""></option>@foreach (var d in Model.Departures) { <option value="@d.Id">@d.Label</option> }</select>
      </div>
      <div class="col-md-2"><input type="text" id="f-dateFrom" class="form-control tk-datef" placeholder="Ngày đi từ" autocomplete="off" /></div>
      <div class="col-md-3 d-flex gap-2">
        <input type="text" id="f-dateTo" class="form-control tk-datef" placeholder="đến" autocomplete="off" />
        <button type="button" class="btn btn-primary" id="btn-search" title="Tìm kiếm"><i class="ti ti-search"></i></button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>
</div>

@* Tab trạng thái — bám Segmented hệ cũ (Tất cả / Đã điều / Đang thực hiện) *@
<ul class="nav nav-pills flex-wrap mb-3" id="tabs">
  <li class="nav-item"><button type="button" class="nav-link active" data-v="">Tất cả (<span id="tab-total">@Model.Stats.Total</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="1">Đã điều (<span id="tab-created">@Model.Stats.Created</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="2">Đang thực hiện (<span id="tab-active">@Model.Stats.Active</span>)</button></li>
</ul>

<div class="card">
  <div class="card-header"><h5 class="mb-0">Danh sách phân công HDV</h5></div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>Chuyến</th><th>HDV</th><th>Thời gian</th>
          <th>Trạng thái</th><th>Thu-chi</th><th>Bàn giao</th><th></th>
        </tr>
      </thead>
    </table>
  </div>
</div>

@Html.AntiForgeryToken()

@* Offcanvas CRUD — GIỮ NGUYÊN các trường Create/Update DTO *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">phân công HDV</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3">
        <label class="form-label">Chuyến <span class="text-danger">*</span></label>
        <select name="Input.TourDepartureId" class="form-select tk-s2" data-placeholder="Chọn chuyến">
          <option value="">— Chọn chuyến —</option>
          @foreach (var d in Model.Departures) { <option value="@d.Id">@d.Label</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Hướng dẫn viên <span class="text-danger">*</span></label>
        <select name="Input.ProviderId" class="form-select tk-s2" data-placeholder="Chọn HDV">
          <option value="">— Chọn HDV —</option>
          @foreach (var g in Model.Guides) { <option value="@g.Id">@g.Name</option> }
        </select>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngày đi</label><input type="text" name="Input.TimeGo" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3"><label class="form-label">Ngày về</label><input type="text" name="Input.TimeCome" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngày trả tour</label><input type="text" name="Input.TimeReturn" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3">
          <label class="form-label">Trạng thái</label>
          <select name="Input.Status" class="form-select"><option value="1">Đã điều</option><option value="2">Đang thực hiện</option></select>
        </div>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Ghi chú điều HDV"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@* Modal Thu-chi HDV theo chuyến — nạp ĐÚNG 1 phân công khi mở (bám GuideTransactionCell hệ cũ) *@
<div class="modal fade" id="tx-modal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="tx-title">Thu-chi HDV theo chuyến</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="row g-3 mb-3">
          <div class="col-4"><div class="border rounded p-2"><small class="text-muted d-block">Tổng thu</small><h6 class="mb-0 text-success" id="tx-revenue">0</h6></div></div>
          <div class="col-4"><div class="border rounded p-2"><small class="text-muted d-block">Tổng chi</small><h6 class="mb-0 text-danger" id="tx-expense">0</h6></div></div>
          <div class="col-4"><div class="border rounded p-2"><small class="text-muted d-block">Net (thu − chi)</small><h6 class="mb-0" id="tx-net">0</h6></div></div>
        </div>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead><tr><th>Ngày</th><th>Loại</th><th>Diễn giải</th><th class="text-end">Số tiền</th><th></th></tr></thead>
            <tbody id="tx-rows"></tbody>
          </table>
        </div>
        @if (Model.CanManage)
        {
          <form id="tx-frm" class="row g-2 mt-3 pt-3 border-top" onsubmit="return false">
            <div class="col-md-2">
              <label class="form-label small mb-1">Loại <span class="text-danger">*</span></label>
              <select id="tx-type" class="form-select"><option value="0">Thu</option><option value="1">Chi</option></select>
            </div>
            <div class="col-md-3">
              <label class="form-label small mb-1">Số tiền <span class="text-danger">*</span></label>
              <input type="number" min="1" id="tx-amount" class="form-control" placeholder="0" />
            </div>
            <div class="col-md-5">
              <label class="form-label small mb-1">Diễn giải <span class="text-danger">*</span></label>
              <input type="text" id="tx-desc" class="form-control" placeholder="VD: Thu vé tham quan" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="button" class="btn btn-primary w-100" id="tx-add">Ghi</button>
            </div>
          </form>
        }
      </div>
    </div>
  </div>
</div>

@* Modal Biên bản bàn giao (bám GuideHandoverCell hệ cũ) *@
<div class="modal fade" id="ho-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Biên bản bàn giao HDV</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <p class="text-muted small d-none" id="ho-at"></p>
        <label class="form-label">Nội dung bàn giao <span class="text-danger">*</span></label>
        <textarea id="ho-content" class="form-control" rows="5" placeholder="Nội dung bàn giao: sự cố, còn tồn, phản hồi khách…"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button>
        @if (Model.CanManage)
        {
          <button type="button" class="btn btn-primary" id="ho-save">Nộp bàn giao</button>
        }
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt, fStatus = '', txId = null, hoId = null;
    var CAN_MANAGE = @(Model.CanManage ? "true" : "false");
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (GuideAssignmentListFilter) — không lọc ở client, không get-all.
    var FILTERS = ['providerId', 'departureId', 'dateFrom', 'dateTo'];

    function collectFilters(d) {
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { d[k] = v; } });
      if (fStatus !== '') { d.status = fStatus; }
    }
    function applyStats(s) {
      if (!s) { return; }
      $('#kpi-total, #tab-total').text(tk.money(s.total));
      $('#kpi-created, #tab-created').text(tk.money(s.created));
      $('#kpi-active, #tab-active').text(tk.money(s.active));
      $('#kpi-guides').text(tk.money(s.guideCount));
    }

    // ---- Modal Thu-chi: nạp đối soát của ĐÚNG 1 phân công ----
    function loadTx() {
      $.getJSON('?handler=Settlement&id=' + txId, function (s) {
        $('#tx-revenue').text(tk.money(s.totalRevenue));
        $('#tx-expense').text(tk.money(s.totalExpense));
        $('#tx-net').text(tk.money(s.net));
        var html = '';
        (s.items || []).forEach(function (i) {
          html += '<tr><td>' + tk.escape(i.occurredAtText) + '</td><td>' + tk.escape(i.typeLabel) + '</td><td>' + tk.trunc(i.description, 260) + '</td>' +
                  '<td class="text-end fw-medium">' + tk.money(i.amount) + '</td>' +
                  '<td class="text-end">' + (CAN_MANAGE ? '<button type="button" class="btn btn-icon btn-sm text-danger js-tx-del" data-id="' + i.id + '" title="Xoá"><i class="ti ti-trash"></i></button>' : '') + '</td></tr>';
        });
        $('#tx-rows').html(html || '<tr><td colspan="5" class="text-center text-muted">Chưa có dòng thu-chi</td></tr>');
      });
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          // Chuyến: tên + mã (bám CellEntity hệ cũ)
          { data: null, render: function (r) {
              return '<div class="fw-medium">' + tk.trunc(r.departureTitle, 220) + '</div>' +
                     '<div class="small text-muted">' + tk.escape(r.departureCode) + '</div>';
            } },
          { data: 'providerName', render: function (v) { return '<span class="fw-medium">' + tk.trunc(v, 170) + '</span>'; } },
          // Thời gian: ngày đi + "Về: ..." (+ "Trả tour: ..." nếu có)
          { data: null, render: function (r) {
              return '<div>' + tk.escape(r.timeGoText) + '</div>' +
                     (r.timeComeText ? '<div class="small text-muted">Về: ' + tk.escape(r.timeComeText) + '</div>' : '') +
                     (r.timeReturnText ? '<div class="small text-muted">Trả tour: ' + tk.escape(r.timeReturnText) + '</div>' : '');
            } },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, render: function () { return '<button type="button" class="btn btn-sm btn-label-secondary js-tx">Thu-chi</button>'; } },
          { data: null, render: function (r) {
              return '<button type="button" class="btn btn-sm btn-label-' + (r.handedOverAtText ? 'success' : 'secondary') + ' js-ho">' +
                     (r.handedOverAtText ? 'Đã bàn giao' : 'Bàn giao') + '</button>';
            } },
          { data: null, className: 'text-end text-nowrap', render: function () {
              if (!CAN_MANAGE) { return ''; }
              return '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" title="Xoá"><i class="ti ti-trash"></i></button>';
            } }
        ]
      });

      // KPI + số đếm trên tab lấy từ khối stats kèm theo mỗi lần tải bảng.
      $('#tbl').on('xhr.dt', function (e, settings, json) { applyStats(json && json.stats); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'phân công HDV',
        rules: { 'Input.TourDepartureId': { required: true }, 'Input.ProviderId': { required: true } },
        messages: { 'Input.TourDepartureId': { required: 'Bắt buộc chọn chuyến' }, 'Input.ProviderId': { required: 'Bắt buộc chọn HDV' } } });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      $('.tk-datef').on('change', function () { dt.ajax.reload(); });
      $('#btn-reset').on('click', function () {
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('.tk-datef').each(function () { if (this._flatpickr) { this._flatpickr.clear(); } });
        fStatus = '';
        $('#tabs .nav-link').removeClass('active').filter('[data-v=""]').addClass('active');
        dt.ajax.reload();
      });
      $('#tabs').on('click', '.nav-link', function () {
        $('#tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        fStatus = this.getAttribute('data-v');
        dt.ajax.reload();
      });

      // Server-side: lấy dữ liệu dòng từ DataTables API (không còn data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var r = dt.row($(this).closest('tr')).data();
        tk.confirmDelete({ title: 'Xoá phân công HDV?', text: 'Phân công ' + r.providerName + ' — ' + r.departureCode + ' sẽ bị xoá.' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { dt.ajax.reload(null, false); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      });

      $('#tbl tbody').on('click', '.js-tx', function () {
        var r = dt.row($(this).closest('tr')).data();
        txId = r.id;
        $('#tx-title').text('Thu-chi HDV — ' + r.departureCode + ' · ' + r.providerName);
        $('#tx-rows').empty();
        loadTx();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('tx-modal')).show();
      });
      $('#tx-add').on('click', function () {
        var amount = Number($('#tx-amount').val()) || 0;
        var desc = ($('#tx-desc').val() || '').trim();
        if (amount <= 0 || !desc) { tk.error('Nhập số tiền > 0 và diễn giải.'); return; }
        var fd = new FormData();
        fd.append('id', txId); fd.append('type', $('#tx-type').val()); fd.append('amount', amount); fd.append('description', desc);
        tk.post('?handler=AddTransaction', fd).then(function (res) {
          if (res && res.isSuccess) { $('#tx-amount').val(''); $('#tx-desc').val(''); loadTx(); tk.toast(res.message || 'Đã ghi.'); }
          else { tk.error((res && res.message) || 'Ghi thất bại.'); }
        });
      });
      $('#tx-rows').on('click', '.js-tx-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá dòng thu-chi?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', txId); fd.append('transactionId', id);
          tk.post('?handler=DeleteTransaction', fd).then(function (res) {
            if (res && res.isSuccess) { loadTx(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      });

      $('#tbl tbody').on('click', '.js-ho', function () {
        var r = dt.row($(this).closest('tr')).data();
        hoId = r.id;
        $('#ho-content').val(r.handoverContent || '');
        $('#ho-at').toggleClass('d-none', !r.handedOverAtText).text(r.handedOverAtText ? ('Đã bàn giao lúc ' + r.handedOverAtText + '.') : '');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('ho-modal')).show();
      });
      $('#ho-save').on('click', function () {
        var content = ($('#ho-content').val() || '').trim();
        if (!content) { tk.error('Cần nội dung bàn giao.'); return; }
        var fd = new FormData(); fd.append('id', hoId); fd.append('content', content);
        tk.post('?handler=Handover', fd).then(function (res) {
          if (res && res.isSuccess) {
            bootstrap.Modal.getInstance(document.getElementById('ho-modal')).hide();
            dt.ajax.reload(null, false);
            tk.toast(res.message || 'Đã bàn giao.');
          } else { tk.error((res && res.message) || 'Nộp bàn giao thất bại.'); }
        });
      });
    });
  </script>
}
