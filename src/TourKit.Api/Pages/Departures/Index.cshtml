@page
@model TourKit.Api.Pages.Departures.IndexModel
@{ ViewData["Title"] = Model.ByCategory ? $"Quản lý chuyến — {Model.CategoryLabel}" : "Chuyến đi (Tour / LKH)"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 4 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng chuyến", Model.Stats.Total.ToString("#,##0"), "ti ti-route", "primary"),
        ("Sắp khởi hành", Model.Stats.Upcoming.ToString("#,##0"), "ti ti-plane-departure", "success"),
        ("Đã đóng", Model.Stats.Closed.ToString("#,##0"), "ti ti-lock", "danger"),
        ("Tổng chỗ", Model.Stats.TotalSlots.ToString("#,##0"), "ti ti-armchair", "info"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Điều hành <span class="mx-1">/</span> <span class="text-body">Chuyến đi</span></div>
    <h4 class="mb-0">@(Model.ByCategory ? $"Quản lý chuyến — {Model.CategoryLabel}" : "Chuyến đi (Tour / LKH)")</h4>
  </div>
  <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm chuyến</button>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — bám staging /sample-tours ở các field CÓ model chuyến: q · loại tour · NVĐH ·
     khoảng ngày khởi hành · khoảng ngày kết thúc · sắp xếp. (TT thanh toán/NCC/cọc/người tạo là cấp ĐƠN,
     không có ở model chuyến → chưa đưa vào, tránh bịa.) *@
  <div class="tk-pad">
    @* Tab trạng thái — bám SegmentTabs hệ cũ (Tất cả / Đang mở / Đã đóng) *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="isClosed">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1">@Model.Stats.Total.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="false">Đang mở</a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="true">Đã đóng <span class="badge bg-label-secondary ms-1">@Model.Stats.Closed.ToString("#,##0")</span></a></li>
    </ul>
    <input type="hidden" id="f-isClosed" value="" />

    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã / tên chuyến" /></div>
      <div class="col-md-2">
        <select id="f-tourType" class="form-select tk-s2f" data-placeholder="Loại hình"><option value=""></option>@foreach (var t in Model.TourTypes) { <option value="@t">@t</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-assignedToUserId" class="form-select tk-s2f" data-placeholder="NV điều hành"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-sort" class="form-select tk-auto">
          <option value="dateDesc">Ngày KH: mới → cũ</option>
          <option value="dateAsc">Ngày KH: cũ → mới</option>
          <option value="slots">Số chỗ nhiều nhất</option>
          <option value="code">Mã chuyến (A→Z)</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-adv" title="Lọc nâng cao"><i class="ti ti-filter"></i></button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    @* LƯU Ý: tk.dateRanges() (tk.js) gộp ô "…From/…To" thành 1 range và ẨN CẢ CỘT chứa ô "…To".
       => Mỗi ô "…To" để RIÊNG 1 cột; KHÔNG đặt nút/điều khiển khác chung cột đó. *@
    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><input type="text" id="f-departureFrom" class="form-control tk-datef" placeholder="Ngày khởi hành từ" /></div>
      <div class="col-md-3"><input type="text" id="f-departureTo" class="form-control tk-datef" placeholder="Ngày khởi hành đến" /></div>
      <div class="col-md-3"><input type="text" id="f-endFrom" class="form-control tk-datef" placeholder="Ngày kết thúc từ" /></div>
      <div class="col-md-3"><input type="text" id="f-endTo" class="form-control tk-datef" placeholder="Ngày kết thúc đến" /></div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> chuyến đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-departures"></div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">chuyến đi</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body tk-oc">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <div class="tk-oc-fields">
      @* Có ô này thì tk.form mới điền được data.id lúc mở sửa; thiếu nó, handler không biết sửa
         chuyến nào và lần Lưu kế tiếp tạo ra một chuyến trùng mã. *@
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Mẫu tour</label>
        <select name="Input.TemplateId" class="form-select tk-s2" data-placeholder="Chọn mẫu (tuỳ chọn)"><option value="">— Không dùng mẫu —</option>@foreach (var t in Model.Templates) { <option value="@t.Id">@t.Label</option> }</select>
        <div class="form-text" data-role="ghi-chu-mau">Chỉ chọn được khi tạo mới — lịch trình đã chép từ mẫu nên không đổi mẫu khi sửa.</div>
      </div>
      <div class="row">
        <div class="col-5 mb-3"><label class="form-label">Mã chuyến <span class="text-danger">*</span></label><input type="text" name="Input.Code" class="form-control" placeholder="VD: DN-2607" /></div>
        <div class="col-7 mb-3"><label class="form-label">Tên chuyến <span class="text-danger">*</span></label><input type="text" name="Input.Title" class="form-control" placeholder="Đà Nẵng 3N2Đ" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngày khởi hành</label><input type="text" name="Input.DepartureDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3"><label class="form-label">Ngày về</label><input type="text" name="Input.EndDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Tổng số chỗ</label><input type="number" name="Input.TotalSlots" class="form-control" placeholder="0" min="0" /></div>
      </div>
      <div class="tk-oc-actions">
        <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
      </div>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;

    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'chuyến đi',
        rules: { 'Input.Code': { required: true }, 'Input.Title': { required: true } },
        messages: { 'Input.Code': { required: 'Bắt buộc nhập mã chuyến' }, 'Input.Title': { required: 'Bắt buộc nhập tên chuyến' } },

        // Khi SỬA: khoá ô "Mẫu tour" cho khớp với server — UpdateDepartureDto không nhận TemplateId,
        // vì lịch trình đã được chép sang chuyến lúc tạo. Để ô đó bấm được mà lưu xong không đổi gì
        // là nói dối người dùng.
        afterOpen: function (data) {
          var sua = !!data;
          $('#frm [name="Input.TemplateId"]').prop('disabled', sua).trigger('change.select2');
          $('#frm [data-role="ghi-chu-mau"]').toggle(sua);
        },

        // Đổi ngày khởi hành của chuyến ĐÃ CÓ KHÁCH: chủ dự án chốt CẢNH BÁO nhưng VẪN CHO SỬA —
        // dời ngày là chuyện bình thường trong nghề, chặn cứng thì người điều hành phải lách bằng
        // cách tạo chuyến mới rồi chuyển khách sang, vừa mất lịch sử vừa dễ sai hơn.
        //
        // Cảnh báo phải hiện TRƯỚC khi lưu. Báo sau khi đã ghi thì không còn là cảnh báo, chỉ là
        // thông báo — người dùng không còn lựa chọn nào ngoài việc sửa ngược lại.
        beforeSave: function ($f, cu) {
          if (!cu) { return true; }                       // thêm mới, chưa có khách nào

          var daDat = (Number(cu.seatHeld) || 0) + (Number(cu.seatSold) || 0);
          if (daDat <= 0) { return true; }

          // So ngày ở dạng ISO yyyy-MM-dd — đúng thứ flatpickr gửi đi và cũng là thứ lưới trả về.
          // Lấy nhầm ô altInput (d/m/Y) thì hai vế không bao giờ bằng nhau và cảnh báo hiện cả khi
          // người dùng không đụng gì tới ngày.
          var moi = $f.find('[name="Input.DepartureDate"]').val() || '';
          if (moi === (cu.departureDate || '')) { return true; }

          return tk.confirmWarn({
            title: 'Chuyến này đã có khách đặt',
            text: 'Đã giữ/bán ' + daDat + ' chỗ. Đổi ngày khởi hành thì lịch của khách đã đặt lệch theo, '
                + 'và phân công HDV/xe (nếu có) vẫn giữ ngày cũ — cần sửa lại riêng. Vẫn đổi chứ?',
            confirm: 'Vẫn đổi ngày'
          });
        }
      });

      function closeRow(r) {
        tk.confirmDelete({ title: 'Đóng chuyến ' + r.code + '?', text: 'Chuyến đã đóng sẽ khoá đặt chỗ.', confirm: 'Đóng chuyến' })
          .then(function (ok) {
            if (!ok) { return; }
            var fd = new FormData(); fd.append('id', r.id);
            tk.post('?handler=Close', fd).then(function (res) {
              if (res && res.isSuccess) { grid.reload(); tk.toast(res.message || 'Đã đóng chuyến.'); }
              else { tk.error((res && res.message) || 'Đóng chuyến thất bại.'); }
            });
          });
      }

      // Chỉ chuyến CHƯA đóng mới có mục "Đóng chuyến" — giữ đúng luật hệ cũ.
      function actionsFor(r) {
        var items = [
          { label: '<i class="ti ti-eye me-2"></i>Chi tiết chuyến', action: function () { window.location = '/chuyen-di/' + r.id; } }
        ];

        // Chuyến ĐÃ ĐÓNG thì không mời sửa: đóng chuyến là khoá đặt chỗ, và hoa hồng/đối soát sau đó
        // đều dựa trên số liệu tại thời điểm đóng. Server cũng từ chối, nhưng bày ra một mục bấm vào
        // chỉ để nhận thông báo lỗi là bắt người dùng tự dò xem cái gì làm được cái gì không.
        if (!r.isClosed) {
          items.push({ label: '<i class="ti ti-edit me-2"></i>Sửa chuyến', action: function () { oc.open(r); } });
        }
        if (!r.isClosed) {
          items.push({ separator: true });
          items.push({ label: '<i class="ti ti-lock me-2"></i>Đóng chuyến', action: function () { closeRow(r); } });
        }
        return items;
      }

      // Mọi tiêu chí đẩy xuống SERVER (DepartureListFilter) — không lọc ở client.
      grid = tk.grid('#grid-departures', {
        filters: ['tourType', 'assignedToUserId', 'departureFrom', 'departureTo', 'endFrom', 'endTo', 'sort', 'isClosed'],
        exportName: 'chuyen-di-da-chon.csv',
        actions: actionsFor,
        columns: [
          {
            title: 'Tour / LKH', field: 'title', widthGrow: 4, minWidth: 250,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell"><a class="tk-cell-main" href="/chuyen-di/' + r.id + '" title="' + esc(r.title) + '">' + esc(r.title) + '</a>' +
                '<div class="tk-cell-sub">' + esc(r.code) + ' · ' + esc(r.tourType) + '</div></div>';
            }
          },
          {
            title: 'Ngày khởi hành', field: 'departureDateText', width: 150,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.departureDateText, r.endDateText ? ('→ ' + r.endDateText) : null);
            }
          },
          {
            title: 'Giá', field: 'price', width: 140, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) {
              var v = c.getValue();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + (v > 0 ? money(v) : '—') + '</div></div>';
            }
          },
          {
            // Tổng · Giữ · Bán · Còn (bám cột chỗ staging /sample-tours)
            title: 'Chỗ (Tổng/Giữ/Bán/Còn)', field: 'totalSlots', width: 180, hozAlign: 'center',
            formatter: function (c) {
              var r = c.getData();
              return '<span class="badge bg-label-secondary me-1" title="Tổng">' + r.totalSlots + '</span>' +
                '<span class="badge bg-label-warning me-1" title="Giữ chỗ">' + r.seatHeld + '</span>' +
                '<span class="badge bg-label-success me-1" title="Đã bán">' + r.seatSold + '</span>' +
                '<span class="badge bg-label-info" title="Còn lại">' + r.seatRemaining + '</span>';
            }
          },
          {
            title: 'Điều hành', field: 'assigneeName', widthGrow: 2, minWidth: 160,
            formatter: function (c) {
              var r = c.getData();
              var v = c.getValue();
              if (!v) { return g.stack(null, r.closedAtText ? ('Đóng: ' + r.closedAtText) : null); }
              return '<div class="tk-row-media">' + g.avatar(v, true) + g.stack(v, r.closedAtText ? ('Đóng: ' + r.closedAtText) : null) + '</div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 140,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });
    });
  </script>
}
