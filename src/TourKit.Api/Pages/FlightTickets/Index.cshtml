@page
@model TourKit.Api.Pages.FlightTickets.IndexModel
@{ ViewData["Title"] = "Vé máy bay đoàn"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Quản lý Vé Đoàn</h4>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
    @if (Model.CanManage)
    {
      <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm vé đoàn</button>
    }
  </div>
</div>

@* 7 KPI — bám StatGrid hệ cũ *@
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Số lượng vé</small><h5 class="mb-0" id="kpi-qty">@Model.Stats.TotalQuantity.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã sử dụng</small><h5 class="mb-0 text-warning" id="kpi-used">@Model.Stats.TotalUsed.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Vé còn lại</small><h5 class="mb-0 text-success" id="kpi-remain">@Model.Stats.TotalRemaining.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng chi</small><h5 class="mb-0" id="kpi-cost">@Model.Stats.TotalCost.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Đã thanh toán</small><h5 class="mb-0 text-success" id="kpi-paid">@Model.Stats.TotalPaid.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Còn lại</small><h5 class="mb-0 text-danger" id="kpi-remaincost">@Model.Stats.TotalRemainingCost.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3 col-xxl-2"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tiền bảo lưu</small><h5 class="mb-0" id="kpi-reserved">@Model.Stats.TotalReserved.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — MỌI tiêu chí đẩy xuống server (FlightTicketListFilter) *@
<div class="card mb-4">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-4"><input type="text" id="f-q" class="form-control" placeholder="Mã PNR" /></div>
      <div class="col-md-2">
        <select id="f-marketRef" class="form-select tk-s2f" data-placeholder="Thị trường"><option value=""></option>@foreach (var m in Model.Markets) { <option value="@m.Id">@m.Name</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-providerRef" class="form-select tk-s2f" data-placeholder="NCC"><option value=""></option>@foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }</select>
      </div>
      <div class="col-md-2">
        <select id="f-tourType" class="form-select">
          <option value="">Loại hình</option>
          @foreach (var t in TourKit.Api.Pages.FlightTickets.IndexModel.TourTypes) { <option value="@t.Value">@t.Label</option> }
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search"></i></button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>

    <div class="row g-2 mt-1 pt-3 border-top d-none" id="adv">
      <div class="col-md-3"><label class="form-label small mb-1">Số ngày</label><input type="number" id="f-days" class="form-control" placeholder="Ví dụ: 4" /></div>
      <div class="col-md-3"><label class="form-label small mb-1">Ngày đi từ</label><input type="text" id="f-departureFrom" class="form-control tk-datef" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
    </div>
  </div>
</div>

@* Tab Tất cả / Đã gán tour / Chưa gán tour — bám Segmented hệ cũ *@
<input type="hidden" id="f-assigned" value="" />
<ul class="nav nav-pills flex-wrap mb-3" id="tabs">
  <li class="nav-item"><button type="button" class="nav-link active" data-val="">Tất cả code (<span id="tab-all">@Model.Stats.Total.ToString("#,##0")</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-val="true">Đã gán tour (<span id="tab-assigned">@Model.Stats.Assigned.ToString("#,##0")</span>)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-val="false">Chưa gán tour (<span id="tab-unassigned">@Model.Stats.Unassigned.ToString("#,##0")</span>)</button></li>
</ul>

<div class="card">
  <div class="card-header"><h5 class="mb-0">Danh sách vé máy bay đoàn</h5></div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>PNR / Loại hình</th><th>Gán Tour</th><th>NCC / Thị trường</th>
          <th>Lịch trình</th><th>Hành trình</th><th class="text-center">Vé (SL/Dùng/Còn)</th>
          <th class="text-end">Tổng chi / Đã TT</th><th class="text-end">Còn lại / Bảo lưu</th><th></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="10" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

@Html.AntiForgeryToken()

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">vé đoàn</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      @* Passthrough: gán tour + chặng bay không có editor ở form này → giữ nguyên để KHÔNG mất dữ liệu *@
      <input type="hidden" name="Input.OrderRef" />
      <input type="hidden" name="Input.SegmentsJson" />
      <div class="mb-3"><label class="form-label">PNR <span class="text-danger">*</span></label><input type="text" name="Input.Pnr" class="form-control" placeholder="Nhập mã PNR" /></div>
      <div class="row">
        <div class="col-6 mb-3">
          <label class="form-label">Loại hình</label>
          <select name="Input.TourType" class="form-select">
            <option value="">— Chọn loại hình —</option>
            @foreach (var t in TourKit.Api.Pages.FlightTickets.IndexModel.TourTypes) { <option value="@t.Value">@t.Label</option> }
          </select>
        </div>
        <div class="col-6 mb-3"><label class="form-label">Số ngày</label><input type="number" name="Input.Days" class="form-control" placeholder="0" value="0" /></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Thị trường</label>
        <select name="Input.MarketRef" class="form-select tk-s2" data-placeholder="Chọn thị trường">
          <option value=""></option>
          @foreach (var m in Model.Markets) { <option value="@m.Id">@m.Name</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Nhà cung cấp</label>
        <select name="Input.ProviderRef" class="form-select tk-s2" data-placeholder="Chọn nhà cung cấp">
          <option value=""></option>
          @foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }
        </select>
      </div>
      <div class="mb-3"><label class="form-label">Ngày đi</label><input type="text" name="Input.DepartureDate" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Số lượng vé</label><input type="number" name="Input.Quantity" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-6 mb-3"><label class="form-label">Đã dùng</label><input type="number" name="Input.UsedQuantity" class="form-control" placeholder="0" value="0" /></div>
      </div>
      <div class="row">
        <div class="col-4 mb-3"><label class="form-label">Tổng chi phí</label><input type="number" step="any" name="Input.TotalCost" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-4 mb-3"><label class="form-label">Đã thanh toán</label><input type="number" step="any" name="Input.PaidAmount" class="form-control" placeholder="0" value="0" /></div>
        <div class="col-4 mb-3"><label class="form-label">Bảo lưu</label><input type="number" step="any" name="Input.ReservedAmount" class="form-control" placeholder="0" value="0" /></div>
      </div>
      <div class="mb-3"><label class="form-label">Trạng thái (mã số)</label><input type="number" name="Input.Status" class="form-control" placeholder="0" value="0" /></div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Ghi chú thêm"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@* Modal gán tour — bám nút "+ Gán tour" hệ cũ (AssignAsync) *@
<div class="modal fade" id="assign-modal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Gán tour cho vé đoàn</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <p class="text-muted small mb-3">Chọn đơn (order) cần gán vé đoàn này vào — gõ mã đơn hoặc tên khách để tìm. Để trống = gỡ gán.</p>
        <input type="hidden" id="as-id" />
        <select id="as-order" class="form-select" data-placeholder="Chọn đơn hàng">
          <option value=""></option>
          @foreach (var o in Model.Orders) { <option value="@o.Id">@o.Text</option> }
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Huỷ</button>
        <button type="button" class="btn btn-primary" id="as-submit">Gán</button>
      </div>
    </div>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt;
    var CAN_MANAGE = @(Model.CanManage ? "true" : "false");
    // Toàn bộ tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
    var FILTERS = ['marketRef', 'providerRef', 'tourType', 'days', 'departureFrom', 'assigned'];

    function filterValues() {
      var o = {};
      FILTERS.forEach(function (k) { var v = $('#f-' + k).val(); if (v) { o[k] = v; } });
      return o;
    }
    function collectFilters(d) {
      var o = filterValues();
      Object.keys(o).forEach(function (k) { d[k] = o[k]; });
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }
    function refreshStats() {
      var p = new URLSearchParams(filterValues());
      var q = $('#f-q').val(); if (q) { p.set('search', q); }
      $.getJSON('?handler=Stats&' + p.toString(), function (s) {
        $('#kpi-qty').text(tk.money(s.totalQuantity));
        $('#kpi-used').text(tk.money(s.totalUsed));
        $('#kpi-remain').text(tk.money(s.totalRemaining));
        $('#kpi-cost').text(tk.money(s.totalCost));
        $('#kpi-paid').text(tk.money(s.totalPaid));
        $('#kpi-remaincost').text(tk.money(s.totalRemainingCost));
        $('#kpi-reserved').text(tk.money(s.totalReserved));
      });
    }
    function reload() { dt.ajax.reload(); refreshStats(); }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });
      if (window.flatpickr) { flatpickr('.tk-datef', { dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true }); }
      $('#as-order').select2({ width: '100%', allowClear: true, placeholder: 'Chọn đơn hàng', dropdownParent: $('#assign-modal') });

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          // PNR / Loại hình
          { data: null, render: function (r) {
              return '<span class="fw-medium">' + tk.escape(r.pnr) + '</span>' +
                     '<div class="small text-muted">' + tk.escape(r.tourTypeLabel) + '</div>';
            } },
          // Gán Tour: mã đơn + tên tour, hoặc nút gán
          { data: null, render: function (r) {
              if (r.orderRef) {
                return '<span class="fw-medium">' + tk.escape(r.orderCode || r.orderRef) + '</span>' +
                       (r.orderName ? '<div class="small text-muted">' + tk.trunc(r.orderName, 180) + '</div>' : '');
              }
              return CAN_MANAGE
                ? '<button type="button" class="btn btn-sm btn-label-primary js-assign">+ Gán tour</button>'
                : '<span class="badge bg-label-secondary">Chưa gán</span>';
            } },
          // NCC / Thị trường
          { data: null, render: function (r) {
              return '<div>' + (r.providerName ? tk.trunc(r.providerName, 160) : '—') + '</div>' +
                     '<div class="small text-muted">' + (r.marketName ? tk.trunc(r.marketName, 160) : '—') + '</div>';
            } },
          // Lịch trình: ngày đi + số ngày
          { data: null, render: function (r) {
              return '<div>' + tk.escape(r.departureDateText) + '</div>' +
                     (r.days ? '<div class="small text-muted">' + r.days + ' ngày</div>' : '');
            } },
          // Hành trình: từng chặng bay
          { data: 'segments', render: function (v) {
              if (!v || !v.length) { return '—'; }
              return '<div class="text-nowrap small">' + v.map(function (s) {
                return '<div><span class="text-muted">' + tk.escape(s.date) + '</span> <b>' + tk.escape(s.flightNo) + '</b> ' +
                       tk.escape(s.from) + '→' + tk.escape(s.to) + ' ' + tk.escape(s.depTime) + '</div>';
              }).join('') + '</div>';
            } },
          // Vé: SL / Dùng / Còn
          { data: null, className: 'text-center text-nowrap', render: function (r) {
              return '<span class="badge bg-label-secondary me-1" title="Số lượng">' + r.quantity + '</span>' +
                     '<span class="badge bg-label-warning me-1" title="Đã dùng">' + r.usedQuantity + '</span>' +
                     '<span class="badge bg-label-success" title="Còn lại">' + r.remainingQuantity + '</span>';
            } },
          // Tổng chi / Đã TT
          { data: null, className: 'text-end', render: function (r) {
              return '<div class="fw-medium" title="Tổng chi">' + tk.money(r.totalCost) + '</div>' +
                     '<div class="small text-muted" title="Đã thanh toán">Đã TT ' + tk.money(r.paidAmount) + '</div>';
            } },
          // Còn lại / Bảo lưu
          { data: null, className: 'text-end', render: function (r) {
              return '<div class="fw-medium ' + (r.remainingCost > 0 ? 'text-danger' : '') + '" title="Còn lại">' + tk.money(r.remainingCost) + '</div>' +
                     '<div class="small text-muted" title="Bảo lưu">Bảo lưu ' + tk.money(r.reservedAmount) + '</div>';
            } },
          { data: null, className: 'text-end text-nowrap', render: function () {
              if (!CAN_MANAGE) { return ''; }
              return '<button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>' +
                     '<button type="button" class="btn btn-icon btn-sm text-danger js-del" title="Xoá"><i class="ti ti-trash"></i></button>';
            } }
        ]
      });

      // Dòng "Tổng cộng (trang này)" — đọc khối pageSum ngoài contract DataTables.
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.pageSum;
        if (!s) { return; }
        var parts = [['SL vé', s.quantity, ''], ['Đã dùng', s.used, ''], ['Còn lại', s.remaining, ''],
                     ['Tổng chi', s.cost, ''], ['Đã TT', s.paid, 'text-success'],
                     ['Còn lại tiền', s.remainingCost, s.remainingCost > 0 ? 'text-danger' : ''], ['Bảo lưu', s.reserved, '']];
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (trang này)</span>' + parts.map(function (p) {
          return '<span class="me-3 text-muted">' + p[0] + ': <span class="fw-medium ' + p[2] + '">' + tk.money(p[1]) + '</span></span>';
        }).join(''));
      });

      oc = tk.form({
        offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'vé đoàn',
        rules: { 'Input.Pnr': { required: true } }, messages: { 'Input.Pnr': { required: 'Bắt buộc nhập PNR' } },
        // Ref thị trường/NCC có thể là id legacy KHÔNG nằm trong danh mục → thêm option tạm để không mất giá trị khi lưu.
        fill: function ($form, data) {
          [['Input.MarketRef', 'marketRef', 'marketName'], ['Input.ProviderRef', 'providerRef', 'providerName']].forEach(function (m) {
            var $sel = $form.find('[name="' + m[0] + '"]');
            var val = data ? data[m[1]] : '';
            if (val && !$sel.find('option[value="' + val + '"]').length) {
              $sel.append(new Option(data[m[2]] || val, val, true, true));
            }
            $sel.val(val || null).trigger('change');
          });
        }
      });

      $('#btn-search').on('click', reload);
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { reload(); } });
      $('#f-tourType, #f-days').on('change', reload);
      $('.tk-s2f').on('change', reload);
      $('.tk-datef').on('change', reload);
      tk.advFilter();
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        FILTERS.forEach(function (k) { var $e = $('#f-' + k); $e.val(''); if ($e.hasClass('tk-s2f')) { $e.trigger('change.select2'); } });
        $('.tk-datef').each(function () { if (this._flatpickr) { this._flatpickr.clear(); } });
        $('#tabs .nav-link').removeClass('active').first().addClass('active');
        reload();
      });
      $('#tabs').on('click', '.nav-link', function () {
        $('#tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        $('#f-assigned').val($(this).data('val'));
        reload();
      });
      $('#btn-export').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(filterValues());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });

      // Sau khi lưu qua tk.form (bảng tự reload) → làm tươi KPI.
      $('#frm').on('submit', function () { setTimeout(refreshStats, 600); });

      // Server-side: dữ liệu dòng lấy từ DataTables API (không còn data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open(dt.row($(this).closest('tr')).data()); });
      $('#tbl tbody').on('click', '.js-assign', function () {
        var r = dt.row($(this).closest('tr')).data();
        $('#as-id').val(r.id);
        $('#as-order').val(r.orderRef || null).trigger('change');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('assign-modal')).show();
      });
      $('#as-submit').on('click', function () {
        var fd = new FormData();
        fd.append('id', $('#as-id').val());
        fd.append('orderRef', $('#as-order').val() || '');
        tk.post('?handler=Assign', fd).then(function (res) {
          if (res && res.isSuccess) {
            bootstrap.Modal.getInstance(document.getElementById('assign-modal')).hide();
            dt.ajax.reload(null, false); refreshStats(); tk.toast(res.message || 'Đã gán tour.');
          } else { tk.error((res && res.message) || 'Gán tour thất bại.'); }
        });
      });
      $('#tbl tbody').on('click', '.js-del', function () {
        var r = dt.row($(this).closest('tr')).data();
        tk.confirmDelete({ title: 'Xoá vé đoàn ' + r.pnr + '?' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { dt.ajax.reload(null, false); refreshStats(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      });
    });
  </script>
}
