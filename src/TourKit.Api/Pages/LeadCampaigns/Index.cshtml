@page
@model TourKit.Api.Pages.LeadCampaigns.IndexModel
@{ ViewData["Title"] = "Chia số Sale"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 4 thẻ KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("Tổng chiến dịch", Model.Stats.TotalCampaigns.ToString("#,##0"), "ti ti-speakerphone", "primary"),
        ("Tổng Leads", Model.Stats.TotalLeads.ToString("#,##0"), "ti ti-users", "info"),
        ("Tỷ lệ chốt TB", Model.Stats.AvgCloseRate.ToString("0.##") + "%", "ti ti-trending-up", "success"),
        ("Hoàn thành", Model.Stats.Completed.ToString("#,##0"), "ti ti-circle-check", "success"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">CRM <span class="mx-1">/</span> <span class="text-body">Chia số Sale</span></div>
    <h4 class="mb-0">Chia số Sale</h4>
  </div>
  <div class="d-flex gap-2">
    <a id="btn-export" class="btn btn-label-secondary" href="#"><i class="ti ti-file-export me-1"></i> Xuất file</a>
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Tạo chiến dịch mới</button>
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  @* Thanh lọc — đủ 2 tiêu chí service hỗ trợ *@
  <div class="tk-pad">
    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Tên chiến dịch…" /></div>
      <div class="col-md-4">
        <select id="f-createdByUserId" class="form-select tk-s2f" data-placeholder="Người tạo"><option value=""></option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.Name</option> }</select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm kiếm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> chiến dịch đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-lead-campaigns"></div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">chiến dịch chia số</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3"><label class="form-label">Tên chiến dịch <span class="text-danger">*</span></label><input type="text" name="Input.Name" class="form-control" placeholder="Nhập tên chiến dịch" /></div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="3" placeholder="Nhập ghi chú"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc;
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;

      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'chiến dịch chia số',
        rules: { 'Input.Name': { required: true } }, messages: { 'Input.Name': { required: 'Bắt buộc nhập tên' } } });

      var grid = tk.grid('#grid-lead-campaigns', {
        // Tiêu chí lọc đẩy xuống SERVER (không lọc ở client, không get-all).
        filters: ['createdByUserId'],
        exportName: 'chien-dich-chia-so.csv',
        actions: function (r) {
          return [
            { label: '<i class="ti ti-edit me-2"></i>Sửa chiến dịch', action: function () { oc.open(r); } },
            { label: '<i class="ti ti-target me-2"></i>Xem cơ hội của chiến dịch', action: function () { window.location = '/co-hoi?campaignId=' + encodeURIComponent(r.id); } }
          ];
        },
        columns: [
          {
            title: 'Chiến dịch', field: 'name', widthGrow: 3, minWidth: 220,
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-row-media">' + g.avatar(r.name) +
                g.stack(r.name, r.createdByName ? ('Tạo bởi ' + r.createdByName) : null) + '</div>';
            }
          },
          { title: 'Ngày tạo', field: 'createdAt', width: 130,
            formatter: function (c) { return g.stack(c.getValue(), null); } },
          {
            title: 'Số liệu', field: 'totalLeads', width: 170, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var cared = c.getTable().getData().reduce(function (a, r) { return a + (r.caredCount || 0); }, 0);
              return '<span class="fw-semibold" title="Đã chăm sóc trang này: ' + money(cared) + '">' + money(c.getValue()) + ' leads</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(r.totalLeads) + ' leads</div>' +
                '<div class="tk-cell-sub">Chăm sóc ' + money(r.caredCount) + '/' + money(r.totalLeads) + '</div></div>';
            }
          },
          {
            title: 'Tiến độ', field: 'progress', widthGrow: 2, minWidth: 150,
            formatter: function (c) {
              var p = Number(c.getValue()) || 0;
              return '<div class="d-flex align-items-center gap-2">' +
                '<div class="progress w-100" style="height:6px"><div class="progress-bar" style="width:' + p + '%"></div></div>' +
                '<small class="text-muted">' + p + '%</small></div>';
            }
          },
          {
            title: 'Đơn chốt', field: 'closedCount', width: 130, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold text-success">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main text-success">' + money(r.closedCount) + '</div>' +
                '<div class="tk-cell-sub">' + (Number(r.closeRate) || 0) + '%</div></div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 140,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });

      // Xuất TOÀN BỘ theo bộ lọc đang áp — handler Export nhận keyword ở tham số `search`.
      $('#btn-export').off('click').on('click', function (e) {
        e.preventDefault();
        var p = new URLSearchParams(grid.filters());
        var q = $('#f-q').val(); if (q) { p.set('search', q); }
        location.href = '?handler=Export&' + p.toString();
      });
    });
  </script>
}
