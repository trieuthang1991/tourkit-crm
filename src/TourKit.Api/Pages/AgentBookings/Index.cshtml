@page
@model TourKit.Api.Pages.AgentBookings.IndexModel
@{ ViewData["Title"] = "Đặt chỗ đại lý"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Đặt chỗ đại lý</h5>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Mã</th><th>Đại lý</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr>
          <td class="fw-medium">@x.Code</td>
          <td>@(x.AgentName ?? "—")</td>
          <td><span class="badge bg-label-@TourKit.Api.Pages.AgentBookings.IndexModel.StatusColor(x.Status)">@TourKit.Api.Pages.AgentBookings.IndexModel.StatusLabel(x.Status)</span></td>
          <td class="text-end">@x.TotalAmount.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl'); });
  </script>
}
