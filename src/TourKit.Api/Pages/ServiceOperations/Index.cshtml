@page
@model TourKit.Api.Pages.ServiceOperations.IndexModel
@{ ViewData["Title"] = "Phiếu điều hành dịch vụ"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Danh sách phiếu điều hành dịch vụ</h4>
</div>

@* 4 KPI — bám StatGrid hệ cũ, cập nhật theo bộ lọc đang áp *@
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Tổng đơn hàng</small><h5 class="mb-0 tk-num" id="kpi-total">@Model.Stats.Total.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Chưa thanh toán</small><h5 class="mb-0 text-danger tk-num" id="kpi-unpaid">@Model.Stats.Unpaid.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Chưa chi hết</small><h5 class="mb-0 text-warning tk-num" id="kpi-partial">@Model.Stats.Partial.ToString("#,##0")</h5></div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body py-3"><small class="text-muted d-block">Hoàn thành</small><h5 class="mb-0 text-success tk-num" id="kpi-done">@Model.Stats.Done.ToString("#,##0")</h5></div></div></div>
</div>

@* Thanh lọc — đủ 2 tiêu chí hệ cũ (q · NCC) *@
<div class="card mb-3">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Mã phiếu / NCC / tên dịch vụ" /></div>
      <div class="col-md-4">
        <select id="f-providerId" class="form-select tk-s2f" data-placeholder="Nhà cung cấp"><option value=""></option>@foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }</select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btn-search"><i class="ti ti-search me-1"></i> Tìm kiếm</button>
        <button type="button" class="btn btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>
</div>

@* Tab trạng thái chi — bám Segmented hệ cũ *@
<ul class="nav nav-pills flex-wrap mb-3" id="tabs">
  <li class="nav-item"><button type="button" class="nav-link active" data-v="">Tất cả (@Model.Stats.Total)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="0">Chờ chi (@Model.Stats.Unpaid)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="1">Chưa chi hết (@Model.Stats.Partial)</button></li>
  <li class="nav-item"><button type="button" class="nav-link" data-v="2">Thành công (@Model.Stats.Done)</button></li>
</ul>

<div class="card">
  <div class="card-header"><h5 class="mb-0">Danh sách phiếu điều hành</h5></div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead>
        <tr>
          <th class="text-center">#</th><th>Phiếu ĐH</th><th>Dịch vụ / NCC</th>
          <th class="text-end">Tổng chi</th><th class="text-end">Thanh toán</th><th>Trạng thái</th><th></th>
        </tr>
      </thead>
      <tfoot>
        <tr id="page-sum" class="fw-medium"><td colspan="7" class="small"></td></tr>
      </tfoot>
    </table>
  </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:480px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">Ghi nhận thanh toán</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Pay" onsubmit="return false">
      <input type="hidden" name="Id" />
      <p class="text-muted small mb-3" id="pay-info"></p>
      <div class="mb-3">
        <label class="form-label">Số đã thanh toán NCC <span class="text-danger">*</span></label>
        <input type="number" name="Input.PaidAmount" class="form-control" placeholder="0" min="0" step="1000" />
        <span class="text-muted small">Ghi nhận tổng số tiền đã chi cho NCC của phiếu này.</span>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc, dt, paymentStatus = '';
    // Mọi tiêu chí đẩy xuống SERVER (ServiceOperationListFilter) — không lọc ở client.
    function collectFilters(d) {
      var p = $('#f-providerId').val(); if (p) { d.providerId = p; }
      if (paymentStatus !== '') { d.paymentStatus = paymentStatus; }
      var q = $('#f-q').val(); if (q) { d['search[value]'] = q; }
    }

    $(function () {
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      dt = tk.table('#tbl', {
        url: '?handler=Data',
        extraData: collectFilters,
        columns: [
          { data: null, className: 'text-center text-muted', render: function (r, t, row, meta) { return meta.settings._iDisplayStart + meta.row + 1; } },
          { data: null, render: function (r) {
              // Cột ghép: mã phiếu · ngày dùng dịch vụ
              return '<div class="fw-medium">' + tk.escape(r.code) + '</div>' +
                     (r.usageDateText ? '<div class="small text-muted">' + tk.escape(r.usageDateText) + '</div>' : '');
            } },
          { data: null, render: function (r) {
              // Cột ghép: mô tả dịch vụ · nhà cung cấp
              return '<div>' + tk.trunc(r.description, 260) + '</div>' +
                     '<div class="small text-muted">' + tk.escape(r.providerName) + '</div>';
            } },
          { data: 'totalAmount', className: 'text-end', render: function (v) { return tk.money(v); } },
          { data: null, className: 'text-end', render: function (r) {
              return '<div class="text-success fw-medium">' + tk.money(r.paidAmount) + '</div>' +
                     (r.remainingAmount > 0 ? '<div class="small text-danger">Còn ' + tk.money(r.remainingAmount) + '</div>' : '');
            } },
          { data: null, render: function (r) { return '<span class="badge bg-label-' + r.statusColor + '">' + tk.escape(r.statusLabel) + '</span>'; } },
          { data: null, className: 'text-end', render: function () {
              return '<button type="button" class="btn btn-icon btn-sm js-pay" title="Ghi nhận thanh toán"><i class="ti ti-cash"></i></button>';
            } }
        ]
      });

      // KPI + dòng tổng cộng lấy từ khối stats ngoài contract DataTables (sự kiện xhr).
      $('#tbl').on('xhr.dt', function (e, settings, json) {
        var s = json && json.stats;
        if (!s) { return; }
        $('#kpi-total').text(tk.money(s.total));
        $('#kpi-unpaid').text(tk.money(s.unpaid));
        $('#kpi-partial').text(tk.money(s.partial));
        $('#kpi-done').text(tk.money(s.done));
        $('#page-sum td').html('<span class="me-3 fw-bold">Tổng cộng (theo bộ lọc)</span>' +
          '<span class="me-3 text-muted">Tổng chi: <span class="fw-medium">' + tk.money(s.totalCost) + '</span></span>' +
          '<span class="me-3 text-muted">Đã thanh toán: <span class="fw-medium text-success">' + tk.money(s.totalPaid) + '</span></span>' +
          '<span class="me-3 text-muted">Còn thiếu: <span class="fw-medium text-danger">' + tk.money(s.totalRemaining) + '</span></span>');
      });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Pay',
        rules: { 'Input.PaidAmount': { required: true, min: 0 } },
        messages: { 'Input.PaidAmount': { required: 'Bắt buộc nhập số tiền', min: 'Số tiền phải >= 0' } },
        afterOpen: function (data) {
          $('#pay-info').text(data ? ('Phiếu ' + data.code + ' — tổng chi ' + tk.money(data.totalAmount)) : '');
        } });

      // Server-side: lấy dữ liệu dòng từ DataTables API (không có data-json trên <tr>).
      $('#tbl tbody').on('click', '.js-pay', function () { oc.open(dt.row($(this).closest('tr')).data()); });

      $('#btn-search').on('click', function () { dt.ajax.reload(); });
      $('#f-q').on('keydown', function (e) { if (e.key === 'Enter') { dt.ajax.reload(); } });
      $('.tk-s2f').on('change', function () { dt.ajax.reload(); });
      $('#btn-reset').on('click', function () {
        $('#f-q').val('');
        $('#f-providerId').val('').trigger('change.select2');
        paymentStatus = '';
        $('#tabs .nav-link').removeClass('active').filter('[data-v=""]').addClass('active');
        dt.ajax.reload();
      });
      $('#tabs').on('click', '.nav-link', function () {
        $('#tabs .nav-link').removeClass('active');
        $(this).addClass('active');
        paymentStatus = this.getAttribute('data-v');
        dt.ajax.reload();
      });
    });
  </script>
}
