@page
@model TourKit.Api.Pages.ServiceOperations.IndexModel
@{ ViewData["Title"] = "Phiếu điều hành dịch vụ"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

@{
    // 4 KPI — bám StatGrid hệ cũ, cập nhật theo bộ lọc đang áp.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng đơn hàng", Model.Stats.Total.ToString("#,##0"), "ti ti-clipboard-list", "primary"),
        ("kpi-unpaid", "Chưa thanh toán", Model.Stats.Unpaid.ToString("#,##0"), "ti ti-alert-circle", "danger"),
        ("kpi-partial", "Chưa chi hết", Model.Stats.Partial.ToString("#,##0"), "ti ti-progress", "warning"),
        ("kpi-done", "Hoàn thành", Model.Stats.Done.ToString("#,##0"), "ti ti-circle-check", "success"),
    };
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <div>
    <div class="text-muted mb-1" style="font-size:.78rem">Điều hành <span class="mx-1">/</span> <span class="text-body">Phiếu điều hành dịch vụ</span></div>
    <h4 class="mb-0">Danh sách phiếu điều hành dịch vụ</h4>
  </div>
</div>

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value" id="@s.Id">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tab trạng thái chi — bám Segmented hệ cũ *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="paymentStatus">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1">@Model.Stats.Total.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="0">Chờ chi <span class="badge bg-label-danger ms-1">@Model.Stats.Unpaid.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="1">Chưa chi hết <span class="badge bg-label-warning ms-1">@Model.Stats.Partial.ToString("#,##0")</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="2">Thành công <span class="badge bg-label-success ms-1">@Model.Stats.Done.ToString("#,##0")</span></a></li>
    </ul>
    <input type="hidden" id="f-paymentStatus" value="" />

    @* Thanh lọc — đủ 2 tiêu chí hệ cũ (q · NCC) *@
    <div class="row g-2 align-items-center">
      <div class="col-md-5"><input type="text" id="f-q" class="form-control" placeholder="Mã phiếu / NCC / tên dịch vụ" /></div>
      <div class="col-md-4">
        <select id="f-providerId" class="form-select tk-s2f" data-placeholder="Nhà cung cấp"><option value=""></option>@foreach (var p in Model.Providers) { <option value="@p.Id">@p.Name</option> }</select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="button" class="btn btn-primary flex-fill" id="btn-search"><i class="ti ti-search me-1"></i> Tìm kiếm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> phiếu đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-service-ops"></div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:480px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">Ghi nhận thanh toán</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Pay" onsubmit="return false">
      <input type="hidden" name="Id" />
      <p class="text-muted small mb-3" id="pay-info"></p>
      <div class="mb-3">
        <label class="form-label">Số đã thanh toán NCC <span class="text-danger">*</span></label>
        <input type="number" name="Input.PaidAmount" class="form-control" placeholder="0" min="0" step="1000" />
        <span class="text-muted small">Ghi nhận tổng số tiền đã chi cho NCC của phiếu này.</span>
      </div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;
    $(function () {
      var g = tk.g, esc = g.esc, money = g.money;
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Pay',
        rules: { 'Input.PaidAmount': { required: true, min: 0 } },
        messages: { 'Input.PaidAmount': { required: 'Bắt buộc nhập số tiền', min: 'Số tiền phải >= 0' } },
        afterOpen: function (data) {
          $('#pay-info').text(data ? ('Phiếu ' + data.code + ' — tổng chi ' + money(data.totalAmount)) : '');
        } });

      grid = tk.grid('#grid-service-ops', {
        // Mọi tiêu chí đẩy xuống SERVER (ServiceOperationListFilter) — không lọc ở client.
        filters: ['providerId', 'paymentStatus'],
        exportName: 'phieu-dieu-hanh-dich-vu.csv',
        actions: function (r) {
          return [{ label: '<i class="ti ti-cash me-2"></i>Ghi nhận thanh toán', action: function () { oc.open(r); } }];
        },
        // KPI của màn này tính THEO BỘ LỌC nên server trả kèm khối stats mỗi lần tải.
        onData: function (res) {
          var s = res && res.stats;
          if (!s) { return; }
          $('#kpi-total').text(money(s.total));
          $('#kpi-unpaid').text(money(s.unpaid));
          $('#kpi-partial').text(money(s.partial));
          $('#kpi-done').text(money(s.done));
        },
        columns: [
          {
            title: 'Phiếu ĐH', field: 'code', widthGrow: 2, minWidth: 160,
            formatter: function (c) { var r = c.getData(); return g.stack(r.code, r.usageDateText); }
          },
          {
            title: 'Dịch vụ / NCC', field: 'description', widthGrow: 4, minWidth: 260,
            formatter: function (c) { var r = c.getData(); return g.stack(r.description, r.providerName); }
          },
          {
            title: 'Tổng chi', field: 'totalAmount', width: 150, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) { return '<span class="fw-semibold">' + money(c.getValue()) + '</span>'; },
            formatter: function (c) { return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main">' + money(c.getValue()) + '</div></div>'; }
          },
          {
            title: 'Thanh toán', field: 'paidAmount', width: 160, hozAlign: 'right', headerHozAlign: 'right',
            topCalc: 'sum',
            topCalcFormatter: function (c) {
              var left = c.getTable().getData().reduce(function (a, r) { return a + (r.remainingAmount || 0); }, 0);
              return '<span class="fw-semibold text-success" title="Còn thiếu trang này: ' + money(left) + '">' + money(c.getValue()) + '</span>';
            },
            formatter: function (c) {
              var r = c.getData();
              return '<div class="tk-cell tk-cell-right"><div class="tk-cell-main text-success">' + money(r.paidAmount) + '</div>' +
                (r.remainingAmount > 0 ? '<div class="tk-cell-sub text-danger">Còn ' + money(r.remainingAmount) + '</div>' : '') + '</div>';
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 150,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });
    });
  </script>
}
