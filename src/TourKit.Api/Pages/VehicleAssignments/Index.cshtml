@page
@model TourKit.Api.Pages.VehicleAssignments.IndexModel
@{ ViewData["Title"] = "Lịch điều xe"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/tabulator/tabulator_bootstrap5.min.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
  @* Giao diện lưới dùng CHUNG mọi màn danh sách — nạp sau tabulator để override thắng. *@
  <link rel="stylesheet" href="~/css/tk-grid.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Lịch điều xe</h4>
  @if (Model.CanManage)
  {
    <button type="button" class="btn btn-primary" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Thêm phân xe</button>
  }
</div>

@{
    // 4 KPI — bám StatGrid hệ cũ, gói vào dải mảnh dùng chung.
    (string Id, string Label, string Value, string Icon, string Color)[] statCards =
    {
        ("kpi-total", "Tổng phân xe", Model.Stats.Total.ToString("#,##0"), "ti ti-clipboard-list", "primary"),
        ("kpi-created", "Đã điều", Model.Stats.Created.ToString("#,##0"), "ti ti-send", "info"),
        ("kpi-active", "Đang thực hiện", Model.Stats.Active.ToString("#,##0"), "ti ti-run", "success"),
        ("kpi-vehicles", "Số xe", Model.Stats.VehicleCount.ToString("#,##0"), "ti ti-bus", "warning"),
    };
}

<div class="tk-surface">

  <div class="tk-stat-strip">
    @foreach (var s in statCards)
    {
      <div class="tk-stat">
        <span class="tk-stat-ic bg-label-@s.Color"><i class="@s.Icon"></i></span>
        <div class="lh-sm">
          <div class="tk-stat-value" id="@s.Id">@s.Value</div>
          <small class="tk-stat-label">@s.Label</small>
        </div>
      </div>
    }
  </div>

  <div class="tk-pad">
    @* Tab trạng thái — bám Segmented hệ cũ (Tất cả / Đã điều / Đang thực hiện) *@
    <ul class="nav nav-tabs mb-3" id="type-tabs" data-field="status">
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link active" data-type="">Tất cả <span class="badge bg-label-secondary ms-1" id="tab-total">@Model.Stats.Total</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="1">Đã điều <span class="badge bg-label-info ms-1" id="tab-created">@Model.Stats.Created</span></a></li>
      <li class="nav-item"><a href="javascript:void(0)" class="nav-link" data-type="2">Đang thực hiện <span class="badge bg-label-success ms-1" id="tab-active">@Model.Stats.Active</span></a></li>
    </ul>
    <input type="hidden" id="f-status" value="" />

    @* Thanh lọc — đúng các tiêu chí VehicleAssignmentListFilter (xe · chuyến · khoảng ngày đón), đẩy hết xuống SERVER *@
    <div class="row g-2 align-items-center">
      <div class="col-md-3">
        <select id="f-vehicleId" class="form-select tk-s2f" data-placeholder="Xe"><option value=""></option>@foreach (var v in Model.Vehicles) { <option value="@v.Id">@v.Label</option> }</select>
      </div>
      <div class="col-md-4">
        <select id="f-departureId" class="form-select tk-s2f" data-placeholder="Chuyến"><option value=""></option>@foreach (var d in Model.Departures) { <option value="@d.Id">@d.Label</option> }</select>
      </div>
      @* tk.dateRanges() ẩn CẢ CỘT chứa f-dateTo → KHÔNG để nút chung cột đó. *@
      <div class="col-md-2"><input type="text" id="f-dateFrom" class="form-control tk-datef" placeholder="Ngày đón từ" autocomplete="off" /></div>
      <div class="col-md-2"><input type="text" id="f-dateTo" class="form-control tk-datef" placeholder="đến" autocomplete="off" /></div>
      <div class="col-auto d-flex gap-2 ms-auto">
        <button type="button" class="btn btn-primary text-nowrap" id="btn-search"><i class="ti ti-search me-1"></i>Tìm</button>
        <button type="button" class="btn btn-icon btn-label-secondary" id="btn-reset" title="Đặt lại bộ lọc"><i class="ti ti-rotate"></i></button>
      </div>
    </div>
  </div>

  <div id="bulkbar" class="d-none align-items-center gap-2 px-3 py-2" style="background:rgba(var(--bs-primary-rgb),.06)">
    <span class="fw-medium"><span id="bulk-count">0</span> phân xe đã chọn</span>
    <button type="button" class="btn btn-sm btn-label-secondary" id="bulk-export"><i class="ti ti-file-export me-1"></i> Xuất file</button>
    <button type="button" class="btn btn-sm btn-label-secondary ms-auto" id="bulk-clear">Bỏ chọn</button>
  </div>

  <div id="grid-vehicle-assign"></div>
</div>

@Html.AntiForgeryToken()

@* Offcanvas CRUD — GIỮ NGUYÊN các trường Create/Update DTO *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">phân xe</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3">
        <label class="form-label">Chuyến <span class="text-danger">*</span></label>
        <select name="Input.TourDepartureId" class="form-select tk-s2" data-placeholder="Chọn chuyến">
          <option value="">— Chọn chuyến —</option>
          @foreach (var d in Model.Departures) { <option value="@d.Id">@d.Label</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Xe <span class="text-danger">*</span></label>
        <select name="Input.VehicleId" class="form-select tk-s2" data-placeholder="Chọn xe">
          <option value="">— Chọn xe —</option>
          @foreach (var v in Model.Vehicles) { <option value="@v.Id">@v.Label</option> }
        </select>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Tài xế</label><input type="text" name="Input.DriverName" class="form-control" placeholder="Nhập tên tài xế" /></div>
        <div class="col-6 mb-3"><label class="form-label">SĐT tài xế</label><input type="text" name="Input.DriverPhone" class="form-control" placeholder="09xxxxxxxx" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngày đón</label><input type="text" name="Input.TimeGo" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3"><label class="form-label">Ngày trả</label><input type="text" name="Input.TimeCome" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Trạng thái</label>
        <select name="Input.Status" class="form-select"><option value="1">Đã điều</option><option value="2">Đang thực hiện</option></select>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Ghi chú điều xe"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/tabulator/tabulator.min.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script src="~/js/tk-grid.js" asp-append-version="true"></script>
  <script>
    var oc, grid;
    var CAN_MANAGE = @(Model.CanManage ? "true" : "false");

    function applyStats(s) {
      if (!s) { return; }
      $('#kpi-total, #tab-total').text(tk.money(s.total));
      $('#kpi-created, #tab-created').text(tk.money(s.created));
      $('#kpi-active, #tab-active').text(tk.money(s.active));
      $('#kpi-vehicles').text(tk.money(s.vehicleCount));
    }

    $(function () {
      var g = tk.g, esc = g.esc;
      $('.tk-s2f').each(function () { $(this).select2({ width: '100%', allowClear: true, placeholder: $(this).data('placeholder') || 'Tất cả' }); });

      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: null, saveUrl: '?handler=Save', title: 'phân xe',
        rules: { 'Input.TourDepartureId': { required: true }, 'Input.VehicleId': { required: true } },
        messages: { 'Input.TourDepartureId': { required: 'Bắt buộc chọn chuyến' }, 'Input.VehicleId': { required: 'Bắt buộc chọn xe' } } });

      function delRow(r) {
        tk.confirmDelete({ title: 'Xoá phân xe?', text: 'Phân xe ' + r.vehicleName + ' — ' + r.departureCode + ' sẽ bị xoá.' }).then(function (ok) {
          if (!ok) { return; }
          var fd = new FormData(); fd.append('id', r.id);
          tk.post('?handler=Delete', fd).then(function (res) {
            if (res && res.isSuccess) { grid.reload(); tk.toast(res.message || 'Đã xoá.'); }
            else { tk.error((res && res.message) || 'Xoá thất bại.'); }
          });
        });
      }

      // Sửa/xoá chỉ dành cho người có quyền điều hành — giữ đúng luật hệ cũ.
      function actionsFor(r) {
        if (!CAN_MANAGE) { return []; }
        return [
          { label: '<i class="ti ti-edit me-2"></i>Sửa phân xe', action: function () { oc.open(r); } },
          { separator: true },
          { label: '<span class="text-danger"><i class="ti ti-trash me-2"></i>Xoá phân xe</span>', action: function () { delRow(r); } }
        ];
      }

      // Toàn bộ tiêu chí lọc đẩy xuống SERVER (VehicleAssignmentListFilter).
      grid = tk.grid('#grid-vehicle-assign', {
        filters: ['vehicleId', 'departureId', 'dateFrom', 'dateTo', 'status'],
        exportName: 'dieu-xe.csv',
        actions: CAN_MANAGE ? actionsFor : null,
        // KPI + số đếm trên tab lấy từ khối stats kèm theo mỗi lần tải bảng.
        onData: function (res) { applyStats(res && res.stats); },
        columns: [
          {
            title: 'Chuyến', field: 'departureTitle', widthGrow: 3, minWidth: 220,
            formatter: function (c) { var r = c.getData(); return g.stack(r.departureTitle, r.departureCode); }
          },
          {
            title: 'Xe', field: 'vehicleName', widthGrow: 2, minWidth: 160,
            formatter: function (c) {
              var v = c.getValue();
              if (!v) { return '<span class="tk-cell-sub">—</span>'; }
              return '<div class="tk-row-media">' + g.avatar(v) + g.stack(v, null) + '</div>';
            }
          },
          {
            title: 'Tài xế', field: 'driverName', widthGrow: 2, minWidth: 160,
            formatter: function (c) { var r = c.getData(); return g.stack(r.driverName, r.driverPhone); }
          },
          {
            title: 'Thời gian', field: 'timeGoText', width: 170,
            formatter: function (c) {
              var r = c.getData();
              return g.stack(r.timeGoText, r.timeComeText ? ('Trả: ' + r.timeComeText) : null);
            }
          },
          {
            title: 'Trạng thái', field: 'statusLabel', width: 150,
            formatter: 'tkBadge', formatterParams: { color: 'statusColor' }
          }
        ]
      });
    });
  </script>
}
