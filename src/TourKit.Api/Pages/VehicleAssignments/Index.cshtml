@page
@model TourKit.Api.Pages.VehicleAssignments.IndexModel
@{ ViewData["Title"] = "Lịch điều xe"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
}

<div class="row g-4 mb-4">
  <div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><p class="mb-1 text-muted">Tổng phân xe</p><h4 class="mb-0">@Model.Stats.Total</h4></div></div></div>
  <div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><p class="mb-1 text-muted">Đã điều</p><h4 class="mb-0 text-info">@Model.Stats.Created</h4></div></div></div>
  <div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><p class="mb-1 text-muted">Đang thực hiện</p><h4 class="mb-0 text-success">@Model.Stats.Active</h4></div></div></div>
  <div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><p class="mb-1 text-muted">Số xe</p><h4 class="mb-0">@Model.Stats.VehicleCount</h4></div></div></div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Lịch điều xe</h5>
    <button type="button" class="btn btn-primary btn-sm" onclick="oc.open(null)"><i class="ti ti-plus me-1"></i> Điều xe</button>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Xe</th><th>Chuyến</th><th>Tài xế</th><th>Ngày đón</th><th>Ngày trả</th><th>Trạng thái</th><th></th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr data-json='@System.Text.Json.JsonSerializer.Serialize(new { id = x.Id, tourDepartureId = x.TourDepartureId, vehicleId = x.VehicleId, driverName = x.DriverName, driverPhone = x.DriverPhone, timeGo = x.TimeGo != null ? x.TimeGo.Value.ToString("yyyy-MM-dd") : null, timeCome = x.TimeCome != null ? x.TimeCome.Value.ToString("yyyy-MM-dd") : null, note = x.Note, status = x.Status })'>
          <td class="fw-medium">@(string.IsNullOrEmpty(x.VehicleName) ? "—" : x.VehicleName)</td>
          <td>@(x.DepartureCode ?? "—")@(string.IsNullOrEmpty(x.DepartureTitle) ? "" : $" — {x.DepartureTitle}")</td>
          <td>@(string.IsNullOrEmpty(x.DriverName) ? "—" : x.DriverName)@(string.IsNullOrEmpty(x.DriverPhone) ? "" : $" · {x.DriverPhone}")</td>
          <td data-order="@(x.TimeGo?.ToUnixTimeSeconds() ?? 0)">@(x.TimeGo?.ToString("dd/MM/yyyy") ?? "—")</td>
          <td>@(x.TimeCome?.ToString("dd/MM/yyyy") ?? "—")</td>
          <td><span class="badge bg-label-@TourKit.Api.Pages.VehicleAssignments.IndexModel.StatusColor(x.Status)">@TourKit.Api.Pages.VehicleAssignments.IndexModel.StatusLabel(x.Status)</span></td>
          <td class="text-end">
            <button type="button" class="btn btn-icon btn-sm js-edit" title="Sửa"><i class="ti ti-edit"></i></button>
            <button type="button" class="btn btn-icon btn-sm text-danger js-del" data-id="@x.Id" title="Xoá"><i class="ti ti-trash"></i></button>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<form id="delete-form" method="post" asp-page-handler="Delete" class="d-none"><input type="hidden" name="id" /></form>

<div class="offcanvas offcanvas-end" tabindex="-1" id="oc" style="width:520px;max-width:100%">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">phân xe</h5><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    @Html.AntiForgeryToken()
    <form id="frm" data-action="?handler=Save" onsubmit="return false">
      <input type="hidden" name="Id" />
      <div class="mb-3">
        <label class="form-label">Chuyến <span class="text-danger">*</span></label>
        <select name="Input.TourDepartureId" class="form-select tk-s2" data-placeholder="Chọn chuyến">
          <option value="">— Chọn chuyến —</option>
          @foreach (var d in Model.Departures) { <option value="@d.Id">@d.Label</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Xe <span class="text-danger">*</span></label>
        <select name="Input.VehicleId" class="form-select tk-s2" data-placeholder="Chọn xe">
          <option value="">— Chọn xe —</option>
          @foreach (var v in Model.Vehicles) { <option value="@v.Id">@v.Label</option> }
        </select>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Tài xế</label><input type="text" name="Input.DriverName" class="form-control" placeholder="Nhập tên tài xế" /></div>
        <div class="col-6 mb-3"><label class="form-label">SĐT tài xế</label><input type="text" name="Input.DriverPhone" class="form-control" placeholder="09xxxxxxxx" /></div>
      </div>
      <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Ngày đón</label><input type="text" name="Input.TimeGo" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
        <div class="col-6 mb-3"><label class="form-label">Ngày trả</label><input type="text" name="Input.TimeCome" class="form-control tk-date" placeholder="dd/mm/yyyy" autocomplete="off" /></div>
      </div>
      <div class="mb-3">
        <label class="form-label">Trạng thái</label>
        <select name="Input.Status" class="form-select"><option value="1">Đã điều</option><option value="2">Đang thực hiện</option></select>
      </div>
      <div class="mb-3"><label class="form-label">Ghi chú</label><textarea name="Input.Note" class="form-control" rows="2" placeholder="Ghi chú điều xe"></textarea></div>
      <button type="submit" class="btn btn-primary me-2">Lưu</button>
      <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Huỷ</button>
    </form>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
  <script src="~/vendor/libs/select2/select2.js"></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
  <script src="~/vendor/libs/jquery-validation/jquery.validate.min.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
}

@section PageScripts {
  <script>
    var oc;
    $(function () {
      tk.tableClient('#tbl', { order: [[3, 'desc']], columnDefs: [{ orderable: false, targets: [6] }] });
      oc = tk.form({ offcanvas: '#oc', form: '#frm', table: '#tbl', saveUrl: '?handler=Save', title: 'phân xe',
        rules: { 'Input.TourDepartureId': { required: true }, 'Input.VehicleId': { required: true } },
        messages: { 'Input.TourDepartureId': { required: 'Bắt buộc chọn chuyến' }, 'Input.VehicleId': { required: 'Bắt buộc chọn xe' } } });
      $('#tbl tbody').on('click', '.js-edit', function () { oc.open($(this).closest('tr').data('json')); });
      $('#tbl tbody').on('click', '.js-del', function () {
        var id = this.getAttribute('data-id');
        tk.confirmDelete({ title: 'Xoá phân xe?' }).then(function (ok) { if (ok) { var f = document.getElementById('delete-form'); f.querySelector('[name="id"]').value = id; f.submit(); } });
      });
    });
  </script>
}
