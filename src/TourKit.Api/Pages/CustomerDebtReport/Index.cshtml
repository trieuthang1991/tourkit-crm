@page
@model TourKit.Api.Pages.CustomerDebtReport.IndexModel
@{ ViewData["Title"] = "Công nợ khách"; }

@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
}

@{
    (string Label, string Value, string Icon, string Color, string Sub)[] statCards =
    {
        ("Tổng phải thu", Model.TotalAmount.ToString("#,##0"), "ti ti-receipt", "primary", "toàn bộ đơn"),
        ("Đã thu", Model.TotalPaid.ToString("#,##0"), "ti ti-cash", "success", "phiếu đã duyệt"),
        ("Còn nợ", Model.TotalOutstanding.ToString("#,##0"), "ti ti-alert-triangle", "danger", "chưa thu"),
    };
}
<div class="row g-4 mb-4">
  @foreach (var s in statCards)
  {
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center">
            <div class="avatar flex-shrink-0 me-3">
              <span class="avatar-initial rounded-3 bg-label-@s.Color">
                <i class="@s.Icon ti-md"></i>
              </span>
            </div>
            <div>
              <span class="d-block text-muted small">@s.Label</span>
              <h4 class="mb-0">@s.Value</h4>
            </div>
          </div>
          <div class="text-muted small mt-2">@s.Sub</div>
        </div>
      </div>
    </div>
  }
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Công nợ khách theo đơn hàng</h5>
    <a id="btn-export" class="btn btn-sm btn-label-secondary" href="?handler=Export"><i class="ti ti-file-export me-1"></i> Xuất CSV</a>
  </div>
  <div class="card-datatable table-responsive">
    <table id="tbl" class="table table-hover">
      <thead><tr><th>Mã đơn</th><th class="text-end">Phải thu</th><th class="text-end">Đã thu</th><th class="text-end">Còn nợ</th></tr></thead>
      <tbody>
      @foreach (var x in Model.Items)
      {
        <tr>
          <td class="fw-medium">@(string.IsNullOrEmpty(x.OrderCode) ? "—" : x.OrderCode)</td>
          <td class="text-end">@x.Total.ToString("#,##0")</td>
          <td class="text-end text-success">@x.Paid.ToString("#,##0")</td>
          <td class="text-end fw-medium @(x.Outstanding > 0 ? "text-danger" : "")">@x.Outstanding.ToString("#,##0")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
}

@section PageScripts {
  <script>
    $(function () { tk.tableClient('#tbl'); });
  </script>
}
